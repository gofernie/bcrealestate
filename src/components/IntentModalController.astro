<script is:inline>
  (() => {
    function arrangeListingActions() {
      const openPanel =
        document.querySelector(".panel__content.open") ||
        document.querySelector(".panel__content");

      const body = openPanel?.querySelector(".panel__body");
      const shareButton =
        document.getElementById("sheet-share-btn");

      if (!body || !shareButton) return;

      const reactionRows = [
        ...body.querySelectorAll(".listing-reaction-actions"),
      ];

      if (!reactionRows.length) return;

      const primaryRow =
        reactionRows.find((row) =>
          row.querySelector("#decision-love-btn")
        ) || reactionRows[0];

      reactionRows.forEach((row) => {
        const duplicate = row !== primaryRow;

        row.dataset.duplicateActions =
          duplicate ? "true" : "false";

        row.hidden = duplicate;
      });

      let shareSolo =
        body.querySelector(".panel__share-solo");

      if (!shareSolo) {
        shareSolo = document.createElement("div");
        shareSolo.className = "panel__share-solo";
      }

      shareSolo.appendChild(shareButton);

      primaryRow.insertAdjacentElement(
        "afterend",
        shareSolo
      );

      shareButton.hidden = false;
      shareButton.style.display = "inline-flex";
    }

    arrangeListingActions();

    const observer = new MutationObserver(() => {
      window.requestAnimationFrame(arrangeListingActions);
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
    });

    document.addEventListener(
      "click",
      () => window.requestAnimationFrame(arrangeListingActions),
      true
    );
  })();
</script>
