  const inp = () => document.getElementById("watch-home-phone");
  document.addEventListener("focusin", (e) => { if (e.target === inp()) log("FOCUS phone"); }, true);
  document.addEventListener("focusout", (e) => { if (e.target === inp()) log("BLUR phone -> " + (e.relatedTarget ? (e.relatedTarget.id || e.relatedTarget.tagName) : "none") + "\n" + (new Error().stack || "").split("\n").slice(2, 7).join("\n")); }, true);
  addEventListener("resize", () => log("RESIZE " + innerWidth + "x" + innerHeight + " active=" + (document.activeElement?.id || document.activeElement?.tagName)));
  new MutationObserver((ms) => ms.forEach((m) => {
    const i = inp(); if (!i) return;
    if (m.type === "childList") [...m.removedNodes].forEach((n) => { if (n.nodeType === 1 && (n === i || n.contains(i))) log("MOVED/REMOVED ancestor " + (n.id || n.className)); });
    if (m.type === "attributes" && m.target.contains(i)) log("ATTR " + m.attributeName + " on " + (m.target.id || m.target.className) + " = " + String(m.target.getAttribute(m.attributeName)).slice(0, 60));
  })).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ["hidden", "class", "style"] });
  log("debugblur ready");
})();
</script>