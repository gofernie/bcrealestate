<script is:inline>
(() => {
  function arrangeModalActionSuite() {

    const preview = document.getElementById("preview-sheet");
    const engage = document.getElementById("sheet-engage");
    const brochure = document.getElementById("sheet-brochure-btn");
    const share = document.getElementById("sheet-share-btn");
    if (!preview || !engage || !brochure || !share) return;
if (preview.dataset.actionSuiteReady === "true") return;
preview.dataset.actionSuiteReady = "true";

    let suite = preview.querySelector(".panel__action-suite");
    if (!suite) {
      suite = document.createElement("div");
      suite.className = "panel__action-suite";
      engage.parentNode.insertBefore(suite, engage);
    }

    let utilities = suite.querySelector(".panel__utility-actions");
    if (!utilities) {
      utilities = document.createElement("div");
      utilities.className = "panel__utility-actions";
    }

    suite.appendChild(engage);
    const brochureRow = document.createElement("div");
    brochureRow.className = "panel__brochure-row";
    brochureRow.appendChild(brochure);

    suite.appendChild(brochureRow);
    utilities.appendChild(share);
    suite.appendChild(utilities);
  
  }

  document.addEventListener("astro:page-load", arrangeModalActionSuite);

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      arrangeModalActionSuite,
      { once: true }
    );
  } else {
    arrangeModalActionSuite();
  }
})();
</script>

