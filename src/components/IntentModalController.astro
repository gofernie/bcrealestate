<script is:inline>
(() => {
  if (window.__watchHomeInit) return;
  window.__watchHomeInit = true;
  const KEY = "watchedListings";
  const $ = (id) => document.getElementById(id);
  const readMap = () => { try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { return {}; } };
  const writeMap = (m) => { try { localStorage.setItem(KEY, JSON.stringify(m)); } catch {} };
  const txt = (id) => ($(id)?.textContent || "").trim();
  let lastClickedCard = null;
  document.addEventListener("click", (e) => {
    const c = e.target instanceof Element ? e.target.closest("[data-listing-id]") : null;
    if (c && !c.closest("#preview-sheet")) lastClickedCard = c;
  }, true);
  const idOf = (el) => (el ? String(el.dataset.listingId || el.dataset.itemId || el.dataset.mls || "").trim() : "");
  const listingId = () => {
    const a = idOf(window.__activeIntentCard);
    if (a) return a;
    const p = new URLSearchParams(location.search).get("listing_id");
    if (p) return p.trim();
    const addr = txt("sheet-address").toLowerCase();
    if (addr && addr !== "address") {
      const cards = [...document.querySelectorAll("[data-listing-id]")];
      for (const c of cards) {
        const ca = String(c.dataset.address || "").trim().toLowerCase();
        if (ca && (ca === addr || ca.startsWith(addr) || addr.startsWith(ca))) return idOf(c);
      }
      for (const c of cards) {
        if ((c.textContent || "").toLowerCase().includes(addr)) return idOf(c);
      }
    }
    return idOf(lastClickedCard);
  };
  window.__modalListingId = listingId;

  function setWatching(on, last4) {
    const btn = $("watch-home-btn"), card = $("watch-home-card");
    if (!btn || !card) return;
    btn.classList.toggle("is-watching", on);
    btn.querySelector(".watch-home__label").textContent = on ? "Watching" : "Watch";
    card.classList.toggle("is-done", on);
    card.querySelector(".watch-home__title").textContent = on ? "You're watching this home" : "Watch this home?";
    card.querySelector(".watch-home__sub").textContent = on
      ? "We'll text \u2022\u2022\u2022" + (last4 || "") + " if the price drops or it sells."
      : "Get a text if the price drops or it sells.";
    $("watch-home-msg").textContent = "No calls. Reply STOP anytime.";
  }

  function reset() {
    const card = $("watch-home-card"), home = $("watch-home");
    if (!card || !home) return;
    if (card.parentElement !== home) home.appendChild(card);
    card.hidden = true;
    $("watch-home-btn")?.setAttribute("aria-expanded", "false");
    const w = readMap()[listingId()];
    setWatching(!!w, w);
  }

  function openCard(anchor, focus) {
    const card = $("watch-home-card");
    if (!card) return;
    if (anchor && anchor.isConnected) anchor.insertAdjacentElement("afterend", card);
    else $("watch-home").appendChild(card);
    card.hidden = false;
    $("watch-home-btn")?.setAttribute("aria-expanded", "true");
    if (focus && !card.classList.contains("is-done") && !matchMedia("(pointer: coarse)").matches) $("watch-home-phone")?.focus({ preventScroll: true });
  }

