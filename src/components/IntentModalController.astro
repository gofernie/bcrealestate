<script is:inline>
  (() => {
    let cleanupScheduled = false;

    function cleanModalUtilities() {
      cleanupScheduled = false;

      const openPanel =
        document.querySelector(".panel__content.open");

      const body = openPanel?.querySelector(".panel__body");

      if (!body) return;

      const reactionRows = [
        ...body.querySelectorAll(
          ".listing-reaction-actions"
        ),
      ];

      const primaryRow =
        reactionRows.find((row) =>
          row.querySelector("#decision-love-btn")
        ) || reactionRows[0];

      reactionRows.forEach((row) => {
        if (row !== primaryRow) {
          row.remove();
        }
      });

      const shareButton =
        document.getElementById("sheet-share-btn");

      if (!shareButton || !primaryRow) return;

      let shareSolo =
        body.querySelector(".panel__share-solo");

      if (!shareSolo) {
        shareSolo = document.createElement("div");
        shareSolo.className = "panel__share-solo";
      }

      shareSolo.appendChild(shareButton);

      primaryRow.insertAdjacentElement(
        "afterend",
        shareSolo
      );

      shareButton.hidden = false;
      shareButton.style.display = "inline-flex";
    }

    function scheduleCleanup() {
      if (cleanupScheduled) return;

      cleanupScheduled = true;

      requestAnimationFrame(cleanModalUtilities);
    }

    scheduleCleanup();

    new MutationObserver(scheduleCleanup).observe(
      document.body,
      {
        childList: true,
        subtree: true,
      }
    );

    document.addEventListener(
      "click",
      scheduleCleanup,
      true
    );
  })();
</script>
