    function scheduleRemoval() {
      if (scheduled) return;

      scheduled = true;
      requestAnimationFrame(removeLegacyReactionRow);
    }

    removeLegacyReactionRow();

    new MutationObserver(scheduleRemoval).observe(
      document.getElementById("preview-sheet") ||
        document.body,
      {
        childList: true,
        subtree: true,
      }
    );

    document.addEventListener(
      "click",
      scheduleRemoval,
      true
    );
  })();
</script>
