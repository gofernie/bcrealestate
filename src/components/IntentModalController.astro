<script is:inline>
  // mobile-top-floorplan-visibility-guard
  (() => {
    const button =
      document.getElementById("sheet-floorplan-btn");

    const mobileQuery =
      window.matchMedia("(max-width: 600px)");

    if (!button) return;

    const enforceVisibility = () => {
      if (!mobileQuery.matches) return;

      if (
        !button.hidden ||
        button.style.getPropertyValue("display") !== "none"
      ) {
        button.hidden = true;
        button.style.setProperty(
          "display",
          "none",
          "important"
        );
      }
    };

    enforceVisibility();

    new MutationObserver(enforceVisibility).observe(
      button,
      {
        attributes: true,
        attributeFilter: [
          "hidden",
          "style",
          "class"
        ]
      }
    );

    mobileQuery.addEventListener?.(
      "change",
      enforceVisibility
    );
  })();
</script>
