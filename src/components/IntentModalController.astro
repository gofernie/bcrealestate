---
const { listings = [] } = Astro.props;
---
<style is:global>
@import "/src/styles/intent-modal.css";

/*
 * MOBILE LANDSCAPE PHOTO MODE
 *
 * Rotating a phone to landscape while a listing is open turns
 * the existing modal into a dedicated image viewer.
 *
 * We reuse the existing image, swipe handlers and photo index.
 */
@media (orientation: landscape) {
 #preview-sheet.is-landscape-gallery {
  position: fixed !important;
  inset: 0 !important;
  width: var(--landscape-vw, 100vw) !important;
  height: var(--landscape-vh, 100dvh) !important;
    max-width: none !important;
    max-height: none !important;
    border-radius: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #000 !important;
    z-index: 2147483000 !important;
    transform: none !important;
  }

  #preview-sheet.is-landscape-gallery .panel__grab,
  #preview-sheet.is-landscape-gallery .panel__progress-track,
  #preview-sheet.is-landscape-gallery .panel__position,
  #preview-sheet.is-landscape-gallery .panel__header-actions,
  #preview-sheet.is-landscape-gallery .panel__image-overlay,
  #preview-sheet.is-landscape-gallery .photo-nav,
  #preview-sheet.is-landscape-gallery .panel__body,
  #preview-sheet.is-landscape-gallery .panel__mini-map,
  #preview-sheet.is-landscape-gallery .panel__osm-amenities,
  #preview-sheet.is-landscape-gallery .panel__engage,
  #preview-sheet.is-landscape-gallery .panel__footer,
  #preview-sheet.is-landscape-gallery #sheet-highlight-chips {
    display: none !important;
  }

  #preview-sheet.is-landscape-gallery .panel__progress-wrap {
    position: static !important;
    height: 0 !important;
    min-height: 0 !important;
    overflow: visible !important;
  }

  #preview-sheet.is-landscape-gallery .panel__header {
    position: static !important;
    height: 0 !important;
    min-height: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
  }

#preview-sheet.is-landscape-gallery .panel__close {
  display: none !important;
}

#preview-sheet.is-landscape-gallery .panel__view,
#preview-sheet.is-landscape-gallery .panel__content,
#preview-sheet.is-landscape-gallery .panel__image-stage {
  position: fixed !important;
  inset: 0 !important;
  width: var(--landscape-vw, 100vw) !important;
  height: var(--landscape-vh, 100dvh) !important;
  min-height: var(--landscape-vh, 100dvh) !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    background: #000 !important;
  }

  #preview-sheet.is-landscape-gallery .panel__content {
    display: block !important;
    overscroll-behavior: none;
    touch-action: pan-y;
  }

  #preview-sheet.is-landscape-gallery .panel__image-stage {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  #preview-sheet.is-landscape-gallery .panel__image {
    display: block !important;
    width: 100vw !important;
    height: 100dvh !important;
    max-width: 100vw !important;
    max-height: 100dvh !important;
    object-fit: contain !important;
    object-position: center !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #000 !important;
  }

  #preview-sheet.is-landscape-gallery .panel__photo-count {
  display: block !important;
  position: fixed !important;

  top: max(12px, env(safe-area-inset-top)) !important;
  left: max(14px, env(safe-area-inset-left)) !important;
  right: auto !important;
  bottom: auto !important;

  width: fit-content !important;
  height: auto !important;
  min-width: 0 !important;
  min-height: 0 !important;
  max-width: none !important;
  max-height: none !important;

  transform: none !important;

  padding: 0 !important;
  margin: 0 !important;

  border: 0 !important;
  border-radius: 0 !important;

  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;

  color: #fff !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  line-height: 1 !important;
  white-space: nowrap !important;

  text-shadow: 0 1px 4px rgba(0,0,0,0.85) !important;

  z-index: 2147483645 !important;
}

  #sheet-overlay.is-landscape-gallery {
    position: fixed !important;
    inset: 0 !important;
    background: #000 !important;
    z-index: 2147482999 !important;
  }

  /* HARD RESET anything from the portrait gallery */
#preview-sheet.is-landscape-gallery .panel__image-stage,
#preview-sheet.is-landscape-gallery .panel__image-stage::before,
#preview-sheet.is-landscape-gallery .panel__image-stage::after,
#preview-sheet.is-landscape-gallery .panel__view::before,
#preview-sheet.is-landscape-gallery .panel__view::after,
#preview-sheet.is-landscape-gallery .panel__content::before,
#preview-sheet.is-landscape-gallery .panel__content::after {
  border-radius: 0 !important;
  clip-path: none !important;
  mask: none !important;
  -webkit-mask: none !important;
  filter: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  box-shadow: none !important;
}

#preview-sheet.is-landscape-gallery .panel__image-stage::before,
#preview-sheet.is-landscape-gallery .panel__image-stage::after,
#preview-sheet.is-landscape-gallery .panel__view::before,
#preview-sheet.is-landscape-gallery .panel__view::after,
#preview-sheet.is-landscape-gallery .panel__content::before,
#preview-sheet.is-landscape-gallery .panel__content::after {
  content: none !important;
  display: none !important;
}
#preview-sheet.is-landscape-gallery #sheet-image {
  position: fixed !important;
  inset: 0 !important;

  width: var(--landscape-vw, 100vw) !important;
  height: var(--landscape-vh, 100dvh) !important;

  max-width: var(--landscape-vw, 100vw) !important;
  max-height: var(--landscape-vh, 100dvh) !important;

  object-fit: contain !important;
  object-position: center center !important;

  border: 0 !important;
  border-radius: 0 !important;
  clip-path: none !important;
  mask: none !important;
  -webkit-mask: none !important;

  filter: none !important;

  transform-origin: center center !important;
  will-change: transform;
  touch-action: none;

  background: #000 !important;

  z-index: 1 !important;
}
}
.panel__mini-map-wrap {
  position: relative;
  width: 100%;
}

.panel__mini-map {
  width: 100%;
  transition:
    height 260ms ease,
    min-height 260ms ease;
}

.panel__map-expand-btn {
  position: absolute;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  z-index: 1000;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  min-height: 44px;
  padding: 0 18px;

  border: 1px solid rgba(0, 0, 0, 0.12);
  border-radius: 999px;

  background: rgba(255, 255, 255, 0.96);
  color: #222;

  font: inherit;
  font-size: 14px;
  font-weight: 700;

  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.16);
  cursor: pointer;

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.panel__map-expand-btn:active {
  transform: translateX(-50%) scale(0.97);
}

@media (min-width: 769px) {
  .panel__map-expand-btn {
    display: none !important;
  }
}

@media (min-width: 769px) {
  .photo-nav {
    position: absolute !important;
    top: 200px !important;
    transform: none !important;
  }

  .photo-nav--prev {
    left: 18px !important;
  }

  .photo-nav--next {
    right: 18px !important;
  }
}


/* Center What stood out buttons */
.panel__feedback {
  text-align: center !important;
}

.panel__feedback .feedback-options,
.panel__feedback .feedback-tags {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 0.75rem !important;
  flex-wrap: wrap !important;
  width: 100% !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

/* Center Love / Like / Nope */
.decision-actions {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 0.75rem !important;
  width: 100% !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

.decision-actions .decision-btn {
  flex: 0 0 auto !important;
}


/* Force Love / Like / Nope to true center */
.decision-actions {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 0.75rem !important;
  width: 100% !important;
  margin: 1rem auto 0 !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
  transform: none !important;
}

.decision-actions .decision-btn {
  flex: 0 0 auto !important;
  margin: 0 !important;
}


/* Final reaction-row centering override */
#preview-sheet .decision-actions {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 0.75rem !important;

  width: 100% !important;
  max-width: none !important;

  margin: 14px 0 0 !important;
  padding: 0 !important;

  box-sizing: border-box !important;
  transform: none !important;
}

#preview-sheet .decision-actions .decision-btn {
  flex: 0 0 auto !important;
  margin: 0 !important;
}


/* Clean isolated listing reaction row */
#preview-sheet .listing-reaction-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.75rem;

  width: min(100%, 768px);
  margin: 1.25rem 0 0;
  padding: 0;

  box-sizing: border-box;
}

#preview-sheet .listing-reaction-actions .decision-btn {
  flex: 0 0 auto;
  margin: 0;
}


/* Use real HTML gallery arrows - disable corrupted CSS-generated arrows */
#preview-sheet .photo-nav {
  font-size: 1.5rem !important;
}

#preview-sheet .photo-nav::before {
  content: none !important;
  display: none !important;
}


/* FINAL gallery arrows - ASCII-safe Unicode escapes */
#preview-sheet .photo-nav {
  font-size: 0 !important;
}

#preview-sheet .photo-nav::before {
  display: block !important;
  font-family: Arial, sans-serif !important;
  font-size: 2rem !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  color: #fff !important;
}

#preview-sheet .photo-nav--prev::before {
  content: "\2039" !important;
}

#preview-sheet .photo-nav--next::before {
  content: "\203A" !important;
}


#preview-sheet .panel__image-stage.is-floorplan {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: #fff !important;
}

#preview-sheet .panel__image.is-floorplan {
  width: 100% !important;
  height: 100% !important;
  max-width: 100% !important;
  max-height: 100% !important;
  object-fit: contain !important;
  object-position: center center !important;
  background: #fff !important;
}

#preview-sheet .panel__image-stage.is-floorplan
.panel__image-overlay {
  display: none !important;
}
</style>
