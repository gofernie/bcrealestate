  // Keep Download PDF inside the image rather than in the header.
  if (
    sheetImageStage &&
    sheetFloorplanDownloadBtn &&
    sheetFloorplanDownloadBtn.parentElement !== sheetImageStage
  ) {
    sheetImageStage.appendChild(sheetFloorplanDownloadBtn);
  }

