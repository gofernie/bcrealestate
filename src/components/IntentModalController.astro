    const p = pair();
    $("together-form").hidden = !!p; const tb = $("together-back"), prev = store.get("together_prev"); if (tb) { tb.hidden = !!p || !prev; tb.textContent = prev ? "Back to search with " + (prev.partner_name || "your partner") : ""; }
