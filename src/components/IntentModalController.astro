  const visibleMapButton = Array.from(
    document.querySelectorAll("#sheet-map-btn")
  ).find((button) => {
    const rect = button.getBoundingClientRect();

    return (
      rect.width > 0 &&
      rect.height > 0 &&
      rect.bottom > 0 &&
      rect.top < window.innerHeight
    );
  });

  if (
    visibleMapButton?.parentElement &&
    sheetFloorplanBtn.parentElement !==
      visibleMapButton.parentElement
