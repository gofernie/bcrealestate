            '<li><span class="together__kind ' + (m.kind === "match" ? "match" : "maybe") + '">' +
            (m.kind === "match" ? "Both love" : "Maybe") + "</span>" +
            '<a href="' + esc(m.listing_url) + '">' + esc(m.address || m.listing_id) + "</a>" +
