---
import { mobileHomeParks } from "../../data/mobileHomeParks";

const featuredParks = mobileHomeParks.filter((park) =>
  ["sea-breeze", "deerwood-place-estates", "sharman"].includes(park.slug)
);
---

<section class="parks-home" aria-labelledby="parks-home-title">
  <div class="parks-home__head">
    <div>
      <span>MORE THAN THE LISTING</span>
      <h2 id="parks-home-title">Find the right park, too.</h2>
      <p>
        Compare Nanaimo parks by age rules, pet policies and community type
        before you book a showing.
      </p>
    </div>
    <a href="/mobile-home-parks-in-nanaimo">Browse all parks →</a>
  </div>

  <div class="parks-home__paths">
    <a href="/mobile-home-parks-in-nanaimo?age=55-plus">55+ communities</a>
    <a href="/mobile-home-parks-in-nanaimo?type=other">All other parks</a>
    <a href="/mobile-home-parks-in-nanaimo?type=pets">Pet-friendly parks</a>
  </div>

  <div class="parks-home__grid">
    {featuredParks.map((park) => (
      <a href={`/parks/${park.slug}`} class="parks-home__card">
        <span>{park.age} · {park.petType === "none" ? "No pets" : park.pets}</span>
        <strong>{park.name.replace(" Manufactured Home Park", "")}</strong>
        <small>{park.address}, Nanaimo</small>
        <b>View park details →</b>
      </a>
    ))}
  </div>
</section>

<style>
  .parks-home {
    margin: 40px 0 28px; padding: clamp(22px, 3vw, 34px);
    border: 1px solid #d7e1de; border-radius: 18px; background: #edf4f1;
  }
  .parks-home__head { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .parks-home__head span { color: var(--accent, #2f6f73); font-size: .72rem; font-weight: 800; letter-spacing: .1em; }
  h2 { margin: 6px 0 8px; color: #153a3d; font-size: clamp(1.6rem, 3vw, 2.25rem); }
  p { max-width: 650px; margin: 0; color: #49605f; }
  .parks-home__head > a, .parks-home__card b { color: var(--accent, #2f6f73); font-weight: 800; text-decoration: none; white-space: nowrap; }
  .parks-home__paths { display: flex; gap: 8px; flex-wrap: wrap; margin: 22px 0 14px; }
  .parks-home__paths a { padding: 8px 12px; border: 1px solid #bfd2cd; border-radius: 999px; background: #fff; color: #244c4d; font-size: .85rem; font-weight: 750; text-decoration: none; }
  .parks-home__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .parks-home__card { display: grid; gap: 8px; min-height: 168px; padding: 18px; border: 1px solid #d7e1de; border-radius: 12px; background: #fff; color: #274342; text-decoration: none; }
  .parks-home__card span { color: #557270; font-size: .74rem; font-weight: 700; }
  .parks-home__card strong { color: #173f40; font-size: 1rem; }
  .parks-home__card small { color: #667a78; }
  .parks-home__card b { align-self: end; font-size: .85rem; }
  @media (max-width: 720px) {
    .parks-home__head { align-items: start; flex-direction: column; }
    .parks-home__grid { grid-template-columns: 1fr; }
  }
</style>