---
import { createClient } from "@supabase/supabase-js";
import { getMarketPulse } from "../lib/marketPulse";
const { city = "nanaimo", showLink = false, fx = true } = Astro.props;
const __sb = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.SUPABASE_SERVICE_ROLE_KEY);
const {
  cityLabel, monthlyHistory, marketPulseRead, salesToActive, monthsOfSupply, priorSalesToActive,
  pulseSupply, pulseSupplyYoY, pulseSupplyLabel, pulseSupplyNoun, salesRollingAverage, salesYoY,
  hasInventoryPulse, activeInventoryAverage, activeListingsRollingAverage, daysOnMarketRollingAverage,
  daysOnMarketContext, saleToListRollingAverage, saleToListContext, islandRank, islandList,
} = await getMarketPulse(__sb, String(city));
const citySlug = String(city).toLowerCase().trim();
---
<div class={"mpc" + (showLink ? " mpc--embed" : "")} style="--market-ink:#17131c;--market-muted:#6d6872;--market-line:rgba(45,35,55,.11);--market-text:#17131c;color:var(--market-ink);">
<section data-pulse-lead style="width:min(1400px, calc(100% - 4rem));margin:28px auto 8px;">
<div
  class="market-pulse"
  style="display:grid;grid-template-columns:minmax(255px,.75fr) minmax(0,1.5fr);gap:34px;align-items:stretch;"
>
            <aside class="market-pulse__read">
  <div data-pulse-left style="margin:0 0 22px;padding-bottom:18px;border-bottom:1px solid rgba(0,0,0,.09);"><span data-pulse-date style="display:block;margin-top:0;font-size:1.02rem;font-weight:700;letter-spacing:0;text-transform:none;line-height:1.1;color:inherit;">{monthlyHistory.at(-1)?.month ? new Intl.DateTimeFormat("en-CA", { month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(`${monthlyHistory.at(-1)?.month}T00:00:00Z`)) : ""}</span>{(() => { const m = String(monthlyHistory.at(-1)?.month || "").slice(0, 10); const d = new Date(); const prev = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() - 1, 1)).toISOString().slice(0, 10); return m === prev; })() && (<span data-pulse-prelim style="display:block;margin-top:4px;font-size:.74rem;font-weight:500;letter-spacing:0;text-transform:none;font-style:italic;opacity:.7;">Preliminary: sales reported after month end are added nightly.</span>)}<span data-updated style="display:block;margin-top:8px;font-size:.72rem;letter-spacing:0;text-transform:none;opacity:.6;">Updated {new Intl.DateTimeFormat("en-CA", { month: "long", day: "numeric", year: "numeric", timeZone: "America/Edmonton" }).format(new Date())} · statistically indexed nightly</span></div><p class="market-pulse__eyebrow">Market read</p>

  <h3>{marketPulseRead.headline}</h3>

  <p style="font-size:1.02rem !important;line-height:1.45 !important;margin-top:12px !important;">{marketPulseRead.detail}</p>

  <span class="market-pulse__evidence">
    {salesToActive == null ? marketPulseRead.evidence : (() => {
      const h = String(marketPulseRead.headline || "");
      if (/buyers? (have|hold)/i.test(h)) return "Good time to buy: room to negotiate on price and conditions.";
      if (/sellers? (have|hold)/i.test(h)) return "Good time to sell: well-priced homes are drawing strong interest.";
      if (/tilt\w* toward buyers/i.test(h)) return "Balanced, with an edge to buyers: there's room to negotiate on the right home.";
      if (/tilt\w* toward sellers/i.test(h)) return "Balanced, with an edge to sellers: well-priced homes still move quickly.";
      return "Fair deals both ways: pricing right matters more than timing.";
    })()}
  </span>{islandRank && (<details data-island-rank style="margin-top:14px;padding-top:12px;border-top:1px solid rgba(0,0,0,.09);font-size:.82rem;line-height:1.45;letter-spacing:0;text-transform:none;">
  <summary style="cursor:pointer;font-weight:500;opacity:.85;">{(islandRank as any).rank === 1 ? "The most active" : `#${(islandRank as any).rank} most active`} of {(islandRank as any).total} Island markets this week{String((islandRank as any).name).toLowerCase() !== String(cityLabel).toLowerCase() ? ` (${(islandRank as any).name})` : ""} · {(islandRank as any).deals} new {(islandRank as any).deals === 1 ? "deal" : "deals"} in the last 7 days <span style="text-decoration:underline;opacity:.7;white-space:nowrap;">See all</span></summary>
  <ol style="margin:10px 0 0;padding:0;list-style:none;display:grid;gap:2px;">
    {islandList.map((r: any, idx: number) => { const me = String(r.market_name).toLowerCase() === String((islandRank as any).name).toLowerCase(); return (
      <li style={`display:flex;justify-content:space-between;gap:10px;padding:3px 8px;border-radius:6px;${me ? "background:rgba(0,0,0,.08);font-weight:700;" : ""}`}>
        <span>{idx + 1}. {r.market_name}</span>
        <span style="font-variant-numeric:tabular-nums;opacity:.75;">{Math.round(Number(r.activity_index) * 100)}%</span>
      </li>); })}
  </ol>
  <span style="display:block;margin-top:8px;font-size:.72rem;opacity:.6;">Pending deals as a share of active listings. Updated nightly.</span>
</details>)}
</aside>
   <div class="market-pulse__story">
                <div class="market-pulse__number" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:12px 0 22px;">
                <div style="min-width:0;">
                  <span style="display:block;min-height:34px;margin-bottom:7px;color:var(--market-muted);font-size:.95rem;font-weight:850;letter-spacing:.08em;line-height:1.25;text-transform:uppercase;">{pulseSupplyLabel}</span>
                  <strong style="display:block;color:var(--accent,#258fd0);font-family:var(--f-display,Georgia,serif);font-size:clamp(2.5rem,4vw,3.7rem);font-weight:500;letter-spacing:-.045em;line-height:.95;">
                    {pulseSupply != null ? Math.round(pulseSupply).toLocaleString() : "\u2014"}<span aria-hidden="true" data-arrow-next-to-value-v1 style={pulseSupplyYoY != null && pulseSupplyYoY < 0 ? "display:inline-grid;place-items:center;width:1.45em;height:1.45em;margin-left:.25em;border-radius:999px;font-family:system-ui,-apple-system,sans-serif;font-size:.5em;font-weight:900;line-height:1;letter-spacing:0;vertical-align:.2em;padding-bottom:.08em;background:color-mix(in srgb,currentColor 20%,transparent);color:#a65353;" : "display:inline-grid;place-items:center;width:1.45em;height:1.45em;margin-left:.25em;border-radius:999px;font-family:system-ui,-apple-system,sans-serif;font-size:.5em;font-weight:900;line-height:1;letter-spacing:0;vertical-align:.2em;padding-bottom:.08em;background:color-mix(in srgb,currentColor 20%,transparent);color:var(--accent,#258fd0);"}>{pulseSupplyYoY != null && pulseSupplyYoY < 0 ? "\u25BC" : "\u25B2"}</span>
                  </strong>
                  <p style="display:block;margin:12px 0 0;color:var(--market-text);font-size:1.05rem;font-weight:750;line-height:1.3;">
                    {pulseSupplyYoY != null ? `${Math.abs(pulseSupplyYoY).toFixed(0)}% ${pulseSupplyYoY >= 0 ? "more" : "fewer"} ${pulseSupplyNoun}` : "Year-over-year comparison unavailable"}
                    <small style="display:block;margin-top:3px;color:var(--market-muted);font-size:.85rem;font-weight:400;line-height:1.35;">vs. the same 3-month period last year</small>
                  </p>
                </div>
                <div style="min-width:0;padding-left:16px;border-left:1px solid var(--market-line);">
                  <span style="display:block;min-height:34px;margin-bottom:7px;color:var(--market-muted);font-size:.95rem;font-weight:850;letter-spacing:.08em;line-height:1.25;text-transform:uppercase;">Average sales / month</span>
                  <strong style="display:block;color:#c17f3a;font-family:var(--f-display,Georgia,serif);font-size:clamp(2.5rem,4vw,3.7rem);font-weight:500;letter-spacing:-.045em;line-height:.95;">
                    {salesRollingAverage != null ? Math.round(salesRollingAverage).toLocaleString() : "\u2014"}<span aria-hidden="true" data-arrow-next-to-value-v1 style={salesYoY != null && salesYoY < 0 ? "display:inline-grid;place-items:center;width:1.45em;height:1.45em;margin-left:.25em;border-radius:999px;font-family:system-ui,-apple-system,sans-serif;font-size:.5em;font-weight:900;line-height:1;letter-spacing:0;vertical-align:.2em;padding-bottom:.08em;background:color-mix(in srgb,currentColor 20%,transparent);color:#a65353;" : "display:inline-grid;place-items:center;width:1.45em;height:1.45em;margin-left:.25em;border-radius:999px;font-family:system-ui,-apple-system,sans-serif;font-size:.5em;font-weight:900;line-height:1;letter-spacing:0;vertical-align:.2em;padding-bottom:.08em;background:color-mix(in srgb,currentColor 20%,transparent);color:var(--accent,#258fd0);"}>{salesYoY != null && salesYoY < 0 ? "\u25BC" : "\u25B2"}</span>
                  </strong>
                  <p style="display:block;margin:12px 0 0;color:var(--market-text);font-size:1.05rem;font-weight:750;line-height:1.3;">
                    {salesYoY != null ? `${Math.abs(salesYoY).toFixed(0)}% ${salesYoY >= 0 ? "more" : "fewer"} sales` : "Year-over-year comparison unavailable"}
                    <small style="display:block;margin-top:3px;color:var(--market-muted);font-size:.85rem;font-weight:400;line-height:1.35;">vs. the same 3-month period last year</small>
                  </p>
                </div>
              </div>
              {salesToActive != null && (
                <div class="market-balance">
                  <div class="market-balance__head"><span>Sales-to-active ratio</span><strong>{salesToActive.toFixed(0)}%</strong><em>{monthsOfSupply != null ? `${monthsOfSupply.toFixed(1)} months of supply` : ""}</em>{priorSalesToActive != null && <em class="market-balance__was"><span class="market-balance__was-dot"></span>{priorSalesToActive.toFixed(0)}% a year ago</em>}</div>
                  <div class="market-balance__track"><i class="mb-buyers"></i><i class="mb-balanced"></i><i class="mb-sellers"></i>{priorSalesToActive != null && <span class="market-balance__prior" title={`A year ago: ${priorSalesToActive.toFixed(0)}%`} style={`left:${Math.min(Math.max((priorSalesToActive / 30) * 100, 2), 98)}%`}></span>}<b style={`left:${Math.min(Math.max((salesToActive / 30) * 100, 2), 98)}%`}></b></div>
                  <div class="market-balance__scale"><span>Buyer's market</span><span>Balanced</span><span>Seller's market</span></div>
                </div>
              )}
              <h3 style="margin-top:24px;">The numbers behind it.</h3>
              <p>
  Over the last three months, the market averaged {hasInventoryPulse && activeInventoryAverage != null && <><strong>{Math.round(activeInventoryAverage).toLocaleString()} active listings</strong>,{" "}</>}
  <strong>{activeListingsRollingAverage != null ? Math.round(activeListingsRollingAverage).toLocaleString() : "\u2014"} new listings</strong>
  and
  <strong>{salesRollingAverage != null ? Math.round(salesRollingAverage).toLocaleString() : "\u2014"} sales per month</strong>.
  Median days on market averaged
  <strong>{daysOnMarketRollingAverage != null ? `${Math.round(daysOnMarketRollingAverage)} days` : "\u2014"}</strong>{daysOnMarketContext ? ` \u2014 ${daysOnMarketContext}` : ""}.
  Sale-to-list averaged
  <strong>{saleToListRollingAverage != null ? `${saleToListRollingAverage.toFixed(1)}%` : "\u2014"}</strong>{saleToListContext ? `, ${saleToListContext}` : ""}.
</p>
              {showLink && <a class="mpc__more" href={`/${citySlug}/market-intelligence`}>Read the full {cityLabel} market update &rarr;</a>}
            </div>
          </div>
</section>
</div>
{fx && <script is:inline>
  (() => {
    const arrows = [...document.querySelectorAll('.market-pulse [data-arrow-next-to-value-v1]')].slice(0, 2); arrows.forEach((b) => { const s = b.textContent || ''; const up = /[\u25B2\u2191]/.test(s), dn = /[\u25BC\u2193]/.test(s); if (!up && !dn) return; const d = up ? 'M5 1.6 L8.9 8.4 H1.1 Z' : 'M1.1 1.6 H8.9 L5 8.4 Z'; b.innerHTML = `<svg viewBox="0 0 10 10" width="0.6em" height="0.6em" aria-hidden="true" style="display:block;overflow:visible"><path d="${d}" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/></svg>`; });
    if (!arrows.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const play = () => { arrows.forEach((b, i) => { b.style.transformOrigin = 'center'; b.style.animation = 'none'; if (b.animate) { const ring = getComputedStyle(b).color; b.animate([{ transform: 'scale(1)', boxShadow: '0 0 0 0 transparent' }, { transform: 'scale(1.6)', boxShadow: `0 0 0 8px color-mix(in srgb, ${ring} 22%, transparent)`, offset: .45 }, { transform: 'scale(1)', boxShadow: '0 0 0 0 transparent' }], { duration: 1200, delay: (0.4 + i * 1.6) * 1000, easing: 'ease-in-out' }); } }); const dot = document.querySelector('.market-pulse .market-balance__track b'); if (dot && dot.animate) { const ring = getComputedStyle(dot).backgroundColor; dot.animate([{ transform: 'translateY(-50%) scale(1)', boxShadow: '0 1px 4px rgba(0,0,0,.25)' }, { transform: 'translateY(-50%) scale(1.6)', boxShadow: `0 0 0 8px color-mix(in srgb, ${ring} 22%, transparent)`, offset: .45 }, { transform: 'translateY(-50%) scale(1)', boxShadow: '0 1px 4px rgba(0,0,0,.25)' }], { duration: 1200, delay: (0.4 + arrows.length * 1.6) * 1000, easing: 'ease-in-out' }); } };
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { setTimeout(play, 2600); io.disconnect(); } }, { threshold: 0.5 });
    io.observe(arrows[0]);
  })();
  (() => {
    const h = document.querySelector('.market-pulse h3');
    if (!h || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!(CSS.supports('-webkit-background-clip', 'text') || CSS.supports('background-clip', 'text'))) return;
    const sheen = () => { const base = getComputedStyle(h).color; const s = h.style; s.backgroundImage = `linear-gradient(100deg, ${base} 0%, ${base} 40%, #d9934f 50%, ${base} 60%, ${base} 100%)`; s.backgroundSize = '250% 100%'; s.backgroundPosition = '100% 0'; s.webkitBackgroundClip = 'text'; s.backgroundClip = 'text'; s.webkitTextFillColor = 'transparent'; const a = h.animate([{ backgroundPosition: '100% 0' }, { backgroundPosition: '0% 0' }], { duration: 1400, easing: 'cubic-bezier(.45,0,.25,1)' }); a.onfinish = a.oncancel = () => { ['backgroundImage','backgroundSize','backgroundPosition','webkitBackgroundClip','backgroundClip','webkitTextFillColor'].forEach((k) => (s[k] = '')); }; };
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(sheen, 1000); } }, { threshold: 0.6 });
    io.observe(h);
  })();
</script>}
{showLink && <script is:inline>
/* embed-js-v1: flatten the host frame with inline !important so later stylesheets can't undo it */
(function () {
  function flat() {
    document.querySelectorAll(".mpc--embed").forEach(function (card) {
      var host = card.parentElement; if (!host || host === document.body) return;
      ["border", "background", "box-shadow", "padding"].forEach(function (k) { host.style.setProperty(k, k === "background" ? "none" : k === "box-shadow" ? "none" : "0", "important"); });
      var sec = card.querySelector("section[data-pulse-lead]");
      if (sec) { sec.style.setProperty("width", "100%", "important"); sec.style.setProperty("margin-left", "0", "important"); sec.style.setProperty("margin-right", "0", "important"); }
    });
  }
  flat();
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", flat);
  window.addEventListener("load", flat);
  setTimeout(flat, 1500);
})();
</script>}<style is:global>
  .market-pulse__read > p:not(.market-pulse__eyebrow), .market-pulse__story p { font-size: 1.05rem !important; line-height: 1.62 !important; }
  .market-pulse { align-items: start !important; }
  .market-pulse > :not(.market-pulse__read) { align-self: start !important; padding-top: 30px !important; }
  .market-pulse { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(290px, 1fr); gap: 42px; align-items: end; margin-top: 30px; padding: 30px 32px; border-left: 4px solid var(--accent, #258fd0); background: linear-gradient(90deg, color-mix(in srgb, var(--accent, #258fd0) 8%, transparent), transparent 72%); }
  .market-pulse__eyebrow { margin: 0 0 10px; color: var(--accent, #258fd0); font-size: .7rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .market-pulse h3 { margin: 0; color: var(--market-text); font-family: var(--f-display, Georgia, serif); font-size: clamp(1.8rem, 3vw, 2.55rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.05; }
  .market-pulse__story > p:last-child { max-width: 660px; margin: 14px 0 0; color: var(--market-muted); font-size: 1rem; line-height: 1.65; }
  .market-pulse__story > p:last-child strong { color: var(--market-text); font-weight: 750; }
  @media (max-width: 720px) { .market-pulse { grid-template-columns: 1fr; gap: 25px; padding: 26px 22px; } }
  .market-pulse { grid-template-columns: minmax(240px, .78fr) minmax(0, 1.6fr) !important; }
  .market-pulse__read { grid-column: 1 !important; grid-row: 1 !important; order: 0 !important; min-width: 0 !important; }
  .market-pulse__story { grid-column: 2 !important; grid-row: 1 !important; order: 0 !important; min-width: 0 !important; }
  @media (max-width: 720px) { .market-pulse { grid-template-columns: 1fr !important; } .market-pulse__read { grid-column: 1 !important; grid-row: 1 !important; } .market-pulse__story { grid-column: 1 !important; grid-row: 2 !important; } }
  .market-pulse { background: none !important; }
  .market-pulse > .market-pulse__story { align-self: start !important; padding-top: 30px !important; }
  .market-pulse > .market-pulse__read { background: color-mix(in srgb, var(--accent, #258fd0) 11%, #ffffff) !important; border-radius: 14px !important; padding: 30px 30px !important; align-self: stretch !important; margin-left: 22px !important; align-content: center !important; border: 0 !important; }
  .market-balance__scale span { font-size: .85rem !important; }
  .market-pulse__read { order: -1; display: grid; align-content: center; min-width: 0; padding-right: 30px; }
  .market-pulse__read h3 { margin: 0; color: var(--market-text); font-family: var(--f-display, Georgia, serif); font-size: clamp(2rem, 3.3vw, 3.15rem); font-weight: 500; letter-spacing: -.045em; line-height: .98; }
  .market-pulse__read > p:not(.market-pulse__eyebrow) { max-width: 510px; margin: 16px 0 0; color: var(--market-muted); font-size: .98rem; line-height: 1.58; }
  .market-pulse__evidence { display: block; margin-top: 18px; color: var(--accent, #258fd0); font-size: .73rem; font-weight: 850; letter-spacing: .07em; line-height: 1.4; text-transform: uppercase; }
  @media (max-width: 720px) {
    .market-pulse__read { padding-right: 0; }
    .market-pulse { display: grid !important; grid-template-columns: minmax(0, 1fr) !important; width: 100% !important; min-width: 0 !important; margin: 30px 0 0 !important; padding: 24px 20px 22px !important; gap: 24px !important; box-sizing: border-box !important; }
    .market-pulse__read, .market-pulse__story { grid-column: 1 !important; width: 100% !important; min-width: 0 !important; box-sizing: border-box !important; }
    .market-pulse__read { grid-row: 1 !important; order: 0 !important; padding: 0 !important; border: 0 !important; }
    .market-pulse__story { grid-row: 2 !important; order: 0 !important; padding: 20px 0 0 !important; border-top: 1px solid var(--market-line) !important; }
    .market-pulse__number { gap: 14px !important; margin: 14px 0 0 !important; }
    .market-pulse__read h3 { font-size: clamp(2rem, 9vw, 2.65rem) !important; }
    .market-pulse__story > h3 { margin-top: 24px !important; }
  }
  .market-pulse { margin-top: 28px; padding: 26px 0 20px; border-top: 1px solid var(--market-line); border-bottom: 1px solid var(--market-line); }
  .market-balance { max-width: 560px; margin: 0 0 8px; }
  .market-balance__head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 10px; }
  .market-balance__head span { color: var(--market-muted); font-size: .68rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
  .market-balance__head strong { color: var(--market-text); font-size: 1.4rem; font-weight: 750; }
  .market-balance__head em { color: var(--market-muted); font-size: .82rem; font-style: normal; }
  .market-balance__track { position: relative; display: flex; height: 8px; }
  .market-balance__track i { display: block; height: 100%; }
  .market-balance__track .mb-buyers { width: 40%; border-radius: 4px 0 0 4px; background: #cfe0ea; }
  .market-balance__track .mb-balanced { width: 26.67%; background: #e3e6ea; }
  .market-balance__track .mb-sellers { width: 33.33%; border-radius: 0 4px 4px 0; background: #f1dccd; }
  .market-balance__track b { position: absolute; top: 50%; width: 16px; height: 16px; margin-left: -8px; border: 3px solid #fff; border-radius: 50%; background: var(--accent, #2f3a45) !important; z-index: 2; box-shadow: 0 1px 4px rgba(0,0,0,.25); transform: translateY(-50%); }
  .market-balance__scale { display: grid; grid-template-columns: 40% 26.67% 33.33%; margin-top: 7px; color: var(--market-muted); font-size: .68rem; }
  .market-balance__scale span:nth-child(2) { text-align: center; }
  .market-balance__scale span:nth-child(3) { text-align: right; }
  .market-balance__prior { position: absolute; top: 50%; width: 10px; height: 10px; margin-left: -5px; border: 2px solid #9aa3ad !important; border-radius: 50%; background: #fff !important; opacity: .9; z-index: 1; transform: translateY(-50%); }
  .market-balance__head .market-balance__was { display: inline-flex; align-items: center; gap: 6px; }
  .market-balance__was-dot { display: inline-block; width: 8px; height: 8px; border: 2px solid #9aa3ad; border-radius: 50%; opacity: .9; }
  @media (max-width: 720px) {
    section[data-pulse-lead] { width: calc(100% - 1.5rem) !important; margin: 16px auto 8px !important; }
    section[data-pulse-lead] .market-pulse { border-left: 0 !important; padding: 0 !important; margin: 0 !important; background: none !important; gap: 18px !important; }
    section[data-pulse-lead] .market-pulse > .market-pulse__read { margin: 0 !important; padding: 20px 18px !important; width: 100% !important; border-radius: 12px !important; }
    section[data-pulse-lead] .market-pulse > .market-pulse__story { padding: 4px 2px 0 !important; border-top: 0 !important; }
    section[data-pulse-lead] .market-pulse__number { grid-template-columns: 1fr !important; gap: 0 !important; margin: 4px 0 18px !important; }
    section[data-pulse-lead] .market-pulse__number > div { display: grid !important; grid-template-columns: auto minmax(0, 1fr) !important; align-items: center !important; column-gap: 18px !important; padding: 14px 0 !important; border-left: 0 !important; border-top: 1px solid var(--market-line) !important; }
    section[data-pulse-lead] .market-pulse__number > div:first-child { border-top: 0 !important; padding-top: 4px !important; }
    section[data-pulse-lead] .market-pulse__number > div > span { grid-column: 1 / -1 !important; min-height: 0 !important; margin: 0 0 6px !important; font-size: .72rem !important; }
    section[data-pulse-lead] .market-pulse__number > div > strong { font-size: 2.6rem !important; }
    section[data-pulse-lead] .market-pulse__number > div > p { margin: 0 !important; font-size: .98rem !important; }
    section[data-pulse-lead] .market-balance__head { flex-wrap: wrap !important; column-gap: 8px !important; row-gap: 2px !important; }
    section[data-pulse-lead] .market-balance__head > span { flex-basis: 100% !important; }
