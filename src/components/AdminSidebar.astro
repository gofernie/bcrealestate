---
import AdminTopNav from "./AdminTopNav.astro";

const { active = "", siteId = "" } = Astro.props;

const activeMap: Record<string, string> = {
  "new-page": "pages",
  areas: "area-boundaries",
};
const topActive = activeMap[active] || active;
const hasSections = Astro.slots.has("default");
---

<div class="admin-topnav-wrap">
  <AdminTopNav active={topActive} siteId={siteId} />
</div>

{hasSections && (
  <div class="admin-sectionbar">
    <slot />
  </div>
)}

<style>
  :global(html) { overflow-y: scroll; scrollbar-gutter: stable; }

  /* Old layouts put the sidebar in a 220px grid column; collapse that grid. */
  :global(*:has(> .admin-topnav-wrap)) { display: block !important; }

  :global(html:has(.admin-sectionbar)) { scroll-padding-top: 70px; }

  .admin-sectionbar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: #f7f4ef;
    border-bottom: 1px solid #e3ddd2;
    padding: 0 32px;
  }

  :global(.admin-sectionbar .sidebar__section-links) {
    display: flex;
    flex-direction: row;
    gap: 4px;
    overflow-x: auto;
    margin: 0;
    padding: 10px 0;
    border: 0;
  }

  :global(.admin-sectionbar .sidebar__section-links a) {
    flex: 0 0 auto;
    padding: 7px 12px;
    border: 0;
    border-radius: 8px;
    color: #5f5a54;
    text-decoration: none;
    font: 600 13px/1.2 "DM Sans", system-ui, sans-serif;
    white-space: nowrap;
  }

  :global(.admin-sectionbar .sidebar__section-links a:hover) { background: #ece6dc; color: #181614; }

  :global(.admin-sectionbar .sidebar__section-links a.active) {
    background: #181614;
    color: #fff;
    border-left: 0;
    padding-left: 12px;
  }

  @media (max-width: 860px) {
    .admin-sectionbar { padding: 0 16px; }
  }
</style>
