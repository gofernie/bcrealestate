---
const {
  city = "nanaimo",
  pages = [],
  inventory = [],
  title = "",
  currentType = "",
  dedupeBy = "href",
  currentArea = "",
  limit = 6,
} = Astro.props;

const titleCase = (value: unknown) =>
  String(value || "")
    .replace(/-/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase())
    .trim();

const normalise = (value: unknown) =>
  String(value || "")
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const typeLabels: Record<string, string> = {
  house: "Homes",
  condo: "Condos",
  townhouse: "Townhomes",
  mobile: "Mobile Homes",
  land: "Lots",
};


const listingMatchesType = (listing: any, wanted: string) => {
  const actual = normalise(
    listing.normalized_type || listing.property_type
  );

  if (wanted === "mobile") {
    return [
      "mobile", "mobiles", "mobile-home", "mobile-homes",
      "manufactured", "manufactured-home", "manufactured-homes",
    ].includes(actual);
  }

  if (wanted === "house") {
    return ["house", "homes", "houses"].includes(actual);
  }

  if (wanted === "townhouse") {
    return ["townhouse", "townhouses", "townhome", "townhomes"].includes(actual);
  }

  if (wanted === "land") {
    return ["land", "lot", "lots"].includes(actual);
  }

  return actual === wanted;
};
const currentPath =
  Astro.url.pathname.replace(/\/+$/, "") || "/";

const seenTargets = new Set<string>();
const cards: any[] = [];
const activeType = normalise(currentType);

for (const intent of pages) {
  const href = `/${city}/${String(intent.slug || "").replace(/^\/+/, "")}`
    .replace(/\/+$/, "");

  const type = normalise(intent.property_type);
  const area = normalise(intent.area);
  const cardIdentity = dedupeBy === "href" ? href : type ? `type:${type}:${area || "all"}` : href;

  if (
    !intent.slug ||
    href === currentPath ||
    (type && activeType && type === activeType && !area) ||
    seenTargets.has(cardIdentity)
  ) {
    continue;
  }

  seenTargets.add(cardIdentity);
  let matching = Array.isArray(inventory) ? [...inventory] : [];
  // Keep this count in step with the destination page.
  if (type) {
    matching = matching.filter((listing) =>
      listingMatchesType(listing, type)
    );
  }

  if (area) {
    matching = matching.filter(
      (listing) => normalise(listing.normalized_area || listing.area) === area
    );
  }

  const intentSignals =
    `${intent.slug || ""} ${intent.hero_heading || ""} ${intent.seo_heading || ""}`;

  const viewType =
    String(intent.view_type || "").trim().toLowerCase() ||
    (/ocean\s+view/i.test(intentSignals) ? "ocean" : "");

  if (viewType) {
    matching = matching.filter((listing) => {
      const listingViewType = String(
        listing.view_type || listing.viewType || ""
      ).trim().toLowerCase();

      return viewType === "ocean"
        ? /\bocean\b/.test(listingViewType)
        : listingViewType.includes(viewType);
    });
  }
  const waterfrontType =
    String(intent.waterfront_type || "").trim().toLowerCase() ||
    (/lakefront/i.test(
      `${intent.slug || ""} ${intent.hero_heading || ""} ${intent.seo_heading || ""}`
    )
      ? "lakefront"
      : "");

  if (waterfrontType) {
    matching = matching.filter(
      (listing) =>
        String(listing.waterfront_type || "").trim().toLowerCase() ===
        waterfrontType
    );
  } else if (intent.requires_waterfront === true) {
    matching = matching.filter((listing) =>
      ["true", "yes", "y", "1"].includes(
        String(listing.waterfront ?? "").trim().toLowerCase()
      )
    );
  }

  const minPrice = Number(intent.price_min || 0);
  const maxPrice = Number(intent.price_max || 0);

  if (minPrice) matching = matching.filter((listing) => Number(listing.price || 0) >= minPrice);
  if (maxPrice) matching = matching.filter((listing) => Number(listing.price || 0) <= maxPrice);
  const bedsMin = Number(intent.beds_min || 0);
  const bathsMin = Number(intent.baths_min || 0);
  const minSqft = Number(intent.min_sqft || 0);
  const minLotSqft = Number(intent.min_lot_sqft || 0);
  const minYear = Number(intent.min_year || 0);
  const lotSqftOf = (listing: any) =>
    Number(listing.lot_size_sqft || 0) || Number(listing.lot_size_acres || 0) * 43560;

  if (bedsMin) matching = matching.filter((listing) => Number(listing.beds || 0) >= bedsMin);
  if (bathsMin) matching = matching.filter((listing) => Number(listing.baths || 0) >= bathsMin);
  if (minSqft) matching = matching.filter((listing) => Number(listing.sqft || 0) >= minSqft);
  if (minLotSqft) matching = matching.filter((listing) => lotSqftOf(listing) >= minLotSqft);
  if (minYear) matching = matching.filter((listing) => Number(listing.year_built || listing.year || 0) >= minYear);

  const prices = matching
    .map((listing) => Number(listing.price || 0))
    .filter((price) => price > 0)
    .sort((a, b) => a - b);

  const median = prices.length
    ? prices[Math.floor(prices.length / 2)]
    : 0;

  const sourceCopy = String(
    intent.intro_copy ||
    intent.meta_description ||
    ""
  ).replace(/\s+/g, " ").trim();

  const copyIsThin = sourceCopy.split(/\s+/).filter(Boolean).length <= 4;

  const cardType =
    type ||
    (/lakefront|waterfront|oceanfront/i.test(
      `${intent.slug || ""} ${intent.hero_heading || ""} ${intent.seo_heading || ""}`
    )
      ? "waterfront"
      : "listing");

  const label =
    viewType === "ocean"
      ? "Ocean view homes"
      : waterfrontType === "lakefront"
        ? "Lakefront homes"
        : cardType === "waterfront"
          ? "Waterfront homes"
          : typeLabels[type] ||
            titleCase(intent.property_type || intent.area || "Listings");

  const count = matching.length;

  const generatedCopy =
    count && median
      ? `${count} ${label.toLowerCase()} for sale, with a median asking price of $${median.toLocaleString()}.`
      : count
        ? `${count} active ${label.toLowerCase()} currently for sale.`
        : `Browse current ${label.toLowerCase()} and compare new opportunities as they come to market.`;


  cards.push({
    _type: type,
    _area: area,
    _rank: Number(intent.featured_rank || 0),
    _i: cards.length,
    href,
    label,
    count,
    type: cardType,
    title:
      intent.hero_heading ||
      intent.seo_heading ||
      `${titleCase(city)} ${label}`,
    copy: copyIsThin ? generatedCopy : sourceCopy,
  });
}


/* card selection v1 */
const limitN = Number(limit) || 6;
const ctxType = activeType;
const ctxArea = normalise(currentArea);
const hasContext = Boolean(ctxType || ctxArea);
const noRanks = !cards.some((c) => c._rank);
const scoreOf = (c: any) => {
  if (!hasContext && noRanks) return -c._i;
  let s = 0;
  if (ctxType && c._type === ctxType) s += 40;
  if (ctxArea) {
    if (c._area === ctxArea) s += 40;
    else if (!c._area) s += 10;
  }
  if (c._rank) s += hasContext ? 8 : (1000 - c._rank) * 100;
  s += Math.min(10, Math.log10(1 + Number(c.count || 0)) * 4);
  return s;
};
const pool = cards
  .filter((c) => Number(c.count || 0) >= (c._rank ? 1 : 3))
  .map((c) => ({ c, s: scoreOf(c) }))
  .sort((a, b) => b.s - a.s || a.c._i - b.c._i)
  .map((x) => x.c);
const picked: any[] = [];
const perType = new Map<string, number>();
const capFor = (t: string) => (ctxType && t === ctxType ? Math.max(1, limitN - 2) : 2);
const takeCard = (c: any) => {
  picked.push(c);
  perType.set(c._type, (perType.get(c._type) || 0) + 1);
};
for (const c of pool) {
  if (picked.length >= limitN) break;
  if (!(c._rank && !hasContext) && (perType.get(c._type) || 0) >= capFor(c._type)) continue;
  takeCard(c);
}
for (const c of pool) {
  if (picked.length >= limitN) break;
  if (!picked.includes(c)) takeCard(c);
}
const shownCards = picked;
const cardIcons: Record<string, string> = {
  house: '<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 11 9-7 9 7"/><path d="M5.5 10v10h13V10"/><path d="M9.5 20v-6h5v6"/></svg>',
  condo: '<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="3" width="14" height="18" rx="1"/><path d="M8 7h2M14 7h2M8 11h2M14 11h2M8 15h2M14 15h2M11 21v-3h2v3"/></svg>',
  townhouse: '<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m2 11 5-4 5 4v9H2Z"/><path d="m12 11 5-4 5 4v9h-10Z"/><path d="M6 20v-5h2v5M16 20v-5h2v5"/></svg>',
  mobile: '<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="7" width="16" height="10" rx="1"/><path d="M19 11h2v6h-2M6 10h5M8 17v2M17 17v2"/><circle cx="7" cy="20" r="1"/><circle cx="17" cy="20" r="1"/></svg>',
  land: '<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 20h16M5 16c3-4 6-4 9-1 2 2 4 1 5 0"/><path d="M10 16V4l7 3-7 3"/></svg>',
  waterfront: '<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m4 11 8-6 8 6"/><path d="M7 10v5h10v-5"/><path d="M2 18c2 1.5 4 1.5 6 0s4-1.5 6 0 4 1.5 6 0"/></svg>',
  listing: '<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8"/><path d="m15 9-2 4-4 2 2-4 4-2Z"/></svg>',
};
const heading = title || `Keep looking in ${titleCase(city)}`;
---

{cards.length > 0 && (
  <section class="related-intents">
    <div class="related-intents__head">
      <div>
        <p>Next searches</p>
        <h2>{heading}</h2>
      </div>

      <span>Each search stays live. Save one and we’ll tell you when something new fits.</span>
    </div>

    <div class="related-intents__grid">
      {shownCards.map((card) => (
        <a class="related-intent-card" href={card.href}>
          <div class="related-intent-card__stat">
            <h3 class="related-intent-card__title">{String(card.title).replace(new RegExp(`^${titleCase(city)}\\s+(?=\\S)`, "i"), "")}</h3>
          </div>

          <div class="related-intent-card__body">
            <div class="related-intent-card__meta">
              <span
                class="related-intent-card__icon"
                aria-hidden="true"
                set:html={cardIcons[card.type] || cardIcons.listing}
              ></span>
              <div class="related-intent-card__stat-copy">
                <strong>{card.count || "\u2014"}</strong>
                <span>{card.count ? `${card.label} for sale` : `Explore ${card.label}`}</span>
              </div>
            </div>
            <p class="related-intent-card__copy">{card.copy}</p>
            <span class="related-intent-card__link">See {card.label.toLowerCase()} &rarr;</span>
          </div>
        </a>
      ))}
    </div>

    {cards.length > shownCards.length && (
      <a class="related-intents__all" href={`/${city}/searches`} style="display:inline-block;margin-top:18px;font-weight:700;color:var(--accent,#2a6f73);text-decoration:none;">{`See all ${cards.length} ${titleCase(city)} searches \u2192`}</a>
    )}
  </section>
)}

<style is:global>
  /* card refresh v3: neutral, compact title row (global, wins over pastel rules) */
  html body section.related-intents .related-intents__all { display: inline-block; margin-top: 18px; font-weight: 700; color: var(--accent, #2a6f73); text-decoration: none; }
  html body section.related-intents .related-intents__all:hover { text-decoration: underline; text-underline-offset: 3px; }
  html body section.related-intents a.related-intent-card {
    background: #fff !important;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  html body section.related-intents a.related-intent-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(15, 30, 45, .08);
  }
  html body section.related-intents a.related-intent-card .related-intent-card__stat {
    background: transparent !important;
    background-image: none !important;
    padding: 18px 20px 12px !important;
    min-height: 0 !important;
    height: auto !important;
    aspect-ratio: auto !important;
    border-bottom: 1px solid rgba(15, 30, 45, .08) !important;
  }
  html body section.related-intents a.related-intent-card .related-intent-card__stat::before,
  html body section.related-intents a.related-intent-card .related-intent-card__stat::after { display: none !important; }
  html body section.related-intents .related-intent-card__title { font-size: 1.3rem !important; margin: 0 !important; }
  html body section.related-intents .related-intent-card__body { padding-top: 14px !important; }
  html body section.related-intents .related-intent-card__meta strong,
  html body section.related-intents .related-intent-card__meta .related-intent-card__icon,
  html body section.related-intents .related-intent-card__link { color: var(--accent, #2a6f73) !important; }
</style>
<style>
  /* title-in-band layout v1 */
  /* card refresh v2: single accent tint, compact band */
  .related-intent-card { transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .related-intent-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(15, 30, 45, .08); border-color: color-mix(in srgb, var(--accent, #2a6f73) 35%, #d8dde2); }
  .related-intent-card .related-intent-card__stat {
    background: color-mix(in srgb, var(--accent, #2a6f73) 7%, #fff) !important;
    padding: 16px 20px !important;
    min-height: 0 !important;
    border-bottom: 1px solid color-mix(in srgb, var(--accent, #2a6f73) 14%, transparent);
    transition: background .18s ease;
  }
  .related-intent-card:hover .related-intent-card__stat { background: color-mix(in srgb, var(--accent, #2a6f73) 12%, #fff) !important; }
  .related-intent-card__title { font-size: 1.3rem !important; }
  .related-intent-card__meta strong { color: var(--accent, #2a6f73); }
  .related-intent-card__meta .related-intent-card__icon { color: var(--accent, #2a6f73); }
  .related-intent-card__link { color: var(--accent, #2a6f73) !important; }
  .related-intent-card__stat { align-items: center; }
  .related-intent-card__title {
    margin: 0;
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: 1.45rem;
    line-height: 1.15;
    color: inherit;
  }
  .related-intent-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .related-intent-card__meta .related-intent-card__icon { display: inline-flex; opacity: .85; }
  .related-intent-card__meta .related-intent-card__icon :global(svg) { width: 26px; height: 26px; }
  .related-intent-card__meta .related-intent-card__stat-copy { display: flex; align-items: baseline; gap: 6px; }
  .related-intent-card__meta strong {
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1;
  }
  .related-intent-card__meta .related-intent-card__stat-copy span {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .75;
  }
</style>
<style>
  .related-intents {
    margin-top: 56px;
  }

  .related-intents__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 22px;
  }

  .related-intents__head p,
  .related-intent-card__label {
    margin: 0;
    color: var(--accent);
    font-size: .67rem;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .related-intents__head h2 {
    margin: 7px 0 0;
    font-family: var(--serif, Georgia, serif);
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    font-weight: 500;
    letter-spacing: -.04em;
  }

  .related-intents__head > span {
    max-width: 260px;
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.35;
  }

  .related-intents__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .related-intent-card {
    overflow: hidden;
    border: 1px solid var(--line-warm);
    border-radius: 10px;
    background: var(--card-bg, #fff);
    color: var(--ink);
    text-decoration: none;
    transition: transform .18s ease, box-shadow .18s ease;
  }

  .related-intent-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(10, 31, 45, .10);
  }

  .related-intent-card__stat {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    min-height: 70px;
    padding: 14px 18px;
    background: color-mix(in srgb, var(--accent) 10%, white);
  }

  .related-intent-card__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    color: var(--accent);
  }

  .related-intent-card__icon :global(svg) {
    width: 34px;
    height: 34px;
  }

  .related-intent-card__stat-copy {
    display: flex;
    align-items: end;
    gap: 8px;
  }

  .related-intent-card:nth-child(2n) .related-intent-card__stat {
    background: #eef7f7;
  }

  .related-intent-card:nth-child(3n) .related-intent-card__stat {
    background: #f4f0fa;
  }

  .related-intent-card:nth-child(4n) .related-intent-card__stat {
    background: #f4f8ee;
  }

  .related-intent-card__stat-copy strong {
    font-family: var(--serif, Georgia, serif);
    font-size: 1.8rem;
    font-weight: 500;
    letter-spacing: -.05em;
    line-height: .9;
  }

  .related-intent-card__stat-copy span {
    padding-bottom: 2px;
    color: var(--muted);
    font-size: .6rem;
    font-weight: 850;
    letter-spacing: .10em;
    text-transform: uppercase;
  }

  .related-intent-card__body {
    padding: 16px 18px 17px;
  }

  .related-intent-card h3 {
    margin: 8px 0 8px;
    font-family: var(--serif, Georgia, serif);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -.025em;
  }

  .related-intent-card__copy {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .related-intent-card__link {
    display: inline-block;
    margin-top: 14px;
    color: var(--accent);
    font-size: .72rem;
    font-weight: 850;
  }

  @media (max-width: 850px) {
    .related-intents__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .related-intents {
      margin-top: 38px;
    }

    .related-intents__head {
      display: block;
    }

    .related-intents__head > span {
      display: block;
      margin-top: 12px;
    }

    .related-intents__grid {
      grid-template-columns: 1fr;
    }
  }

/* Clear icon / count / label spacing in related cards */
.related-intent-card__stat {
  display: flex !important;
  align-items: center !important;
  gap: 11px !important;
}

.related-intent-card__stat strong + span {
  margin-left: 0 !important;
  white-space: nowrap;
}

/* Make the count label easier to scan */
.related-intent-card__stat span {
  font-size: 0.72rem !important;
  letter-spacing: 0.08em !important;
}
</style>