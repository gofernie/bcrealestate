---
type NavItem = {
  label: string;
  href: string;
};

const {
  city = "nanaimo",
  areas = [],
  intentPages = [],
  site = null,
  showAreaNav = false,
  activeSection = "",
  listingCount = 0,
  areaListingCounts = {},
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const cityLabel = String(city)
  .replace(/-/g, " ")
  .replace(/\b\w/g, (char) => char.toUpperCase());

const navMarketLabel =
  currentPath.startsWith("/saanich-east") ? "Saanich East" : currentPath.startsWith("/saanich-west") ? "Saanich West" : cityLabel;

// Agent-owned domains retain the agent's identity across every market.
// The central platform remains branded by the current market.
const hostname = Astro.url.hostname
  .toLowerCase()
  .replace(/^www\./, "");

const localAgentMatch =
  hostname.match(/^([a-z0-9-]+)\.localhost$/);

const effectiveBrandHostname =
  localAgentMatch
    ? `${localAgentMatch[1]}.bc.realestate`
    : hostname;

const isCentralPlatform =
  effectiveBrandHostname === "bc.realestate" ||
  effectiveBrandHostname === "localhost" ||
  effectiveBrandHostname === "127.0.0.1";

const configuredSiteName =
  String(site?.site_name || "").trim();

const navBrandLabel =
  currentPath.startsWith("/saanich-east") ? "Saanich East Homes" : currentPath.startsWith("/saanich-west") ? "Saanich West Homes" : !isCentralPlatform && configuredSiteName
      ? configuredSiteName
      : `${navMarketLabel} Homes`;
const slugify = (value: string) =>
  String(value || "")
    .toLowerCase()
    .trim()
    .replace(/\s+/g, "-");

const isActive = (href: string) => {
  const targetUrl = new URL(href, Astro.url);
  const targetType = targetUrl.searchParams.get("type");
  const currentType = Astro.url.searchParams.get("type");

  if (targetType) {
    return (
      currentPath === (targetUrl.pathname.replace(/\/$/, "") || "/") &&
      currentType === targetType
    );
  }
  const cleanHref = href.replace(/\/$/, "") || "/";

if (
    cleanHref === `/${slugify(city)}-real-estate-market` &&
    currentPath.startsWith(`/${slugify(city)}/areas/`)
  ) {
    return true;
  }

if (
    cleanHref === `/${slugify(city)}/areas` &&
    (
      currentPath === `/${slugify(city)}/areas` ||
      currentPath.startsWith(`/${slugify(city)}/areas/`) ||
      (
        currentPath.startsWith(`/${slugify(city)}/`) &&
        currentPath !== `/${slugify(city)}/` &&
        !typeLinks.some((t) => t.href === currentPath) &&
        !finalNavLinks.some((t) => t.href === currentPath) &&
        areaLinks.some((a) => a.href === currentPath)
      )
    )
  ) {
    return true;
  }

  return currentPath === cleanHref;
};

const TYPE_PAGE_MAP: Record<string, string> = {
  house: "homes",
  home: "homes",
  condo: "condos",
  townhouse: "townhomes",
  townhome: "townhomes",
  land: "land",
};

// ordered-core-navigation
const defaultTypeOrder = [
  "house",
  "condo",
  "townhouse",
  "mobile",
  "land",
];

const typeLinkMap: Record<
  string,
  NavItem
> = {
  house: {
    label: "Homes",
    href: `/${slugify(city)}/homes`,
  },
  condo: {
    label: "Condos",
    href: `/${slugify(city)}/condos`,
  },
  townhouse: {
    label: "Townhomes",
    href: `/${slugify(city)}/townhomes`,
  },
  mobile: {
    label: "Mobile Homes",
    href: `/${slugify(city)}/mobile-homes`,
  },
  land: {
    label: "Lot / Land",
    href: `/${slugify(city)}/land`,
  },
};

const configuredTypeOrder =
  Array.isArray(site?.nav_property_types)
    ? site.nav_property_types
        .map((value: unknown) =>
          String(value).trim().toLowerCase()
        )
        .filter((value: string) =>
          Boolean(typeLinkMap[value])
        )
    : defaultTypeOrder;

const typeLinks: NavItem[] =
  configuredTypeOrder.map(
    (propertyType: string) =>
      typeLinkMap[propertyType]
  );

const cleanAreaLabel = (value: string) =>
  String(value || "")
    .replace(/^pq\s+/i, "")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/\b\w/g, (char) => char.toUpperCase());

const areaLinks: NavItem[] = areas.map((area: string) => ({
  label: cleanAreaLabel(area),
  href: `/${slugify(city)}/${slugify(area)}`,
}));

const areaListingCountLookup: Record<string, number> =
  areaListingCounts &&
  typeof areaListingCounts === "object"
    ? (areaListingCounts as Record<string, number>)
    : {};

const hasAreaListingCounts =
  Object.keys(areaListingCountLookup).length > 0;

const normalizeNavCountArea = (value: string) =>
  String(value || "")
    .replace(/-/g, " ")
    .replace(/^pq\s+/i, "")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase()
    .replace(/\s+neighbou?rhood$/i, "")
    .trim();

const getNavAreaCount = (label: string) => {
  const key = normalizeNavCountArea(label);
  return Object.entries(areaListingCountLookup).reduce(
    (total, [area, count]) =>
      normalizeNavCountArea(area) === key
        ? total + Math.max(0, Number(count) || 0)
        : total,
    0
  );
};
const canonicalIntentHref = (pageSlug: string) => {
  const citySlug = slugify(city);
  const normalizedSlug = slugify(String(pageSlug || ""));

  const slugWithoutCity =
    normalizedSlug.startsWith(`${citySlug}-`)
      ? normalizedSlug.slice(citySlug.length + 1)
      : normalizedSlug;

  const canonicalTypeSlugs: Record<string, string> = {
    home: "homes",
    homes: "homes",
    house: "homes",
    houses: "homes",

    condo: "condos",
    condos: "condos",

    townhome: "townhomes",
    townhomes: "townhomes",
    townhouse: "townhomes",
    townhouses: "townhomes",

    mobile: "mobile-homes",
    mobiles: "mobile-homes",
    "mobile-home": "mobile-homes",
    "mobile-homes": "mobile-homes",

    lot: "land",
    lots: "land",
    land: "land",
    "lot-land": "land",
  };

  const canonicalTypeSlug =
    canonicalTypeSlugs[slugWithoutCity];

  if (canonicalTypeSlug) {
    return `/${citySlug}/${canonicalTypeSlug}`;
  }

  return `/${citySlug}/${normalizedSlug}`;
};

const intentLinks: NavItem[] = intentPages.slice(0, 6).map((page: any) => ({
  label:
    page.nav_label ||
    page.card_title ||
    page.hero_heading ||
    page.seo_heading ||
    page.lifestyle_angle ||
    page.slug
      .replace(/-/g, " ")
      .replace(/\b\w/g, (char: string) => char.toUpperCase()),
  href: canonicalIntentHref(page.slug),
}));

const navIntentLinks: NavItem[] = intentPages
  .filter((p: any) => p.show_in_nav)
  .map((page: any) => ({
    label:
      page.nav_label ||
      page.card_title ||
      page.hero_heading ||
      page.seo_heading ||
      page.slug
        .replace(/-/g, " ")
        .replace(/\b\w/g, (char: string) => char.toUpperCase()),
    href: canonicalIntentHref(page.slug),
  }));

const standardTypeLinksByHref = new Map(
  typeLinks.map((item) => [item.href, item])
);

const uniqueNavIntentLinks: NavItem[] = Array.from(
  new Map(
    navIntentLinks.map((item) => {
      const normalizedItem =
        standardTypeLinksByHref.get(item.href) || item;

      return [normalizedItem.href, normalizedItem];
    })
  ).values()
);

const isNanaimoMobilesSite =
  effectiveBrandHostname === "nanaimomobiles.com" ||
  Astro.url.searchParams
    .get("siteDomain")
    ?.toLowerCase()
    .replace(/^www\./, "") === "nanaimomobiles.com";

const combinedNavLinks: NavItem[] =
  Array.from(
    new Map(
      [
        ...typeLinks,
        ...uniqueNavIntentLinks,
      ].map((item) => [item.href, item])
    ).values()
  );

const nanaimoListingCount = Math.max(0, Number(listingCount) || 0);
const nanaimoListingCountText = nanaimoListingCount
  .toLocaleString("en-CA")
  .padStart(2, "0");

// site-nav-listing-counter-v1
const finalNavLinks: NavItem[] =
  isNanaimoMobilesSite
    ? typeLinks.filter(
        (item) =>
          item.label === "Mobile Homes"
      )
    : combinedNavLinks;

const navHref = (item: NavItem) => {
  const greaterVictoriaTypes: Record<string, string> = {
    Homes: "house",
    Condos: "condo",
    Townhomes: "townhouse",
    "Mobile Homes": "mobile",
    "Lot / Land": "land",
  };

  const type = greaterVictoriaTypes[item.label];

  return (
    String(city).trim().toLowerCase() === "greater-victoria" && type
      ? `/${slugify(city)}/?type=${type}#homepage-listings`
      : item.href
  );
};

const nanaimoMobileUtilityLinks: NavItem[] = [
  { label: "Park Directory", href: "/mobile-home-parks-in-nanaimo" },
  { label: "55+ Communities", href: "/mobile-home-parks-in-nanaimo?age=55-plus" },
];---

<nav class="site-nav">
  <div class="shell site-nav__inner">
   <a
    class="site-nav__brand"
    href={isNanaimoMobilesSite ? "/" : `/${slugify(city)}/`}
    aria-label={`${navBrandLabel} home`}
  >
    {navBrandLabel}
  </a>

    <button
      class="site-nav__toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-nav-links"
    >
      <span aria-hidden="true">&equiv;</span>
    </button>

    <button
      class="site-nav__theme-toggle"
      id="site-theme-toggle"
      type="button"
      aria-label="Switch to dark theme"
      title="Switch theme"
    >
      <span aria-hidden="true">◐</span>
      <span class="site-nav__theme-label">Theme</span>
    </button>
    <div class="site-nav__links" id="site-nav-links">
<div class="site-nav__areas">
  <a
    class="site-nav__areas-desktop"
    class:list={{
      active:
        activeSection === "areas" ||
        isActive(`/${slugify(city)}/areas`)
    }}
    href={`/${slugify(city)}/areas`}
  >
    Areas
  </a>

  <button
    class="site-nav__areas-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-nav-area-links"
  >
    <span>Areas</span>
    <span
      class="site-nav__areas-chevron"
      aria-hidden="true"
    >
      &#8964;
    </span>
  </button>

  <div
    class="site-nav__area-links"
    id="site-nav-area-links"
  >
        <a class="site-nav__area-map" style="background: var(--accent-soft) !important; color: var(--accent) !important; box-shadow: none !important;" href={`/${slugify(city)}/areas`}>
      <span>View map</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
{areaLinks.map((item) => (
      <a
        href={item.href}
      >
        <span class="site-nav__area-label">{item.label}</span>
        {hasAreaListingCounts && (
          <span
            class:list={{
              "site-nav__area-count": true,
              "is-zero": !getNavAreaCount(item.label),
            }}
          >
            {getNavAreaCount(item.label)} listings
          </span>
        )}
      </a>
    ))}

    <a
      class="site-nav__all-areas"
      href={`/${slugify(city)}/areas`}
    >
      View all {cityLabel} areas →
    </a>
  </div>
</div>

   {finalNavLinks.map((item) => (
  <a class:list={{ active: isActive(navHref(item)) }} href={navHref(item)}>
    {item.label}
  </a>
))}
{isNanaimoMobilesSite && nanaimoMobileUtilityLinks.map((item) => (
  <a
    class:list={{ active: isActive(item.href) }}
    href={
      String(city).trim().toLowerCase() === "greater-victoria" &&
      item.href.includes("?type=")
        ? `${item.href}#homepage-listings`
        : item.href
    }
  >
    {item.label}
  </a>
))}

{!isNanaimoMobilesSite && (
  <a
    class:list={{
      active: isActive(`/${slugify(city)}/market-intelligence`)
    }}
    href={`/${slugify(city)}/market-intelligence`}
  >Market Intel</a>
)}
    </div>
  </div>
</nav>

{showAreaNav && areaLinks.length > 0 && (
  <div class="site-subnav">
    <div class="shell site-subnav__inner">
      {areaLinks.map((item) => (
        <a
    class:list={{ active: isActive(item.href) }}
    href={
      String(city).trim().toLowerCase() === "greater-victoria" &&
      item.href.includes("?type=")
        ? `${item.href}#homepage-listings`
        : item.href
    }
  >
          {item.label}
        </a>
      ))}
    </div>
  </div>
)}


<script is:inline>
  (() => {
    const toggle = document.getElementById("site-theme-toggle");
    const metaThemeColor = document.querySelector(
      'meta[name="theme-color"]'
    );

    const updateThemeControl = () => {
      const isDark =
        document.documentElement.dataset.theme === "dark";

      toggle?.setAttribute(
        "aria-label",
        isDark
          ? "Switch to light theme"
          : "Switch to dark theme"
      );

      toggle?.setAttribute(
        "aria-pressed",
        String(isDark)
      );

      if (metaThemeColor) {
        metaThemeColor.setAttribute(
          "content",
          isDark ? "#08111b" : "#ffffff"
        );
      }
    };

    toggle?.addEventListener("click", () => {
      const nextTheme =
        document.documentElement.dataset.theme === "dark"
          ? "light"
          : "dark";

      document.documentElement.dataset.theme = nextTheme;

      try {
        localStorage.setItem("locus-theme", nextTheme);
      } catch {}

      updateThemeControl();
    });

    updateThemeControl();
  })();
</script><script is:inline>
  const navToggle = document.querySelector(".site-nav__toggle");
  const navLinks = document.querySelector(".site-nav__links");

  navToggle?.addEventListener("click", () => {
    const isOpen = navLinks?.classList.toggle("open");
    navToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });
</script>



<script is:inline>
  /* dynamic-area-menu-handler-v3 */
  const areaNav =
    document.querySelector(".site-nav__areas");
  const areaMenuToggle =
    document.querySelector(
      ".site-nav__areas-toggle"
    );

  const areaMenu =
    document.getElementById(
      "site-nav-area-links"
    );

  areaMenuToggle?.addEventListener(
    "click",
    (event) => {
      event.preventDefault();
      event.stopPropagation();

      if (!areaNav || !areaMenu) return;

      const willOpen = !areaNav.classList.contains("is-open");

      areaNav.classList.toggle("is-open", willOpen);

      areaMenuToggle.setAttribute(
        "aria-expanded",
        String(willOpen)
      );
    }
  );
</script>
