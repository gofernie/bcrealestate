<script is:inline>
  // greater-victoria-listings-anchor-v1
  (() => {
    const scrollToListings = () => {
      if (
        !location.pathname.replace(/\/$/, "").endsWith("/greater-victoria") ||
        location.hash !== "#homepage-listings"
      ) return;

      const results = document.querySelector(".home-results-experience");
      if (!results) return;

      results.id = "listings";
      results.style.scrollMarginTop = "9.5rem";

      requestAnimationFrame(() => {
        results.scrollIntoView({ block: "start" });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", scrollToListings, { once: true });
    } else {
      scrollToListings();
    }
  })();
</script>
<script is:inline>
  // greater-victoria-type-nav-and-anchor-v1
  (() => {
    const isGreaterVictoria = (pathname = location.pathname) =>
      pathname.replace(/\/$/, "").endsWith("/greater-victoria");

    const typeLabels = {
      house: "Homes",
      condo: "Condos",
      townhouse: "Townhomes",
      townhome: "Townhomes",
      mobile: "Mobile Homes",
      land: "Lot / Land",
    };

    const applyTypeNav = () => {
      if (!isGreaterVictoria()) return;

      const type = new URLSearchParams(location.search).get("type");
      const activeLabel = typeLabels[type];
      if (!activeLabel) return;

      document.querySelectorAll(".site-nav__links a").forEach((link) => {
        if (link.textContent.trim() === activeLabel) {
          link.classList.add("active");
          link.setAttribute("aria-current", "page");
        }
      });
    };

    document.addEventListener("click", (event) => {
      const link = event.target.closest(".site-nav__links a[href]");
      if (
        !link ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) return;

      const target = new URL(link.href, location.href);
      if (!isGreaterVictoria(target.pathname) || !target.searchParams.has("type")) {
        return;
      }

      event.preventDefault();
      target.hash = "homepage-listings";
      location.assign(target.href);
    });

    const scrollToListings = () => {
      if (!isGreaterVictoria() || location.hash !== "#homepage-listings") return;

      const deadline = performance.now() + 4000;
      const findAndScroll = () => {
        const results = document.querySelector(".home-results-experience");

        if (results) {
          results.id = "listings";
          results.style.scrollMarginTop = "9.5rem";
          results.scrollIntoView({ block: "start" });
          return;
        }

        if (performance.now() < deadline) {
          requestAnimationFrame(findAndScroll);
        }
      };

      requestAnimationFrame(findAndScroll);
    };

    const start = () => {
      applyTypeNav();
      scrollToListings();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start, { once: true });
    } else {
      start();
    }
  })();
</script>
<script is:inline>
  // greater-victoria-type-nav-capture-v1
  (() => {
    const isGreaterVictoria = (pathname) =>
      pathname.replace(/\/$/, "").endsWith("/greater-victoria");

    const typeLabels = {
      house: "Homes",
      condo: "Condos",
      townhouse: "Townhomes",
      townhome: "Townhomes",
      mobile: "Mobile Homes",
      land: "Lot / Land",
    };

    document.addEventListener("click", (event) => {
      const link = event.target.closest(".site-nav__links a[href]");
      if (
        !link ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) return;

      const target = new URL(link.href, location.href);
      const type = target.searchParams.get("type");

      if (!isGreaterVictoria(target.pathname) || !type) return;

      // Update the visible pill immediately.
      const selectedLabel = typeLabels[type];
      if (selectedLabel) {
        document.querySelectorAll(".site-nav__links a").forEach((item) => {
          const selected = item.textContent.trim() === selectedLabel;
          item.classList.toggle("active", selected);
          if (selected) item.setAttribute("aria-current", "page");
          else item.removeAttribute("aria-current");
        });
      }

      // Run before Astro's client-side router so the real anchor is honoured.
      event.preventDefault();
      event.stopImmediatePropagation();
      target.hash = "homepage-listings";
      window.location.href = target.href;
    }, true);
  })();
</script>