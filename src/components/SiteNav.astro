---
type NavItem = {
  label: string;
  href: string;
};

const {
  mode = "city",
  city: incomingCity = "nanaimo",
  site = null,
  areas = [],
  types: suppliedTypes = [],
  intentPages = [],
  showAreaNav = false,
  activeSection = "",
} = Astro.props;

const hostname = Astro.url.hostname
  .toLowerCase()
  .replace(/^www\./, "");

const siteDomain = String(
  site?.domain || ""
)
  .toLowerCase()
  .replace(/^www\./, "");

const isProvinceNav =
  mode === "province";

const isMobileHomeSite =
  site?.property_type_filter ===
    "mobile" ||
  site?.template ===
    "mobile-homes" ||
  siteDomain ===
    "nanaimomobiles.com" ||
  hostname ===
    "nanaimomobiles.com";

const configuredTypes = (() => {
  const value =
    site?.nav_property_types;

  if (Array.isArray(value)) {
    return value;
  }

  if (typeof value === "string") {
    try {
      const parsed =
        JSON.parse(value);

      return Array.isArray(parsed)
        ? parsed
        : [];
    } catch {
      return value
        .split(",")
        .map((item) =>
          item.trim()
        )
        .filter(Boolean);
    }
  }

  return [];
})();

const types =
  isMobileHomeSite
    ? []
    : suppliedTypes.length > 0
      ? suppliedTypes
      : configuredTypes;
const city =
  String(
    incomingCity
  ).toLowerCase() === "404"
    ? String(
        site?.city ||
          "nanaimo"
      )
    : incomingCity;

const currentPath =
  Astro.url.pathname.replace(
    /\/$/,
    ""
  ) || "/";

const cityLabel =
  String(city)
    .replace(/-/g, " ")
    .replace(
      /\b\w/g,
      (char) =>
        char.toUpperCase()
    );

const slugify = (
  value: string
) =>
  String(value || "")
    .toLowerCase()
    .trim()
    .replace(/\s+/g, "-");

const isBcRealEstate =
  hostname ===
    "bc.realestate" ||
  hostname ===
    "bcrealestate.netlify.app" ||
  hostname ===
    "localhost" ||
  hostname ===
    "127.0.0.1";

const isBcHomepage =
  isBcRealEstate &&
  currentPath === "/";

const brandName =
  isProvinceNav ||
  isBcHomepage
    ? "BC Real Estate"
    : isBcRealEstate
      ? `${cityLabel} Real Estate`
      : site?.site_name ||
        `${cityLabel} Homes`;

const usesRootPageUrls =
  hostname ===
    "nanaimomobiles.com" ||
  siteDomain ===
    "nanaimomobiles.com";

const brandHref =
  isProvinceNav
    ? "/"
    : usesRootPageUrls
      ? "/"
      : `/${slugify(city)}/`;

const buildPageHref = (
  pageSlug: string
) =>
  usesRootPageUrls
    ? `/${pageSlug}`
    : `/${slugify(
        city
      )}/${pageSlug}`;

const buildAreaHref = (
  areaSlug: string
) =>
  usesRootPageUrls
    ? `/${areaSlug}`
    : `/${slugify(
        city
      )}/${areaSlug}`;

const areasHref =
  `/${slugify(city)}/areas`;

const isActive = (
  href: string
) => {
  const hrefPath =
    href
      .split("#")[0]
      .split("?")[0]
      .replace(/\/$/, "") ||
    "/";

  return (
    currentPath === hrefPath
  );
};

const TYPE_PAGE_MAP: Record<
  string,
  string
> = {
  house: "homes",
  home: "homes",

  condo: "condos",

  townhouse: "townhomes",
  townhome: "townhomes",

  mobile: "mobile-homes",
  "mobile home": "mobile-homes",
  "mobile homes": "mobile-homes",

  land: "land",
};

const cleanAreaLabel = (
  value: string
) =>
  String(value || "")
    .replace(/^pq\s+/i, "")
    .replace(/\s+/g, " ")
    .trim()
    .replace(
      /\b\w/g,
      (char) =>
        char.toUpperCase()
    );

const provinceNavLinks: NavItem[] =
  [
    {
      label: "Cities",
      href: "/#bc-markets",
    },
   {
  label: "Explore BC",
  href: "/explore-bc",
},
    {
      label: "About BC",
      href: "/about-bc",
    },
    {
      label:
        "Market Insights",
      href:
        "/market-insights",
    },
    {
      label:
        "Buying Guide",
      href:
        "/buying-guide",
    },
    {
      label: "Contact",
      href: "/contact",
    },
  ];

const areaLinks: NavItem[] =
  areas
    .slice(0, 8)
    .map(
      (area: string) => ({
        label:
          cleanAreaLabel(
            area
          ),

        href:
          buildAreaHref(
            slugify(area)
          ),
      })
    );

const typeLinks: NavItem[] =
  types
    .map(
      (type: string) => {
        const normalizedType =
          String(type || "")
            .toLowerCase()
            .trim();

        const pageSlug =
          TYPE_PAGE_MAP[
            normalizedType
          ];

        if (!pageSlug) {
          return null;
        }

        const labels: Record<
          string,
          string
        > = {
          homes: "Homes",
          condos: "Condos",
          townhomes: "Townhomes",
          "mobile-homes":
            "Mobile Homes",
          land: "Land",
        };

        return {
          label:
            labels[
              pageSlug
            ] || pageSlug,

          href:
            buildPageHref(
              pageSlug
            ),
        };
      }
    )
    .filter(
      Boolean
    ) as NavItem[];

const CORE_NAV_ORDER: Record<
  string,
  number
> = {
  Homes: 0,
  Condos: 1,
  Townhomes: 2,
  "Mobile Homes": 3,
  Land: 4,
};

typeLinks.sort(
  (a, b) =>
    (
      CORE_NAV_ORDER[
        a.label
      ] ?? 999
    ) -
    (
      CORE_NAV_ORDER[
        b.label
      ] ?? 999
    )
);

const corePageSlugs = new Set([
  "homes",
  "condos",
  "townhomes",
  "mobile-homes",
  "land",
]);

const corePageLabels = new Set([
  "homes",
  "homes for sale",
  "condos",
  "condos for sale",
  "townhomes",
  "townhouses",
  "townhomes for sale",
  "mobile homes",
  "mobile homes for sale",
  "land",
  "land for sale",
]);

function isCorePageDuplicate(
  page: any
) {
  const slug = String(
    page?.slug || ""
  )
    .toLowerCase()
    .trim();

  const label = String(
    page?.nav_label ||
      page?.card_title ||
      page?.hero_heading ||
      page?.seo_heading ||
      ""
  )
    .toLowerCase()
    .trim();

  const slugWithoutCity =
    slug.replace(
      new RegExp(
        `^${slugify(city)}-`
      ),
      ""
    );

  return (
    corePageSlugs.has(slug) ||
    corePageSlugs.has(
      slugWithoutCity
    ) ||
    corePageLabels.has(label)
  );
}

const intentLinks: NavItem[] =
  intentPages
    .filter(
      (page: any) =>
        !isCorePageDuplicate(page)
    )
    .slice(0, 6)
    .map((page: any) => {
      const label =
        page.nav_label ||
        page.card_title ||
        page.hero_heading ||
        page.seo_heading ||
        page.lifestyle_angle ||
        page.slug
          .replace(/-/g, " ")
          .replace(
            /\b\w/g,
            (
              char: string
            ) =>
              char.toUpperCase()
          );

      const normalizedLabel =
        String(label)
          .toLowerCase()
          .trim();

      let href =
        buildPageHref(
          page.slug
        );

      /*
       * On nanaimomobiles.com,
       * these intent pages live
       * under /nanaimo/.
       */
      if (
        usesRootPageUrls &&
        (
          normalizedLabel ===
            "mobile homes" ||
          normalizedLabel ===
            "mobile homes for sale" ||
          normalizedLabel ===
            "55+" ||
          page.slug ===
            "nanaimo-mobile-homes" ||
          page.slug ===
            "nanaimo-mobile-55-mobile-homes"
        )
      ) {
        href =
          `/${slugify(
            city
          )}/${page.slug}`;
      }

      return {
        label,
        href,
      };
    });

const finalNavLinks: NavItem[] =
  [
    ...typeLinks,

    ...intentLinks.filter(
      (intentItem) =>
        !typeLinks.some(
          (typeItem) =>
            typeItem.href ===
              intentItem.href ||
            typeItem.label.toLowerCase() ===
              intentItem.label.toLowerCase()
        )
    ),
  ];
---

<nav class="site-nav">
  <div
    class="shell site-nav__inner"
  >
    <a
      class="site-nav__brand"
      href={brandHref}
    >
      {brandName}
    </a>

    <button
      class="site-nav__toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-nav-links"
    >
   <span aria-hidden="true">
  ☰
</span>
    </button>

    <div
      class="site-nav__links"
      id="site-nav-links"
    >
      {
        isProvinceNav ? (
          provinceNavLinks.map(
            (item) => (
              <a
                class:list={{
                  active:
                    isActive(
                      item.href
                    ),
                }}
                href={
                  item.href
                }
              >
                {item.label}
              </a>
            )
          )
        ) : (
          <>
            <a
              class:list={{
                active:
                  activeSection ===
                    "areas" ||
                  currentPath ===
                    areasHref,
              }}
              href={areasHref}
            >
              Areas
            </a>

            {
              finalNavLinks.map(
                (item) => (
                  <>
                    <a
                      class:list={{
                        active:
                          isActive(
                            item.href
                          ),
                      }}
                      href={
                        item.href
                      }
                    >
                      {
                        item.label
                      }
                    </a>

                    {
                      usesRootPageUrls &&
                      (
                        item.label.toLowerCase() ===
                          "mobile homes" ||
                        item.label.toLowerCase() ===
                          "mobile homes for sale"
                      ) && (
                        <a
                          class:list={{
                            active:
                              isActive(
                                "/park-directory"
                              ),
                          }}
                          href="/park-directory"
                        >
                          Park Directory
                        </a>
                      )
                    }
                  </>
                )
              )
            }
          </>
        )
      }
    </div>
  </div>
</nav>
<div
  class="site-nav__backdrop"
  aria-hidden="true"
></div>
{
  !isProvinceNav &&
  showAreaNav &&
  areaLinks.length > 0 && (
    <div class="site-subnav">
      <div
        class="shell site-subnav__inner"
      >
        {
          areaLinks.map(
            (item) => (
              <a
                class:list={{
                  active:
                    isActive(
                      item.href
                    ),
                }}
                href={
                  item.href
                }
              >
                {item.label}
              </a>
            )
          )
        }
      </div>
    </div>
  )
}

<script is:inline>
  const navToggle =
    document.querySelector(
      ".site-nav__toggle"
    );

  const navLinks =
    document.querySelector(
      ".site-nav__links"
    );

  const navBackdrop =
    document.querySelector(
      ".site-nav__backdrop"
    );

  const navIcon =
    navToggle?.querySelector(
      "span"
    );

  const closeMenu = () => {
    navLinks?.classList.remove(
      "open"
    );

    navBackdrop?.classList.remove(
      "open"
    );

    navToggle?.setAttribute(
      "aria-expanded",
      "false"
    );

    document.body.classList.remove(
      "site-nav-open"
    );

    if (navIcon) {
      navIcon.textContent = "☰";
    }
  };

  const openMenu = () => {
    navLinks?.classList.add(
      "open"
    );

    navBackdrop?.classList.add(
      "open"
    );

    navToggle?.setAttribute(
      "aria-expanded",
      "true"
    );

    document.body.classList.add(
      "site-nav-open"
    );

    if (navIcon) {
      navIcon.textContent = "×";
    }
  };

  navToggle?.addEventListener(
    "click",
    () => {
      const isOpen =
        navLinks?.classList.contains(
          "open"
        );

      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }
  );

  navBackdrop?.addEventListener(
    "click",
    closeMenu
  );

  navLinks
    ?.querySelectorAll("a")
    .forEach((link) => {
      link.addEventListener(
        "click",
        closeMenu
      );
    });

  document.addEventListener(
    "keydown",
    (event) => {
      if (event.key === "Escape") {
        closeMenu();
      }
    }
  );
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom:
      1px solid var(--line);
    background: #fff;
  }

  .site-nav__inner,
  .site-subnav__inner {
    width: min(
      var(--page-max-width),
      calc(
        100% -
          (
            var(--page-gutter) *
              2
          )
      )
    );

    max-width:
      var(--page-max-width);

    margin-inline: auto;
  }

  .site-nav__inner {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content:
      space-between;
    gap: 24px;
  }

  .site-nav__brand {
    flex: 0 0 auto;
    color: var(--ink);
    font-family:
      var(
        --f-display,
        Georgia,
        serif
      );
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing:
      -0.04em;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__toggle {
    display:
      none !important;
  }

.site-nav__links {
  display: flex !important;
  align-items: center;
  justify-content: flex-end;
  gap: 2px;
  min-width: 0;
  overflow-x: visible;
  flex-wrap: nowrap;
}

  .site-nav__links::-webkit-scrollbar {
    display: none;
  }

  .site-nav__links a,
  .site-subnav__inner a {
    padding: 9px 10px;
    border-radius: 6px;
    color: var(--muted);
    font-family:
      system-ui,
      sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__links a:hover,
  .site-subnav__inner a:hover {
    background:
      var(--accent-soft);
    color: var(--accent);
  }

  .site-nav__links a.active,
  .site-subnav__inner a.active {
    background:
      var(--accent);
    color: #fff;
  }

  .site-subnav {
    border-bottom:
      1px solid var(--line);
    background:
      var(--surface);
  }

  .site-subnav__inner {
    display: flex;
    min-height: 50px;
    align-items: center;
    gap: 8px;
    padding: 6px 0;
    flex-wrap: wrap;
  }
.site-nav__backdrop {
  display: none;
}
  @media (
    max-width: 760px
  ) {
    .site-nav {
  z-index: 140;
}
    .site-nav__inner,
    .site-subnav__inner {
      width: calc(
        100% -
          (
            var(
                --page-gutter-mobile
              ) *
              2
          )
      );

      max-width: none;
    }

    .site-nav__inner {
      position: relative;
      gap: 14px;
    }

  .site-nav__toggle {
  position: relative;
  z-index: 130;

  display:
    inline-flex !important;
  width: 42px;
  height: 38px;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  border:
    1px solid
    var(--line-warm);
  border-radius: 6px;
  background:
    var(--surface);
  color: var(--ink);
  cursor: pointer;
  font-size: 1.2rem;
}

 .site-nav__links {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 120;

  display: flex !important;

  width: min(
    86vw,
    360px
  );
  max-width: 360px;

  height: 100dvh;

  flex-direction: column;
  justify-content: flex-start;
  align-items: stretch;

  gap: 6px;

  padding:
    84px 18px 24px;

  overflow-y: auto;

  background: #fff;

  box-shadow:
    0 0 40px
    rgba(
      0,
      0,
      0,
      0.18
    );

  transform:
    translateX(-100%);

  visibility: hidden;
  pointer-events: none;

  transition:
    transform .22s ease,
    visibility 0s linear .22s;
}

 

.site-nav__links.open {
  transform:
    translateX(0);

  visibility: visible;
  pointer-events: auto;

  transition:
    transform .22s ease;
}

.site-nav__links.open a {
  display: flex;

  width: 100%;
  min-height: 50px;

  box-sizing: border-box;

  align-items: center;

  padding:
    13px 15px;

  border: 0;
  border-radius: 9px;

  background:
    transparent;

  color:
    var(--ink);

  font-size: 1rem;
  font-weight: 700;

  text-align: left;
}

.site-nav__links.open a:hover {
  background:
    var(--accent-soft);

  color:
    var(--accent);
}

.site-nav__links.open a.active {
  background:
    var(--accent);

  color: #fff;
}

.site-nav__backdrop {
  position: fixed;
  inset: 0;
  z-index: 110;

  display: block;

  background:
    rgba(
      0,
      0,
      0,
      0.38
    );

  opacity: 0;
  pointer-events: none;

  transition:
    opacity 220ms ease;
}

.site-nav__backdrop.open {
  opacity: 1;
  pointer-events: auto;
}

:global(body.site-nav-open) {
  overflow: hidden;
}

    .site-subnav__inner {
      overflow-x: auto;
      flex-wrap: nowrap;
    }
  }
</style>