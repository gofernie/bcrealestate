---
const { active = "homes", site = null } = Astro.props;
---
<header class="gv-header">
  <a data-astro-reload class="gv-brand" href="/greater-victoria">Greater Victoria Homes</a>
  <nav aria-label="Greater Victoria navigation">
    <a data-astro-reload href="/greater-victoria" aria-current={active === "homes" ? "page" : undefined}>Homes</a>
    <a data-astro-reload href="/greater-victoria/areas" aria-current={active === "areas" ? "page" : undefined}>Areas</a>
    <details><summary>Local markets</summary><div>
      <a data-astro-reload href="/victoria">Victoria</a><a data-astro-reload href="/saanich-east">Saanich East</a>
      <a data-astro-reload href="/saanich-west">Saanich West</a><a data-astro-reload href="/oak-bay">Oak Bay</a>
    </div></details>
  </nav>
</header>
<style>
.gv-header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px max(20px,calc((100vw - 1400px)/2));border-bottom:1px solid var(--line);background:var(--surface)}
.gv-brand{font:600 clamp(1.1rem,2vw,1.55rem)/1.1 Georgia,serif;text-decoration:none;color:var(--ink)}
nav{display:flex;align-items:center;gap:8px;font-size:.85rem;font-weight:700}nav>a,summary{padding:10px 14px;border-radius:5px;text-decoration:none;color:var(--ink);cursor:pointer;list-style:none}nav>a[aria-current]{background:var(--accent);color:white}details{position:relative}details>div{position:absolute;right:0;top:42px;z-index:1200;background:var(--card-bg);border:1px solid var(--line);border-radius:6px;min-width:180px;padding:8px;box-shadow:0 5px 20px #0001}details>div>a{display:block;padding:10px;text-decoration:none;color:var(--ink)}details>div>a:hover{background:var(--card-soft)}@media(max-width:620px){.gv-header{padding:16px;align-items:flex-start;flex-direction:column;gap:14px}nav>a,summary{padding:9px 12px}}
</style>
