---
const {
  siteId = "",
  city = "",
  area = "",
  propertyType = "",
  minPrice = "",
  maxPrice = "",
  waterfrontType = "",
  requiresWaterfront = false,
  requiresOceanView = false,
} = Astro.props;
---

<div
  class="slug-save-search"
  data-slug-save-search
  data-site-id={siteId}
  data-city={city}
  data-area={area}
  data-property-type={propertyType}
  data-min-price={minPrice}
  data-max-price={maxPrice}
  data-waterfront-type={waterfrontType}
  data-requires-waterfront={String(Boolean(requiresWaterfront))}
  data-requires-ocean-view={String(Boolean(requiresOceanView))}
>
  <div class="slug-save-search__links">
    <button
      type="button"
      class="slug-save-search__open"
      data-slug-save-open
      aria-expanded="false"
    >
      Save this search
    </button>
    <button type="button" class="slug-save-search__mine" data-slug-saved-list-open>My searches</button>
  </div>

  <dialog class="slug-saved-list" data-slug-saved-list aria-label="My searches">
    <div class="slug-saved-list__header">
      <div>
        <p class="slug-saved-list__eyebrow">Your searches</p>
        <h2>My searches</h2>
      </div>
      <button type="button" class="slug-saved-list__close" data-slug-saved-list-close aria-label="Close my searches">×</button>
    </div>
    <p class="slug-saved-list__intro">Reopen searches you saved on this browser.</p>
    <div class="slug-saved-list__items" data-slug-saved-list-items></div>
    <p data-slug-saved-list-empty hidden>No searches saved here yet. Save a search to see it here.</p>
    <p data-slug-saved-list-error hidden>This browser is blocking saved searches.</p>
    <p class="slug-saved-list__note">These shortcuts stay on this device. Removing one here won’t cancel a request you sent us.</p>
  </dialog>

  <form class="slug-save-search__panel" data-slug-save-form hidden>
    <div class="slug-save-search__heading">
      <strong>Save this search</strong>
      <span>Leave your details and we’ll follow up when relevant listings appear.</span>
    </div>

    <div data-slug-save-readback
      aria-live="polite"
      style="margin:16px 0;padding:14px 16px;border:1px solid #cfe3df;border-radius:12px;background:#f0f7f5;color:#2f4f50;line-height:1.5;">
    </div>

    <div class="slug-save-search__fields">
      <label>
        <span>Search name</span>
        <input
          type="text"
          name="searchName"
          placeholder="My home search"
        />
      </label>

      <label>
        <span>Your name</span>
        <input
          type="text"
          name="name"
          autocomplete="name"
          placeholder="Your name"
        />
      </label>

      <label>
        <span>Email</span>
        <input
          type="email"
          name="email"
          autocomplete="email"
          placeholder="you@example.com"
        />
      </label>

      <label>
        <span>Phone</span>
        <input
          type="tel"
          name="phone"
          autocomplete="tel"
          placeholder="Optional"
        />
      </label>
    </div>

    <p class="slug-save-search__status" data-slug-save-status hidden></p>

    <div class="slug-save-search__actions">
      <button type="submit" class="slug-save-search__submit">
        Save my search
      </button>

      <button
        type="button"
        class="slug-save-search__cancel"
        data-slug-save-cancel
      >
        Cancel
      </button>
    </div>
  </form>
</div>

<script is:inline>
  document.querySelectorAll("[data-slug-save-search]").forEach((root) => {
    if (root.dataset.saveSearchReady === "true") return;
    root.dataset.saveSearchReady = "true";

    const openButton = root.querySelector("[data-slug-save-open]");
    const form = root.querySelector("[data-slug-save-form]");
    const cancelButton = root.querySelector("[data-slug-save-cancel]");
    const status = root.querySelector("[data-slug-save-status]");
    const submitButton = root.querySelector(".slug-save-search__submit");
    const readback = root.querySelector("[data-slug-save-readback]");
    const savedList = root.querySelector("[data-slug-saved-list]");
    const savedItems = root.querySelector("[data-slug-saved-list-items]");
    const savedEmpty = root.querySelector("[data-slug-saved-list-empty]");
    const savedError = root.querySelector("[data-slug-saved-list-error]");
    const savedKey = "locus:buyer-saved-searches:v1";

    const readSavedSearches = () => {
      const data = JSON.parse(localStorage.getItem(savedKey) || "[]");
      return Array.isArray(data) ? data : [];
    };

    const renderSavedSearches = () => {
      let searches;
      try {
        searches = readSavedSearches();
      } catch {
        savedItems.replaceChildren();
        savedEmpty.hidden = true;
        savedError.hidden = false;
        return;
      }

      savedItems.replaceChildren();
      savedError.hidden = true;
      for (const search of searches) {
        if (!search || typeof search.url !== "string") continue;
        let url;
        try {
          url = new URL(search.url);
        } catch {
          continue;
        }
        if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) continue;

        const item = document.createElement("article");
        item.className = "slug-saved-list__item";
        const title = document.createElement("h3");
        title.textContent = String(search.name || search.summary || "Saved search");
        item.appendChild(title);
        if (search.summary && search.summary !== search.name) {
          const summary = document.createElement("p");
          summary.textContent = String(search.summary);
          item.appendChild(summary);
        }
        const actions = document.createElement("div");
        actions.className = "slug-saved-list__actions";
        const open = document.createElement("a");
        open.href = url.href;
        open.textContent = "View homes";
        const remove = document.createElement("button");
        remove.type = "button";
        remove.textContent = "Remove shortcut";
        remove.setAttribute("aria-label", `Remove ${title.textContent} from this browser`);
        remove.addEventListener("click", () => {
          try {
            localStorage.setItem(savedKey, JSON.stringify(readSavedSearches().filter((entry) => entry?.id !== search.id)));
            renderSavedSearches();
          } catch {
            savedError.hidden = false;
          }
        });
        actions.append(open, remove);
        item.appendChild(actions);
        savedItems.appendChild(item);
      }
      savedEmpty.hidden = savedItems.childElementCount > 0;
    };

    root.querySelector("[data-slug-saved-list-open]")?.addEventListener("click", () => {
      renderSavedSearches();
      savedList.showModal();
    });
    root.querySelector("[data-slug-saved-list-close]")?.addEventListener("click", () => savedList.close());
    savedList?.addEventListener("click", (event) => {
      if (event.target === savedList) savedList.close();
    });
    window.addEventListener("storage", (event) => {
      if (event.key === savedKey && savedList?.open) renderSavedSearches();
    });

    const getLiveSearch = () => {
      const params = new URLSearchParams(window.location.search);
      const select = (selector) => document.querySelector(selector);
      const value = (selector, key) =>
        select(selector)?.value || params.get(key) || "";

      const areaSelect = select(".area-filter-select");
      const chosenAreas = areaSelect instanceof HTMLSelectElement
        ? [...areaSelect.selectedOptions]
            .filter((option) => option.value !== "all")
            .map((option) => ({
              value: option.value,
              label: option.textContent.trim(),
            }))
        : params.getAll("area").map((area) => ({
            value: area,
            label: area.replace(/[-_]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
          }));

      if (!chosenAreas.length && root.dataset.area) {
        chosenAreas.push({
          value: root.dataset.area,
          label: root.dataset.area.replace(/[-_]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
        });
      }

      const priceSelect = select(".price-filter-select");
      const priceBand = value(".price-filter-select", "price");
      const hasPriceBand = priceBand && priceBand !== "all";
      const priceLabel = hasPriceBand
        ? priceSelect?.selectedOptions?.[0]?.textContent?.trim() || priceBand
        : root.dataset.maxPrice
          ? `Up to $${Number(root.dataset.maxPrice).toLocaleString("en-CA")}`
          : root.dataset.minPrice
            ? `From $${Number(root.dataset.minPrice).toLocaleString("en-CA")}`
            : "";

      const beds = value(".beds-filter-select", "beds");
      const baths = value(".baths-filter-select", "baths");
      const type = value(".type-filter-select", "type") ||
        root.dataset.propertyType || "";
      const expansionKm = Number(document.body.dataset.areaExpansionKm || 0);

      const criteria = {
        url: window.location.href,
        area: params.getAll("area").length
          ? params.getAll("area")
          : root.dataset.area || "",
        propertyType: params.get("type") || root.dataset.propertyType || "",
        price: params.get("price") || "",
        beds: params.get("beds") || "",
        baths: params.get("baths") || "",
        minSqft: params.get("minSqft") || "",
        minYear: params.get("minYear") || "",
        viewType: params.get("viewType") || "",
        waterfrontType: params.get("waterfrontType") || root.dataset.waterfrontType || "",
        primaryOnMain: params.get("primaryOnMain") === "true",
        threeSameFloor: params.get("threeSameFloor") === "true",
        fourSameFloor: params.get("fourSameFloor") === "true",
        sort: params.get("sort") || "newest",
      };

      const parts = [
        type && type !== "all"
          ? type.replace(/[-_]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase())
          : "Homes",
        chosenAreas.length
          ? `in ${chosenAreas.map((area) => area.label).join(", ")}`
          : `in ${(root.dataset.city || "this market").replace(/\b\w/g, (c) => c.toUpperCase())}`,
        priceLabel,
        criteria.beds ? `${criteria.beds}+ beds` : "",
        criteria.baths ? `${criteria.baths}+ baths` : "",
        expansionKm ? `${expansionKm} km beyond the selected area` : "",
      ].filter(Boolean);

      return { criteria, summary: parts.join(" · ") };
    };

    const updateReadback = () => {
      if (!readback) return;
      const { summary } = getLiveSearch();
      readback.replaceChildren();
      const title = document.createElement("strong");
      title.textContent = "Your saved search";
      title.style.display = "block";
      title.style.marginBottom = "3px";
      readback.append(title, document.createTextNode(summary));
    };

    root.addEventListener("change", updateReadback);
    document.querySelector(".intent-controls")?.addEventListener("change", updateReadback);
    window.addEventListener("listing-filters-updated", updateReadback);
    window.addEventListener("popstate", updateReadback);
    document.addEventListener("homepage-fast-results-replaced", updateReadback);
    updateReadback();


    const setOpen = (open) => {
      form.hidden = !open;
      openButton.setAttribute("aria-expanded", String(open));
      openButton.textContent = open ? "Close saved search" : "Save this search";

      if (open) {
        updateReadback();
        const searchNameInput = form.querySelector('input[name="searchName"]');
        if (searchNameInput && !searchNameInput.value.trim()) {
          searchNameInput.value = getLiveSearch().summary;
        }
        searchNameInput?.focus();
      }
    };

    openButton?.addEventListener("click", () => {
      setOpen(form.hidden);
    });

    cancelButton?.addEventListener("click", () => {
      setOpen(false);
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formData = new FormData(form);
      const name = String(formData.get("name") || "").trim();
      const email = String(formData.get("email") || "").trim();
      const phone = String(formData.get("phone") || "").trim();
      const searchName =
        String(formData.get("searchName") || "").trim() ||
        "Saved property search";

      status.hidden = true;
      status.className = "slug-save-search__status";

      if (!email && !phone) {
        status.textContent = "Please enter an email address or phone number.";
        status.classList.add("is-error");
        status.hidden = false;
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Saving...";

      const { criteria, summary } = getLiveSearch();

      try {
        const response = await fetch("/api/intent-lead", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            name,
            email,
            phone,
            city: root.dataset.city || "",
            slug:
              window.location.pathname
                .split("/")
                .filter(Boolean)
                .pop() || "",
            source: "saved_search",
            message:
              `${searchName}\nSaved search: ${summary}\nSearch URL: ${window.location.href}\nCriteria: ${JSON.stringify(criteria)}`,
          }),
        });

        if (!response.ok) {
          throw new Error(`Save request failed (${response.status})`);
        }

        let savedInBrowser = false;
        try {
          const key = "locus:buyer-saved-searches:v1";
          const existing = JSON.parse(localStorage.getItem(key) || "[]");
          const searches = Array.isArray(existing) ? existing : [];
          const searchUrl = new URL(window.location.href);
          searchUrl.hash = "listing-results-anchor";
          const entry = {
            id: crypto.randomUUID(),
            name: searchName,
            summary,
            url: searchUrl.href,
            city: root.dataset.city || "",
            savedAt: new Date().toISOString(),
          };
          localStorage.setItem(key, JSON.stringify([
            entry,
            ...searches.filter((item) => item?.url !== entry.url).slice(0, 99),
          ]));
          savedInBrowser = true;
        } catch (error) {
          console.warn("Search submitted, but could not save it in this browser:", error);
        }

        status.textContent =
          savedInBrowser
            ? "Search sent. You can reopen it from My searches on this browser."
            : "Search sent, but this browser could not keep a shortcut. Bookmark this page to return to it.";
        status.classList.add("is-success");
        status.hidden = false;

        submitButton.textContent = "Saved";
        openButton.textContent = "Search saved";
        openButton.disabled = true;
      } catch (error) {
        console.error("Could not save search:", error);

        status.textContent =
          "We couldn’t save this search. Please try again.";
        status.classList.add("is-error");
        status.hidden = false;

        submitButton.disabled = false;
        submitButton.textContent = "Save my search";
      }
    });
  });
</script>

<style>
  .slug-save-search {
    margin: 1rem 0 1.75rem;
  }

  .slug-save-search button,
  .slug-save-search input {
    font: inherit;
  }

  .slug-save-search__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .slug-save-search__mine {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 18px;
    border: 1px solid #d8d8d4;
    border-radius: 999px;
    background: #fff;
    color: #172019;
    font-size: .86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .slug-save-search__mine:hover,
  .slug-save-search__mine:focus-visible {
    border-color: var(--accent, #2f6f73);
    color: var(--accent, #2f6f73);
  }

  .slug-save-search__open {
    min-height: 40px;
    padding: 0 18px;
    border: 1px solid #d8d8d4;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-weight: 700;
    cursor: pointer;
  }

  .slug-save-search__panel {
    max-width: 760px;
    margin-top: 14px;
    padding: 20px;
    border: 1px solid #dfe4e1;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 16px 36px rgba(17, 34, 28, 0.08);
  }

  .slug-save-search__panel[hidden] {
    display: none;
  }

  .slug-save-search__heading {
    display: grid;
    gap: 5px;
    margin-bottom: 16px;
  }

  .slug-save-search__heading strong {
    font-size: 1.15rem;
  }

  .slug-save-search__heading span {
    color: #65716b;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .slug-save-search__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .slug-save-search__fields label {
    display: grid;
    gap: 6px;
  }

  .slug-save-search__fields label > span {
    color: #53615a;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .slug-save-search__fields input {
    width: 100%;
    min-height: 46px;
    box-sizing: border-box;
    padding: 0 13px;
    border: 1px solid #d8dfdb;
    border-radius: 10px;
    background: #fbfcfb;
    color: #172019;
  }

  .slug-save-search__actions {
    display: flex;
    gap: 10px;
    margin-top: 16px;
  }

  .slug-save-search__submit,
  .slug-save-search__cancel {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 10px;
    font-weight: 800;
    cursor: pointer;
  }

  .slug-save-search__submit {
    border: 0;
    background: #18bf58;
    color: #fff;
  }

  .slug-save-search__cancel {
    border: 1px solid #d8dfdb;
    background: #fff;
    color: #53615a;
  }

  .slug-save-search__status {
    margin: 14px 0 0;
    padding: 10px 12px;
    border-radius: 9px;
    font-size: 0.85rem;
  }

  .slug-save-search__status.is-error {
    background: #fff0f0;
    color: #a12626;
  }

  .slug-save-search__status.is-success {
    background: #eaf9ef;
    color: #176b35;
  }

  @media (max-width: 700px) {
    .slug-save-search__fields {
      grid-template-columns: 1fr;
    }

    .slug-save-search__actions {
      flex-direction: column;
    }
  }
</style>

<style is:global>
  .slug-saved-list {
    box-sizing: border-box;
    width: min(620px, calc(100vw - 28px));
    max-height: min(720px, calc(100dvh - 36px));
    overflow-y: auto;
    padding: clamp(20px, 4vw, 32px);
    border: 1px solid #dfe4e1;
    border-radius: 20px;
    background: #fff;
    color: #172019;
    box-shadow: 0 30px 80px rgba(0, 0, 0, .24);
  }
  .slug-saved-list::backdrop { background: rgba(12, 25, 24, .55); }
  .slug-saved-list__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
  .slug-saved-list__eyebrow { margin: 0 0 6px; font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #466c68; }
  .slug-saved-list h2 { margin: 0; font-size: clamp(1.6rem, 5vw, 2.2rem); }
  .slug-saved-list__intro { margin: 10px 0 20px; color: #53615a; }
  .slug-saved-list__close { display: grid; place-items: center; flex: none; width: 40px; height: 40px; padding: 0; border: 1px solid #d8dfdb; border-radius: 50%; background: #fff; color: #172019; font-size: 1.5rem; cursor: pointer; }
  .slug-saved-list__items { display: grid; gap: 12px; }
  .slug-saved-list__item { padding: 18px; border: 1px solid #dfe4e1; border-radius: 14px; background: #f9fbfa; }
  .slug-saved-list__item h3 { margin: 0 0 7px; font-size: 1.05rem; }
  .slug-saved-list__item p { margin: 0 0 10px; color: #53615a; }
  .slug-saved-list__actions { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 12px; }
  .slug-saved-list__actions a, .slug-saved-list__actions button { display: inline-flex; align-items: center; box-sizing: border-box; min-height: 40px; padding: 0 14px; border-radius: 999px; font: inherit; font-size: .84rem; font-weight: 700; text-decoration: none; cursor: pointer; }
  .slug-saved-list__actions a { border: 1px solid #315d62; background: #315d62; color: #fff; }
  .slug-saved-list__actions button { border: 1px solid #d8dfdb; background: #fff; color: #41504a; }
  .slug-saved-list__note { margin: 24px 0 0; color: #53615a; font-size: .8rem; line-height: 1.5; }
</style>
