---
const {
  siteId,
  city,
  area,
  propertyType,
  minPrice,
  maxPrice,
  waterfrontType,
  requiresWaterfront,
  requiresOceanView
} = Astro.props;
---

<div
  class="slug-save-search"
  data-site-id={siteId}
  data-city={city}
  data-area={area}
  data-property-type={propertyType}
  data-min-price={minPrice}
  data-max-price={maxPrice}
  data-waterfront-type={waterfrontType}
  data-requires-waterfront={requiresWaterfront}
  data-requires-ocean-view={requiresOceanView}
>
  <button type="button">
    Save this search
  </button>
</div>

<style>
.slug-save-search {
  margin: 1rem 0;
}

.slug-save-search button {
  border: 1px solid #ddd;
  border-radius: 999px;
  padding: 10px 18px;
  background: white;
  cursor: pointer;
  font-weight: 600;
}
</style>
