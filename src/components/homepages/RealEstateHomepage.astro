---
import ListingCard from "../ListingCard.astro";
import IntentModalController from "../IntentModalController.astro";
import AreaMultiSelect from "../listings/AreaMultiSelect.astro";
import SingleSelectDropdown from "../listings/SingleSelectDropdown.astro";
import { createClient } from "@supabase/supabase-js";
interface LocationCard {
  city?: string;
  area?: string;
  label: string;
  href: string;
  count: number;
  image?: string;
}

interface Filters {
  city?: string;
  type?: string;
  areas?: string[];

  beds?: number | null;
  baths?: number | null;

  primaryOnMain?: boolean;
  bedsTogether?: boolean;
  fourBedsTogether?: boolean;

  hasFloorplan?: boolean;
  hasUpdatedKitchen?: boolean;
  hasDetachedShop?: boolean;

  minPrice?: number | null;
  maxPrice?: number | null;

  minSqft?: number | null;
  maxSqft?: number | null;

  sort?: string;
  page?: number;
}

interface Props {
  site?: any;
  heroImageUrl?: string;
  listings?: any[];
  mapListings?: any[];
  locationCards?: LocationCard[];
  mode?: "province" | "city";
  city?: string;

  filters?: Filters;
  totalMatchingCount?: number;
  currentPage?: number;
  totalPages?: number;
  pageSize?: number;
  paginationStart?: number;
  paginationEnd?: number;
  hasPreviousPage?: boolean;
  hasNextPage?: boolean;
  previousPageHref?: string | null;
  nextPageHref?: string | null;
}

const {
  site,
  heroImageUrl = "",
  listings = [],
  mapListings = listings,
  locationCards = [],
  mode = "province",
  city = "",

  filters = {},
  totalMatchingCount = listings.length,
  currentPage = 1,
  totalPages = 1,
  paginationStart = listings.length > 0 ? 1 : 0,
  paginationEnd = listings.length,
  hasPreviousPage = false,
  hasNextPage = false,
  previousPageHref = null,
  nextPageHref = null,
} = Astro.props;
const newMatchIds =
  new Set(
    String(
      Astro.url.searchParams.get(
        "new"
      ) || ""
    )
      .split(",")
      .map((value) =>
        value.trim()
      )
      .filter(Boolean)
  );

const newMatchListings =
  mapListings.filter(
    (listing) => {
      const listingId =
        String(
          listing?.mls_number ||
          listing?.id ||
          ""
        );

      return newMatchIds.has(
        listingId
      );
    }
  );
const visibleListingIds = new Set(
  listings
    .map((listing) =>
      String(
        listing?.id ||
        listing?.mls_number ||
        ""
      )
    )
    .filter(Boolean)
);

const modalOnlyListings =
  mapListings.filter((listing) => {
    const listingId = String(
      listing?.id ||
      listing?.mls_number ||
      ""
    );

    return (
      listingId &&
      !visibleListingIds.has(listingId)
    );
  });
  const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const allListingIds = listings
  .map((listing) =>
    String(
      listing?.id ||
      listing?.mls_number ||
      ""
    )
  )
  .filter(Boolean);

let floorplanRows: any[] = [];
let roomRows: any[] = [];

if (allListingIds.length > 0) {
  const { data, error } = await supabase
    .from("listing_floorplans")
    .select(
      "listing_id, image_number, image_url, confidence"
    )
    .in("listing_id", allListingIds);

  if (error) {
    console.error(
      "Floorplan lookup failed:",
      error
    );
  } else {
    floorplanRows = data || [];
  }

  const {
    data: loadedRoomRows,
    error: roomError,
  } = await supabase
    .from("listing_rooms")
    .select(
      "listing_id, room_label, level, length, width"
    )
    .in(
      "listing_id",
      allListingIds
    );

  if (roomError) {
    console.error(
      "Room matrix lookup failed:",
      roomError
    );
  } else {
    roomRows =
      loadedRoomRows || [];
  }
}

const floorplansByListingId =
  floorplanRows.reduce(
    (
      result: Record<string, any[]>,
      floorplan: any
    ) => {
      const listingId =
        String(
          floorplan.listing_id ||
          ""
        );

      if (!listingId) {
        return result;
      }

      if (!result[listingId]) {
        result[listingId] = [];
      }

      result[listingId].push(
        floorplan
      );

      return result;
    },
    {}
  );
  const roomsByListingId =
  roomRows.reduce(
    (
      result: Record<
        string,
        any[]
      >,
      room: any
    ) => {
      const listingId =
        String(
          room.listing_id ||
          ""
        );

      if (!listingId) {
        return result;
      }

      if (!result[listingId]) {
        result[listingId] = [];
      }

      result[listingId].push({
        label:
          room.room_label ||
          "",
        level:
          room.level ||
          "",
        length:
          room.length ||
          "",
        width:
          room.width ||
          "",
      });

      return result;
    },
    {}
  );
const isCityMode =
  mode === "city";

const locationName =
  isCityMode
    ? city
        .replace(/-/g, " ")
        .replace(
          /\b\w/g,
          (letter) =>
            letter.toUpperCase()
        )
    : "British Columbia";

const heroEyebrow =
  isCityMode
    ? `Real estate in ${locationName}, British Columbia`
    : "Real estate across British Columbia";

const heroTitle =
  isCityMode
    ? `Find your place in ${locationName}.`
    : "Find your place in British Columbia.";

const heroCopy =
  isCityMode
    ? `Explore homes, condos, townhomes, and land across ${locationName}’s neighbourhoods.`
    : "Explore homes, condos, townhomes, and land across British Columbia’s most desirable communities.";

const browseEyebrow =
  isCityMode
    ? "Browse by neighbourhood"
    : "Browse by city";

const browseHeading =
  isCityMode
    ? `Explore ${locationName} neighbourhoods`
    : "Explore BC markets";

const accent =
  site?.accent_color ||
  "#1f5a49";

const featuredLocations =
  locationCards.slice(0, 6);

const totalListings =
  locationCards.reduce(
    (total, location) =>
      total +
      Number(
        location.count || 0
      ),
    0
  ) ||
  totalMatchingCount;

const selectedAreas =
  Array.isArray(
    filters.areas
  )
    ? filters.areas
    : [];

const hasActiveFilters =
  Boolean(
    filters.city ||
    filters.type ||
    selectedAreas.length ||
    filters.beds !== null &&
  filters.beds !== undefined ||
filters.primaryOnMain === true ||
filters.bedsTogether === true ||
filters.fourBedsTogether === true ||
filters.baths !== null &&
      filters.baths !== undefined ||
    filters.minPrice !== null &&
      filters.minPrice !== undefined ||
    filters.maxPrice !== null &&
      filters.maxPrice !== undefined ||
    filters.minSqft !== null &&
      filters.minSqft !== undefined ||
    filters.maxSqft !== null &&
      filters.maxSqft !== undefined ||
    filters.sort &&
      filters.sort !== "newest"
  );
  const formatPrice = (
  value: number
) => {
  if (value >= 1000000) {
    return `$${Number(
      (value / 1000000).toFixed(1)
    )}M`;
  }

  return `$${Math.round(
    value / 1000
  )}k`;
};

const priceFilterLabel = (() => {
  const min =
    filters.minPrice;

  const max =
    filters.maxPrice;

  if (
    min !== null &&
    min !== undefined &&
    max !== null &&
    max !== undefined
  ) {
    return `${formatPrice(
      min
    )}–${formatPrice(max)}`;
  }

  if (
    min !== null &&
    min !== undefined
  ) {
    return `${formatPrice(
      min
    )}+`;
  }

  if (
    max !== null &&
    max !== undefined
  ) {
    return `Under ${formatPrice(
      max
    )}`;
  }

  return "";
})();

const marketOptions = locationCards
  .filter(
    (
      location
    ): location is LocationCard & {
      city: string;
    } => Boolean(location.city)
  )
  .filter(
    (location, index, all) =>
      all.findIndex(
        (candidate) =>
          candidate.city ===
          location.city
      ) === index
  )
  .map((location) => ({
    value: String(
      location.city
    ).toLowerCase(),
    label: location.label,
  }));
const propertyTypeResultLabels: Record<
  string,
  string
> = {
  house: "Homes",
  condo: "Condos",
  townhouse: "Townhomes",
  mobile: "Mobile homes",
  land: "Land",
};

const resultPropertyLabel =
  propertyTypeResultLabels[
    String(filters.type || "")
      .toLowerCase()
  ] || "Homes";

const selectedAreaLabels =
  selectedAreas.map((areaSlug) => {
    const matchingLocation =
      locationCards.find(
        (location) =>
          String(location.area || "")
            .toLowerCase() ===
          String(areaSlug || "")
            .toLowerCase()
      );

    return (
      matchingLocation?.label ||
      String(areaSlug || "")
        .replace(/-/g, " ")
        .replace(
          /\b\w/g,
          (letter) =>
            letter.toUpperCase()
        )
    );
  });

const resultLocationLabel =
  selectedAreaLabels.length === 1
    ? selectedAreaLabels[0]
    : locationName;

const resultsEyebrow =
  isCityMode
    ? `${resultPropertyLabel} for sale in ${resultLocationLabel}`
    : `${resultPropertyLabel} for sale across British Columbia`;

const propertyTypeOptions = [
  {
    value: "house",
    label: "Homes",
  },
  {
    value: "condo",
    label: "Condos",
  },
  {
    value: "townhouse",
    label: "Townhomes",
  },
  {
    value: "mobile",
    label: "Mobile homes",
  },
  {
    value: "land",
    label: "Land",
  },
];

const bedOptions = [
  {
    value: "1",
    label: "1+ beds",
  },
  {
    value: "2",
    label: "2+ beds",
  },
  {
    value: "3",
    label: "3+ beds",
  },
  {
    value: "4",
    label: "4+ beds",
  },
  {
    value: "5",
    label: "5+ beds",
  },
];

const bedsFilterLabel = (() => {
  const parts: string[] = [];

  if (
    filters.beds !== null &&
    filters.beds !== undefined
  ) {
    parts.push(
      `${filters.beds}+ beds`
    );
  }

  if (filters.primaryOnMain) {
    parts.push(
      "Primary on main"
    );
  }

  if (filters.bedsTogether) {
    parts.push(
      "3+ beds together"
    );
  }
if (filters.fourBedsTogether) {
  parts.push(
    "4+ same floor"
  );
}
  return parts.join(" · ");
})();

const priceOptions = [
  {
    value: "500000",
    label: "Under $500,000",
  },
  {
    value: "700000",
    label: "Under $700,000",
  },
  {
    value: "900000",
    label: "Under $900,000",
  },
  {
    value: "1200000",
    label: "Under $1.2M",
  },
  {
    value: "1600000",
    label: "Under $1.6M",
  },
  {
    value: "2000000",
    label: "Under $2M",
  },
];

const sortOptions = [
  {
    value: "price-low",
    label: "Price: low to high",
  },
  {
    value: "price-high",
    label: "Price: high to low",
  },
];

const clearHref =
  isCityMode
    ? `/${city}`
    : "/";

const formAction =
  isCityMode
    ? `/${city}`
    : "/";

const fallbackLocationImages = [
  "https://images.unsplash.com/photo-1559511260-66a654ae982a?auto=format&fit=crop&w=1200&q=78",
  "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=78",
  "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=78",
  "https://images.unsplash.com/photo-1500534314209-a25ddb2bd4297?auto=format&fit=crop&w=1200&q=78",
  "https://images.unsplash.com/photo-1486911278844-a81c5267e227?auto=format&fit=crop&w=1200&q=78",
  "https://images.unsplash.com/photo-1464278533981-50106e6176b1?auto=format&fit=crop&w=1200&q=78",
];

const formatCount = (
  value: number
) =>
  Number(value || 0)
    .toLocaleString();

const visiblePages = (() => {
  const pages: number[] = [];
  const start = Math.max(
    1,
    currentPage - 2
  );
  const end = Math.min(
    totalPages,
    currentPage + 2
  );

  for (
    let page = start;
    page <= end;
    page += 1
  ) {
    pages.push(page);
  }

  return pages;
})();

const buildPageHref = (
  page: number
) => {
  const params =
    new URLSearchParams();

  if (filters.city) {
    params.set(
      "city",
      filters.city
    );
  }

  if (filters.type) {
    params.set(
      "type",
      filters.type
    );
  }

  for (
    const area of selectedAreas
  ) {
    params.append(
      "area",
      area
    );
  }

  if (
  filters.beds !== null &&
  filters.beds !== undefined
) {
  params.set(
    "beds",
    String(filters.beds)
  );
}
if (filters.primaryOnMain) {
  params.set(
    "primaryOnMain",
    "true"
  );
}

if (filters.bedsTogether) {
  params.set(
    "bedsTogether",
    "true"
  );
}
if (filters.fourBedsTogether) {
  params.set(
    "fourBedsTogether",
    "true"
  );
}

if (filters.hasFloorplan) {
  params.set(
    "hasFloorplan",
    "true"
  );
}

if (filters.hasUpdatedKitchen) {
  params.set(
    "hasUpdatedKitchen",
    "true"
  );
}

if (filters.hasDetachedShop) {
  params.set(
    "hasDetachedShop",
    "true"
  );
}

if (
  filters.baths !== null &&
  filters.baths !== undefined
) {
  params.set(
    "baths",
    String(filters.baths)
  );
}

if (
  filters.minPrice !== null &&
  filters.minPrice !== undefined
) {
  params.set(
    "minPrice",
    String(
      filters.minPrice
    )
  );
}

if (
  filters.maxPrice !== null &&
  filters.maxPrice !== undefined
) {
  params.set(
    "maxPrice",
    String(
      filters.maxPrice
    )
  );
}

if (
  filters.minSqft !== null &&
  filters.minSqft !== undefined
) {
  params.set(
    "minSqft",
    String(
      filters.minSqft
    )
  );
}

if (
  filters.maxSqft !== null &&
  filters.maxSqft !== undefined
) {
  params.set(
    "maxSqft",
    String(
      filters.maxSqft
    )
  );
}

  if (
    filters.sort &&
    filters.sort !== "newest"
  ) {
    params.set(
      "sort",
      filters.sort
    );
  }

  if (page > 1) {
    params.set(
      "page",
      String(page)
    );
  }

  const queryString =
    params.toString();

  return queryString
    ? `${formAction}?${queryString}`
    : formAction;
};
---

<div
  class:list={[
    "bc-homepage",
    {
      "bc-homepage--city":
        isCityMode,
    },
  ]}
  style={`--bc-home-accent: ${accent};`}
  data-site-id={site?.id || ""}
>
  <section
  class="bc-hero"
  style={
    heroImageUrl
      ? `--bc-hero-image: url("${heroImageUrl}");`
      : undefined
  }
>
    

    <div
      class="bc-hero__inner"
    >
      <div
        class="bc-hero__content"
      >
        <p class="bc-eyebrow">
          {heroEyebrow}
        </p>

        <h1>{heroTitle}</h1>

        <p
          class="bc-hero__copy"
        >
          {heroCopy}
        </p>
      </div>
    </div>
  </section>

  <div class="bc-search-wrap">
    <form
      class:list={[
        "bc-search",
        {
          "bc-search--city":
            isCityMode,
        },
      ]}
         method="GET"
      action={formAction}
      data-async-search-form
    >
   
    {
  filters.baths !== null &&
  filters.baths !== undefined && (
    <input
      type="hidden"
      name="baths"
      value={filters.baths}
    />
  )
}

{
  filters.minPrice !== null &&
  filters.minPrice !== undefined && (
    <input
      type="hidden"
      name="minPrice"
      value={filters.minPrice}
    />
  )
}

{
  filters.minSqft !== null &&
  filters.minSqft !== undefined && (
    <input
      type="hidden"
      name="minSqft"
      value={filters.minSqft}
    />
  )
}

{
  filters.maxSqft !== null &&
  filters.maxSqft !== undefined && (
    <input
      type="hidden"
      name="maxSqft"
      value={filters.maxSqft}
    />
  )
}
         {
  !isCityMode && (
    <SingleSelectDropdown
      label="Market"
      name="city"
      icon="location"
      defaultLabel="All markets"
      options={marketOptions}
      value={filters.city}
    />
  )
}

<SingleSelectDropdown
  label="Property type"
  name="type"
  icon="home"
  defaultLabel="Any type"
  options={propertyTypeOptions}
  value={filters.type}
/>

{
  isCityMode && (
    <AreaMultiSelect
      locationCards={locationCards}
      selectedAreas={selectedAreas}
    />
  )
}

<SingleSelectDropdown
  label="Beds"
  name="beds"
  icon="beds"
  defaultLabel="Any beds"
  options={bedOptions}
  value={filters.beds}
  summary={
    bedsFilterLabel ||
    undefined
  }
toggles={[
  {
    name: "primaryOnMain",
    label:
      "Primary bedroom on main",
    checked:
      filters.primaryOnMain ===
      true,
  },
  {
    name: "bedsTogether",
    label:
      "3+ beds on one floor",
    checked:
      filters.bedsTogether ===
      true,
  },
  {
    name: "fourBedsTogether",
    label:
      "4+ beds on one floor",
    checked:
      filters.fourBedsTogether ===
      true,
  },
]}
/>
      <SingleSelectDropdown
        label="Price"
        name="maxPrice"
        icon="price"
        defaultLabel="Any price"
        options={priceOptions}
        value={filters.maxPrice}
        summary={
          priceFilterLabel ||
          undefined
        }
        clearNames={[
          "minPrice",
        ]}
      />

     <SingleSelectDropdown
  label="Sort"
  name="sort"
  icon="sort"
  defaultLabel="Newest"
  options={sortOptions}
  value={
    filters.sort &&
    filters.sort !== "newest"
      ? filters.sort
      : ""
  }
/>

<div
  class="bc-more-filter"
  data-more-filter
  data-open={
    filters.hasFloorplan ||
    filters.hasUpdatedKitchen ||
    filters.hasDetachedShop
      ? ""
      : undefined
  }
>
  <button
    type="button"
    class="bc-more-filter__trigger"
    data-more-filter-trigger
    aria-expanded={
      filters.hasFloorplan ||
      filters.hasUpdatedKitchen ||
      filters.hasDetachedShop
        ? "true"
        : "false"
    }
  >
    <span
      class="bc-more-filter__icon"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      >
        <path d="M4 6h16" />
        <path d="M7 12h10" />
        <path d="M10 18h4" />
      </svg>
    </span>

    <span class="bc-more-filter__copy">
      <span class="bc-more-filter__label">
        More
      </span>

      <span class="bc-more-filter__summary">
        {
          [
            filters.hasFloorplan
              ? "Floorplan"
              : "",
            filters.hasUpdatedKitchen
              ? "Kitchen"
              : "",
            filters.hasDetachedShop
              ? "Shop"
              : "",
          ]
            .filter(Boolean)
            .join(", ") ||
          "Features"
        }
      </span>
    </span>

    <span
      class="bc-more-filter__chevron"
      aria-hidden="true"
    >
      ▾
    </span>
  </button>
</div>

<div
  class="bc-more-panel"
  data-more-filter-panel
  hidden={
    !filters.hasFloorplan &&
    !filters.hasUpdatedKitchen &&
    !filters.hasDetachedShop
  }
>
  <div class="bc-more-panel__header">
    <div>
      <strong>More filters</strong>
      <span>
        Features found in listing photos
      </span>
    </div>

    <button
      type="button"
      class="bc-more-panel__close"
      data-more-filter-close
      aria-label="Close more filters"
    >
      ×
    </button>
  </div>

  <div class="bc-more-panel__section">
    <div class="bc-more-panel__heading">
      <span class="bc-more-panel__spark">
        ✦
      </span>

      <div>
        <strong>Photo features</strong>
        <small>
          Identified from listing photos
        </small>
      </div>
    </div>

    <div class="bc-more-panel__options">
      <label class="bc-more-option">
        <input
          type="checkbox"
          name="hasFloorplan"
          value="true"
          checked={
            filters.hasFloorplan === true
          }
          data-more-filter-input
        />

        <span class="bc-more-option__box">
          ✓
        </span>

        <span>
          <strong>Has floorplan</strong>
          <small>
            View layout images
          </small>
        </span>
      </label>

      <label class="bc-more-option">
        <input
          type="checkbox"
          name="hasUpdatedKitchen"
          value="true"
          checked={
            filters.hasUpdatedKitchen ===
            true
          }
          data-more-filter-input
        />

        <span class="bc-more-option__box">
          ✓
        </span>

        <span>
          <strong>Updated kitchen</strong>
          <small>
            Modernized kitchen photos
          </small>
        </span>
      </label>

      <label class="bc-more-option">
        <input
          type="checkbox"
          name="hasDetachedShop"
          value="true"
          checked={
            filters.hasDetachedShop ===
            true
          }
          data-more-filter-input
        />

        <span class="bc-more-option__box">
          ✓
        </span>

        <span>
          <strong>Detached shop</strong>
          <small>
            Separate workshop or shop
          </small>
        </span>
      </label>
    </div>
  </div>

  <div class="bc-more-panel__footer">
    <button
      type="button"
      class="bc-more-panel__clear"
      data-more-filter-clear
    >
      Clear
    </button>

    <button
      type="button"
      class="bc-more-panel__apply"
