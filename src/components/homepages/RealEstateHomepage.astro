          "is-active",
          isActive
        );

        button.setAttribute(
          "aria-pressed",
          String(isActive)
        );
      }
    );

  if (
    listView instanceof HTMLElement
  ) {
    listView.hidden =
      view !== "list";

    listView.classList.toggle(
      "is-active",
      view === "list"
    );
  }

  if (
    mapView instanceof HTMLElement
  ) {
    mapView.hidden =
      view !== "map";

    mapView.classList.toggle(
      "is-active",
      view === "map"
    );
  }
if (
  pagination instanceof HTMLElement
) {
  pagination.style.display =
    view === "map"
      ? "none"
      : "";
}
  if (view === "map") {
    requestAnimationFrame(
      initializeHomepageMap
    );
  }
};

document.addEventListener(
  "click",
  (event) => {
    const target =
      event.target;

    if (
      !(target instanceof Element)
    ) {
      return;
    }

    const viewButton =
      target.closest(
        "[data-home-view]"
      );

    if (
      !(
        viewButton instanceof
        HTMLButtonElement
      )
    ) {
      return;
    }

    setHomepageView(
      viewButton.dataset
        .homeView || "list"
    );
  }
);
window.addEventListener(
  "popstate",
    () => {
      loadSearchUrl(
        new URL(
          window.location.href
        ),
        {
          updateHistory: false,
          scrollToResults: false,
        }
      );
    }
  );

  document.addEventListener(
  "click",
  (event) => {
    const target = event.target;

    if (!(target instanceof Element)) {
      return;
    }

    const openButton =
      target.closest(
        "[data-save-search-open]"
      );

    if (
      !(
        openButton instanceof
        HTMLButtonElement
      )
    ) {
      return;
    }

    const saveSearch =
      openButton.closest(
        "[data-save-search]"
      );

    const panel =
      saveSearch?.querySelector(
        "[data-save-search-panel]"
      );

    if (
      !(
        panel instanceof HTMLElement
      )
    ) {
      return;
    }

    const opening =
      panel.hidden;

    panel.hidden = !opening;

    if (opening) {
      const nameInput =
        saveSearch?.querySelector(
          'input[name="searchName"]'
        );

      if (
        nameInput instanceof HTMLInputElement &&
        !nameInput.value.trim()
      ) {
        const searchParams =
          new URLSearchParams(
            window.location.search
          );

        const map =
          document.querySelector(
            "[data-home-listing-map]"
          );

        const city =
          String(
            map?.getAttribute(
              "data-city"
            ) || ""
          )
            .replace(/-/g, " ")
            .replace(/\b\w/g, (character) =>
              character.toUpperCase()
            );

        const areas =
          searchParams
            .getAll("area")
            .map((value) =>
              value
                .replace(/-/g, " ")
                .replace(/\b\w/g, (character) =>
                  character.toUpperCase()
                )
            )
            .filter(Boolean);

        const rawType =
          searchParams.get("type") ||
          "";

        const typeLabels = {
          house: "Homes",
          condo: "Condos",
          townhouse: "Townhomes",
          mobile: "Mobile Homes",
          land: "Land",
        };

        const type =
          typeLabels[
            rawType.toLowerCase()
          ] ||
          (rawType
            ? rawType
                .replace(/-/g, " ")
                .replace(/\b\w/g, (character) =>
                  character.toUpperCase()
                )
            : "Homes");

        nameInput.value = [
          areas.length === 1
            ? areas[0]
            : city,
          type,
        ]
          .filter(Boolean)
          .join(" · ");
      }
    }

    openButton.setAttribute(
      "aria-expanded",
      String(opening)
    );

    openButton.textContent =
      opening
        ? "Close"
        : "Save search";
  }
);
const initializeMoreFilters = () => {
  const form =
    document.querySelector(
      "[data-async-search-form]"
    );

  const group =
    form?.querySelector(
      "[data-more-filter]"
    );

  const trigger =
    form?.querySelector(
      "[data-more-filter-trigger]"
    );

  const panel =
    form?.querySelector(
      "[data-more-filter-panel]"
    );

  const closeButton =
    form?.querySelector(
      "[data-more-filter-close]"
    );

  const clearButton =
    form?.querySelector(
      "[data-more-filter-clear]"
    );

  const applyButton =
    form?.querySelector(
      "[data-more-filter-apply]"
    );

  if (
    !(form instanceof HTMLFormElement) ||
    !(group instanceof HTMLElement) ||
    !(trigger instanceof HTMLButtonElement) ||
    !(panel instanceof HTMLElement)
  ) {
    return;
  }

  const setOpen = (
    open: boolean
  ) => {
    group.toggleAttribute(
      "data-open",
      open
    );

    panel.hidden = !open;

    trigger.setAttribute(
      "aria-expanded",
      String(open)
    );
  };

  trigger.addEventListener(
    "click",
    () => {
      setOpen(
        !group.hasAttribute(
          "data-open"
        )
      );
    }
  );

  closeButton?.addEventListener(
    "click",
    () => {
      setOpen(false);
    }
  );

  clearButton?.addEventListener(
    "click",
    () => {
      form
        .querySelectorAll(
          "[data-more-filter-input]"
        )
        .forEach((input) => {
          if (
            input instanceof
            HTMLInputElement
          ) {
            input.checked = false;
          }
        });
    }
  );

  applyButton?.addEventListener(
    "click",
    () => {
      setOpen(false);
      form.requestSubmit();
    }
  );
};

initializeMoreFilters();
</script>

