<script>
  const SEARCH_FORM_SELECTOR =
    "[data-async-search-form]";

  const RESULTS_SELECTOR =
    "[data-async-search-results]";

  const FILTER_SELECTOR =
    "[data-single-select], [data-area-multi-select]";

  let activeRequest:
    AbortController | null =
    null;

  const getSearchForm = () =>
    document.querySelector(
      SEARCH_FORM_SELECTOR
    );

  const getResultsContainer = () =>
    document.querySelector(
      RESULTS_SELECTOR
    );
const positionSingleMenu = (
  group: Element
) => {
  const trigger =
    group.querySelector(
      "[data-single-trigger]"
    );

  const menu =
    group.querySelector(
      "[data-single-menu]"
    );

  if (
    !(trigger instanceof HTMLElement) ||
    !(menu instanceof HTMLElement)
  ) {
    return;
  }

  const wasHidden =
    menu.hidden;

  if (wasHidden) {
    menu.hidden = false;
    menu.style.visibility =
      "hidden";
  }

  group.classList.remove(
    "single-filter--open-up"
  );

  const triggerRect =
    trigger.getBoundingClientRect();

  const menuHeight =
    menu.scrollHeight;

  const spaceBelow =
    window.innerHeight -
    triggerRect.bottom;

  const spaceAbove =
    triggerRect.top;

  const shouldOpenUp =
    spaceBelow <
      menuHeight + 12 &&
    spaceAbove > spaceBelow;

  group.classList.toggle(
    "single-filter--open-up",
    shouldOpenUp
  );

   if (wasHidden) {
    menu.hidden = true;
    menu.style.visibility = "";
  }
};

const positionAreaMenu = (
  group: Element
) => {
  const trigger =
    group.querySelector(
      "[data-area-trigger]"
    );

  const menu =
    group.querySelector(
      "[data-area-menu]"
    );

  if (
    !(trigger instanceof HTMLElement) ||
    !(menu instanceof HTMLElement)
  ) {
    return;
  }

  const wasHidden =
    menu.hidden;

  if (wasHidden) {
    menu.hidden = false;
    menu.style.visibility =
      "hidden";
  }

  // Reset to normal downward position
  menu.style.top = "";
  menu.style.bottom = "";

  const triggerRect =
    trigger.getBoundingClientRect();

  const menuHeight =
    menu.scrollHeight;

  const spaceBelow =
    window.innerHeight -
    triggerRect.bottom;

  const spaceAbove =
    triggerRect.top;

  const shouldOpenUp =
    spaceBelow <
      menuHeight + 12 &&
    spaceAbove > spaceBelow;

  if (shouldOpenUp) {
    menu.style.top = "auto";
    menu.style.bottom =
      "calc(100% + 6px)";
  }

  if (wasHidden) {
    menu.hidden = true;
    menu.style.visibility = "";
  }
};
  const closeAllSearchMenus = (
    except: Element | null = null
  ) => {
    document
      .querySelectorAll(
        FILTER_SELECTOR
      )
      .forEach((element) => {
        if (element === except) {
          return;
        }

        element.removeAttribute(
          "data-open"
        );

        const trigger =
          element.querySelector(
            "[data-single-trigger], [data-area-trigger]"
          );

        const menu =
          element.querySelector(
            "[data-single-menu], [data-area-menu]"
          );

        trigger?.setAttribute(
          "aria-expanded",
          "false"
        );

        if (
          menu instanceof HTMLElement
        ) {
          menu.hidden = true;
        }
      });
  };

  const buildSearchUrl = (
    form: HTMLFormElement
  ) => {
    const url =
      new URL(
        form.action,
        window.location.origin
      );

    const formData =
      new FormData(form);

    for (
      const [key, rawValue]
      of formData.entries()
    ) {
      const value =
        String(rawValue).trim();

      if (!value) {
        continue;
      }

      url.searchParams.append(
        key,
        value
      );
    }

    return url;
  };

  const setLoadingState = (
    loading: boolean
  ) => {
    const results =
      getResultsContainer();

    const form =
      getSearchForm();

    results?.classList.toggle(
      "is-loading",
      loading
    );

    form?.toggleAttribute(
      "aria-busy",
      loading
    );
  };

  const replaceResults = (
    html: string
  ) => {
    const parser =
      new DOMParser();

    const nextDocument =
      parser.parseFromString(
        html,
        "text/html"
      );

    const nextResults =
      nextDocument.querySelector(
        RESULTS_SELECTOR
      );

    const currentResults =
      getResultsContainer();

    if (
      !nextResults ||
      !currentResults
    ) {
      throw new Error(
        "Search results container was not found."
      );
    }

   const activeView =
  document
    .querySelector(
      "[data-home-view].is-active"
    )
    ?.getAttribute(
      "data-home-view"
    ) || "list";

currentResults.innerHTML =
  nextResults.innerHTML;

homeListingMarkers.forEach(
  (marker) =>
    marker.remove()
);

homeListingMarkers = [];

if (homeListingMap) {
  homeListingMap.remove();
  homeListingMap = null;
}

setHomepageView(
  activeView
);
  };

  const loadSearchUrl = async (
    url: URL,
    options: {
      updateHistory?: boolean;
      scrollToResults?: boolean;
    } = {}
  ) => {
    const {
      updateHistory = true,
      scrollToResults = false,
    } = options;

    activeRequest?.abort();

    activeRequest =
      new AbortController();

    setLoadingState(true);

    try {
      const response =
        await fetch(
          url.toString(),
          {
            headers: {
              "X-Requested-With":
                "async-search",
            },
            signal:
              activeRequest.signal,
          }
        );

      if (!response.ok) {
        throw new Error(
          `Search request failed with status ${response.status}.`
        );
      }

      const html =
