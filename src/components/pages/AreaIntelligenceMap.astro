    iconSize: [24, 24],
    iconAnchor: [12, 12],
    popupAnchor: [0, -10],
    html: `
      <div style="
        width:24px;
        height:24px;
        display:grid;
        place-items:center;
        border:3px solid rgba(255,255,255,.96);
        border-radius:50%;
