  `;
}

// --- Draw polygon ---
function drawSearchPolygon(map) {
  if (!searchAreaGeojson?.coordinates?.[0]) return null;

  const coords = searchAreaGeojson.coordinates[0].map(([lng, lat]) => [lat, lng]);

  // Mask (darken outside polygon)
  const worldCoords = [
    [[-85, -180], [-85, 180], [85, 180], [85, -180]],
    coords,
  ];
  maskLayer = L.polygon(worldCoords, {
    color: "none",
    fillColor: "#000",
    fillOpacity: 0.06,
    interactive: false,
  }).addTo(map);

  // Outline
  polygonLayer = L.polygon(coords, {
    color: accentColor,
    weight: 3,
    fillOpacity: 0.02,
    interactive: false,
  }).addTo(map);

  return L.latLngBounds(coords);
}

// --- Init main map ---

function initLeafletMap(mode = "all") {
  if (!intentMapEl) return;

  waitForLeaflet(() => {
    const selector = mode === "refined" ? ".refined-card" : ".original-card";
    const cards = Array.from(document.querySelectorAll(selector)).filter(
      (c) => !c.hidden && c.style.display !== "none" && c.dataset.lat && c.dataset.lng
    );

    const points = cards.map((c) => ({ card: c, latlng: getCardLatLng(c) })).filter((i) => i.latlng);

    // Init map if needed
    if (!leafletMap) {
    leafletMap = L.map(intentMapEl, {
  zoomControl: true,
  attributionControl: false,
  scrollWheelZoom: false,
});

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: "| OpenStreetMap",
      }).addTo(leafletMap);

      L.control.attribution({ prefix: false }).addAttribution('| <a href="https://openstreetmap.org">OSM</a>').addTo(leafletMap);
    }

    // Clear existing markers
    listingMarkers.forEach((m) => m.remove());
    listingMarkers = [];
    amenityMarkers.forEach((m) => m.remove());
    amenityMarkers = [];
    if (polygonLayer) { polygonLayer.remove(); polygonLayer = null; }
    if (maskLayer) { maskLayer.remove(); maskLayer = null; }

    // Draw polygon
    const areaBounds = drawSearchPolygon(leafletMap);

    // Add listing markers
    points.forEach(({ card, latlng }) => {
      const marker = L.marker(latlng, { icon: makeListingIcon() }).addTo(leafletMap);

      const popup = L.popup({
        maxWidth: 260,
        closeButton: true,
        offset: [0, -8],
        minWidth: 240,
        className: "leaflet-listing-popup",
      }).setContent(buildListingPopup(card));

      marker.bindPopup(popup);

      listingMarkers.push(marker);
    });

    // Fit bounds
    if (areaBounds) {
      leafletMap.fitBounds(areaBounds, { padding: [40, 40] });
    } else if (points.length) {
      const bounds = L.latLngBounds(points.map((p) => p.latlng));
      leafletMap.fitBounds(bounds, { padding: [40, 40] });
    }

    // Track bounds for refine
    leafletMap.on("moveend", () => {
      const b = leafletMap.getBounds();
      currentIntentMapBounds = {
        north: b.getNorth(),
        east: b.getEast(),
        south: b.getSouth(),
        west: b.getWest(),
      };
    });

    // Load amenities on area pages
    if (document.querySelector(".area-intelligence") && !window.__amenitiesLoaded) {
      window.__amenitiesLoaded = true;
      setTimeout(() => loadAreaAmenities("school"), 200);
    }

    setTimeout(() => leafletMap.invalidateSize(), 100);
  });
}
function pointInAreaPolygon(lat, lng) {
  if (!searchAreaGeojson?.coordinates?.[0]?.length) {
    return false;
  }

  const rings =
    searchAreaGeojson.type === "MultiPolygon"
      ? searchAreaGeojson.coordinates.flat()
      : searchAreaGeojson.coordinates;

  return rings.some((ring) => {
    let inside = false;
    const x = lng;
    const y = lat;

    for (
      let i = 0, j = ring.length - 1;
      i < ring.length;
      j = i++
    ) {
      const xi = Number(ring[i][0]);
      const yi = Number(ring[i][1]);
      const xj = Number(ring[j][0]);
      const yj = Number(ring[j][1]);

      const intersects =
        yi > y !== yj > y &&
        x <
          ((xj - xi) * (y - yi)) /
            (yj - yi) +
          xi;

      if (intersects) inside = !inside;
    }

    return inside;
  });
}
// --- Amenity radius (computed once from polygon size) ---
let amenityRadius = 4;

if (searchAreaGeojson?.coordinates?.[0]?.length) {
  const coords = searchAreaGeojson.coordinates[0];

  const lats = coords.map((c) => c[1]);
  const lngs = coords.map((c) => c[0]);

  const latSpan =
    Math.max(...lats) - Math.min(...lats);

  const lngSpan =
    Math.max(...lngs) - Math.min(...lngs);

  const spanKm =
    Math.max(latSpan, lngSpan) * 111;

  amenityRadius = Math.min(
    Math.max(spanKm * 0.6 + 2, 4),
    12
  );
}

// --- Load amenities ---
async function loadAreaAmenities(category = "school") {
  if (!leafletMap) return;

  amenityMarkers.forEach((m) => m.remove());
  amenityMarkers = [];

  const osmCity = document.querySelector("[data-city]")?.dataset.city || "nanaimo";
  const areaEl = document.querySelector("[data-area-center-lat]");
  const osmLat = Number(areaEl?.dataset.areaCenterLat || 0);
  const osmLng = Number(areaEl?.dataset.areaCenterLng || 0);

  if (!osmLat || !osmLng) return;

  try {


    const res = await fetch(
  `/api/osm-amenities?city=${encodeURIComponent(osmCity)}&lat=${osmLat}&lng=${osmLng}&radius=${Math.min(amenityRadius + 2, 15)}&limit=250`
);
    const payload = await res.json();
const areaAmenityFilter = (item) => {
  const lat = Number(item.lat);
  const lng = Number(item.lng);

  if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
    return false;
  }

  // Definitely include anything physically inside the area.
  if (pointInAreaPolygon(lat, lng)) {
    return true;
  }

  // Also allow nearby amenities just outside the boundary.
  return Number(item.distKm || 0) <= 2;
};
    // Update chip counts
   document.querySelectorAll(".amenity-chip").forEach((chip) => {
  // Keep the listings toggle visible.
  if (chip.id === "toggle-listings-btn") return;

  const key =
    amenityCategoryMap[chip.dataset.amenity] ||
    chip.dataset.amenity;

  const items =
    payload.categories?.[key] || [];

 const count =
  items.filter(areaAmenityFilter).length;

  const strong =
    chip.querySelector("strong");

  if (strong) {
    strong.textContent = String(count);
  }

  chip.hidden = count === 0;
});

const visibleAmenityChips = Array.from(
  document.querySelectorAll(
    ".amenity-chip:not(#toggle-listings-btn)"
  )
).filter((chip) => !chip.hidden);

let activeChip = document.querySelector(
  ".amenity-chip.active:not(#toggle-listings-btn)"
);

if (!activeChip || activeChip.hidden) {
  document
    .querySelectorAll(
      ".amenity-chip.active:not(#toggle-listings-btn)"
    )
    .forEach((chip) => {
      chip.classList.remove("active");
    });

  activeChip = visibleAmenityChips[0] || null;

  activeChip?.classList.add("active");
}

const activeCategory = activeChip
  ? amenityCategoryMap[activeChip.dataset.amenity] ||
    activeChip.dataset.amenity
  : category;

const rows = (
  payload.categories?.[activeCategory] || []
).filter(areaAmenityFilter);

// Update panel
const label =
  activeChip?.childNodes?.[0]?.textContent?.trim() ||
  activeCategory;

const panelTitle =
  document.querySelector("#area-amenity-panel h3");

const panelCopy =
  document.querySelector("#area-amenity-panel p");

const amenityList =
  document.querySelector("#amenity-list");

    if (panelTitle) panelTitle.textContent = label;
    if (panelCopy) panelCopy.textContent = `${rows.filter(i => i.name?.trim()).length} ${label.toLowerCase()} near ${document.querySelector("[data-slug]")?.dataset.slug?.replaceAll("-", " ") || "this area"}`;

  if (amenityList) {
  amenityList.innerHTML = rows
    .filter((item) => item.name && item.name.trim())
    .slice(0, 8)
    .map((item) => `
      <div
        class="amenity-row"
        data-amenity-name="${String(item.name || "").replace(/"/g, "&quot;")}"
      >
        <strong>${item.name}</strong>
        <span>${Number(item.distKm || 0).toFixed(1)} km away</span>
      </div>`)
    .join("") || `<div style="padding:14px 18px;color:#9c9590;font-size:0.88rem;">No named ${label.toLowerCase()} found nearby.</div>`;

  amenityList.querySelectorAll(".amenity-row").forEach((row) => {
    row.addEventListener("mouseenter", () => {
      if (window.matchMedia("(max-width: 800px)").matches) return;

      const name = row.dataset.amenityName || "";
      const marker = amenityMarkers.find((m) => m.__amenityName === name);

      row.style.background = "rgba(0,0,0,0.035)";

      if (marker) {
        marker.openPopup();
        marker.setZIndexOffset(1000);

        const el = marker.getElement();
        if (el) {
          el.style.transform += " scale(1.35)";
          el.style.transition = "transform 0.15s ease";
        }
      }
    });

    row.addEventListener("mouseleave", () => {
      const name = row.dataset.amenityName || "";
      const marker = amenityMarkers.find((m) => m.__amenityName === name);

      row.style.background = "";

      if (marker) {
        marker.closePopup();
        marker.setZIndexOffset(0);

        const el = marker.getElement();
        if (el) {
          el.style.transform = el.style.transform.replace(" scale(1.35)", "");
        }
      }
    });

    row.addEventListener("click", () => {
      const name = row.dataset.amenityName || "";
      const marker = amenityMarkers.find((m) => m.__amenityName === name);

      if (marker && leafletMap) {
        leafletMap.flyTo(marker.getLatLng(), Math.max(leafletMap.getZoom(), 15), {
          duration: 0.45,
        });
        marker.openPopup();
      }
    });
  });
}

    // Add amenity markers
    rows.forEach((item) => {
      const lat = Number(item.lat);
      const lng = Number(item.lng);
      if (!lat || !lng) return;

   const marker = L.marker([lat, lng], { icon: makeAmenityIcon() }).addTo(leafletMap);
const popupLabel = item.name?.trim() || label || category;
marker.bindPopup(`
  <div style="font-family:'DM Sans',system-ui,sans-serif;padding:8px 12px;font-size:0.88rem;">
    <strong style="display:block;font-weight:700;color:#1c1914;margin-bottom:2px;">${popupLabel}</strong>
    <span style="font-size:0.78rem;color:#9c9590;">${Number(item.distKm || 0).toFixed(1)} km away</span>
  </div>`, {
  closeButton: false,
  offset: [0, -7],
});
marker.on("click", () => marker.openPopup());
marker.__amenityName = String(item.name || "").trim();
marker.__amenityCategory = category;

amenityMarkers.push(marker);
    });

  } catch (e) {
    console.warn("Amenity load failed:", e);
  }
}

// --- Init refined map ---
function initRefinedLeafletMap() {
  const refinedMapEl = document.getElementById("refined-intent-map");
  if (!refinedMapEl) return;

  waitForLeaflet(() => {
    const cards = Array.from(document.querySelectorAll(".refined-card")).filter(
      (c) => c.style.display !== "none"
    );
    const points = cards.map((c) => ({ card: c, latlng: getCardLatLng(c) })).filter((i) => i.latlng);

    if (!points.length) {
      refinedMapEl.innerHTML = "<p style='padding:16px;color:#6b6560;'>No map locations available.</p>";
      return;
    }

    if (!refinedLeafletMap) {
      refinedLeafletMap = L.map(refinedMapEl, { zoomControl: true, attributionControl: false, scrollWheelZoom: false });
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19 }).addTo(refinedLeafletMap);
    }

    refinedMarkers.forEach((m) => m.remove());
    refinedMarkers = [];

    points.forEach(({ card, latlng }) => {
      const marker = L.marker(latlng, { icon: makeListingIcon() }).addTo(refinedLeafletMap);
      marker.bindPopup(buildListingPopup(card), { maxWidth: 210, closeButton: false });
      refinedMarkers.push(marker);
    });

    const bounds = L.latLngBounds(points.map((p) => p.latlng));
    refinedLeafletMap.fitBounds(bounds, { padding: [40, 40] });
    setTimeout(() => refinedLeafletMap.invalidateSize(), 100);
  });
}

// --- View toggle ---
listViewBtn?.addEventListener("click", () => {
  document.body.classList.remove("is-map-mode");
  intentMapEl.hidden = true;
  gridEl?.classList.remove("map-hidden");
  listViewBtn.classList.add("active");
  mapViewBtn?.classList.remove("active");
});

mapViewBtn?.addEventListener("click", () => {
  document.body.classList.add("is-map-mode");
  intentMapEl.hidden = false;
  gridEl?.classList.add("map-hidden");
  mapViewBtn.classList.add("active");
  listViewBtn?.classList.remove("active");
  requestAnimationFrame(() => initLeafletMap());
});

// Area intelligence map initializes only when it approaches the viewport.
// The separate listings map still waits for the Map button.
const areaIntelligenceSection =
  document.querySelector(".area-intelligence");

if (areaIntelligenceSection && intentMapEl) {
  const initializeVisibleAreaMap = () => {
    intentMapEl.hidden = false;

    waitForLeaflet(() => {
      initLeafletMap();

      window.setTimeout(() => {
        leafletMap?.invalidateSize();
      }, 100);
    });
  };

  if ("IntersectionObserver" in window) {
    const areaMapObserver = new IntersectionObserver(
      (entries, observer) => {
        const isNearViewport =
          entries.some((entry) => entry.isIntersecting);

        if (!isNearViewport) return;

        observer.disconnect();
        initializeVisibleAreaMap();
      },
      {
        rootMargin: "300px 0px",
        threshold: 0.01,
      }
    );

    areaMapObserver.observe(areaIntelligenceSection);
  } else {
    initializeVisibleAreaMap();
  }
}

// Show more listings
let visibleListingCount = 12;
document.getElementById("show-more-listings-btn")?.addEventListener("click", () => {
  visibleListingCount += 12;
  const cards = Array.from(document.querySelectorAll(".original-card"));
  cards.forEach((card, index) => { if (index < visibleListingCount) card.hidden = false; });
  if (visibleListingCount >= cards.length) {
    document.getElementById("show-more-listings-btn")?.setAttribute("hidden", "");
  }
});

// Re-init map on filter changes
window.addEventListener("listing-filters-updated", () => {
  if (leafletMap && intentMapEl && !intentMapEl.hidden) initLeafletMap();
});

</script>
