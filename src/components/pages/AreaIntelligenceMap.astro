        <span style="
          display:block;
          margin-bottom:11px;
          color:#9c9590;
          font-size:.74rem;
        ">
          ${card.dataset.beds || "-"} bd &nbsp;|&nbsp; ${card.dataset.baths || "-"} ba
        </span>

        <button
          type="button"
