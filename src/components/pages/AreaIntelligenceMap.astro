        ">
          ${card.dataset.price || ""}
        </strong>

        <span style="
          display:block;
          margin-bottom:5px;
          color:#687080;
          font-size:.78rem;
          line-height:1.4;
        ">
          ${card.dataset.address || ""}
        </span>

        <span style="
          display:block;
          margin-bottom:11px;
          color:#9c9590;
          font-size:.74rem;
        ">
          ${card.dataset.beds || "-"} bd &nbsp;|&nbsp; ${card.dataset.baths || "-"} ba
        </span>

        <button
          type="button"
          onclick="document.querySelector('[data-listing-id=&quot;${listingId}&quot;]')?.click();"
          style="
            display:inline-flex;
            align-items:center;
            justify-content:center;
            min-height:36px;
            padding:0 14px;
            border:0;
            border-radius:6px;
            background:${accentColor};
            color:#fff;
            font-family:inherit;
