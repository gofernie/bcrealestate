---
type Props = {
  city: string;
  page: any;
  listingTypeCounts?: any;
};

const {
  city,
  page,
  listingTypeCounts = {},
} = Astro.props;
---

<section class="area-intelligence">

  <div class="area-intelligence__chips">

    <button type="button" class="amenity-chip" data-amenity="grocery">
      Grocery <strong></strong>
    </button>

    <button type="button" class="amenity-chip" data-amenity="restaurants">
      Food & Cafés <strong></strong>
    </button>

    <button type="button" class="amenity-chip" data-amenity="medical">
      Medical <strong></strong>
    </button>

    <button type="button" class="amenity-chip active" data-amenity="schools">
      Schools <strong></strong>
    </button>

    <button type="button" class="amenity-chip" data-amenity="parks">
      Parks <strong></strong>
    </button>

    <button type="button" class="amenity-chip" data-amenity="trails">
      Trails <strong></strong>
    </button>

    <button type="button" class="amenity-chip" data-amenity="beaches">
      Beaches <strong></strong>
    </button>

    <button type="button" class="amenity-chip" data-amenity="transit">
      Transit <strong></strong>
    </button>

  </div>


  <div class="area-map-toolbar">

    <button
      type="button"
      id="toggle-listings-btn"
      class="map-listing-toggle"
      data-listings-visible="true"
    >
      Listings On
    </button>

  </div>


  <div class="area-map-layout">

    <aside id="amenity-list">
    </aside>

    <div class="area-neighbourhood-map">
      <div
        id="intent-map"
        style="height:500px;"
      ></div>
    </div>

  </div>

</section>

<style>
.area-map-toolbar {
  display:flex;
  justify-content:flex-end;
  margin:-8px 0 10px;
}

.map-listing-toggle {
  display:inline-flex;
  align-items:center;
  gap:6px;
  border:1px solid rgba(0,0,0,.08);
  background:#fff;
  padding:7px 12px;
  border-radius:6px;
  font:inherit;
  font-size:.76rem;
  font-weight:700;
  cursor:pointer;
}

.map-listing-toggle.is-off {
  opacity:.6;
}

.area-intelligence__chips {
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-bottom:12px;
}

.amenity-chip {
  display:inline-flex;
  align-items:center;
  gap:6px;
  white-space:nowrap;
  border:1px solid rgba(0,0,0,.08);
  background:#fff;
  padding:6px 12px;
  border-radius:6px;
  font:inherit;
  font-size:.76rem;
  font-weight:600;
  cursor:pointer;
}

.amenity-chip.active {
  background:var(--accent);
  color:#fff;
}

.area-map-layout {
  display:grid;
  grid-template-columns:340px 1fr;
  gap:18px;
}

.area-amenity-panel {
  border:1px solid rgba(0,0,0,.08);
  border-radius:12px;
  background:#fff;
}

.area-neighbourhood-map {
  min-height:520px;
  border-radius:12px;
  overflow:hidden;
  border:1px solid rgba(0,0,0,.08);
}

#intent-map {
  height:500px;
}

@media(max-width:900px){
  .area-map-layout {
    grid-template-columns:1fr;
  }
}
</style>

