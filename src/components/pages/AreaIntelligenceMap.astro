    card.dataset.listingId ||
    card.dataset.mls ||
    "";

  return `
    <div style="
      width:240px;
      overflow:hidden;
      border-radius:9px;
      background:#fff;
      font-family:DM Sans,system-ui,sans-serif;
    ">
