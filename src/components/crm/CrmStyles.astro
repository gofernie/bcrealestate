<style is:global>
  /* crm-v1 */
  body { margin:0; font-family:"DM Sans",system-ui,sans-serif; background:#f7f4ef; color:#181614; font-size:15px; line-height:1.5; }
  .crm { padding:40px 48px 72px; max-width:1100px; }
  .crm h1 { margin:0 0 6px; font-size:2.2rem; font-weight:700; letter-spacing:-0.03em; line-height:1.05; }
  .crm .sub { color:#6f6a63; margin:0 0 26px; }
  .crm h2 { font-size:.78rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:#8a8378; margin:0 0 10px; }
  .crm-card { background:#fff; border:1px solid #e3ddd2; border-radius:10px; box-shadow:0 10px 30px rgba(0,0,0,.04); }
  .today { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin-bottom:34px; }
  .today .crm-card { padding:16px 16px 10px; }
  .today h3 { margin:0 0 2px; font-size:.95rem; font-weight:800; display:flex; justify-content:space-between; align-items:center; }
  .today h3 .n { font-size:.75rem; background:#181614; color:#fff; border-radius:999px; padding:1px 8px; }
  .today .hint { color:#8a8378; font-size:.8rem; margin:0 0 8px; }
  .today a.t { display:block; padding:8px 0; border-top:1px solid #f0ebe2; text-decoration:none; color:inherit; }
  .today a.t:hover strong { text-decoration:underline; }
  .today a.t strong { display:block; font-size:.9rem; }
  .today a.t span { display:block; font-size:.8rem; color:#6f6a63; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .today .empty { color:#a8a196; font-size:.85rem; padding:8px 0 6px; border-top:1px solid #f0ebe2; }
  .overdue { color:#b4442e !important; font-weight:700; }
  .bar { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:14px; }
  .bar input[type=search] { flex:1 1 220px; max-width:320px; height:36px; border:1px solid #d9d2c6; border-radius:6px; padding:0 12px; font:inherit; background:#fff; }
  .chip { height:32px; padding:0 12px; border-radius:6px; border:1px solid rgba(24,22,20,.2); background:#fff; font:inherit; font-size:.8rem; font-weight:700; color:#555; cursor:pointer; }
  .chip.on { background:#181614; color:#fff; border-color:#181614; }
  .chip .c { opacity:.6; margin-left:4px; font-weight:600; }
  .plist { overflow:hidden; }
  .prow { display:grid; grid-template-columns:minmax(0,1.3fr) 110px minmax(0,1.6fr) 150px 110px; gap:14px; align-items:center; padding:12px 18px; border-top:1px solid #f0ebe2; text-decoration:none; color:inherit; }
  .prow:first-child { border-top:0; }
  .prow:hover { background:#fbf9f5; }
  .prow .nm strong { display:block; font-weight:800; }
  .prow .nm span, .prow .last span { display:block; font-size:.8rem; color:#7a746b; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .prow .last { font-size:.88rem; min-width:0; }
  .prow .last b { font-weight:600; display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .prow .cnt { display:flex; gap:6px; flex-wrap:wrap; font-size:.75rem; color:#5d574f; }
  .prow .cnt i { font-style:normal; background:#f4f0e9; border-radius:5px; padding:2px 7px; white-space:nowrap; }
  .prow .cnt i.love { background:#fdeceb; color:#a3352a; }
  .prow .fu { font-size:.8rem; color:#6f6a63; text-align:right; }
  .stage { display:inline-block; font-size:.72rem; font-weight:800; letter-spacing:.02em; padding:3px 9px; border-radius:6px; background:#eef0f3; color:#4a5263; white-space:nowrap; }
  .stage-new { background:#eaf0fb; color:#2c4f8c; } .stage-active { background:#e6f3f1; color:#1f6b60; }
  .stage-showing { background:#fdf1e3; color:#8a5414; } .stage-offer { background:#f1edf8; color:#5b3f8c; }
  .stage-closed { background:#e5f2e3; color:#2d6a2a; } .stage-past { background:#f0ece5; color:#6b6358; } .stage-notnow { background:#f3f3f3; color:#8a8a8a; }
  .crm .btn { display:inline-flex; align-items:center; gap:6px; height:34px; padding:0 14px; border-radius:6px; border:1px solid rgba(24,22,20,.2); background:#fff; color:#181614; text-decoration:none; font:inherit; font-size:.82rem; font-weight:800; cursor:pointer; }
  .crm .btn:hover { background:#f7f4ef; }
  .crm .btn.dark { background:#181614; color:#fff; border-color:#181614; }
  .crm .btn.dark:hover { background:#2d2a27; }
  @media (max-width:900px) {
    .crm { padding:24px 16px 56px; } .today { grid-template-columns:1fr; }
    .prow { grid-template-columns:minmax(0,1fr) auto; } .prow .last { grid-column:1 / -1; } .prow .cnt, .prow .fu { display:none; }
  }
</style>
