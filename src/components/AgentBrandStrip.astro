    .agent-brand-strip--has-photo .agent-brand-strip__actions {
      margin-left: 34px;
    }
  }
  /* Homepage introduction variant */
  .agent-brand-strip--intro {
    min-height: 220px;
    background: #f4fbff;
  }

  .agent-brand-strip--intro .agent-brand-strip__eyebrow {
    color: var(--accent);
