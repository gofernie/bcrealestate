---
import { getAgentForSite } from "../lib/getAgentForSite";

const { site = null, city = "nanaimo" } = Astro.props;
const agent = await getAgentForSite(site);

const first = (...values) =>
  values.find((value) => String(value || "").trim()) || "";

const agentName = first(
  agent?.name,
  site?.agent_name,
  site?.realtor_name,
  site?.owner_name
);

const agentTitle = first(
  agent?.title,
  site?.agent_title,
  site?.realtor_title,
  "REALTOR"
);

const brokerage = first(
  agent?.brokerage,
  site?.brokerage,
  site?.brokerage_name
);

const phone = first(
  agent?.phone,
  site?.agent_phone,
  site?.phone,
  site?.contact_phone
);

const email = first(
  agent?.email,
  site?.agent_email,
  site?.email,
  site?.contact_email
);

const photo = first(
  agent?.photo_url,
  agent?.photo,
  agent?.headshot_url,
  site?.agent_photo,
  site?.agent_photo_url,
  site?.headshot,
  site?.headshot_url
);

const cityLabel = String(city || "nanaimo")
  .replace(/-/g, " ")
  .replace(/\b\w/g, (character) => character.toUpperCase());

const initials = String(
  agentName || site?.site_name || cityLabel
)
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
---

<section
  class:list={[
    "agent-brand-strip",
    photo && "agent-brand-strip--has-photo"
  ]}
  aria-label="Your local real estate guide"
>
  <div class="agent-brand-strip__identity">
    <span class="agent-brand-strip__initials" aria-hidden="true">
      {initials}
    </span>

    <div>
      <span class="agent-brand-strip__eyebrow">LOCAL GUIDANCE</span>

      <h2>
        {agentName
          ? `${agentName}, ${agentTitle}`
          : `${cityLabel} real estate, made clearer.`}
      </h2>

      {brokerage && <p class="agent-brand-strip__brokerage">{brokerage}</p>}
    </div>
  </div>

    {photo && (
    <div class="agent-brand-strip__portrait" aria-hidden="true">
      <div class="agent-brand-strip__portrait-halo"></div>
      <img
        src={photo}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
<p class="agent-brand-strip__copy">
    Real listings, local context, and straightforward advice when you
    need it. Browse freely or ask about a property, neighbourhood, or move.
  </p>

  <div class="agent-brand-strip__actions">
    {email && (
      <a class="agent-brand-strip__primary" href={`mailto:${email}`}>
        Ask a question
      </a>
    )}

    {phone && (
      <a
        class="agent-brand-strip__secondary"
        href={`tel:${String(phone).replace(/[^\d+]/g, "")}`}
      >
        {phone}
      </a>
    )}

    {!email && !phone && (
      <a class="agent-brand-strip__primary" href="#homepage-listings">
        Browse homes
      </a>
    )}
  </div>
</section>

<style>
  .agent-brand-strip {
    width: min(1180px, calc(100% - 40px));
    margin: 54px auto;
    padding: 28px 32px;
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(280px, 1.15fr) auto;
    align-items: center;
    gap: 30px;
    border: 1px solid var(--line-warm);
    border-radius: 18px;
    background:
      linear-gradient(
        110deg,
        color-mix(in srgb, var(--accent) 9%, white),
        white 62%
      );
  }

  .agent-brand-strip__identity {
    display: flex;
    align-items: center;
    gap: 17px;
    min-width: 0;
  }

  .agent-brand-strip img,
  .agent-brand-strip__initials {
    width: 76px;
    height: 76px;
    flex: 0 0 76px;
    border-radius: 50%;
  }

  .agent-brand-strip img {
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .agent-brand-strip__initials {
    display: grid;
    place-items: center;
    background: var(--accent);
    color: white;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: .04em;
  }

  .agent-brand-strip__eyebrow {
    display: block;
    margin-bottom: 7px;
    color: var(--accent);
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .15em;
  }

  .agent-brand-strip h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--f-display, Georgia, serif);
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    line-height: 1.05;
  }

  .agent-brand-strip__brokerage {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: .82rem;
  }

  .agent-brand-strip__copy {
    margin: 0;
    max-width: 520px;
    color: var(--muted);
    font-size: .94rem;
    line-height: 1.65;
  }

  .agent-brand-strip__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 9px;
  }

  .agent-brand-strip__actions a {
    display: inline-flex;
    min-height: 43px;
    padding: 0 17px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: .84rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .agent-brand-strip__primary {
    border: 1px solid var(--accent);
    background: var(--accent);
    color: white;
  }

  .agent-brand-strip__secondary {
    border: 1px solid var(--line-warm);
    background: white;
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .agent-brand-strip {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .agent-brand-strip__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 600px) {
    .agent-brand-strip {
      width: calc(100% - 28px);
      margin: 34px auto;
      padding: 20px;
      gap: 16px;
      border-radius: 14px;
    }

    .agent-brand-strip img,
    .agent-brand-strip__initials {
      width: 60px;
      height: 60px;
      flex-basis: 60px;
    }

    .agent-brand-strip__copy {
      font-size: .88rem;
      line-height: 1.55;
    }

    .agent-brand-strip__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }

  /* agent-brand-wow-v3 */

.agent-brand-strip {
  position: relative;
  overflow: visible;
}

.agent-brand-strip--has-photo {
  grid-template-columns:
    minmax(340px, .95fr)
    300px
    minmax(390px, 1.15fr)
    auto;
  gap: 28px;
  min-height: 225px;
  padding: 0 38px;
  align-items: center;
  overflow: visible;
}

.agent-brand-strip--has-photo .agent-brand-strip__identity {
  position: relative;
  z-index: 3;
}

.agent-brand-strip--has-photo .agent-brand-strip__initials {
  width: 72px;
  height: 72px;
  flex: 0 0 72px;
}

.agent-brand-strip__portrait {
  position: relative;
  align-self: stretch;
  width: 300px;
  min-width: 300px;
  height: 225px;
  margin: 0;
  z-index: 2;
}

.agent-brand-strip__portrait-halo {
  position: absolute;
  left: 50%;
  bottom: -54px;
  width: 270px;
  height: 270px;
  transform: translateX(-50%);
  border-radius: 50%;
  background:
    color-mix(
      in srgb,
      var(--accent) 11%,
      white
    );
}

.agent-brand-strip__portrait img {
  position: absolute;
  display: block;
  left: 50%;
  bottom: 28px;
  width: 325px;
  height: 285px;
  transform: translateX(-50%);
  object-fit: contain;
  object-position: center bottom;
  border-radius: 0;
  box-shadow: none;
}

.agent-brand-strip--has-photo .agent-brand-strip__copy {
  position: relative;
  max-width: 520px;
  padding-left: 34px;
}

.agent-brand-strip--has-photo .agent-brand-strip__copy::before {
  content: "";
  position: absolute;
  left: 0;
  top: 5%;
  width: 1px;
  height: 90%;
  background:
    color-mix(
      in srgb,
      var(--accent) 24%,
      transparent
    );
}

.agent-brand-strip--has-photo .agent-brand-strip__actions {
  position: relative;
  z-index: 3;
  white-space: nowrap;
}

@media (max-width: 1100px) {
  .agent-brand-strip--has-photo {
    grid-template-columns:
      minmax(255px, 1fr)
      190px
      minmax(270px, 1fr);
    padding: 0 24px;
  }

  .agent-brand-strip__portrait {
    width: 190px;
    min-width: 190px;
  }

  .agent-brand-strip__portrait img {
    width: 220px;
    height: 220px;
  }

  .agent-brand-strip__portrait-halo {
    width: 180px;
    height: 180px;
  }

  .agent-brand-strip--has-photo .agent-brand-strip__actions {
    grid-column: 3;
  }
}

@media (max-width: 860px) {
  .agent-brand-strip--has-photo {
    grid-template-columns: minmax(0, 1fr) 145px;
    min-height: 180px;
    padding: 18px 20px;
    gap: 16px;
  }

  .agent-brand-strip--has-photo .agent-brand-strip__identity {
    grid-column: 1;
    grid-row: 1;
  }

  .agent-brand-strip__portrait {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 145px;
    min-width: 145px;
    height: 180px;
    margin: -18px 0 -18px 0;
  }

  .agent-brand-strip__portrait img {
    width: 175px;
    height: 185px;
    bottom: -2px;
  }

  .agent-brand-strip__portrait-halo {
    width: 145px;
    height: 145px;
    bottom: -10px;
  }

  .agent-brand-strip--has-photo .agent-brand-strip__copy {
    grid-column: 1;
    grid-row: 2;
    padding-left: 0;
  }

  .agent-brand-strip--has-photo .agent-brand-strip__copy::before {
    display: none;
  }

  .agent-brand-strip--has-photo .agent-brand-strip__actions {
    grid-column: 1 / -1;
    grid-row: 3;
  }
}

@media (max-width: 600px) {
  .agent-brand-strip--has-photo {
    grid-template-columns: minmax(0, 1fr) 100px;
    padding: 16px;
    gap: 12px;
  }

  .agent-brand-strip--has-photo .agent-brand-strip__initials {
    width: 56px;
    height: 56px;
    flex-basis: 56px;
  }

  .agent-brand-strip__portrait {
    width: 100px;
    min-width: 100px;
    height: 150px;
    margin: -16px -6px -16px 0;
  }

  .agent-brand-strip__portrait img {
    width: 132px;
    height: 154px;
    bottom: -1px;
  }

  .agent-brand-strip__portrait-halo {
    width: 110px;
    height: 110px;
    bottom: 0;
  }
}
</style>