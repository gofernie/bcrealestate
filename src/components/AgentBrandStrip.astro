---
import { getAgentForSite } from "../lib/getAgentForSite";

const { site = null, city = "nanaimo", variant = "contact" } = Astro.props;
const agent = await getAgentForSite(site);
const isIntro = variant === "intro";
const isNudge = variant === "nudge";

const first = (...values) =>
  values.find((value) => String(value || "").trim()) || "";

const introCopy =
  first(
    site?.bio,
    agent?.intro,
    agent?.short_bio,
    site?.agent_intro,
    site?.agent_bio
  ) ||
  "A local guide to homes, neighbourhoods, and the questions that come with a move. Browse at your own pace, then reach out when you’d like a straight answer.";

const contactCopy =
  first(
    site?.contact_copy,
    agent?.contact_copy,
    agent?.contactCopy
  ) ||
  "Real listings, local context, and straightforward advice when you need it. Browse freely or reach out - I’m always happy to help.";
const agentName = first(
  agent?.name,
  site?.agent_name,
  site?.realtor_name,
  site?.owner_name
);

const agentCredentials = first(
  agent?.credentials
);

const agentTitle = first(
  agent?.title,
  site?.agent_title,
  site?.realtor_title,
  "REALTOR"
);

const brokerage = first(
  agent?.brokerage,
  site?.brokerage,
  site?.brokerage_name
);

const phone = first(
  agent?.phone,
  site?.agent_phone,
  site?.phone,
  site?.contact_phone
);

const email = first(
  agent?.email,
  site?.agent_email,
  site?.email,
  site?.contact_email
);

const photo = first(
  agent?.photo_url,
  agent?.photo,
  agent?.headshot_url,
  site?.agent_photo,
  site?.agent_photo_url,
  site?.headshot,
  site?.headshot_url
);

const originalPhoto = first(
  agent?.photo_original_url,
  agent?.original_photo_url,
  site?.agent_photo_original_url,
  site?.agent_original_photo_url
);
const introBackground = first(
  site?.agent_intro_background_url
);

const cityLabel = String(city || "nanaimo")
  .replace(/-/g, " ")
  .replace(/\b\w/g, (character) => character.toUpperCase());

const agentFirstName = String(agentName || "")
  .trim()
  .split(/\s+/)[0] || "";

const initials = String(
  agentName || site?.site_name || cityLabel
)
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
---

<section
  class:list={[
    "agent-brand-strip",
    isIntro && "agent-brand-strip--intro",
    isNudge && "agent-brand-strip--nudge",
    photo && !isNudge && "agent-brand-strip--has-photo"
  ]}
  aria-label="Your local real estate guide"
>
  <div class="agent-brand-strip__identity">
    <span class="agent-brand-strip__initials" aria-hidden="true">
      {initials}
    </span>

    <div>
      <span class="agent-brand-strip__eyebrow">{isNudge ? "YOUR LOCAL GUIDE" : isIntro ? "MEET YOUR LOCAL GUIDE" : "LOCAL GUIDANCE"}</span>

      <h2>
        {isNudge
          ? agentFirstName
            ? "Ask " + agentFirstName + " about any home."
            : "Questions about a home?"
          : agentName
          ? `${agentName}${agentCredentials ? ` ${agentCredentials}` : ""}, ${agentTitle}`
          : `${cityLabel} real estate, made clearer.`}
      </h2>

      {!isNudge && brokerage && <p class="agent-brand-strip__brokerage">{brokerage}</p>}

      {isIntro && (
        <p class="agent-brand-strip__intro-copy">
          {introCopy}
        </p>
      )}
    </div>
  </div>

    {photo && !isNudge && (
    <div class="agent-brand-strip__portrait" aria-hidden="true" style={`--agent-photo: url("${photo}"); --agent-original-photo: url("${originalPhoto || photo}"); --agent-intro-background: url("${introBackground}")`}>
      <div class="agent-brand-strip__portrait-halo"></div>
      <img
        src={photo}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
<div class="agent-brand-strip__content">
  <p class="agent-brand-strip__copy">
    {isNudge ? agentFirstName ? "Ask " + agentFirstName + " for local context and a straight answer." : "Local context and a straight answer whenever you want one." : contactCopy}
  </p>

  <div class="agent-brand-strip__actions">
    {email && (
      <a class="agent-brand-strip__primary" href={`mailto:${email}`}>
        {isNudge && agentFirstName ? "Email " + agentFirstName : "Ask a question"}
      </a>
    )}

    {phone && (
      <a
        class="agent-brand-strip__secondary"
        href={`tel:${String(phone).replace(/[^\d+]/g, "")}`}
      >
        {isNudge ? "Call " + phone : phone}
      </a>
    )}

    {!email && !phone && (
      <a class="agent-brand-strip__primary" href="#homepage-listings">
        Browse homes
      </a>
    )}
  </div>
</div>
</section>

<style>
  .agent-brand-strip {
    box-sizing: border-box;
    width: 100%;
    max-width: none;
    margin: 54px auto;
    padding: 28px 32px;
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(280px, 1.15fr) auto;
    align-items: center;
    gap: 30px;
    border: 1px solid var(--line-warm);
    border-radius: 18px;
    background:
      linear-gradient(
        110deg,
        color-mix(in srgb, var(--accent) 9%, white),
        white 62%
      );
  }

  .agent-brand-strip__identity {
    display: flex;
    align-items: center;
    gap: 17px;
    min-width: 0;
  }

  .agent-brand-strip img,
  .agent-brand-strip__initials {
    width: 76px;
    height: 76px;
    flex: 0 0 76px;
    border-radius: 50%;
  }

  .agent-brand-strip img {
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .agent-brand-strip__initials {
    display: grid;
    place-items: center;
    background: var(--accent);
    color: white;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: .04em;
  }

  .agent-brand-strip__eyebrow {
    display: block;
    margin-bottom: 7px;
    color: var(--accent);
    font-size: .7rem;
    font-weight: 850;
    letter-spacing: .15em;
  }

  .agent-brand-strip h2 {
    margin: 0;
    color: var(--ink);
    font-family: var(--f-display, Georgia, serif);
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    line-height: 1.05;
  }

  .agent-brand-strip__brokerage {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 1.1rem;
    font-weight: 700;
    font-weight: 600;
  }

  .agent-brand-strip__copy {
    margin: 0;
    max-width: 520px;
    color: var(--muted);
    font-size: .94rem;
    line-height: 1.65;
  }

  .agent-brand-strip__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 9px;
  }

  .agent-brand-strip__actions a {
    display: inline-flex;
    min-height: 43px;
    padding: 0 17px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: .84rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .agent-brand-strip__primary {
    border: 1px solid var(--accent);
    background: var(--accent);
    color: white;
  }

  .agent-brand-strip__secondary {
    border: 1px solid var(--line-warm);
    background: white;
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .agent-brand-strip {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .agent-brand-strip__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 600px) {
    .agent-brand-strip {
      width: 100%;
      margin: 34px auto;
      padding: 20px;
      gap: 16px;
      border-radius: 14px;
    }

    .agent-brand-strip img,
    .agent-brand-strip__initials {
      width: 60px;
      height: 60px;
      flex-basis: 60px;
    }

    .agent-brand-strip__copy {
      font-size: .88rem;
      line-height: 1.55;
    }

    .agent-brand-strip__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }

  /* agent-brand-wow-v3 */

.agent-brand-strip {
  position: relative;
  overflow: visible;
}


