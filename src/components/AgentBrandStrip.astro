  .agent-brand-strip--nudge .agent-brand-strip__primary,
  .agent-brand-strip--nudge .agent-brand-strip__secondary {
    padding: 9px 13px;
    font-size: .72rem;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .agent-brand-strip--nudge {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 16px;
    }

    .agent-brand-strip--nudge .agent-brand-strip__content {
      align-items: flex-start;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

