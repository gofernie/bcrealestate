}

.agent-brand-strip--has-photo .agent-brand-strip__content {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 18px;
}

.agent-brand-strip--has-photo .agent-brand-strip__actions {
  position: relative;
  z-index: 3;
  justify-content: flex-start;
  flex-wrap: wrap;
  margin: 0;
  white-space: nowrap;
}

