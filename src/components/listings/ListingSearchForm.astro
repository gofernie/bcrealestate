---
import AreaMultiSelect from "./AreaMultiSelect.astro";
import SingleSelectDropdown from "./SingleSelectDropdown.astro";

type Props = {
  city: string;

  areas?: string[];

  pageArea?: string | null;
  propertyType?: string | null;
};

const {
  city,
  areas = [],
  pageArea = null,
  propertyType = null,
} = Astro.props;

const params = Astro.url.searchParams;

const queryType =
  String(
    params.get("type") || ""
  )
    .trim()
    .toLowerCase();

const queryAreas =
  params
    .getAll("area")
    .map((value) =>
      String(value || "")
        .trim()
        .toLowerCase()
    )
    .filter(Boolean);

const queryBeds =
  params.get("beds");

const queryMaxPrice =
  params.get("maxPrice");

const querySort =
  String(
    params.get("sort") || ""
  ).trim();

const primaryOnMain =
  ["1", "true"].includes(
    String(
      params.get(
        "primaryOnMain"
      ) || ""
    ).toLowerCase()
  );

const bedsTogether =
  ["1", "true"].includes(
    String(
      params.get(
        "bedsTogether"
      ) || ""
    ).toLowerCase()
  );

const fourBedsTogether =
  ["1", "true"].includes(
    String(
      params.get(
        "fourBedsTogether"
      ) || ""
    ).toLowerCase()
  );

const normalizeSlug = (
  value: string
) =>
  String(value || "")
    .trim()
    .toLowerCase()
    .replace(/^pq[\s-]+/i, "")
    .replace(/&/g, "and")
    .replace(/\//g, "-")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const formatLabel = (
  value: string
) =>
  String(value || "")
    .replace(/-/g, " ")
    .replace(
      /\b\w/g,
      (character) =>
        character.toUpperCase()
    );

const selectedAreas =
  queryAreas.length
    ? queryAreas
    : pageArea
      ? [
          normalizeSlug(
            pageArea
          ),
        ]
      : [];

const locationCards =
  areas.map((area) => {
    const slug =
      normalizeSlug(area);

    return {
      city,
      area: slug,
      label:
        formatLabel(area),
      href:
        `${Astro.url.pathname}?area=${encodeURIComponent(
          slug
        )}`,
      count: 0,
    };
  });

const propertyTypeOptions = [
  {
    value: "house",
    label: "Homes",
  },
  {
    value: "condo",
    label: "Condos",
  },
  {
    value: "townhouse",
    label: "Townhomes",
  },
  {
    value: "mobile",
    label: "Mobile homes",
  },
  {
    value: "land",
    label: "Land",
  },
];

const bedOptions = [
  {
    value: "1",
    label: "1+ beds",
  },
  {
    value: "2",
    label: "2+ beds",
  },
  {
    value: "3",
    label: "3+ beds",
  },
  {
    value: "4",
    label: "4+ beds",
  },
  {
    value: "5",
    label: "5+ beds",
  },
];

const priceOptions = [
  {
    value: "500000",
    label: "Under $500,000",
  },
  {
    value: "700000",
    label: "Under $700,000",
  },
  {
    value: "900000",
    label: "Under $900,000",
  },
  {
    value: "1200000",
    label: "Under $1.2M",
  },
  {
    value: "1600000",
    label: "Under $1.6M",
  },
  {
    value: "2000000",
    label: "Under $2M",
  },
];

const sortOptions = [
  {
    value: "price-asc",
    label:
      "Price: low to high",
  },
  {
    value: "price-desc",
    label:
      "Price: high to low",
  },
];

const effectiveType =
  queryType ||
  String(
    propertyType || ""
  )
    .trim()
    .toLowerCase();

const bedSummaryParts: string[] =
  [];

if (queryBeds) {
  bedSummaryParts.push(
    `${queryBeds}+ beds`
  );
}

if (primaryOnMain) {
  bedSummaryParts.push(
    "Primary on main"
  );
}

if (bedsTogether) {
  bedSummaryParts.push(
    "3+ beds together"
  );
}

if (fourBedsTogether) {
  bedSummaryParts.push(
    "4+ same floor"
  );
}

const bedsSummary =
  bedSummaryParts.join(" · ");

const formatPrice = (
  value: number
) => {
  if (value >= 1000000) {
    return `$${Number(
      (
        value /
        1000000
      ).toFixed(1)
    )}M`;
  }

  return `$${Math.round(
    value / 1000
  )}k`;
};

const priceSummary =
  queryMaxPrice
    ? `Under ${formatPrice(
        Number(
          queryMaxPrice
        )
      )}`
    : "";
---

<div class="listing-search-form-wrap">
  <form
    class="bc-search"
    data-listing-search-form
    method="GET"
    action={Astro.url.pathname}
  >
    <SingleSelectDropdown
      label="Property type"
      name="type"
      icon="home"
      defaultLabel="Any type"
      options={propertyTypeOptions}
      value={effectiveType}
    />

    <AreaMultiSelect
      locationCards={locationCards}
      selectedAreas={selectedAreas}
    />

    <SingleSelectDropdown
      label="Beds"
      name="beds"
      icon="beds"
      defaultLabel="Any beds"
      options={bedOptions}
      value={queryBeds}
      summary={
        bedsSummary ||
        undefined
      }
      toggles={[
        {
          name:
            "primaryOnMain",
          label:
            "Primary bedroom on main",
          checked:
            primaryOnMain,
        },
        {
          name:
            "bedsTogether",
          label:
            "3+ beds on one floor",
          checked:
            bedsTogether,
        },
        {
          name:
            "fourBedsTogether",
          label:
            "4+ beds on one floor",
          checked:
            fourBedsTogether,
        },
      ]}
    />

    <SingleSelectDropdown
      label="Price"
      name="maxPrice"
      icon="price"
      defaultLabel="Any price"
      options={priceOptions}
      value={queryMaxPrice}
      summary={
        priceSummary ||
        undefined
      }
      clearNames={[
        "minPrice",
      ]}
    />

    <SingleSelectDropdown
      label="Sort"
      name="sort"
      icon="sort"
      defaultLabel="Newest"
      options={sortOptions}
      value={
        querySort &&
        querySort !== "newest"
          ? querySort
          : ""
      }
    />
  </form>
</div>

<style>
  .listing-search-form-wrap {
    width: 100%;
    margin: 0 0 28px;
  }

  .bc-search {
    display: grid;
    grid-template-columns:
      repeat(
        5,
        minmax(0, 1fr)
      );
    width: 100%;
    overflow: visible;
    border: 1px solid
      rgba(24, 22, 20, 0.1);
    border-radius: 8px;
    background: #fff;
  }

  @media (
    max-width: 1000px
  ) {
    .bc-search {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }
  }

  @media (
    max-width: 600px
  ) {
    .bc-search {
      grid-template-columns:
        1fr;
    }
  }
</style>
