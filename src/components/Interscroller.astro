---
const { img, alt = "", title, sub = "", href = "", cta = "" } = Astro.props;
---
<section class="isc" aria-label={title}>
  <div class="isc-inner">
    <img src={img} alt={alt} loading="lazy" decoding="async" />
    <div class="isc-shade"></div>
    <div class="isc-copy">
      <h3>{title}</h3>
      {sub && <p>{sub}</p>}
      {href && <a href={href}>{cta}</a>}
    </div>
  </div>
</section>
<style>
  .isc{position:relative;height:100svh;clip-path:inset(0);margin:3rem calc(50% - 50vw);width:100vw}
  .isc-inner{position:fixed;inset:0;display:grid;place-items:center}
  .isc-inner img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .isc-shade{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,.05),rgba(0,0,0,.45))}
  .isc-copy{position:relative;text-align:center;color:#fff;padding:0 1.5rem;max-width:36rem}
  .isc-copy h3{font-family:"Instrument Serif",serif;font-size:clamp(2rem,6vw,3.5rem);line-height:1.05;margin:0 0 .5rem;text-shadow:0 2px 16px rgba(0,0,0,.5)}
  .isc-copy p{font-size:1.05rem;margin:0 0 1.25rem;opacity:.95}
  .isc-copy a{display:inline-block;padding:.75rem 1.5rem;border-radius:999px;background:var(--accent,#2f5d50);color:#fff;text-decoration:none;font-weight:600}
</style>
