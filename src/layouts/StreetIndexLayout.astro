---
interface Props { title: string; description?: string; q?: string }
const { title, description = "Housing market indexes for B.C. towns, read like stocks and updated nightly.", q = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://streetindex.io${Astro.url.pathname}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Inter:wght@400;500;600;700&display=swap" />
  <style is:global>
    body { margin: 0; font-family: Inter, system-ui, sans-serif; color: #191922; background: #fff; }
    a { color: #2f4a68; }
    .si-head { border-bottom: 1px solid #e3e6ea; }
    .si-wrap { width: min(1400px, calc(100% - 4rem)); margin: 0 auto; }
    .si-nav { display: flex; justify-content: space-between; align-items: center; min-height: 60px; }
    .si-brand { font: 700 1.4rem Georgia, serif; letter-spacing: -.04em; color: #191922; text-decoration: none; }
    .si-nav nav a { margin-left: 22px; font-weight: 600; text-decoration: none; }
    .si-main { padding: 28px 0 40px; }
    .si-cta { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 14px; font-weight: 600; }
    .si-foot { margin-top: 40px; padding: 18px 0; border-top: 1px solid #e3e6ea; color: #666; font-size: .85rem; }
    @media (max-width: 640px) { .si-wrap { width: calc(100% - 2rem); } }
  </style>
</head>
<body>
  <header class="si-head"><div class="si-wrap si-nav"><a class="si-brand" href={`/${q}`}>StreetIndex</a><nav><a href={`/${q}`}>Markets</a></nav></div></header>
  <slot name="ticker" />
  <main class="si-main"><slot /></main>
  <footer class="si-wrap si-foot">Indexes and charts by <a href="https://bc.realestate">bc.realestate</a> · Powered by <a href="https://locus.homes">Locus</a> · Statistical estimates, not appraisals.</footer>
</body>
</html>