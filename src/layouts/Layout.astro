    if (on) {
      const ref = [...document.querySelectorAll(".filter-dd__value")].find((e) => { const bg = getComputedStyle(e).backgroundColor; return bg && bg !== "transparent" && !/rgba\(0, 0, 0, 0\)/.test(bg); });
      if (ref) { const cs = getComputedStyle(ref); props.forEach((k) => val.style.setProperty(k, cs.getPropertyValue(k), "important")); val.style.setProperty("width", "auto", "important"); val.style.setProperty("max-width", "100%", "important"); val.classList.remove("area-pill-on"); val.dataset.pillCopied = "1"; }
      else {
        /* area-pill-accent-v1 */
