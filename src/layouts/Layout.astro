        set(panel, "width", "100%");
        set(panel, "max-width", "none");
        set(panel, "margin-top", "0");
        set(panel, "background", surface);
        set(panel, "border", `1px solid ${border}`);
        set(panel, "border-top", "0");
        set(panel, "border-top-left-radius", "0");
        set(panel, "border-top-right-radius", "0");
        set(panel, "border-bottom-left-radius", "6px");
        set(panel, "border-bottom-right-radius", "6px");
        set(panel, "box-shadow", panelShadow);
      }
    };

    let frame = 0;

    const scheduleSync = () => {
      if (frame) return;

      frame = requestAnimationFrame(() => {
        frame = 0;
        syncHomeDockedRail();
      });
    };

    const start = () => {
