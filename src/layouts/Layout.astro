        subtree: true,
      });

      new MutationObserver(scheduleSync).observe(document.body, {
        attributes: true,
        subtree: true,
        attributeFilter: ["hidden"],
      });

      new MutationObserver(scheduleSync).observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ["data-theme"],
        }
