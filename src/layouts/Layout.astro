      set(rail, "background", "transparent");
      set(rail, "padding", "0");
      set(rail, "border", "0");
      set(rail, "box-shadow", "none");

      set(form, "box-sizing", "border-box");
      set(form, "min-width", "0");
      set(form, "width", railWidth);
      set(form, "max-width", railWidth);
      set(form, "margin", "0 auto");
      set(form, "background", surface);
      set(form, "border", `1px solid ${border}`);
      set(form, "border-top-left-radius", "0");
      set(form, "border-top-right-radius", "0");

      if (panelOpen) {
        set(form, "border-bottom", "0");
        set(form, "border-bottom-left-radius", "0");
        set(form, "border-bottom-right-radius", "0");
        set(form, "box-shadow", "none");
      } else {
        set(form, "border-bottom", `1px solid ${border}`);
        set(form, "border-bottom-left-radius", "6px");
        set(form, "border-bottom-right-radius", "6px"); set(form, "border-bottom", "2px solid var(--accent)"); /* docked-accent-v1 */
