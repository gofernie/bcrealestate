</script>    <script is:inline>/* opt-img-v1: same URL the server builds for card + hero photos */ window.__optImg = function (src, w, h, q) { src = String(src || "").trim(); if (!src || /^(localhost|127\.0\.0\.1)$/.test(location.hostname) || src.indexOf("placehold.co") >= 0 || src.indexOf("https://cdn.repliers.io/") !== 0) return src; return "/.netlify/images?url=" + encodeURIComponent(src) + "&w=" + w + "&h=" + h + "&fit=cover&fm=webp&q=" + q; }; window.__optCardImg = function (src) { return window.__optImg(src, 760, 475, 76); };</script>
    <link rel="preconnect" href="https://cdn.repliers.io" crossorigin /><!-- preconnect-repliers-v1 -->
    <link rel="canonical" href={(() => { let p = Astro.url.pathname.replace(/\/+$/, ""); if (p.split("/").filter(Boolean).length <= 1) p += "/"; return new URL(p || "/", Astro.url.origin).href; })()} /><!-- canonical-v1 -->
    <meta charset="UTF-8" />
    <script is:inline>
      // ?style= (house style from a listing's "more like this" pill) must reach every listing request,
      // including the ones page scripts send while the page is still loading, so this runs first.
      (() => {
        if (window.__lsStyleCarry) return;
        window.__lsStyleCarry = true;
        window.__lsActiveStyles = new URLSearchParams(location.search).getAll("style").filter(Boolean);
        const active = () => window.__lsActiveStyles || [];
        const withStyle = (u) => {
          const str = String(u);
          if (!active().length || !str.includes("/api/home-listings") || /[?&]style=/.test(str)) return u;
          return str + (str.includes("?") ? "&" : "?") + active().map((s) => "style=" + encodeURIComponent(s)).join("&");
        };
        const origFetch = window.fetch;
        window.fetch = (input, init) => origFetch.call(window, typeof input === "string" || input instanceof URL ? withStyle(input) : input, init);
        for (const k of ["pushState", "replaceState"]) {
          const orig = history[k];
          history[k] = function (state, title, url) {
            if (url != null && active().length) {
              try {
                const u = new URL(url, location.href);
                if (u.pathname === location.pathname && !u.searchParams.has("style")) {
                  active().forEach((s) => u.searchParams.append("style", s));
                  url = u.pathname + u.search + u.hash;
