<script is:inline>
(() => {
  const GAP = 24;
  let fs, strips = [];
  const layout = () => {
    if (!fs) return;
    const form = document.getElementById("home-hero-search");
    if (form && !form.closest(".listing-filter-rail.is-visible") && getComputedStyle(form).position !== "fixed") {
      fs.style.setProperty("margin-top", "0px", "important");
      const gap = fs.getBoundingClientRect().top - form.getBoundingClientRect().bottom;
      fs.style.setProperty("margin-top", (GAP - gap) + "px", "important");
    }
    fs.style.setProperty("margin-bottom", "0px", "important");
    const ref = document.getElementById("homepage-listings");
    const w = ref ? ref.getBoundingClientRect().width : 0;
    strips.forEach((s) => {
      s.style.setProperty("transform", "none", "important");
      s.style.setProperty("margin-top", (GAP + 20) + "px", "important");
      s.style.setProperty("margin-bottom", "-20px", "important");
      if (w > 0) { s.style.setProperty("max-width", w + "px", "important"); s.style.setProperty("margin-left", "auto", "important"); s.style.setProperty("margin-right", "auto", "important"); }
      const inner = s.firstElementChild; if (inner) inner.style.setProperty("margin-top", "0px", "important");
    });
  };
  const place = () => {
    fs = document.querySelector(".hero-collections-strip");
    if (!fs) return false;
    const hero = document.querySelector(".locus-home-hero"), ft = document.querySelector("footer");
    if (hero && ft && (ft.compareDocumentPosition(fs) & Node.DOCUMENT_POSITION_FOLLOWING)) hero.after(fs);
    strips = [...document.querySelectorAll(".locus-home-agent-strip-top--desktop, .locus-home-agent-strip-top--mobile")];
    let a = fs; strips.forEach((s) => { a.after(s); a = s; });
    layout(); setTimeout(layout, 300);
    addEventListener("resize", () => requestAnimationFrame(layout));
    return true;
  };
  if (place()) return;
  const mo = new MutationObserver(() => { if (place()) mo.disconnect(); });
  mo.observe(document.body, { childList: true, subtree: true });
  setTimeout(() => mo.disconnect(), 8000);
})();
