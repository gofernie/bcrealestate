      "border-bottom-right-radius",
    ];

    const visualPanelProperties = [
      "background",
      "border",
      "border-top",
      "box-shadow",
      "border-top-left-radius",
      "border-top-right-radius",
      "border-bottom-left-radius",
      "border-bottom-right-radius",
    ];

    const railProperties = [
      "background",
      "padding",
      "border",
      "box-shadow",
    ];

    const removeProperties = (element, properties) => {
      properties.forEach((property) =>
        element.style.removeProperty(property)
      );
    };

    const set = (element, property, value) => {
      element.style.setProperty(property, value, "important");
    };

    const isDesktop = () =>
      window.matchMedia("(min-width: 769px)").matches;

    const syncHomeDockedRail = () => {
      const rail = document.querySelector(".listing-filter-rail");
      const form = document.getElementById("home-hero-search");
      const panel = document.getElementById("hero-more-filters");

      if (!(rail instanceof HTMLElement) || !(form instanceof HTMLElement)) {
        return;
      }

      if (!isDesktop()) {
        removeProperties(form, visualFormProperties);

        if (panel instanceof HTMLElement) {
          removeProperties(panel, visualPanelProperties);
        }

        return;
      }

      if (!rail.contains(form)) {
        removeProperties(rail, railProperties);
        removeProperties(form, allFormProperties);

        if (panel instanceof HTMLElement) {
          removeProperties(panel, allPanelProperties);
        }

        return;
      }

      const navShell = document.querySelector(".site-nav__inner");
      const measuredWidth =
        navShell instanceof HTMLElement
          ? Math.round((() => { const nw = navShell.getBoundingClientRect().width; const rs = Array.from(document.querySelectorAll(".card"), (c) => c.getBoundingClientRect()).filter((r) => r.width > 0); const span = rs.length ? Math.max(...rs.map((r) => r.right)) - Math.min(...rs.map((r) => r.left)) : 0; const best = span > nw && span <= nw + 60 ? span : nw; return best + 2; })()) /* dock-width-v3 */
