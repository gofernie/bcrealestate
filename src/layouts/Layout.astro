        const m = btn && getComputedStyle(btn).backgroundColor.match(/\d+(\.\d+)?/g);
        if (m && m.length >= 3) { const [r, g, b] = m.map(Number); val.style.setProperty("background", `rgba(${r}, ${g}, ${b}, 0.12)`, "important"); val.style.setProperty("color", `rgb(${r}, ${g}, ${b})`, "important"); }
      }
    } else {
