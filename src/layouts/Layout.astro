    return n > 6 ? `See the 6 closest of ${n} ${label} above ${budget}` : n > 0 ? `See ${n} more ${label} above ${budget}` : `See ${label} above ${budget}`;
  };  /* filter-title-font-v1 */
  const matchTitles = () => {
    const ref = document.querySelector(".filter-dd__option");
    if (!ref) return;
