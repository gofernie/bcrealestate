      "border-bottom",
      "box-shadow",
      "border-top-left-radius",
      "border-top-right-radius",
      "border-bottom-left-radius",
      "border-bottom-right-radius",
    ];

    const allPanelProperties = [
      "box-sizing",
      "width",
      "max-width",
      "margin-top",
      "background",
      "border",
      "border-top",
      "box-shadow",
      "border-top-left-radius",
      "border-top-right-radius",
