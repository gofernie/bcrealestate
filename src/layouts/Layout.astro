  const tc = (s) => s.replace(/\b[A-Z][A-Z'-]+\b/g, (w) => /^(NE|NW|SE|SW|BC)$/.test(w) ? w : w.toLowerCase().replace(/(^|[-'])([a-z])/g, (m, p, c) => p + c.toUpperCase()));
  const el = document.createElement("div");
  el.setAttribute("role", "status");
  el.style.cssText = "position:fixed;top:76px;left:50%;transform:translateX(-50%);z-index:9999;max-width:min(560px,calc(100% - 32px));display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border-radius:6px;background:rgba(14,20,24,.88);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);color:#fff;font-size:.92rem;line-height:1.4;box-shadow:0 10px 30px rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.2);border-top:2px solid var(--accent,#2f6f73);transition:opacity .3s ease";
  const txt = document.createElement("div");
  const b = document.createElement("strong"); b.textContent = "That home is no longer available.";
  const s = document.createElement("div"); s.style.opacity = ".85"; s.textContent = `${tc(gone)} is off the market — here are similar homes currently for sale.`;
  txt.append(b, s);
  const x = document.createElement("button"); x.type = "button"; x.setAttribute("aria-label", "Dismiss"); x.textContent = "×";
  x.style.cssText = "background:none;border:0;color:#fff;font-size:1.3rem;line-height:1;cursor:pointer;opacity:.8;padding:0 2px";
  const close = () => { el.style.opacity = "0"; setTimeout(() => el.remove(), 300); };
  x.addEventListener("click", close);
  el.append(txt, x);
  const show = () => { document.body.appendChild(el); setTimeout(close, 10000); };
  if (document.body) show(); else document.addEventListener("DOMContentLoaded", show, { once: true });
})();
