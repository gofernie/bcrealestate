---
import "../styles/docked-listing-filter-rail.css";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  accentColor?: string;
  city?: string;
  site?: any;
}
const { title, accentColor = "#2f6f73", city = "nanaimo", site = null } = Astro.props;
---
<!doctype html>
<html lang="en" style={`--accent: ${accentColor};`} data-theme="light">
  <head>
    <script is:inline>/* opt-img-v1: same URL the server builds for card + hero photos */ window.__optImg = function (src, w, h, q) { src = String(src || "").trim(); if (!src || /^(localhost|127\.0\.0\.1)$/.test(location.hostname) || src.indexOf("placehold.co") >= 0 || src.indexOf("https://cdn.repliers.io/") !== 0) return src; return "/.netlify/images?url=" + encodeURIComponent(src) + "&w=" + w + "&h=" + h + "&fit=cover&fm=webp&q=" + q; }; window.__optCardImg = function (src) { return window.__optImg(src, 760, 475, 76); };</script>
    <link rel="preconnect" href="https://cdn.repliers.io" crossorigin /><!-- preconnect-repliers-v1 -->
    <link rel="canonical" href={(() => { let p = Astro.url.pathname.replace(/\/+$/, ""); if (p.split("/").filter(Boolean).length <= 1) p += "/"; return new URL(p || "/", Astro.url.origin).href; })()} /><!-- canonical-v1 -->
    <meta charset="UTF-8" />
    <script is:inline>
      // ?style= (house style from a listing's "more like this" pill) must reach every listing request,
      // including the ones page scripts send while the page is still loading, so this runs first.
      (() => {
        if (window.__lsStyleCarry) return;
        window.__lsStyleCarry = true;
        window.__lsActiveStyles = new URLSearchParams(location.search).getAll("style").filter(Boolean);
        const active = () => window.__lsActiveStyles || [];
        const withStyle = (u) => {
          const str = String(u);
          if (!active().length || !str.includes("/api/home-listings") || /[?&]style=/.test(str)) return u;
          return str + (str.includes("?") ? "&" : "?") + active().map((s) => "style=" + encodeURIComponent(s)).join("&");
        };
        const origFetch = window.fetch;
        window.fetch = (input, init) => origFetch.call(window, typeof input === "string" || input instanceof URL ? withStyle(input) : input, init);
        for (const k of ["pushState", "replaceState"]) {
          const orig = history[k];
          history[k] = function (state, title, url) {
            if (url != null && active().length) {
              try {
                const u = new URL(url, location.href);
                if (u.pathname === location.pathname && !u.searchParams.has("style")) {
                  active().forEach((s) => u.searchParams.append("style", s));
                  url = u.pathname + u.search + u.hash;
                }
              } catch (e) {}
            }
            return orig.call(this, state, title, url);
          };
        }
        document.addEventListener("astro:before-preparation", (e) => {
          try { window.__lsActiveStyles = new URL(e.to).searchParams.getAll("style").filter(Boolean); } catch (err) { window.__lsActiveStyles = []; }
        });
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      try {
        localStorage.removeItem("locus-theme");
      } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
<title>{title ?? "Astro Basics"}</title>
    <slot name="head" />
  <style is:global>
/* locus-native-controls-dark-v1 */
html[data-theme="dark"] {
  color-scheme: dark;
}

html[data-theme="light"] {
  color-scheme: light;
}
</style><style is:global>
/* locus-home-search-uniform-bg-v1 */
html[data-theme="dark"] .locus-home-search,
html[data-theme="dark"] .locus-home-search__field,
html[data-theme="dark"] .locus-home-search .area-multiselect,
html[data-theme="dark"] .locus-home-search .area-multiselect__trigger,
html[data-theme="dark"] .locus-home-search .locus-home-more-toggle,
html[data-theme="dark"] .locus-home-search .locus-home-search__popular {
  background: #1d2125 !important;
}
</style><style is:global>
/* locus-global-charcoal-cards */
html[data-theme="dark"] [data-listing-id] {
  background: #1b1e21 !important;
  border-color: #394149 !important;
}
/* /locus-global-charcoal-cards */
</style>
<style is:global>
/* locus-dark-search-lighter-v1 */
html[data-theme="dark"] #home-hero-search {
  background: #202428 !important;
  border-color: #3b434a !important;
}
  /* locus-dark-search-unify-v1 */
  html[data-theme="dark"] #home-hero-search :is(
    .locus-home-search__field,
    .locus-home-search__popular,
    .area-multiselect__trigger,
    .locus-home-more-toggle
  ) {
    background: #202428 !important;
  }
  /* /locus-dark-search-unify-v1 */
/* /locus-dark-search-lighter-v1 */
</style>
<style is:global>
/* locus-dark-search-dropdowns-v1 */
html[data-theme="dark"] #home-hero-search select,
html[data-theme="dark"] #home-hero-search select option,
html[data-theme="dark"] #home-hero-search .area-multiselect__menu,
html[data-theme="dark"] #home-hero-search .area-multiselect__option {
  background: #252a2e !important;
  color: #edf1f3 !important;
  border-color: #49535c !important;
}

html[data-theme="dark"] #home-hero-search .area-multiselect__option:hover,
html[data-theme="dark"] #home-hero-search .area-multiselect__option.is-selected {
  background: #30363b !important;
  color: #ffffff !important;
}

html[data-theme="dark"] #home-hero-search .area-multiselect__check {
  color: #edf1f3 !important;
}
/* /locus-dark-search-dropdowns-v1 */
</style><style>
/* locus-dark-load-more-v1 */
html[data-theme="dark"] #home-load-more.home-load-more-btn {
  background: #111315 !important;
  border-color: #394149 !important;
  color: #f3f5f6 !important;
  box-shadow: none !important;
}

html[data-theme="dark"] #home-load-more.home-load-more-btn:hover {
  background: #202428 !important;
  border-color: var(--accent) !important;
}
</style>
  <style is:global>#listing-results-anchor{scroll-margin-top:190px !important}</style>
<style is:global>
/* type-stats-quiet-v1: keep the stats bar from competing with the search bar */
html body *:has(> article > .type-stat-icon) { background: transparent !important; border: 0 !important; box-shadow: none !important; padding-top: 2px !important; padding-bottom: 2px !important; }
html body *:has(> article > .type-stat-icon) > article { background: transparent !important; border: 0 !important; box-shadow: none !important; padding: 4px 18px !important; }
html body *:has(> article > .type-stat-icon) > article + article { border-left: 1px solid rgba(0, 0, 0, .08) !important; }
html body .type-stat-icon { width: 30px !important; height: 30px !important; background: transparent !important; opacity: .5; }
html body .type-stat-icon svg { width: 18px !important; height: 18px !important; }
html body *:has(> article > .type-stat-icon) strong { font-size: 1.15rem !important; font-weight: 600 !important; color: #3b4148 !important; }
html body *:has(> article > .type-stat-icon) span:not(.type-stat-icon) { font-size: .78rem !important; font-weight: 500 !important; color: #6b7280 !important; }
html body *:has(> article > .type-stat-icon) small { font-size: .7rem !important; color: #9aa1a9 !important; }
html body *:has(> article > .type-stat-icon) { margin-bottom: 32px !important; } /* type-stats-gap */
</style>
<style is:global>
/* filter-active-v4: changed filters show their value as a soft accent pill (sort excluded) */
.filter-dd:not(.filter-dd--sort):not([class*="sort"]):has(.filter-dd__option.is-selected:not([data-value="all"]):not([data-value=""])) .filter-dd__value {
  display: inline-block !important;
  margin: -2px 0 -2px -8px !important; position: relative; top: 4px;
  padding: 2px 8px !important;
  border-radius: 999px !important;
  background: color-mix(in srgb, var(--accent, #2f6f73) 12%, #ffffff) !important;
  color: var(--accent, #2f6f73) !important;
  font-weight: 700 !important;
  max-width: calc(100% + 8px);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
</style>
</head>

<body data-google-maps-api-key={import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || ""}>
    <slot />
    <SiteFooter site={site} city={city} />

    <script is:inline define:vars={{ city }}>
      const openMobileMap = () => {
        const mapButton =
          document.getElementById("map-view-btn");

        if (mapButton) {
          mapButton.click();
          mapButton.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
          return;
        }

        window.location.href =
          `/${city}?view=map`;
      };

      const openMobileAlerts = () => {
        const alertButton =
          document.getElementById(
            "hero-save-search-btn"
          ) ||
          document.getElementById(
            "save-search-btn"
          ) ||
          document.querySelector(
            "[data-slug-save-open]"
          );

        if (alertButton) {
          alertButton.click();
          alertButton.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
          return;
        }

        window.location.href =
          `/${city}?alerts=1`;
      };

      document
        .getElementById("mobile-results-map-btn")
        ?.addEventListener(
          "click",
          openMobileMap
        );

      document
        .getElementById("mobile-saved-btn")
        ?.addEventListener(
          "click",
          () => {
            document
              .getElementById("shortlist-modal")
              ?.removeAttribute("hidden");
          }
        );

      document
        .getElementById("mobile-alerts-btn")
        ?.addEventListener(
          "click",
          openMobileAlerts
        );

      window.addEventListener(
        "DOMContentLoaded",
        () => {
          const params =
            new URLSearchParams(
              window.location.search
            );

          if (params.get("view") === "map") {
            window.setTimeout(
              openMobileMap,
              150
            );
          }

          if (params.get("alerts") === "1") {
            window.setTimeout(
              openMobileAlerts,
              150
            );
          }
        }
      );
    </script>
  
<script is:inline>
/* locus-hide-duplicate-intent-selects-v1 */
(() => {
  const hideDuplicates = () => {
    document.querySelectorAll(".intent-controls").forEach((controls) => {
      if (!controls.querySelector(".filter-dd")) return;

      controls.querySelectorAll("select").forEach((select) => {
        if (select.closest(".filter-dd")) return;
        select.hidden = true;
        select.setAttribute("aria-hidden", "true");
        select.tabIndex = -1;
      });
    });
  };

  window.addEventListener("DOMContentLoaded", () => setTimeout(hideDuplicates, 0));
  window.addEventListener("pageshow", () => setTimeout(hideDuplicates, 0));
})();
</script>
<!-- locus-dark-similar-searches-v1 -->
<script is:inline>
  (() => {
    const applySimilarSearches = () => {
      if (document.documentElement.dataset.theme !== "dark") return;

      const heading = Array.from(
        document.querySelectorAll("h1, h2, h3")
      ).find(
        (element) =>
          element.textContent.replace(/\s+/g, " ").trim() ===
          "Explore Similar Searches"
      );

      const section = heading?.closest("section");
      if (!section) return;

      section.querySelectorAll("a").forEach((link) => {
        const card = link.closest("article") || link;

        card.style.setProperty(
          "background-color",
          "#111315",
          "important"
        );
        card.style.setProperty(
          "background-image",
          "none",
          "important"
        );
        card.style.setProperty(
          "border-color",
          "#424a52",
          "important"
        );
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        applySimilarSearches,
        { once: true }
      );
    } else {
      applySimilarSearches();
    }
  })();
</script>
<!-- locus-dark-similar-searches-v2 -->
<script is:inline>
  (() => {
    const updateSimilarSearches = () => {
      const heading = Array.from(
        document.querySelectorAll("h1, h2, h3")
      ).find(
        (element) =>
          element.textContent.replace(/\s+/g, " ").trim() ===
          "Explore Similar Searches"
      );

      const section = heading?.closest("section");
      if (!section) return;

      const dark = document.documentElement.dataset.theme === "dark";

      section.querySelectorAll("a").forEach((link) => {
        const card = link.closest("article") || link;

        if (dark) {
          card.style.setProperty(
            "background-color",
            "#111315",
            "important"
          );
          card.style.setProperty(
            "background-image",
            "none",
            "important"
          );
          card.style.setProperty(
            "border-color",
            "#424a52",
            "important"
          );
        } else {
          card.style.removeProperty("background-color");
          card.style.removeProperty("background-image");
          card.style.removeProperty("border-color");
        }
      });
    };

    const updateDarkHomepageChrome = () => {
      const dark = document.documentElement.dataset.theme === "dark";
      const main = document.querySelector("main.section");
      const search = document.querySelector("#home-hero-search");
      const primary = document.querySelector(".locus-home-market__primary");
      const kicker = document.querySelector(
        ".locus-home-market__intel .locus-home-section-kicker"
      );
      const cta = document.querySelector(
        ".locus-home-market__intel > div > a"
      );

      if (dark) {
        main?.style.setProperty(
          "background-color",
          "#111315",
          "important"
        );
        search?.style.setProperty("border-radius", "18px", "important");
        search?.style.setProperty(
          "background-color",
          "#252a2e",
          "important"
        );
        search?.style.setProperty(
          "border-color",
          "#394149",
          "important"
        );

        primary?.style.setProperty(
          "background-color",
          "var(--accent)",
          "important"
        );
        primary?.style.setProperty(
          "border-color",
          "var(--accent)",
          "important"
        );
        primary?.querySelectorAll("span, strong, small").forEach((el) => {
          el.style.setProperty("color", "#fff", "important");
        });

        kicker?.style.setProperty("color", "var(--accent)", "important");
        cta?.style.setProperty(
          "background-color",
          "var(--accent)",
          "important"
        );
        cta?.style.setProperty(
          "border-color",
          "var(--accent)",
          "important"
        );
        cta?.style.setProperty("color", "#fff", "important");
        return;
      }

      main?.style.removeProperty("background-color");
      search?.style.removeProperty("border-radius");
      search?.style.removeProperty("background-color");
      search?.style.removeProperty("border-color");

      [primary, kicker, cta].filter(Boolean).forEach((el) => {
        el.style.removeProperty("background-color");
        el.style.removeProperty("border-color");
        el.style.removeProperty("color");
      });

      primary?.querySelectorAll("span, strong, small").forEach((el) => {
        el.style.removeProperty("color");
      });
    };

    const updateSearchDockState = () => {
      document
        .querySelector("#home-hero-search")
        ?.classList.remove("is-docked");
    };

    const updateThemeSurfaces = () => {
      updateSimilarSearches();
      updateDarkHomepageChrome();
      updateSearchDockState();
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        updateThemeSurfaces,
        { once: true }
      );
    } else {
      updateThemeSurfaces();
    }

    new MutationObserver(updateThemeSurfaces).observe(
      document.documentElement,
      { attributes: true, attributeFilter: ["data-theme"] }
    );

    window.addEventListener(
      "scroll",
      updateSearchDockState,
      { passive: true }
    );
    window.addEventListener("resize", updateSearchDockState);
  })();
</script>
<!-- locus-similar-search-hover-v1 -->
<script is:inline>
  (() => {
    const markSimilarSearchCards = () => {
      const heading = Array.from(
        document.querySelectorAll("h1, h2, h3")
      ).find(
        (element) =>
          element.textContent.replace(/\s+/g, " ").trim() ===
          "Explore Similar Searches"
      );

      heading?.closest("section")
        ?.querySelectorAll("a")
        .forEach((link) => {
          (link.closest("article") || link)
            .classList.add("locus-similar-search-card");
        });
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        markSimilarSearchCards,
        { once: true }
      );
    } else {
      markSimilarSearchCards();
    }
  })();
</script>
<!-- locus-similar-search-hover-v2 -->
<script is:inline>
  (() => {
    const addSimilarSearchHover = () => {
      const heading = Array.from(
        document.querySelectorAll("h1, h2, h3")
      ).find(
        (element) =>
          element.textContent.replace(/\s+/g, " ").trim() ===
          "Explore Similar Searches"
      );

      if (!heading) return;

      let scope = heading.parentElement;
      let links = [];

      while (scope && scope !== document.body) {
        links = Array.from(scope.querySelectorAll("a")).filter((link) => {
          const box = link.getBoundingClientRect();
          return box.width > 160 && box.height > 100;
        });

        if (links.length >= 4) break;
        scope = scope.parentElement;
      }

      links.forEach((link) => {
        if (link.dataset.locusSimilarHover === "true") return;

        const article = link.closest("article");
        const card =
          article &&
          article.getBoundingClientRect().width > 160 &&
          article.getBoundingClientRect().height > 100
            ? article
            : link;

        card.dataset.locusSimilarHover = "true";
        card.style.cursor = "pointer";
        card.style.transition =
          "transform .18s ease, box-shadow .18s ease, border-color .18s ease";

        const activate = () => {
          const dark =
            document.documentElement.dataset.theme === "dark";

          card.style.setProperty(
            "transform",
            "translateY(-5px)",
            "important"
          );
          card.style.setProperty(
            "border-color",
            dark ? "#a7b1ba" : "#7a8792",
            "important"
          );
          card.style.setProperty(
            "box-shadow",
            dark
              ? "0 0 0 1px rgba(205, 216, 225, .20), 0 0 30px color-mix(in srgb, var(--accent) 48%, transparent), 0 18px 38px rgba(0, 0, 0, .58), inset 0 1px 0 rgba(255, 255, 255, .055)"
              : "0 14px 30px rgba(0, 0, 0, .34)",
            "important"
          );

          if (dark) {
            card.style.setProperty(
              "background-color",
              "#181c20",
              "important"
            );
          }
        };

        const deactivate = () => {
          const dark =
            document.documentElement.dataset.theme === "dark";

          card.style.removeProperty("transform");
          card.style.removeProperty("border-color");
          card.style.removeProperty("box-shadow");

          if (dark) {
            card.style.setProperty(
              "background-color",
              "#111315",
              "important"
            );
          } else {
            card.style.removeProperty("background-color");
          }
        };

        card.addEventListener("mouseenter", activate);
        card.addEventListener("mouseleave", deactivate);
        card.addEventListener("focusin", activate);
        card.addEventListener("focusout", deactivate);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        addSimilarSearchHover,
        { once: true }
      );
    } else {
      addSimilarSearchHover();
    }
  })();
</script>
<!-- docked-more-filters-panel-rail-v3 -->
<script is:inline>
  (() => {
    const alignDockedMoreFilters = () => {
      const rail = document.querySelector(".listing-filter-rail");
      const panel = rail?.querySelector("#type-more-filters");

      if (!panel) return;

      panel.style.setProperty(
        "width",
        "min(1400px, calc(100vw - 80px))",
        "important"
      );
      panel.style.setProperty("max-width", "1400px", "important");
      panel.style.setProperty("margin-left", "auto", "important");
      panel.style.setProperty("margin-right", "auto", "important");
      panel.style.setProperty("padding-left", "24px", "important");
      panel.style.setProperty("padding-right", "24px", "important");

      const grid = panel.querySelector(".type-more-filters-grid");
      if (!grid) return;

      grid.style.setProperty("box-sizing", "border-box", "important");
      grid.style.setProperty("width", "100%", "important");
      grid.style.setProperty("max-width", "none", "important");
      grid.style.setProperty("margin-left", "0", "important");
      grid.style.setProperty("margin-right", "0", "important");
    };

    const queueAlignment = () => {
      requestAnimationFrame(alignDockedMoreFilters);
    };

    new MutationObserver(queueAlignment).observe(document.body, {
      childList: true,
      subtree: true
    });

    window.addEventListener("resize", queueAlignment, { passive: true });
    queueAlignment();
  })();
</script>

<!-- docked-more-filters-square-top-v1 -->
<script is:inline>
  (() => {
    const squareDockedFilterTop = () => {
      const rail = document.querySelector(".listing-filter-rail");
      if (!rail) return;

      const controls = rail.querySelector(
        "#listing-results-anchor.intent-controls"
      );
      const panel = rail.querySelector("#type-more-filters");

      for (const element of [controls, panel]) {
        if (!element) continue;

        element.style.setProperty(
          "border-top-left-radius",
          "0",
          "important"
        );
        element.style.setProperty(
          "border-top-right-radius",
          "0",
          "important"
        );
      }
    };

    const queueSquareTop = () => {
      requestAnimationFrame(squareDockedFilterTop);
    };

    new MutationObserver(queueSquareTop).observe(document.body, {
      childList: true,
      subtree: true
    });

    window.addEventListener("resize", queueSquareTop, { passive: true });
    queueSquareTop();
  })();
</script>

<!-- docked-home-filter-rail-v2 -->
<script is:inline>
  (() => {
    const allFormProperties = [
      "box-sizing",
      "min-width",
      "width",
      "max-width",
      "margin",
      "background",
      "border",
      "border-bottom",
      "box-shadow",
      "border-top-left-radius",
      "border-top-right-radius",
      "border-bottom-left-radius",
      "border-bottom-right-radius",
    ];

    const visualFormProperties = [
      "background",
      "border",
      "border-bottom",
      "box-shadow",
      "border-top-left-radius",
      "border-top-right-radius",
      "border-bottom-left-radius",
      "border-bottom-right-radius",
    ];

    const allPanelProperties = [
      "box-sizing",
      "width",
      "max-width",
      "margin-top",
      "background",
      "border",
      "border-top",
      "box-shadow",
      "border-top-left-radius",
      "border-top-right-radius",
      "border-bottom-left-radius",
      "border-bottom-right-radius",
    ];

    const visualPanelProperties = [
      "background",
      "border",
      "border-top",
      "box-shadow",
      "border-top-left-radius",
      "border-top-right-radius",
      "border-bottom-left-radius",
      "border-bottom-right-radius",
    ];

    const railProperties = [
      "background",
      "padding",
      "border",
      "box-shadow",
    ];

    const removeProperties = (element, properties) => {
      properties.forEach((property) =>
        element.style.removeProperty(property)
      );
    };

    const set = (element, property, value) => {
      element.style.setProperty(property, value, "important");
