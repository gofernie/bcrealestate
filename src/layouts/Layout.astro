    if (!lab) return;
    const val = lab.nextElementSibling;
    const txt = (val.textContent || "").trim().toLowerCase();
    const on = pickedAreas().length > 0 || (txt && !/^all\s*neigh/.test(txt));
    /* area-pill-v2 */
