---
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  accentColor?: string;
  city?: string;
  site?: any;
}
const { title, accentColor = "#2f6f73", city = "nanaimo", site = null } = Astro.props;
---
<!doctype html>
<html lang="en" style={`--accent: ${accentColor};`} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      try {
        localStorage.removeItem("locus-theme");
      } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
<title>{title ?? "Astro Basics"}</title>
    <slot name="head" />
  <style is:global>
/* locus-native-controls-dark-v1 */
html[data-theme="dark"] {
  color-scheme: dark;
}

html[data-theme="light"] {
  color-scheme: light;
}
</style><style is:global>
/* locus-home-search-uniform-bg-v1 */
html[data-theme="dark"] .locus-home-search,
html[data-theme="dark"] .locus-home-search__field,
html[data-theme="dark"] .locus-home-search .area-multiselect,
html[data-theme="dark"] .locus-home-search .area-multiselect__trigger,
html[data-theme="dark"] .locus-home-search .locus-home-more-toggle,
html[data-theme="dark"] .locus-home-search .locus-home-search__popular {
  background: #1d2125 !important;
}
</style><style is:global>
/* locus-global-charcoal-cards */
html[data-theme="dark"] [data-listing-id] {
  background: #1b1e21 !important;
  border-color: #394149 !important;
}
/* /locus-global-charcoal-cards */
</style>
<style is:global>
/* locus-dark-search-lighter-v1 */
html[data-theme="dark"] #home-hero-search {
  background: #202428 !important;
  border-color: #3b434a !important;
}
  /* locus-dark-search-unify-v1 */
  html[data-theme="dark"] #home-hero-search :is(
    .locus-home-search__field,
    .locus-home-search__popular,
    .area-multiselect__trigger,
    .locus-home-more-toggle
  ) {
    background: #202428 !important;
  }
  /* /locus-dark-search-unify-v1 */
/* /locus-dark-search-lighter-v1 */
</style>
<style is:global>
/* locus-dark-search-dropdowns-v1 */
html[data-theme="dark"] #home-hero-search select,
html[data-theme="dark"] #home-hero-search select option,
html[data-theme="dark"] #home-hero-search .area-multiselect__menu,
html[data-theme="dark"] #home-hero-search .area-multiselect__option {
  background: #252a2e !important;
  color: #edf1f3 !important;
  border-color: #49535c !important;
}

html[data-theme="dark"] #home-hero-search .area-multiselect__option:hover,
html[data-theme="dark"] #home-hero-search .area-multiselect__option.is-selected {
  background: #30363b !important;
  color: #ffffff !important;
}

html[data-theme="dark"] #home-hero-search .area-multiselect__check {
  color: #edf1f3 !important;
}
/* /locus-dark-search-dropdowns-v1 */
</style><style>
/* locus-dark-load-more-v1 */
html[data-theme="dark"] #home-load-more.home-load-more-btn {
  background: #111315 !important;
  border-color: #394149 !important;
  color: #f3f5f6 !important;
  box-shadow: none !important;
}

html[data-theme="dark"] #home-load-more.home-load-more-btn:hover {
  background: #202428 !important;
  border-color: var(--accent) !important;
}
</style>
</head>

<body data-google-maps-api-key={import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || ""}>
    <slot />
    <SiteFooter site={site} city={city} />
    <nav
      class="mobile-bottom-nav"
      aria-label="Mobile navigation"
    >
      <a
        class="mobile-bottom-nav__item"
        href={`/${city}`}
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 11l9-8 9 8" />
          <path d="M5 10v10h14V10" />
          <path d="M9 20v-6h6v6" />
        </svg>
        <span>Browse</span>
      </a>

      <button
        class="mobile-bottom-nav__item"
        id="mobile-results-map-btn"
        type="button"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0z" />
          <circle cx="12" cy="10" r="2.5" />
        </svg>
        <span>Map</span>
      </button>

      <button
        class="mobile-bottom-nav__item"
        id="mobile-saved-btn"
        type="button"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l7.78-7.78a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
        <span>Saved</span>
      </button>

      <button
        class="mobile-bottom-nav__item"
        id="mobile-alerts-btn"
        type="button"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
          <path d="M10 21h4" />
        </svg>
        <span>Alerts</span>
      </button>
    </nav>

    <script is:inline define:vars={{ city }}>
      const openMobileMap = () => {
        const mapButton =
          document.getElementById("map-view-btn");

        if (mapButton) {
          mapButton.click();
          mapButton.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
          return;
        }

        window.location.href =
          `/${city}?view=map`;
      };

      const openMobileAlerts = () => {
        const alertButton =
          document.getElementById(
            "hero-save-search-btn"
          ) ||
          document.getElementById(
            "save-search-btn"
          ) ||
          document.querySelector(
            "[data-slug-save-open]"
          );

        if (alertButton) {
          alertButton.click();
          alertButton.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
          return;
        }

        window.location.href =
          `/${city}?alerts=1`;
      };

      document
        .getElementById("mobile-results-map-btn")
        ?.addEventListener(
          "click",
          openMobileMap
        );

      document
        .getElementById("mobile-saved-btn")
        ?.addEventListener(
          "click",
          () => {
            document
              .getElementById("shortlist-modal")
              ?.removeAttribute("hidden");
          }
        );

      document
        .getElementById("mobile-alerts-btn")
        ?.addEventListener(
          "click",
          openMobileAlerts
        );

      window.addEventListener(
        "DOMContentLoaded",
        () => {
          const params =
            new URLSearchParams(
              window.location.search
            );

          if (params.get("view") === "map") {
            window.setTimeout(
              openMobileMap,
              150
            );
          }

          if (params.get("alerts") === "1") {
            window.setTimeout(
              openMobileAlerts,
              150
            );
          }
        }
      );
    </script>
  
<script is:inline>
/* locus-hide-duplicate-intent-selects-v1 */
(() => {
  const hideDuplicates = () => {
    document.querySelectorAll(".intent-controls").forEach((controls) => {
      if (!controls.querySelector(".filter-dd")) return;

      controls.querySelectorAll("select").forEach((select) => {
        if (select.closest(".filter-dd")) return;
        select.hidden = true;
        select.setAttribute("aria-hidden", "true");
        select.tabIndex = -1;
      });
    });
  };

  window.addEventListener("DOMContentLoaded", () => setTimeout(hideDuplicates, 0));
  window.addEventListener("pageshow", () => setTimeout(hideDuplicates, 0));
})();
</script>
<!-- locus-dark-similar-searches-v1 -->
<script is:inline>
  (() => {
    const applySimilarSearches = () => {
      if (document.documentElement.dataset.theme !== "dark") return;

      const heading = Array.from(
        document.querySelectorAll("h1, h2, h3")
      ).find(
        (element) =>
          element.textContent.replace(/\s+/g, " ").trim() ===
          "Explore Similar Searches"
      );

      const section = heading?.closest("section");
      if (!section) return;

      section.querySelectorAll("a").forEach((link) => {
        const card = link.closest("article") || link;

        card.style.setProperty(
          "background-color",
          "#111315",
          "important"
        );
        card.style.setProperty(
          "background-image",
          "none",
          "important"
        );
        card.style.setProperty(
          "border-color",
          "#424a52",
          "important"
        );
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        applySimilarSearches,
        { once: true }
      );
    } else {
      applySimilarSearches();
    }
  })();
</script>
<!-- locus-dark-similar-searches-v2 -->
<script is:inline>
  (() => {
    const updateSimilarSearches = () => {
      const heading = Array.from(
        document.querySelectorAll("h1, h2, h3")
      ).find(
        (element) =>
          element.textContent.replace(/\s+/g, " ").trim() ===
          "Explore Similar Searches"
      );

      const section = heading?.closest("section");
      if (!section) return;

      const dark = document.documentElement.dataset.theme === "dark";

      section.querySelectorAll("a").forEach((link) => {
        const card = link.closest("article") || link;

        if (dark) {
          card.style.setProperty(
            "background-color",
            "#111315",
            "important"
          );
          card.style.setProperty(
            "background-image",
            "none",
            "important"
          );
          card.style.setProperty(
            "border-color",
            "#424a52",
            "important"
          );
        } else {
          card.style.removeProperty("background-color");
          card.style.removeProperty("background-image");
          card.style.removeProperty("border-color");
        }
      });
    };

    const updateDarkHomepageChrome = () => {
      const dark = document.documentElement.dataset.theme === "dark";
      const main = document.querySelector("main.section");
      const search = document.querySelector("#home-hero-search");
      const primary = document.querySelector(".locus-home-market__primary");
      const kicker = document.querySelector(
        ".locus-home-market__intel .locus-home-section-kicker"
      );
      const cta = document.querySelector(
        ".locus-home-market__intel > div > a"
      );

      if (dark) {
        main?.style.setProperty(
          "background-color",
          "#111315",
          "important"
        );
        search?.style.setProperty("border-radius", "18px", "important");
        search?.style.setProperty(
          "background-color",
          "#252a2e",
          "important"
        );
        search?.style.setProperty(
          "border-color",
          "#394149",
          "important"
        );

        primary?.style.setProperty(
          "background-color",
          "var(--accent)",
          "important"
        );
        primary?.style.setProperty(
          "border-color",
          "var(--accent)",
          "important"
        );
        primary?.querySelectorAll("span, strong, small").forEach((el) => {
          el.style.setProperty("color", "#fff", "important");
        });

        kicker?.style.setProperty("color", "var(--accent)", "important");
        cta?.style.setProperty(
          "background-color",
          "var(--accent)",
          "important"
        );
        cta?.style.setProperty(
          "border-color",
          "var(--accent)",
          "important"
        );
        cta?.style.setProperty("color", "#fff", "important");
        return;
      }

      main?.style.removeProperty("background-color");
      search?.style.removeProperty("border-radius");
      search?.style.removeProperty("background-color");
      search?.style.removeProperty("border-color");

      [primary, kicker, cta].filter(Boolean).forEach((el) => {
        el.style.removeProperty("background-color");
        el.style.removeProperty("border-color");
        el.style.removeProperty("color");
      });

      primary?.querySelectorAll("span, strong, small").forEach((el) => {
        el.style.removeProperty("color");
      });
    };

    const updateSearchDockState = () => {
      document
        .querySelector("#home-hero-search")
        ?.classList.remove("is-docked");
    };

    const updateThemeSurfaces = () => {
      updateSimilarSearches();
      updateDarkHomepageChrome();
      updateSearchDockState();
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        updateThemeSurfaces,
        { once: true }
      );
    } else {
      updateThemeSurfaces();
    }

    new MutationObserver(updateThemeSurfaces).observe(
      document.documentElement,
      { attributes: true, attributeFilter: ["data-theme"] }
    );

    window.addEventListener(
      "scroll",
      updateSearchDockState,
      { passive: true }
    );
    window.addEventListener("resize", updateSearchDockState);
  })();
</script>
<!-- locus-similar-search-hover-v1 -->
<script is:inline>
  (() => {
    const markSimilarSearchCards = () => {
      const heading = Array.from(
        document.querySelectorAll("h1, h2, h3")
      ).find(
        (element) =>
          element.textContent.replace(/\s+/g, " ").trim() ===
          "Explore Similar Searches"
      );

      heading?.closest("section")
        ?.querySelectorAll("a")
        .forEach((link) => {
          (link.closest("article") || link)
            .classList.add("locus-similar-search-card");
        });
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        markSimilarSearchCards,
        { once: true }
      );
    } else {
      markSimilarSearchCards();
    }
  })();
</script>
<!-- locus-similar-search-hover-v2 -->
<script is:inline>
  (() => {
    const addSimilarSearchHover = () => {
      const heading = Array.from(
        document.querySelectorAll("h1, h2, h3")
      ).find(
        (element) =>
          element.textContent.replace(/\s+/g, " ").trim() ===
          "Explore Similar Searches"
      );

      if (!heading) return;

      let scope = heading.parentElement;
      let links = [];

      while (scope && scope !== document.body) {
        links = Array.from(scope.querySelectorAll("a")).filter((link) => {
          const box = link.getBoundingClientRect();
          return box.width > 160 && box.height > 100;
        });

        if (links.length >= 4) break;
        scope = scope.parentElement;
      }

      links.forEach((link) => {
        if (link.dataset.locusSimilarHover === "true") return;

        const article = link.closest("article");
        const card =
          article &&
          article.getBoundingClientRect().width > 160 &&
          article.getBoundingClientRect().height > 100
            ? article
            : link;

        card.dataset.locusSimilarHover = "true";
        card.style.cursor = "pointer";
        card.style.transition =
          "transform .18s ease, box-shadow .18s ease, border-color .18s ease";

        const activate = () => {
          const dark =
            document.documentElement.dataset.theme === "dark";

          card.style.setProperty(
            "transform",
            "translateY(-5px)",
            "important"
          );
          card.style.setProperty(
            "border-color",
            dark ? "#a7b1ba" : "#7a8792",
            "important"
          );
          card.style.setProperty(
            "box-shadow",
            dark
              ? "0 0 0 1px rgba(205, 216, 225, .20), 0 0 30px color-mix(in srgb, var(--accent) 48%, transparent), 0 18px 38px rgba(0, 0, 0, .58), inset 0 1px 0 rgba(255, 255, 255, .055)"
              : "0 14px 30px rgba(0, 0, 0, .34)",
            "important"
          );

          if (dark) {
            card.style.setProperty(
              "background-color",
              "#181c20",
              "important"
            );
          }
        };

        const deactivate = () => {
          const dark =
            document.documentElement.dataset.theme === "dark";

          card.style.removeProperty("transform");
          card.style.removeProperty("border-color");
          card.style.removeProperty("box-shadow");

          if (dark) {
            card.style.setProperty(
              "background-color",
              "#111315",
              "important"
            );
          } else {
            card.style.removeProperty("background-color");
          }
        };

        card.addEventListener("mouseenter", activate);
        card.addEventListener("mouseleave", deactivate);
        card.addEventListener("focusin", activate);
        card.addEventListener("focusout", deactivate);
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        addSimilarSearchHover,
        { once: true }
      );
    } else {
      addSimilarSearchHover();
    }
  })();
</script></body>
</html>

<style is:global>
  :root {
   /* Derived colours */
    --accent-light: color-mix(in srgb, var(--accent) 35%, white);
 --accent-soft: color-mix(in srgb, var(--accent) 12%, white);

/* Theme-aware surfaces */
--surface: color-mix(in srgb, var(--accent) 1.5%, white);
--bg: color-mix(in srgb, var(--accent) 2%, #faf9f7);
    /* Cards & sections */
    --card-bg: #ffffff;
    --card-soft: color-mix(in srgb, var(--accent) 4%, white);
--section-bg: color-mix(in srgb, var(--accent) 1%, #fdfcfb);
    /* Typography */
    --ink: #1c1917;
    --muted: #6b6560;

    /* Borders */
    --line: color-mix(in srgb, var(--accent) 10%, #dcdcdc);
    --line-warm: color-mix(in srgb, var(--accent) 16%, #d0d0d0);
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  a {
    color: inherit;
  }

  button,
  select,
  input,
  textarea {
    font: inherit;
  }

  .accent-bg {
    background: var(--accent);
    color: white;
  }

  .accent-text {
    color: var(--accent);
  }

.accent-soft {
    background: var(--accent-soft);
  }

  .mobile-bottom-nav {
    display: none;
  }

  @media (max-width: 760px) {
    .mobile-bottom-nav {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: color-mix(in srgb, var(--surface) 96%, transparent);
      backdrop-filter: blur(14px);
      border-top: 1px solid var(--line);
      padding-bottom: env(safe-area-inset-bottom);
    }

    .mobile-bottom-nav__item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 10px 0;
      color: var(--muted);
      font-size: 0.7rem;
      font-weight: 700;
      text-decoration: none;
      background: none;
      border: none;
      cursor: pointer;
      transition: color 0.15s ease;
    }

    .mobile-bottom-nav__item:hover,
    .mobile-bottom-nav__item.active {
      color: var(--accent);
    }

    body {
      padding-bottom: calc(64px + env(safe-area-inset-bottom));
    }
  }

  /* locus-theme-dark-v1 */
  :root[data-theme="dark"] {
    color-scheme: dark;
    --accent-light: color-mix(in srgb, var(--accent) 68%, white);
    --accent-soft: color-mix(in srgb, var(--accent) 22%, #17191b);

    --surface: #17191b;
    --bg: #111315;
    --card-bg: #1b1e21;
    --card-soft: #202428;
    --section-bg: #17191b;

    --ink: #f4f6f9;
    --muted: #afbdcb;

    --line: rgba(162, 190, 214, 0.20);
    --line-warm: rgba(180, 205, 224, 0.30);
  }

  /* Maps deliberately remain light in both themes. */
  :root[data-theme="dark"] .leaflet-container {
    background: #dbe5ec;
    color: #1d2935;
  }

  :root[data-theme="dark"] .leaflet-control,
  :root[data-theme="dark"] .leaflet-bar a,
  :root[data-theme="dark"] .leaflet-popup-content-wrapper,
  :root[data-theme="dark"] .leaflet-popup-tip {
    background: #fff;
    color: #1d2935;
  }
  /* locus-dark-listing-cards-v1 */
  :root[data-theme="dark"] :is(
    .listing-card,
    .listing-card__body,
    .listing-card__content,
    .listing-card__details,
    [data-listing-id]
  ) {
    background: var(--card-bg) !important;
    border-color: var(--line) !important;
    color: var(--ink) !important;
  }

  :root[data-theme="dark"] :is(
    .listing-card,
    [data-listing-id]
  ) :is(h1, h2, h3, h4, strong, b) {
    color: var(--ink) !important;
  }

  :root[data-theme="dark"] :is(
    .listing-card,
    [data-listing-id]
  ) :is(p, small, span, address) {
    color: var(--muted) !important;
  }

  :root[data-theme="dark"] :is(
    .listing-card,
    [data-listing-id]
  ) img {
    color: initial !important;
  }
  /* locus-dark-card-body-v1 */
  :root[data-theme="dark"] :is(
    .card.original-card,
    .card.refined-card,
    .explorer-card,
    .grid > .card
  ) {
    background: var(--card-bg) !important;
    border-color: var(--line) !important;
  }

  :root[data-theme="dark"] :is(
    .card-body,
    .card-content,
    .listing-card__body,
    .explorer-card__body
  ) {
    background: var(--card-bg) !important;
    color: var(--ink) !important;
  }

  :root[data-theme="dark"] :is(
    .card-body,
    .card-content,
    .listing-card__body,
    .explorer-card__body
  ) :is(.price, .card-price, .address, .card-address, h2, h3, h4, strong) {
    color: var(--ink) !important;
  }

  :root[data-theme="dark"] :is(
    .card-body,
    .card-content,
    .listing-card__body,
    .explorer-card__body
  ) :is(.meta, .card-meta, .card-brokerage, p, span, small) {
    color: var(--muted) !important;
  }
  /* locus-dark-home-grid-cards-v1 */
  html[data-theme="dark"] .home-results-experience .grid > .card,
  html[data-theme="dark"] .home-results-experience .grid > .card.original-card,
