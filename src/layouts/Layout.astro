<script is:inline>
(() => {
  /* filter-counts-v2 */
  const range = (v) => {
    v = String(v || "");
    let m = v.match(/^under-(\d+)$/); if (m) return [0, +m[1] * 1000];
    m = v.match(/^(\d+)-plus$/); if (m) return [+m[1] * 1000, Infinity];
    m = v.match(/^(\d+)-(\d+)$/); if (m) return [+m[1] * 1000, +m[2] * 1000];
    return null;
  };
  const DIMS = { type: "type-filter-select", price: "price-filter-select", beds: "beds-filter-select", baths: "baths-filter-select" };
  const test = (dim, val, f) => {
    if (!val || val === "all" || val === "any") return true;
    if (dim === "type") return f[3] === val;
    if (dim === "price") { const r = range(val); return !r || (f[0] >= r[0] && f[0] <= r[1]); }
    if (dim === "beds") return +val >= 4 ? f[1] >= +val : f[1] === +val;
    if (dim === "baths") return f[2] >= +val;
    return true;
  };
  const nrm = (s) => String(s || "").replace(/\u2713/g, "").toLowerCase().replace(/^(feru|fe|se|sw|pq|na|ob)\s*-\s*/, "").replace(/-(neighbourhood|neighborhood|area)$/, "").replace(/[0-9]+/g, " ").replace(/[^a-z]+/g, " ").trim();
  const raw = () => (Array.isArray(window.__filterFacts) ? window.__filterFacts : []);
  const pickedAreas = () => new URLSearchParams(location.search).getAll("area").flatMap((v) => v.split(",")).map(nrm).filter((v) => v && v !== "all" && v !== "all neighbourhoods");
  const currentVals = () => { const c = {}; for (const [dim, cls] of Object.entries(DIMS)) { const s = document.querySelector("select." + cls); c[dim] = s ? s.value : "all"; } return c; };
  const update = () => {
    if (!raw().length) return;
    const picked = pickedAreas();
    const facts = picked.length ? raw().filter((f) => picked.includes(nrm(f[4]))) : raw();
    const current = currentVals();
    for (const [dim, cls] of Object.entries(DIMS)) {
      const s = document.querySelector("select." + cls); const dd = s && s.nextElementSibling;
      if (!dd || !dd.classList.contains("filter-dd")) continue;
      const base = facts.filter((f) => Object.keys(DIMS).every((d) => d === dim || test(d, current[d], f)));
      dd.querySelectorAll(".filter-dd__option[data-value]").forEach((opt) => {
        const n = base.filter((f) => test(dim, opt.dataset.value, f)).length;
        let el = opt.querySelector(".filter-dd__count");
        if (!el) { el = document.createElement("span"); el.className = "filter-dd__count"; const check = opt.querySelector(".filter-dd__check"); opt.insertBefore(el, check || null); }
        el.textContent = String(n);
        opt.classList.toggle("is-empty", n === 0);
      });
    }
  };
  const updateAreas = () => {
    if (!raw().length) return;
    const current = currentVals();
    const base = raw().filter((f) => Object.keys(DIMS).every((d) => test(d, current[d], f)));
    const allOpt = [...document.querySelectorAll("button, li, label, a, div, [role=option]")].find((e) => nrm(e.dataset.areaLabel || e.textContent) === "all neighbourhoods" && e.children.length <= 3 && e.parentElement && e.parentElement.children.length > 2);
    if (!allOpt) return;
    [...allOpt.parentElement.children].forEach((opt) => {
      let el = opt.querySelector(".filter-dd__count");
      if (!opt.dataset.areaLabel) opt.dataset.areaLabel = (opt.textContent || "").replace(el ? el.textContent : "", "").trim();
      const key = nrm(opt.dataset.areaLabel);
      if (!key) return;
      const n = key === "all neighbourhoods" ? base.length : base.filter((f) => nrm(f[4]) === key).length;
      if (!el) { el = document.createElement("span"); el.className = "filter-dd__count"; opt.appendChild(el); }
      opt.classList.add("area-count-opt");
      el.textContent = String(n);
      opt.classList.toggle("is-empty", n === 0);
