---
interface Props {
  title?: string;
  accentColor?: string;
  city?: string;
}
const { title, accentColor = "#2f6f73", city = "nanaimo" } = Astro.props;
---
<!doctype html>
<html lang="en" style={`--accent: ${accentColor};`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
<title>{title ?? "Astro Basics"}</title>
    <slot name="head" />
  </head>

<body data-google-maps-api-key={import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || ""}>
    <slot />
    <nav
      class="mobile-bottom-nav"
      aria-label="Mobile navigation"
    >
      <a
        class="mobile-bottom-nav__item"
        href={`/${city}`}
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 11l9-8 9 8" />
          <path d="M5 10v10h14V10" />
          <path d="M9 20v-6h6v6" />
        </svg>
        <span>Browse</span>
      </a>

      <button
        class="mobile-bottom-nav__item"
        id="mobile-results-map-btn"
        type="button"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0z" />
          <circle cx="12" cy="10" r="2.5" />
        </svg>
        <span>Map</span>
      </button>

      <button
        class="mobile-bottom-nav__item"
        id="mobile-saved-btn"
        type="button"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l7.78-7.78a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
        <span>Saved</span>
      </button>

      <button
        class="mobile-bottom-nav__item"
        id="mobile-alerts-btn"
        type="button"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
          <path d="M10 21h4" />
        </svg>
        <span>Alerts</span>
      </button>
    </nav>

    <script is:inline define:vars={{ city }}>
      const openMobileMap = () => {
        const mapButton =
          document.getElementById("map-view-btn");

        if (mapButton) {
          mapButton.click();
          mapButton.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
          return;
        }

        window.location.href =
          `/${city}?view=map`;
      };

      const openMobileAlerts = () => {
        const alertButton =
          document.getElementById(
            "hero-save-search-btn"
          ) ||
          document.getElementById(
            "save-search-btn"
          ) ||
          document.querySelector(
            "[data-slug-save-open]"
          );

        if (alertButton) {
          alertButton.click();
          alertButton.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });
          return;
        }

        window.location.href =
          `/${city}?alerts=1`;
      };

      document
        .getElementById("mobile-results-map-btn")
        ?.addEventListener(
          "click",
          openMobileMap
        );

      document
        .getElementById("mobile-saved-btn")
        ?.addEventListener(
          "click",
          () => {
            document
              .getElementById("shortlist-modal")
              ?.removeAttribute("hidden");
          }
        );

      document
        .getElementById("mobile-alerts-btn")
        ?.addEventListener(
          "click",
          openMobileAlerts
        );

      window.addEventListener(
        "DOMContentLoaded",
        () => {
          const params =
            new URLSearchParams(
              window.location.search
            );

          if (params.get("view") === "map") {
            window.setTimeout(
              openMobileMap,
              150
            );
          }

          if (params.get("alerts") === "1") {
            window.setTimeout(
              openMobileAlerts,
              150
            );
          }
        }
      );
    </script>
  </body>
</html>

<style is:global>
  :root {
   /* Derived colours */
    --accent-light: color-mix(in srgb, var(--accent) 35%, white);
 --accent-soft: color-mix(in srgb, var(--accent) 12%, white);

/* Theme-aware surfaces */
--surface: color-mix(in srgb, var(--accent) 1.5%, white);
--bg: color-mix(in srgb, var(--accent) 2%, #faf9f7);
    /* Cards & sections */
    --card-bg: #ffffff;
    --card-soft: color-mix(in srgb, var(--accent) 4%, white);
--section-bg: color-mix(in srgb, var(--accent) 1%, #fdfcfb);
    /* Typography */
    --ink: #1c1917;
    --muted: #6b6560;

    /* Borders */
    --line: color-mix(in srgb, var(--accent) 10%, #dcdcdc);
    --line-warm: color-mix(in srgb, var(--accent) 16%, #d0d0d0);
  }

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  a {
    color: inherit;
  }

  button,
  select,
  input,
  textarea {
    font: inherit;
  }

  .accent-bg {
    background: var(--accent);
    color: white;
  }

  .accent-text {
    color: var(--accent);
  }

.accent-soft {
    background: var(--accent-soft);
  }

  .mobile-bottom-nav {
    display: none;
  }

  @media (max-width: 760px) {
    .mobile-bottom-nav {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: color-mix(in srgb, var(--surface) 96%, transparent);
      backdrop-filter: blur(14px);
      border-top: 1px solid var(--line);
      padding-bottom: env(safe-area-inset-bottom);
    }

    .mobile-bottom-nav__item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 10px 0;
      color: var(--muted);
      font-size: 0.7rem;
      font-weight: 700;
      text-decoration: none;
      background: none;
      border: none;
      cursor: pointer;
      transition: color 0.15s ease;
    }

    .mobile-bottom-nav__item:hover,
    .mobile-bottom-nav__item.active {
      color: var(--accent);
    }

    body {
      padding-bottom: calc(64px + env(safe-area-inset-bottom));
    }
  }
</style>