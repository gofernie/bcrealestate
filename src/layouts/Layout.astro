  if (!document.getElementById("area-pill-css")) { const st = document.createElement("style"); st.id = "area-pill-css"; st.textContent = ".area-pill-on{display:inline-block !important;width:auto !important;background:#e3efed !important;color:#2b6664 !important;font-weight:700 !important;border-radius:999px !important;padding:2px 8px !important;margin:-2px 0 -2px -8px !important;position:relative !important;top:4px !important;}"; document.head.appendChild(st); }
  /* see-above-count-v1 */
  window.__seeAboveLabel = (ceil, label, budget) => {
