---
import StreetIndexLayout from "../../layouts/StreetIndexLayout.astro";
import { supabase } from "../../lib/supabase";
export const prerender = false;
const q = Astro.url.searchParams.get("siteDomain") === "streetindex.io" ? "?siteDomain=streetindex.io" : "";
const { data: comps } = await supabase.from("market_indexes").select("ticker, name, city")
  .is("prop_type", null).is("area_slug", null).is("parent_ticker", null).order("city");
const tickers = (comps || []).map((c: any) => c.ticker);
const since = new Date(Date.now() - 6 * 864e5).toISOString().slice(0, 10);
const { data: ticks } = tickers.length ? await supabase.from("market_ticks").select("ticker, day, ask_index").in("ticker", tickers).gte("day", since).order("day", { ascending: false }) : { data: [] };
const lastBy = new Map<string, number>();
for (const t of ticks || []) if (!lastBy.has(t.ticker) && t.ask_index) lastBy.set(t.ticker, Number(t.ask_index));
const fmt = (v?: number) => (v == null ? "—" : v >= 1e6 ? `$${(v / 1e6).toFixed(2)}M` : `$${Math.round(v / 1000)}K`);
const markets = (comps || []).map((c: any) => ({ ...c, slug: String(c.city).trim().replace(/\s+/g, "-"), label: String(c.city).replace(/\b\w/g, (ch: string) => ch.toUpperCase()), ask: lastBy.get(c.ticker) }));
---
<StreetIndexLayout title="StreetIndex: B.C. housing markets, indexed" q={q}>
  <section class="si-wrap">
    <p style="font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;margin:0 0 .75rem;">Housing market indexes · updated nightly</p>
    <h1 style="font-family:'Instrument Serif',Georgia,serif;font-weight:400;font-size:clamp(2.6rem,6vw,4.4rem);line-height:1;letter-spacing:-.02em;margin:0 0 1.5rem;">B.C. housing markets, indexed.</h1>
    <input id="si-find" type="search" placeholder="Find a market" style="width:min(420px,100%);padding:10px 14px;font:inherit;border:1px solid #cfd6dd;border-radius:999px;margin-bottom:18px;" />
    <div id="si-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;">
      {markets.map((m: any) => (
        <a href={`/${m.slug}/${q}`} data-name={m.label.toLowerCase()} style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border:1px solid #e3e6ea;border-radius:12px;text-decoration:none;color:inherit;">
          <span><strong style="display:block;">{m.label}</strong><span style="font-size:.8rem;color:#666;">BCRE: {m.ticker}</span></span>
          <span style="font-weight:600;font-variant-numeric:tabular-nums;">{fmt(m.ask)}</span>
        </a>
      ))}
    </div>
  </section>
  <script is:inline>
    const f = document.getElementById('si-find');
    f && f.addEventListener('input', () => { const v = f.value.trim().toLowerCase(); document.querySelectorAll('#si-grid a').forEach((a) => { a.style.display = a.dataset.name.includes(v) ? '' : 'none'; }); });
  </script>
</StreetIndexLayout>