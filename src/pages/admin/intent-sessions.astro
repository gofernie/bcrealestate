      #cmp .cmp-home-info strong { font-size:.88rem; color:#111; }
      #cmp .cmp-home-meta { color:#777; }
      #cmp .cmp-home-why { color:#1f6b60; font-size:.74rem; }
      #cmp .cmp-homes-empty { font-size:.8rem; color:#888; padding:6px 2px; }
          #cmp .cmp-suggest:disabled { opacity:.9; }
      #cmp .cmp-dots { display:inline-flex; gap:3px; margin-left:5px; vertical-align:middle; }
      #cmp .cmp-dots i { width:5px; height:5px; border-radius:50%; background:currentColor; display:block; animation:cmp-wiggle 1s infinite ease-in-out; }
      #cmp .cmp-dots i:nth-child(2) { animation-delay:.15s; }
      #cmp .cmp-dots i:nth-child(3) { animation-delay:.3s; }
      @keyframes cmp-wiggle { 0%, 60%, 100% { transform:translateY(0); opacity:.45; } 30% { transform:translateY(-4px); opacity:1; } }
      #cmp .cmp-hint { font-size:.84rem; color:#1f6b60; background:#f1f7f5; border:1px dashed #c9e6e1; border-radius:8px; padding:10px 12px; line-height:1.45; }
          .cmp-toast { position:fixed; left:50%; bottom:24px; transform:translate(-50%, 16px); background:#111; color:#fff; padding:12px 18px; border-radius:8px; font-size:.9rem; font-weight:600; box-shadow:0 8px 24px rgba(0,0,0,.2); opacity:0; pointer-events:none; transition:opacity .2s, transform .2s; z-index:1100; }
      .cmp-toast.on { opacity:1; transform:translate(-50%, 0); }
      #sent-log .cmp-hist-label { font-size:.68rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em; color:#888; margin-bottom:6px; }
      #sent-log .cmp-hist-row { display:grid; grid-template-columns:64px 84px 1fr; gap:8px; font-size:.82rem; color:#444; padding:5px 0; border-top:1px solid #f0f0f0; }
      #sent-log .cmp-hist-row span:nth-child(2) { text-transform:capitalize; color:#1f6b60; font-weight:600; }
          #cmp .cmp-drafts.stale { opacity:.4; pointer-events:none; transition:opacity .2s; }
    </style>

    <script is:inline>
      (() => {
        const dataEl = document.getElementById("composer-data");
        const cmp = document.getElementById("cmp");
        if (!dataEl || !cmp) return;
        let D; try { D = JSON.parse(dataEl.textContent || "{}"); } catch { return; }
        const $ = (id) => document.getElementById(id);
        const statusEl = $("cmp-status");
        const showToast = (msg) => { let t = document.getElementById("cmp-toast"); if (!t) { t = document.createElement("div"); t.id = "cmp-toast"; t.className = "cmp-toast"; t.setAttribute("role", "status"); document.body.appendChild(t); } t.textContent = msg; t.classList.add("on"); clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove("on"), 4000); };
        let type = "auto", msgType = null, drafts = [];
        const pretty = (c) => String(c || "").replace(/-/g, " ").replace(/\b\w/g, (m) => m.toUpperCase());
        const esc = (s) => String(s || "").replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[ch]));
        const stats = () => { const o = {}; document.querySelectorAll(".stat-cell").forEach((c) => { const l = c.querySelector(".stat-label")?.textContent?.trim(); const n = c.querySelector(".stat-num")?.textContent?.trim(); if (l) o[l] = n; }); return o; };

        async function loadHistory() {
          try {
            const r = await fetch("/admin/api/session-send?session_id=" + encodeURIComponent(D.session_id));
            const j = await r.json();
            const rows = j.messages || [];
            if (!rows.length) return;
            const html = '<div class="cmp-hist-label">Sent to this buyer</div>' + rows.map((m) =>
              '<div class="cmp-hist-row"><span>' + new Date(m.created_at).toLocaleDateString(undefined, { month: "short", day: "numeric" }) +
              "</span><span>" + esc(m.message_type || "email") + "</span><span>" + esc(m.subject) + "</span></div>").join("");
            $("cmp-history").innerHTML = html;
            const strip = document.querySelector(".next-step");
            if (strip) { let box = $("sent-log"); if (!box) { box = document.createElement("div"); box.id = "sent-log"; box.className = "sent-log"; strip.after(box); } box.innerHTML = html; }
          } catch {}
        }

        function open() {
          $("cmp-to").value = D.to || "";
          if (!$("cmp-subject").value) $("cmp-subject").value = "Your home search in " + pretty(D.city);
          statusEl.textContent = "";
          cmp.hidden = false; document.body.style.overflow = "hidden";
        }
        function close() { cmp.hidden = true; document.body.style.overflow = ""; }

        document.querySelectorAll("[data-compose]").forEach((a) => a.addEventListener("click", (e) => { if (!D.to) return; e.preventDefault(); open(); }));
        cmp.querySelectorAll("[data-close]").forEach((b) => b.addEventListener("click", close));
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !cmp.hidden) close(); });

        $("cmp-chips").addEventListener("click", (e) => {
          const b = e.target.closest("button[data-type]"); if (!b) return;
          type = b.dataset.type;
          $("cmp-chips").querySelectorAll("button").forEach((x) => x.classList.toggle("on", x === b));
        });

        $("cmp-suggest").addEventListener("click", async () => {
          const btn = $("cmp-suggest"); $("cmp-drafts").classList.remove("stale"); btn.disabled = true; btn.innerHTML = 'Thinking<span class="cmp-dots"><i></i><i></i><i></i></span>';
          $("cmp-drafts").innerHTML = '<div class="cmp-hint"><strong>Two drafts on the way.</strong> Pick one, tweak it if you like, and hit Send. Keep the loop going. Return the serve.</div>'; statusEl.textContent = "";
          try {
            const r = await fetch("/admin/api/session-suggest", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ type, data: { ...D, homes: [...picked.values()] }, stats: stats() }) });
            const j = await r.json();
            if (!r.ok) throw new Error(j.error || "Suggest failed");
            drafts = j.drafts || [];
            $("cmp-drafts").innerHTML = drafts.map((d, i) =>
              '<button type="button" class="cmp-draft" data-i="' + i + '"><span class="cmp-draft-label">' + esc(d.label) +
              '</span><span class="cmp-draft-sub">' + esc(d.subject) + '</span><span class="cmp-draft-body">' + esc(d.body) + "</span></button>").join("");
            $("cmp-drafts").querySelectorAll(".cmp-draft").forEach((el) => el.addEventListener("click", () => {
              const d = drafts[+el.dataset.i];
              $("cmp-subject").value = d.subject || ""; $("cmp-text").value = d.body || "";
              msgType = d.type || (type === "auto" ? null : type);
              $("cmp-drafts").querySelectorAll(".cmp-draft").forEach((x) => x.classList.toggle("on", x === el));
            }));
          } catch (err) { statusEl.textContent = err.message; }
          if ($("cmp-drafts").querySelector(".cmp-hint")) $("cmp-drafts").innerHTML = ""; btn.disabled = false; btn.innerHTML = "&#10022; Suggest a reply";
        });

        $("cmp-send").addEventListener("click", async () => {
          const subject = $("cmp-subject").value.trim(), body = $("cmp-text").value.trim();
          if (!subject || !body) { statusEl.textContent = "Add a subject and message."; return; }
          const btn = $("cmp-send"); btn.disabled = true; statusEl.textContent = "Sending...";
          try {
            const r = await fetch("/admin/api/session-send", { method: "POST", headers: { "content-type": "application/json" },
              body: JSON.stringify({ session_id: D.session_id, to: D.to, subject, body, homes: [...picked.keys()], message_type: msgType || (type === "auto" ? null : type) }) });
            const j = await r.json();
            if (!r.ok) throw new Error(j.error || "Send failed");
            statusEl.textContent = "Sent."; showToast("\u2713 Email sent to " + D.to);
            $("cmp-text").value = ""; $("cmp-drafts").innerHTML = ""; msgType = null; picked.clear(); renderPicked();
            await loadHistory(); setTimeout(close, 700);
          } catch (err) { statusEl.textContent = err.message; }
          btn.disabled = false;
        });

        // session-homes-picker
        const picked = new Map();
        let homesLoaded = false;
        const fmtP = (p) => (p ? "$" + Math.round(p).toLocaleString("en-CA") : "");
        function syncHomesLine() {
          const ta = $("cmp-text");
          let v = ta.value.replace(/\s*I've also added (?:a home|\d+ homes) below that fits? what you've been looking at\.\s*$/, "");
          const n = picked.size;
          if (v.trim() && n && !/\bbelow\b/i.test(v)) {
            v = v.replace(/\s+$/, "") + "\n\n" + (n === 1 ? "I've also added a home below that fits what you've been looking at." : `I've also added ${n} homes below that fit what you've been looking at.`);
          }
          ta.value = v;
        }
        function renderPicked() {
          const n = picked.size;
          $("cmp-homes-count").textContent = n ? n + (n === 1 ? " home" : " homes") + " added as cards" : "No homes added";
          $("cmp-homes-picked").innerHTML = [...picked.values()].map((h) => '<span class="cmp-home-chip">' + esc(h.address || h.mls) + ' <button type="button" data-rm="' + esc(h.id) + '" aria-label="Remove">&times;</button></span>').join("");
          $("cmp-homes-list").querySelectorAll("input[data-id]").forEach((cb) => { cb.checked = picked.has(cb.dataset.id); }); syncHomesLine();
          if ($("cmp-drafts").querySelector(".cmp-draft")) { $("cmp-drafts").classList.add("stale"); statusEl.textContent = "Updating drafts to include your homes..."; clearTimeout(window.__cmpRedraft); const go = () => { const b = $("cmp-suggest"); if (b.disabled) { window.__cmpRedraft = setTimeout(go, 800); } else { b.click(); } }; window.__cmpRedraft = setTimeout(go, 1200); }
        }
        $("cmp-homes-picked").addEventListener("click", (e) => { const b = e.target.closest("[data-rm]"); if (!b) return; picked.delete(b.dataset.rm); renderPicked(); });
        $("cmp-homes-btn").addEventListener("click", async () => {
          const list = $("cmp-homes-list");
          if (!list.hidden) { list.hidden = true; return; }
          list.hidden = false;
          if (homesLoaded) return;
          list.innerHTML = '<div class="cmp-homes-empty">Finding similar homes...</div>';
          try {
            const r = await fetch("/admin/api/session-homes?session_id=" + encodeURIComponent(D.session_id));
            const j = await r.json();
            if (!r.ok) throw new Error(j.error || "Couldn't load homes");
            const homes = j.homes || [];
            homesLoaded = true;
            if (!homes.length) { list.innerHTML = '<div class="cmp-homes-empty">No active matches found for this buyer yet.</div>'; return; }
            list.innerHTML = homes.map((h) =>
              '<label class="cmp-home"><input type="checkbox" data-id="' + esc(h.id) + '">' +
              (h.image ? '<img src="' + esc(h.image) + '" alt="" loading="lazy">' : '<span class="cmp-home-noimg"></span>') +
              '<span class="cmp-home-info"><strong>' + esc(fmtP(h.price)) + "</strong><span>" + esc(h.address) + '</span><span class="cmp-home-meta">' +
              esc([h.beds ? h.beds + " bd" : "", h.baths ? h.baths + " ba" : "", h.area].filter(Boolean).join(" \u00b7 ")) + "</span>" +
              (h.why ? '<span class="cmp-home-why">' + esc(h.why) + "</span>" : "") + "</span></label>").join("");
            const byId = new Map(homes.map((h) => [String(h.id), h]));
            list.querySelectorAll("input[data-id]").forEach((cb) => cb.addEventListener("change", () => {
              const h = byId.get(cb.dataset.id); if (!h) return;
              if (cb.checked) {
                if (picked.size >= 6) { cb.checked = false; statusEl.textContent = "Up to 6 homes per email."; return; }
                picked.set(cb.dataset.id, h);
              } else picked.delete(cb.dataset.id);
              renderPicked();
            }));
          } catch (err) { list.innerHTML = '<div class="cmp-homes-empty">' + esc(err.message) + "</div>"; }
        });
        loadHistory();
      })();
    </script>
    <script src="/look-search.js" defer is:inline></script>
</body>
</html>