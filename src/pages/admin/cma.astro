      if (ma) {
        var pa = []; addSubject(ma, pa);
        data.actives.forEach(function (a) {
          if (!a.lat || !a.lng) return;
          L.marker([a.lat, a.lng], { icon: pinIcon("pin-act", k(a.price)) }).addTo(ma)
            .bindPopup('<div class="pop">' + popImg(a.image) + '<div class="pop-t">' + esc(fixCase(a.address)) + '</div><div class="pop-p">' + money(a.price) + "<span>asking</span></div><div class=\"pop-m\">" + [a.sqft && Math.round(a.sqft).toLocaleString("en-CA") + " sq ft", a.beds && a.beds + " bed", a.year && "built " + a.year].filter(Boolean).join(" · ") + '</div><a href="#" class="pop-a" data-pop-act="1">Photos &amp; details →</a></div>', { maxWidth: 260, minWidth: 240 }).on("popupopen", function (e) { e.popup.getElement().querySelectorAll("[data-pop-act], .pop-img").forEach(function (l) { l.onclick = function (ev) { ev.preventDefault(); openActive(a); }; }); });
          pa.push([a.lat, a.lng]);
        });
        if (pa.length) ma.fitBounds(pa, { padding: [30, 30], maxZoom: 16 });
      }
    }

    // cma-photos-v1: agent-only sold listing viewer
    var pv = document.getElementById("pv"), pvImgs = [], pvI = 0;
    function pvShow(i) {
