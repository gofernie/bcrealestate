      pv.querySelectorAll(".pv-thumbs img").forEach(function (im, k) { im.classList.toggle("on", k === pvI); if (k === pvI) { var st = im.parentNode; st.scrollLeft = im.offsetLeft - st.clientWidth / 2 + im.clientWidth / 2; } });
    }
    function pvClear() { pv.querySelector(".pv-main").removeAttribute("src"); pv.querySelector(".pv-thumbs").innerHTML = ""; pv.querySelector(".pv-desc").textContent = "Loading…"; }
    function openActive(a) { pvClear(); openListing("active", a); }
    function openPhotos(c) { pvClear(); openListing("sold", c); }
    // cma-pvnav-v1: step through the list the viewer was opened from (ticked comps, or the competition)
    function pvList(kind) { return kind === "sold" ? data.comps.filter(function (c) { return !off[c.mls]; }) : data.actives; }
    function pvStep(d) {
      if (!pvCur) return; var L2 = pvList(pvCur.kind), i = L2.indexOf(pvCur.o); if (i < 0 || L2.length < 2) return;
      var mode = pv.querySelector(".pv-map").hidden ? "photos" : "map";
      openListing(pvCur.kind, L2[(i + d + L2.length) % L2.length]);
