    // cma-pvmap-v1: swap the photos for a map of this home and the subject
    var pvMapObj = null, pvCur = null;
    function pvMode(mode) {
      var isMap = mode === "map", st = pv.querySelector(".pv-stage");
      pv.querySelectorAll(".pv-tabs button").forEach(function (b) { b.classList.toggle("on", b.getAttribute("data-pv") === mode); });
      st.querySelectorAll(".pv-main, .pv-prev, .pv-next, .pv-count").forEach(function (el) { el.style.visibility = isMap ? "hidden" : ""; });
      pv.querySelector(".pv-thumbs").style.display = isMap ? "none" : "";
      var mp = pv.querySelector(".pv-map"); mp.hidden = !isMap;
      if (!isMap || !window.L || !pvCur) return;
      var o = pvCur.o, s = data.subject;
      if (pvMapObj) { pvMapObj.remove(); pvMapObj = null; }
      if (!o.lat || !o.lng) { mp.innerHTML = '<p class="pv-nomap">No map position for this listing.</p>'; return; }
      mp.innerHTML = "";
      pvMapObj = L.map(mp, { scrollWheelZoom: true });
      var tiles = root.getAttribute("data-tiles");
      L.tileLayer(tiles || "https://tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: tiles ? 22 : 19, attribution: tiles ? "&copy; Jawg Maps &copy; OpenStreetMap" : "&copy; OpenStreetMap" }).addTo(pvMapObj);
      var label = pvCur.kind === "sold" ? money(o.soldPrice) + " sold" : money(o.price) + " asking";
      L.marker([o.lat, o.lng], { icon: pinIcon(pvCur.kind === "sold" ? "pin-sold pin-big" : "pin-act pin-big", esc(label)), zIndexOffset: 500 }).addTo(pvMapObj);
      var pts = [[o.lat, o.lng]];
      if (s && s.lat && s.lng && !(Math.abs(s.lat - o.lat) < 1e-6 && Math.abs(s.lng - o.lng) < 1e-6)) {
        L.marker([s.lat, s.lng], { icon: pinIcon("pin-subj", "★ " + esc((s.address || "Subject").split(" ").slice(0, 3).join(" "))), zIndexOffset: 1000 }).addTo(pvMapObj);
        L.polyline([[s.lat, s.lng], [o.lat, o.lng]], { color: "#c0392b", weight: 2, dashArray: "5 6", opacity: .8 }).addTo(pvMapObj);
        pts.push([s.lat, s.lng]);
      }
      setTimeout(function () { pvMapObj.invalidateSize(); if (pts.length > 1) pvMapObj.fitBounds(pts, { padding: [60, 60], maxZoom: 16 }); else pvMapObj.setView(pts[0], 16); }, 30);
    }
    pv.querySelectorAll(".pv-tabs button").forEach(function (b) { b.onclick = function () { pvMode(b.getAttribute("data-pv")); }; });
    function openListing(kind, o) {
      pvCur = { kind: kind, o: o }; pvMode("photos");
      var L3 = pvList(kind), pos = L3.indexOf(o);
      pv.querySelector(".pv-pos").textContent = pos >= 0 ? (pos + 1) + " of " + L3.length : "";
      pv.querySelector(".pv-nav").style.display = L3.length > 1 && pos >= 0 ? "" : "none";
      pv.hidden = false; document.body.style.overflow = "hidden";
      pv.querySelector(".pv-scroll").scrollTop = 0;
      pv.querySelector(".pv-title").textContent = o.address || "MLS® " + o.mls;
      pv.querySelector(".pv-warn").hidden = kind !== "sold";
      pv.querySelector(".pv-facts").innerHTML = "";
      var stepping = !!pv.querySelector(".pv-main").getAttribute("src");
      if (!stepping) { pv.querySelector(".pv-details").innerHTML = pvDetails(kind, o, null); pv.querySelector(".pv-rooms").innerHTML = ""; }
      // keep the last photo and text in place until the next listing loads, so nothing jumps
      var wasOpen = !!pv.querySelector(".pv-main").getAttribute("src");
      if (!wasOpen) { pv.querySelector(".pv-thumbs").innerHTML = ""; pv.querySelector(".pv-desc").textContent = "Loading…"; }
      pv.querySelector(".pv-count").textContent = "";
      fetch("/admin/api/cma?photos=" + encodeURIComponent(o.mls)).then(function (r) { return r.json(); }).then(function (j) {
        if (pvCur.o !== o) return; // a newer listing was opened meanwhile
        if (kind === "sold") pvBlind(o);
        pv.querySelector(".pv-details").innerHTML = j.error ? pvDetails(kind, o, null) : pvDetails(kind, o, j); pv.querySelector(".pv-rooms").innerHTML = j.error ? "" : pvRooms(j.rooms);
        pvImgs = j.images || [];
        pv.querySelector(".pv-desc").textContent = j.error ? j.error : (j.description || "");
        pv.querySelector(".pv-thumbs").innerHTML = pvImgs.map(function (u, k) { return '<img loading="lazy" src="' + esc(u) + '" data-k="' + k + '" alt="" />'; }).join("");
        pv.querySelectorAll(".pv-thumbs img").forEach(function (im) { im.onclick = function () { pvShow(Number(im.getAttribute("data-k"))); }; });
        if (pvImgs.length) pvShow(0); else pv.querySelector(".pv-count").textContent = "No photos";
        pv.querySelector(".pv-scroll").scrollTop = 0;
      });
    }
    function closePhotos() { pv.hidden = true; document.body.style.overflow = ""; }
    pv.querySelector(".pv-close").onclick = closePhotos;
    pv.querySelector(".pv-prev").onclick = function () { pvShow(pvI - 1); };
    pv.querySelector(".pv-next").onclick = function () { pvShow(pvI + 1); };
    pv.onclick = function (e) { if (e.target === pv) closePhotos(); };
    document.addEventListener("keydown", function (e) { if (pv.hidden) return; if (e.key === "Escape") closePhotos(); if (!pv.querySelector(".pv-map").hidden) return; if (e.key === "ArrowLeft") pvShow(pvI - 1); if (e.key === "ArrowRight") pvShow(pvI + 1); });

    form.onsubmit = function (e) { e.preventDefault(); hideSug(); run(); };
    form.setAttribute("autocomplete", "off");

    // cma-suggest-v1: address type-ahead; picking one runs the CMA on that exact home
    var sugBox = document.getElementById("sug"), sugTimer = null, sugItems = [], sugIdx = -1, lastQ = "";
    function hideSug() { sugBox.hidden = true; sugIdx = -1; }
    function clearManual() { ["type", "area", "sqft", "beds", "year", "lot", "waterfront"].forEach(function (n) { $(n).value = ""; }); ["sqft", "beds", "year", "lot"].forEach(function (n) { $(n).placeholder = ""; }); }
    function drawSug() {
      if (!sugItems.length) { hideSug(); return; }
      sugBox.innerHTML = sugItems.map(function (s, i) {
        return '<button type="button" class="sug-i' + (i === sugIdx ? " on" : "") + '" data-i="' + i + '"><b>' + esc(fixCase(s.address)) + "</b><span>" + esc(nice(s.area || "")) + (s.city ? ", " + esc(nice(s.city)) : "") + " · " + esc(s.status) + " · MLS® " + esc(s.mls) + "</span></button>";
      }).join("");
      sugBox.hidden = false;
      sugBox.querySelectorAll(".sug-i").forEach(function (b) { b.onmousedown = function (e) { e.preventDefault(); pickSug(Number(b.getAttribute("data-i"))); }; });
    }
    function pickSug(i) { var s = sugItems[i]; if (!s) return; $("q").value = fixCase(s.address); hideSug(); clearManual(); run({ mls: s.mls }); }
    $("q").addEventListener("input", function () {
      var v = $("q").value.trim();
      if (v !== lastQ) { clearManual(); lastQ = v; } // a new address must not inherit old hand-entered details
      clearTimeout(sugTimer);
      if (v.length < 3 || /^[A-Za-z]?\d{5,9}$/.test(v)) { hideSug(); return; }
      sugTimer = setTimeout(function () {
        fetch("/admin/api/cma?city=" + encodeURIComponent(city) + "&suggest=" + encodeURIComponent(v)).then(function (r) { return r.json(); }).then(function (j) { if ($("q").value.trim() !== v) return; sugItems = j.items || []; sugIdx = -1; drawSug(); }).catch(function () {});
      }, 220);
    });
    $("q").addEventListener("keydown", function (e) {
      if (sugBox.hidden) return;
      if (e.key === "ArrowDown") { e.preventDefault(); sugIdx = Math.min(sugItems.length - 1, sugIdx + 1); drawSug(); }
      else if (e.key === "ArrowUp") { e.preventDefault(); sugIdx = Math.max(-1, sugIdx - 1); drawSug(); }
      else if (e.key === "Enter" && sugIdx >= 0) { e.preventDefault(); pickSug(sugIdx); }
      else if (e.key === "Escape") hideSug();
    });
    $("q").addEventListener("blur", function () { setTimeout(hideSug, 150); });
    var sf = document.getElementById("since-form"), so = document.getElementById("since-out");
    sf.onsubmit = function (e) {
      e.preventDefault();
      var q = new URLSearchParams({ city: city, since: sf.elements.month.value, price: sf.elements.price.value.replace(/[^0-9]/g, ""), type: sf.elements.type.value });
      so.textContent = "Calculating…";
      fetch("/admin/api/cma?" + q.toString()).then(function (r) { return r.json(); }).then(function (j) {
        if (j.error) { so.innerHTML = '<span style="color:#8a2b2b">' + esc(j.error) + "</span>"; return; }
        var mon = function (m) { return new Date(m + "-15").toLocaleDateString("en-CA", { month: "short", year: "numeric" }); };
        so.innerHTML = "<strong style=\"font-size:22px;color:#1f2a2a\">" + money(j.value) + "</strong> &nbsp;" + (j.change >= 0 ? "+" : "") + j.change + "% since " + mon(j.month) +
          "<br>" + money(j.price) + " moved by the " + esc(j.ticker) + " sold index from " + mon(j.month) + " to " + mon(j.asOf) + ". Index history starts " + mon(j.first) + ".";
      }).catch(function (err) { so.textContent = err.message; });
    };
  })();
  </script>
</body>
</html>
