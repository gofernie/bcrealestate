---
// cma-v1: agent-only market valuation. Login required (middleware); never linked publicly, noindex.
import AdminTopNav from "../../components/AdminTopNav.astro";
export const prerender = false;
const city = (Astro.url.searchParams.get("city") || "nanaimo").toLowerCase();
const cityLabel = city.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
// cma-map-v1: same light basemap as the site's listing modal
const jawgToken = import.meta.env.PUBLIC_JAWG_ACCESS_TOKEN || "";
const tileUrl = jawgToken ? `https://tile.jawg.io/8dcad843-ebe7-4a16-8db9-b11d0562bb6d/{z}/{x}/{y}.png?access-token=${encodeURIComponent(jawgToken)}` : "";
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Market valuation · Locus Admin</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style is:global>
    body { margin: 0; font-family: "DM Sans", system-ui, sans-serif; background: #f6f4ef; color: #1f2a2a; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 24px 20px 60px; }
    h1 { font-size: 28px; margin: 6px 0 4px; }
    .sub { color: #5d6868; margin: 0 0 20px; }
    .card { background: #fff; border: 1px solid #e4e0d6; border-radius: 14px; padding: 18px 20px; margin-bottom: 16px; }
    .find { display: flex; gap: 10px; flex-wrap: wrap; align-items: end; }
    label { display: grid; gap: 4px; font-size: 12px; font-weight: 600; color: #5d6868; text-transform: uppercase; letter-spacing: .04em; }
    input, select { font: inherit; font-size: 15px; padding: 9px 11px; border: 1px solid #d6d1c4; border-radius: 9px; background: #fff; text-transform: none; letter-spacing: 0; color: #1f2a2a; }
    .grow { flex: 1 1 260px; }
    .sugwrap { position: relative; display: block; }
    .sugwrap input { width: 100%; box-sizing: border-box; }
    .sug { position: absolute; left: 0; right: 0; top: calc(100% + 4px); z-index: 40; background: #fff; border: 1px solid #d6d1c4; border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.15); overflow: hidden; }
    .sug-i { display: block; width: 100%; text-align: left; background: #fff; color: #1f2a2a; border: 0; border-radius: 0; padding: 9px 12px; font-weight: 400; border-bottom: 1px solid #f0ece3; }
    .sug-i:last-child { border-bottom: 0; }
    .sug-i b { display: block; font-size: 15px; font-weight: 700; text-transform: none; letter-spacing: 0; }
    .sug-i span { display: block; font-size: 12px; color: #5d6868; text-transform: none; letter-spacing: 0; font-weight: 400; }
    .sug-i:hover, .sug-i.on { background: #eef5f4; }
    .grid input, .grid select { width: 100%; min-width: 0; box-sizing: border-box; }
    .grid label { min-width: 0; }
    .msg.err.hint { background: #fdf3dc; color: #7a5a0c; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; margin-top: 14px; }
    button { font: inherit; font-weight: 700; border: 0; border-radius: 9px; padding: 10px 18px; background: #2f6f73; color: #fff; cursor: pointer; }
    button.ghost { background: #eef2f1; color: #2f6f73; }
    details summary { cursor: pointer; color: #2f6f73; font-weight: 600; margin-top: 12px; }
    .msg { padding: 12px 14px; border-radius: 10px; background: #fdf3dc; color: #7a5a0c; margin-bottom: 16px; }
    .msg.err { background: #f6e3e3; color: #8a2b2b; }
    .matches a { display: block; padding: 8px 0; color: #2f6f73; cursor: pointer; border-bottom: 1px solid #eee; }
    .range { display: grid; grid-template-columns: 1fr 1.3fr 1fr; gap: 12px; text-align: center; margin: 6px 0 10px; }
    .range div span { display: block; font-size: 12px; font-weight: 600; color: #5d6868; text-transform: uppercase; letter-spacing: .05em; }
    .range div strong { font-size: 26px; }
    .range .likely strong { font-size: 38px; color: #2f6f73; }
    .cond { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-top: 8px; }
    .cond input[type=range] { flex: 1 1 260px; padding: 0; border: 0; }
    .ticks { display: flex; justify-content: space-between; font-size: 12px; color: #5d6868; flex: 1 1 260px; }
    .condbox { border: 1px solid #e4e0d6; border-radius: 12px; padding: 12px 14px; margin: 14px 0 10px; background: #faf9f5; }
    .condbox.up { border-color: #8cc9a4; background: #eef8f1; }
    .condbox.down { border-color: #e3a2a2; background: #fbefef; }
    .condbox.up .condval, .condbox.up .condnote .delta { color: #1d6b48; }
    .condbox.down .condval, .condbox.down .condnote .delta { color: #a12f2f; }
    a.lst { color: #2f6f73; font-weight: 600; text-decoration: none; }
    a.lst:hover { text-decoration: underline; }
    button.lst { background: none; border: 0; padding: 0; font: inherit; font-weight: 700; color: #2f6f73; cursor: pointer; text-align: left; }
    button.lst:hover { text-decoration: underline; }
    .pv { position: fixed; inset: 0; background: rgba(15, 25, 25, .72); z-index: 1000; display: flex; align-items: flex-start; padding-top: 3vh; justify-content: center; padding: 20px; }
    .pv[hidden] { display: none; }
    .pv-box { background: #f7f4ec; border-radius: 6px; width: min(980px, 100%); max-height: 94vh; overflow: hidden; display: flex; box-shadow: 0 10px 40px rgba(0,0,0,.35); }
    .pv-scroll { flex: 1; overflow-y: auto; max-height: calc(94vh - 12px); margin: 6px 4px 6px 0; padding: 10px 14px 10px 18px; scrollbar-width: thin; scrollbar-color: #c9c3b4 transparent; }
    .pv-scroll::-webkit-scrollbar { width: 8px; } .pv-scroll::-webkit-scrollbar-thumb { background: #c9c3b4; border-radius: 4px; } .pv-scroll::-webkit-scrollbar-track { background: transparent; }
    .pv-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; margin-bottom: 10px; }
    .pv-title { font-size: 18px; }
    .pv-facts { font-size: 13px; color: #5d6868; margin-top: 4px; line-height: 1.5; }
    .qm { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 15px; height: 15px; margin-left: 5px; border-radius: 50%; border: 1px solid #b8b2a3; color: #7a7466; font-size: 10px; font-weight: 700; line-height: 1; cursor: help; vertical-align: 1px; text-transform: none; letter-spacing: 0; background: #fff; }
    .qm:hover, .qm:focus { border-color: #2f6f73; color: #2f6f73; outline: none; }
    .qm-box { position: absolute; top: 20px; left: -10px; z-index: 30; width: 270px; padding: 9px 11px; background: #1f2a2a; color: #f4f1ea; border-radius: 4px; font-size: 12.5px; font-weight: 400; line-height: 1.45; text-align: left; white-space: normal; box-shadow: 0 6px 18px rgba(0,0,0,.25); text-transform: none; letter-spacing: 0; }
    body span.qm:hover span.qm-box, body span.qm:focus-visible span.qm-box { display: block !important; }
    .qm.flip .qm-box { left: auto !important; right: -10px; transform: none !important; }
    body span.qm { display: inline-flex !important; } body span.qm span.qm-box { display: none !important; }
    span.qm-box { text-transform: none !important; letter-spacing: normal !important; font-size: 12.5px !important; font-weight: 400 !important; color: #f4f1ea !important; font-style: normal !important; line-height: 1.45 !important; }
    span.qm { text-transform: none !important; letter-spacing: 0 !important; font-size: 10px !important; font-weight: 700 !important; }
    .range .qm-box { left: 50%; transform: translateX(-50%); }
    .pv-nav { display: inline-flex; align-items: center; gap: 6px; }
    .pv-nav button { background: #fff; color: #2f6f73; border: 1px solid #d6d1c4; border-radius: 4px; padding: 7px 11px; font-size: 13px; }
    .pv-nav button:hover { background: #eef5f4; }
    .pv-pos { font-size: 12px; color: #5d6868; min-width: 52px; text-align: center; white-space: nowrap; }
    @media (max-width: 700px) { .pv-head { flex-wrap: wrap; } .pv-actions { flex-wrap: wrap; } }
    .pv-actions { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
    .pv-tabs { display: inline-flex; border: 1px solid #d6d1c4; border-radius: 4px; overflow: hidden; background: #fff; }
    .pv-tabs button { background: #fff; color: #2f6f73; border-radius: 0; padding: 7px 14px; font-size: 13px; }
    .pv-tabs button + button { border-left: 1px solid #d6d1c4; }
    .pv-tabs button.on { background: #2f6f73; color: #fff; }
    .pv-map { position: absolute; inset: 0; border-radius: 4px; z-index: 3; background: #e9eef0; }
    .pv-nomap { color: #5d6868; text-align: center; margin-top: 25%; }
    .pin-big { font-size: 13px; padding: 6px 10px; }
    .pv-close { background: #eef2f1; color: #1f2a2a; font-size: 22px; line-height: 1; padding: 6px 12px;  border-radius: 4px; }
    .pv-stage { position: relative; background: #111; border-radius: 4px; display: flex; align-items: center; justify-content: center; height: min(58vh, 560px); }
    .pv-main { max-width: 100%; max-height: 100%; object-fit: contain; }
    .pv-prev, .pv-next { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,.85); color: #1f2a2a; font-size: 28px; padding: 4px 14px; }
    .pv-prev { left: 10px; } .pv-next { right: 10px; }
    .pv-count { position: absolute; bottom: 8px; right: 12px; color: #fff; font-size: 12px; background: rgba(0,0,0,.5); padding: 2px 8px; border-radius: 999px; }
    .pv-thumbs { display: flex; gap: 6px; overflow-x: auto; padding: 8px 0; }
    .pv-thumbs img { height: 60px; border-radius: 3px; cursor: pointer; opacity: .6; flex: 0 0 auto; }
    .pv-thumbs img.on { opacity: 1; outline: 2px solid #2f6f73; }
    .pv-price { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 10px; }
    .pv-price > div { background: #fff; border: 1px solid #e4e0d6; border-radius: 4px; padding: 8px 12px; min-width: 120px; }
    .pv-price span, .pv-tile span { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #5d6868; }
    .pv-price strong { display: block; font-size: 24px; line-height: 1.2; color: #1f2a2a; }
    .pv-price em, .pv-tile em { display: block; font-style: normal; font-size: 12px; color: #5d6868; }
    .pv-price .pv-cma { background: #e6efee; border-color: #c6dcda; } .pv-price .pv-cma strong { color: #2f6f73; }
    .pv-price .pv-blind.good { background: #e3f3ec; border-color: #b9dfca; } .pv-price .pv-blind.good b { color: #1d6b48; }
    .pv-price .pv-blind.ok { background: #fdf3dc; border-color: #ecd9a8; } .pv-price .pv-blind.ok b { color: #7a5a0c; }
    .pv-price .pv-blind.miss { background: #fbefef; border-color: #efcaca; } .pv-price .pv-blind.miss b { color: #a12f2f; }
    .pv-price .pv-cut { background: #fbefef; border-color: #efcaca; } .pv-price .pv-cut strong { color: #a12f2f; }
    .pv-tiles { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 4px 2px 10px; }
    .pv-tile { display: inline-flex; align-items: baseline; gap: 6px; font-size: 15px; }
    .pv-tile strong { font-size: 15px; font-weight: 700; color: #1f2a2a; }
    .pv-tile span { display: inline !important; }
    .pv-tile em { display: inline !important; }
    .pv-links { font-size: 13px; color: #5d6868; margin: 2px 0 10px; } .pv-links a { color: #2f6f73; font-weight: 600; }
    .pv-roomsbox { margin: 8px 0; } .pv-roomsbox summary { cursor: pointer; font-weight: 700; color: #2f6f73; }
    .pv-roomgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 6px 18px; margin-top: 6px; }
    .pv-roomgrid h4 { margin: 6px 0 2px; font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: #5d6868; }
    .pv-roomgrid p { display: flex; justify-content: space-between; margin: 0; font-size: 13px; border-bottom: 1px dotted #e4e0d6; padding: 2px 0; }
    .pv-desc { white-space: pre-line; font-size: 14px; line-height: 1.55; margin: 6px 0 10px; }
    .tip { background: #eef2f1; border-radius: 10px; padding: 10px 14px; font-size: 14px; margin: -8px 0 18px; color: #1f2a2a; }
    .buyernote { background: #eef2f1; border-radius: 10px; padding: 8px 12px; font-size: 13px; margin: 4px auto 10px; max-width: 760px; text-align: center; }
    .listgap { text-align: center; font-size: 14px; margin: 6px 0 8px; color: #1f2a2a; }
    .listgap.over strong { color: #a12f2f; }
    .listgap.under strong { color: #1d6b48; }
    .wide { text-align: center; font-size: 13px; color: #5d6868; margin: -2px 0 4px; }
    .projwarn { background: #fbefef; border: 1px solid #efcaca; color: #7a2424; border-radius: 6px; padding: 10px 14px; font-size: 13px; line-height: 1.5; margin: 0 0 10px; }
    .projwarn.dev { background: #fdf3dc; border-color: #ecd9a8; color: #6b4e0a; }
    .projwarn em { font-style: normal; font-weight: 700; }
    .conf { border-radius: 10px; padding: 10px 14px; font-size: 13px; margin: 0 0 10px; line-height: 1.5; }
    .conf ul { margin: 4px 0 0; padding-left: 18px; }
    .conf-high { background: #e3f3ec; color: #1d6b48; }
    .conf-medium { background: #fdf3dc; color: #7a5a0c; }
    .conf-low { background: #f6e3e3; color: #8a2b2b; }
    .cmap .leaflet-popup-content-wrapper { border-radius: 6px; padding: 0; box-shadow: 0 4px 18px rgba(0,0,0,.25); }
    .cmap .leaflet-popup-content { margin: 0; width: 250px !important; font-family: "DM Sans", system-ui, sans-serif; line-height: 1.35; }
    .pop-t { font-size: 14px; font-weight: 700; color: #1f2a2a; margin-bottom: 2px; }
    .pop-p { font-size: 18px; font-weight: 700; color: #1f2a2a; } .pop-p span { font-size: 12px; font-weight: 500; color: #5d6868; margin-left: 6px; }
    .pop-m { font-size: 12px; color: #5d6868; margin: 2px 0 6px; } .pop-m b { color: #2f6f73; }
    .cmap a.pop-a { display: inline-block; font-size: 12px; font-weight: 700; color: #2f6f73; text-decoration: none; border: 1px solid #c6dcda; background: #eef5f4; border-radius: 4px; padding: 4px 9px; }
    .cmap a.pop-a:hover { background: #e0eeec; }
    .pop > :not(.pop-img) { margin-left: 12px; margin-right: 12px; }
    .pop > .pop-t { margin-top: 10px; } .pop > :last-child { margin-bottom: 12px; }
    .cmap .leaflet-popup-close-button { top: 7px !important; right: 7px !important; width: 26px !important; height: 26px !important; border-radius: 50%; background: rgba(255,255,255,.92) !important; color: #1f2a2a !important; font: 700 18px/24px "DM Sans", system-ui, sans-serif !important; text-align: center; box-shadow: 0 1px 4px rgba(0,0,0,.3); z-index: 2; }
    .cmap .leaflet-popup-close-button span { line-height: 24px; }
    .cmap .leaflet-popup-close-button:hover { background: #fff !important; }
    .pop-img { display: block; width: 100%; height: 140px; object-fit: cover; border-radius: 6px 6px 0 0; margin: 0; cursor: pointer; background: #eee; }
    .cmap { height: 340px; border-radius: 10px; margin: 0 0 14px; border: 1px solid #e4e0d6; z-index: 0; }
    .pin { display: inline-block; transform: translate(-50%, -50%); white-space: nowrap; font: 700 12px/1 "DM Sans", system-ui, sans-serif; padding: 5px 7px; border-radius: 999px; box-shadow: 0 1px 4px rgba(0,0,0,.35); border: 2px solid #fff; }
    .pin-sold { background: #2f6f73; color: #fff; min-width: 12px; text-align: center; }
    .pin-off { background: #b9c0c0; color: #fff; }
    .pin-act { background: #fff; color: #1f2a2a; border-color: #2f6f73; }
    .pin-subj { background: #c0392b; color: #fff; font-size: 13px; padding: 6px 10px; position: relative; transform: translate(-50%, calc(-100% - 11px)); }
    .pin-subj::after { content: ""; position: absolute; left: 50%; bottom: -9px; margin-left: -7px; border-style: solid; border-width: 9px 7px 0; border-color: #c0392b transparent transparent; }
    .pin-subj::before { content: ""; position: absolute; left: 50%; bottom: -20px; margin-left: -6px; width: 8px; height: 8px; border-radius: 50%; background: #c0392b; border: 2px solid #fff; box-shadow: 0 1px 3px rgba(0,0,0,.4); }
    .pin-n { display: inline-block; min-width: 20px; height: 20px; line-height: 20px; border-radius: 999px; background: #2f6f73; color: #fff; font-size: 11px; font-weight: 700; text-align: center; margin-right: 6px; }
    tr.off .pin-n { background: #b9c0c0; }
    @media print { .cmap { height: 260px; } }
    .condcall { display: flex; gap: 10px; align-items: flex-start; margin: 8px 0 12px; padding: 10px 12px; background: #1f2a2a; color: #f4f1ea; border-radius: 6px; font-size: 15px; line-height: 1.45; }
    .condcall strong { color: #fff; font-size: 16px; }
    .condcall-i { flex: 0 0 auto; width: 22px; height: 22px; border-radius: 50%; background: #e0b45a; color: #1f2a2a; font-weight: 800; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; margin-top: 1px; }
    @media print { .condcall { background: none; color: #1f2a2a; border: 1px solid #1f2a2a; } .condcall strong { color: #1f2a2a; } }
    .condslide { position: relative; padding-top: 30px; }
    .pr { margin-top: 12px; padding-top: 10px; border-top: 1px dashed #d6d1c4; }
    .pr-btn { background: #fff; color: #2f6f73; border: 1px solid #2f6f73; padding: 8px 14px; font-size: 14px; }
    .pr-btn:hover { background: #eef5f4; }
    .pr-busy { color: #5d6868; font-size: 14px; margin: 0; } .pr-err { color: #8a2b2b; font-size: 14px; margin: 0; }
    .pr-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 15px; }
    .pr-sug { color: #5d6868; font-size: 14px; }
    .pr-again { margin-left: auto; background: none; color: #2f6f73; border: 1px solid #c6dcda; padding: 4px 10px; font-size: 12px; }
    .pr-again:hover { background: #eef5f4; }
    .pr-apply { background: #2f6f73; color: #fff; padding: 6px 12px; font-size: 13px; }
    .pr-on { font-size: 12px; font-weight: 700; color: #1d6b48; background: #e3f3ec; padding: 3px 8px; border-radius: 4px; }
    .pr-sum { margin: 6px 0; font-size: 14px; }
    .pr-areas { margin: 4px 0 6px; padding-left: 18px; font-size: 13px; line-height: 1.6; }
    .pr-dated { color: #a12f2f; } .pr-average { color: #5d6868; } .pr-updated { color: #1d6b48; }
    .condbub { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; font-size: 13px; font-weight: 800; padding: 3px 8px; border-radius: 4px; background: #2f6f73; color: #fff; pointer-events: none; box-shadow: 0 1px 4px rgba(0,0,0,.25); }
    .condbub::after { content: ""; position: absolute; left: 50%; bottom: -5px; margin-left: -5px; border-style: solid; border-width: 5px 5px 0; border-color: inherit; border-top-color: #2f6f73; border-left-color: transparent; border-right-color: transparent; }
    .condbub.down { background: #c0392b; } .condbub.down::after { border-top-color: #c0392b; }
    .condbub.up { background: #1f8a55; } .condbub.up::after { border-top-color: #1f8a55; }
    .condslide input[type=range] { width: 100%; padding: 0; border: 0; accent-color: #2f6f73; position: relative; z-index: 1; background: transparent; }
    .condbox.up input[type=range] { accent-color: #1f8a55; }
    .condbox.down input[type=range] { accent-color: #c0392b; }
    .condslide .mid { position: absolute; left: 66.667%; top: 32px; width: 3px; height: 18px; margin-left: -1.5px; background: #9aa5a5; border-radius: 2px; }
    .condslide .ticks { position: relative; }
    .condslide .ticks .avg { position: absolute; left: 66.667%; transform: translateX(-50%); top: -2px; }
    .ticks .avg { font: inherit; font-size: 12px; font-weight: 700; background: none; color: #2f6f73; padding: 2px 8px; border-radius: 6px; cursor: pointer; }
    .ticks .avg:hover { background: #e6efee; }
    .condhead { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
    .condval { font-weight: 700; color: #2f6f73; }
    .condnote { margin: 10px 0 0; font-size: 14px; }
    .ticks { display: flex; justify-content: space-between; font-size: 12px; color: #5d6868; }
    .meta { font-size: 13px; color: #5d6868; line-height: 1.6; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: #5d6868; padding: 8px 6px; border-bottom: 2px solid #e4e0d6; white-space: nowrap; }
    td { padding: 9px 6px; border-bottom: 1px solid #eee; vertical-align: top; }
    tr.off td { opacity: .4; }
    td.r, th.r { text-align: right; white-space: nowrap; }
    .adj { font-size: 12px; color: #5d6868; margin-top: 4px; }
    .adj div { display: flex; justify-content: space-between; gap: 12px; }
    .flag { display: inline-block; font-size: 11px; background: #fdf3dc; color: #7a5a0c; border-radius: 999px; padding: 1px 8px; margin: 3px 4px 0 0; }
    .w { display: inline-block; height: 6px; background: #2f6f73; border-radius: 3px; vertical-align: middle; margin-right: 6px; }
    .subjcard { display: flex; gap: 18px; align-items: stretch; }
    .subj-img { width: 190px; height: 130px; object-fit: cover; border-radius: 6px; flex: 0 0 auto; background: #eee; }
    .subj-main { flex: 1; min-width: 0; }
    .subj-open { cursor: pointer; } .subj-open:hover { opacity: .9; }
    .subj-link { background: none; border: 0; padding: 0; font: inherit; color: #1f2a2a; cursor: pointer; text-align: left; }
    .subj-link:hover { color: #2f6f73; text-decoration: underline; } .subj-link span { font-size: 16px; }
    .subj-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .subj-kicker { margin: 0; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #5d6868; }
    .subj-title { margin: 2px 0 2px; font-size: 24px; line-height: 1.2; }
    .subj-sub { margin: 0 0 12px; font-size: 14px; color: #5d6868; }
    .subj-facts { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; }
    .sf { display: inline-flex; align-items: baseline; gap: 6px; }
    .sf > span { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #5d6868; }
    .sf strong { font-size: 16px; } .sf em { font-style: normal; font-weight: 400; font-size: 12px; color: #5d6868; margin-left: 5px; }
    .sf-list strong { color: #2f6f73; }
    .subj-sold b { color: #1f2a2a; }
    @media (max-width: 640px) { .subjcard { flex-direction: column; } .subj-img { width: 100%; height: 170px; } }
    .subj { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 14px; }
    .subj b { color: #5d6868; font-weight: 600; margin-right: 4px; }
    .foot { font-size: 12px; color: #5d6868; }
    .toolbar { display: flex; gap: 8px; justify-content: flex-end; }
    @media print { .no-print, nav, header { display: none !important; } body { background: #fff; } .card { border: 0; padding: 0; } }
  </style>
</head>
<body>
  <div class="no-print"><AdminTopNav /></div>
  <main class="wrap" data-city={city} data-tiles={tileUrl}>
    <p class="sub no-print" style="margin:0">Agent tool · not shown on any public page</p>
    <h1>Market valuation · {cityLabel}</h1>
    <p class="sub">Comparable sales from the cached sold data, time-adjusted with the {cityLabel} index.</p>
    <p class="tip no-print"><strong>Working with a buyer?</strong> Run any active listing through this too. It gives you an independent read on the home from the sales around it, so you can see whether the list price is right before you write an offer.</p>

    <form class="card no-print" id="cma-form">
      <div class="find">
        <label class="grow">Address or MLS®
          <span class="sugwrap"><input name="q" placeholder="Start typing an address, or an MLS® number" autocomplete="off" /><div class="sug" id="sug" hidden></div></span>
        </label>
        <button type="submit">Value it</button>
      </div>
      <details id="manual">
        <summary>Enter or correct the details</summary>
        <div class="grid">
          <label>Type
            <select name="type">
              <option value="">From listing</option>
              <option value="house">House</option>
              <option value="condo">Condo</option>
              <option value="townhouse">Townhouse</option>
              <option value="mobile home">Mobile home</option>
              <option value="land">Land</option>
            </select>
          </label>
          <label>Area <select name="area"><option value="">From listing</option></select></label>
          <label>Finished sq ft <input name="sqft" inputmode="numeric" autocomplete="off" /></label>
          <label>Beds <input name="beds" inputmode="numeric" autocomplete="off" /></label>
          <label>Year built <input name="year" inputmode="numeric" autocomplete="off" /></label>
          <label>Lot sq ft <input name="lot" inputmode="numeric" autocomplete="off" /></label>
          <label>Waterfront
            <select name="waterfront"><option value="">From listing</option><option value="no">No</option><option value="yes">Yes</option></select>
          </label>
        </div>
        <p class="foot">Leave the address blank and fill these in to value a home that has never been listed since the cache started. Without an address there's no map position, so comps are matched by area.</p>
      </details>
    </form>

    <form class="card no-print" id="since-form">
      <h3 style="margin:0 0 4px">Market since purchase</h3>
      <p class="foot" style="margin:0 0 12px">For past clients: what their purchase price is worth today on the {cityLabel} sold index. A market-movement figure, not a valuation of the home.</p>
      <div class="find">
        <label>Bought for <input name="price" inputmode="numeric" placeholder="e.g. 525000" /></label>
        <label>Month bought <input name="month" type="month" /></label>
        <label>Type
          <select name="type"><option value="house">House</option><option value="condo">Condo</option><option value="townhouse">Townhouse</option><option value="mobile home">Mobile home</option></select>
        </label>
        <button type="submit">Calculate</button>
      </div>
      <p id="since-out" class="meta" style="margin:12px 0 0"></p>
    </form>

    <div id="out"></div>
    <div id="pv" class="pv" hidden>
      <div class="pv-box" role="dialog" aria-modal="true"><div class="pv-scroll">
        <div class="pv-head"><div><strong class="pv-title"></strong><div class="pv-facts"></div></div><div class="pv-actions"><div class="pv-nav"><button type="button" class="pv-lprev" aria-label="Previous listing">‹ Prev</button><span class="pv-pos"></span><button type="button" class="pv-lnext" aria-label="Next listing">Next ›</button></div><div class="pv-tabs"><button type="button" data-pv="photos" class="on">Photos</button><button type="button" data-pv="map">Map</button></div><button type="button" class="pv-close" aria-label="Close">×</button></div></div>
        <div class="pv-details"></div>
        <div class="pv-stage"><button type="button" class="pv-prev" aria-label="Previous">‹</button><img class="pv-main" alt="" /><button type="button" class="pv-next" aria-label="Next">›</button><span class="pv-count"></span><div class="pv-map" hidden></div></div>
        <div class="pv-thumbs"></div>
        <div class="pv-rooms"></div>
        <p class="pv-desc"></p>
        <p class="foot pv-warn" style="margin:0">Sold listing details for your own use. Don't share these photos or sold details publicly.</p></div>
      </div>
    </div>
  </main>

  <script is:inline>
  (function () {
    var root = document.querySelector("[data-city]");
    var city = root.getAttribute("data-city");
    var form = document.getElementById("cma-form");
    var out = document.getElementById("out");
    var data = null, off = {}, cond = 0;
    var $ = function (n) { return form.elements[n]; };
    var money = function (v) { return v == null ? "—" : "$" + Math.round(v).toLocaleString("en-CA"); };
    var k = function (v) { return v == null ? "—" : v >= 1e6 ? "$" + (v / 1e6).toFixed(2) + "M" : "$" + Math.round(v / 1000) + "K"; };
    var signed = function (v) { return (v >= 0 ? "+" : "−") + "$" + Math.abs(Math.round(v)).toLocaleString("en-CA"); };
    var esc = function (s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); };
    var nice = function (s) { return esc(String(s || "").replace(/\b\w/g, function (c) { return c.toUpperCase(); })); };

    fetch("/admin/api/cma?areas=1&city=" + encodeURIComponent(city)).then(function (r) { return r.json(); }).then(function (j) {
      (j.areas || []).forEach(function (a) { var o = document.createElement("option"); o.value = a; o.textContent = a; $("area").appendChild(o); });
    }).catch(function () {});

    function params(extra) {
      var p = new URLSearchParams({ city: city });
      var q = $("q").value.trim();
      if (extra && extra.mls) p.set("mls", extra.mls);
      else if (/^[A-Za-z]?\d{5,9}$/.test(q)) p.set("mls", q);
      else if (q) p.set("address", q);
      ["type", "area", "sqft", "beds", "year", "lot", "waterfront"].forEach(function (n) { var v = $(n).value.trim(); if (v) p.set(n, v); });
      return p;
    }

    function run(extra) {
      out.innerHTML = '<div class="msg">Pulling comparable sales…</div>';
      fetch("/admin/api/cma?" + params(extra).toString()).then(function (r) { return r.json(); }).then(function (j) {
        if (j.matches) {
          out.innerHTML = '<div class="card matches"><strong>Which home?</strong>' + j.matches.map(function (m) {
            return '<a data-mls="' + esc(m.mls) + '">' + esc(m.address) + ' · ' + esc(m.area || "") + (m.city ? ", " + esc(m.city) : "") + ' · ' + esc(m.type || "") + ' · MLS® ' + esc(m.mls) + (m.status === "A" ? " · active" : "") + '</a>';
          }).join("") + "</div>";
          out.querySelectorAll("[data-mls]").forEach(function (a) { a.onclick = function () { run({ mls: a.getAttribute("data-mls") }); }; });
          return;
        }
        if (j.error) {
          out.innerHTML = '<div class="msg err' + (j.nearby ? " hint" : "") + '">' + esc(j.error) + "</div>";
          if (j.subject) fill(j.subject);
          document.getElementById("manual").open = true;
          if (j.nearby && !$("type").value) $("type").focus();
          return;
        }
        data = j; off = {}; cond = j.autoCondition || 0; photoRead = null; photoReadBusy = false;
        // cma-autovision-v1: fixer / development listings get their photos read automatically; the fixed % is the fallback
        if (j.projectKind && j.subject && j.subject.mls && j.subject.image) setTimeout(function () { startPhotoRead(true); }, 0);
        fill(j.subject);
        render();
      }).catch(function (e) { out.innerHTML = '<div class="msg err">' + esc(e.message) + "</div>"; });
    }

    function fill(s) {
      ["sqft", "beds", "year", "lot"].forEach(function (n) { $(n).placeholder = ""; });
      if (!s) return;
      if (s.sqft && !$("sqft").value) $("sqft").placeholder = s.sqft;
      if (s.beds && !$("beds").value) $("beds").placeholder = s.beds;
      if (s.year && !$("year").value) $("year").placeholder = s.year;
      if (s.lot && !$("lot").value) $("lot").placeholder = Math.round(s.lot);
    }

    // Weighted percentile over the ticked comps
    function pct(list, p) {
      var s = list.slice().sort(function (a, b) { return a.v - b.v; });
      var tot = s.reduce(function (t, x) { return t + x.w; }, 0), acc = 0;
      for (var i = 0; i < s.length; i++) { acc += s[i].w; if (acc / tot >= p) return s[i].v; }
      return s.length ? s[s.length - 1].v : null;
    }
    function summary() {
      var on = data.comps.filter(function (c) { return !off[c.mls]; }).map(function (c) { return { v: c.adjusted, w: Math.max(c.weight, 0.1) }; });
      if (!on.length) return null;
      var f = 1 + cond / 100;
      // cma-confidence-v1: range = likely × backtested band for this confidence level
      var band = (data.confidence && data.confidence.band) || [0.85, 1.15];
      var core = (data.confidence && data.confidence.core) || [0.94, 1.07];
      var likely = pct(on, 0.5) * f, lo = likely * core[0], hi = likely * core[1], wlo = likely * band[0], whi = likely * band[1];
      var r = function (v) { return Math.round(v / 1000) * 1000; };
      return { lo: r(lo), likely: r(likely), hi: r(hi), wlo: r(wlo), whi: r(whi), n: on.length, base: r(likely / f) };
    }
    function condLabel() { return cond <= -11 ? "Fixer / project" : cond < 0 ? "Dated" : cond > 0 ? "Updated" : "Average"; }
    function condCls() { return cond > 0 ? " up" : cond < 0 ? " down" : ""; }
    // cma-listgap-v1: for active listings, compare the asking price with the CMA instead of blending it in
    function listGap(sm) {
      var s = data.subject; if (!sm || !s || s.status !== "A" || !s.listPrice) return "";
      var g = s.listPrice / sm.likely - 1, pc = Math.round(Math.abs(g) * 100);
      var where = pc < 2 ? "in line with the CMA" : pc + "% " + (g > 0 ? "above" : "below") + " the CMA";
      var inside = s.listPrice >= sm.lo && s.listPrice <= sm.hi ? "inside the middle range" : s.listPrice >= sm.wlo && s.listPrice <= sm.whi ? "outside the middle range but inside the 8-in-10 range" : "outside the 8-in-10 range";
      var buyer = pc < 2 ? "The list price lines up with the sales around it." : g > 0 ? "Priced above what nearby sales support. Worth a closer look at what this home has that the comps don't before your buyer offers." : "Priced below what nearby sales support. Check the photos and condition for why, or it may be a chance for your buyer.";
      return '<p class="listgap ' + (pc < 2 ? "" : g > 0 ? "over" : "under") + '">Listed at <strong>' + money(s.listPrice) + "</strong> · " + where + " (" + inside + ")</p>" +
        '<p class="buyernote no-print"><strong>For your buyer:</strong> ' + buyer + " Set the condition slider to what you saw at the showing; the comps can't see condition.</p>";
    }
    function wideText(sm) { return sm ? "Half of similar sales landed between Low and High · 8 in 10 landed between <strong>" + k(sm.wlo) + "</strong> and <strong>" + k(sm.whi) + "</strong>" : ""; }
    function projectBlock() {
      var pj = data.subject && data.subject.project; if (!pj || !pj.length) return "";
      var said = 'The description says: <em>' + pj.map(esc).join(", ") + "</em>. ";
      var pr = photoRead && photoRead.auto && !photoRead.error ? photoRead : null, how;
      if (data.projectKind === "development") how = pr ? (pr.suggested_pct < (data.autoCondition || 0) ? "condition is set from the photos (<b>" + pr.suggested_pct + "%</b>), which judged the house worse than the land discount" : "condition stays at the land discount (<b>" + (data.autoCondition || 0) + "%</b>); the photos alone suggest " + pr.suggested_pct + "% for the house itself") : photoReadBusy ? "the photos are being read (land discount " + (data.autoCondition || 0) + "% for now)" : "condition is set to <b>" + (data.autoCondition || 0) + "%</b> to start, deliberately on the low side";
      else how = pr ? "condition is set from the photos (<b>" + pr.suggested_pct + "%</b>); the fixed " + data.autoCondition + "% is only used when photos can't be read" : photoReadBusy ? "the photos are being read to set condition (fallback " + data.autoCondition + "%)" : "condition is set to <b>" + data.autoCondition + "%</b> to start";
      if (data.projectKind === "fixer") return '<div class="projwarn"><strong>Fixer listing.</strong> ' + said + "In testing on past Nanaimo sales, the comps overvalued homes listed this way by about 20–30%, so " + how + ". Move it if what you saw was better or worse.</div>";
      if (data.autoCondition) return '<div class="projwarn dev"><strong>Marketed on land or development potential, with an older house.</strong> ' + said + "In testing, homes like this (built 1965 or earlier) sold about 9% below what the comps suggested; buyers pay for the lot, not the house, so " + how + ". Move it up if the house has real value.</div>";
      return '<div class="projwarn dev"><strong>Marketed on land or development potential.</strong> ' + said + "In testing, homes listed this way with newer houses sold close to the comps on average but scattered widely, because the lot can be worth more or less than the house suggests. No automatic adjustment; use the slider for the house's condition, and weigh the lot yourself.</div>";
    }
    function confBlock() {
      var c = data.confidence; if (!c) return "";
      var lab = { high: "High confidence", medium: "Medium confidence", low: "Low confidence" }[c.level];
      var tip = { high: "Tested on past Nanaimo sales: the Likely figure was usually within about 6% of what the home actually sold for.", medium: "Tested on past sales: the Likely figure was usually within about 8% of the actual sale price.", low: "Treat as a rough guide. Tested on past sales: the Likely figure was often 14% or more off the actual sale price." }[c.level];
      return '<div class="conf conf-' + c.level + '"><strong>' + lab + "</strong> · " + tip + (c.reasons && c.reasons.length ? '<ul>' + c.reasons.map(function (r) { return "<li>" + esc(r) + "</li>"; }).join("") + "</ul>" : "") + "</div>";
    }
    // cma-condbub-v1: live % and $ change riding on the slider dot
    function condBubble(sm) {
      var b = document.getElementById("condbub"), sl = document.getElementById("cond"); if (!b || !sl) return;
      var min = Number(sl.min), max = Number(sl.max), p = (cond - min) / (max - min);
      b.style.left = "calc(" + (p * 100) + "% + " + (9 - p * 18) + "px)";
      var d = sm ? sm.likely - sm.base : 0;
      b.textContent = cond === 0 ? "0%" : (cond > 0 ? "+" : "−") + Math.abs(cond) + "%" + (sm ? " · " + (d >= 0 ? "+" : "−") + "$" + Math.round(Math.abs(d) / 1000) + "K" : "");
      b.className = "condbub" + (cond > 0 ? " up" : cond < 0 ? " down" : "");
    }
    // cma-vision-v1: ask Claude to read the photos and description
    var photoRead = null, photoReadBusy = false;
    function photoReadBlock() {
      var s = data.subject; if (!s || !s.mls || !s.image) return "";
      if (photoReadBusy) return '<div class="pr"><p class="pr-busy">' + (data.projectKind ? "Fixer / development listing: reading the photos and description to set condition…" : "Reading the photos and description…") + "</p></div>";
      if (!photoRead) return '<div class="pr no-print"><button type="button" class="pr-btn" id="pr-go">📷 Read the photos &amp; description</button><span class="foot"> Claude looks at the listing photos and description and sets a suggested condition.</span></div>';
      if (photoRead.error) return '<div class="pr"><p class="pr-err">' + esc(photoRead.error) + "</p></div>";
      var r = photoRead, pc = r.suggested_pct;
      return '<div class="pr"><div class="pr-head"><strong>From the photos: ' + nice(r.overall) + '</strong><span class="pr-sug">suggests ' + (pc > 0 ? "+" : pc < 0 ? "−" : "") + Math.abs(pc) + "%</span>" +
        (cond !== pc ? '<button type="button" class="pr-apply" id="pr-apply">Apply ' + (pc > 0 ? "+" : pc < 0 ? "−" : "") + Math.abs(pc) + "%</button>" : '<span class="pr-on">applied</span>') + '<button type="button" class="pr-again no-print" id="pr-again">↻ Read again</button></div>' +
        '<p class="pr-sum">' + esc(r.summary || "") + "</p>" +
        '<ul class="pr-areas">' + (r.areas || []).map(function (a) { return '<li><b class="pr-' + esc(a.rating) + '">' + esc(a.area) + " · " + esc(a.rating) + "</b> " + esc(a.note) + "</li>"; }).join("") + "</ul>" +
        '<p class="foot">Based on ' + r.photos + " photos and the description · " + esc(r.confidence || "medium") + " confidence · your call on the slider.</p></div>";
    }
    function startPhotoRead(auto, fresh) {
      var forMls = data.subject.mls, condAtStart = cond;
      photoReadBusy = true; render();
      fetch("/admin/api/cma?city=" + encodeURIComponent(city) + "&photoread=" + encodeURIComponent(forMls) + (fresh ? "&fresh=1" : "")).then(function (r) { return r.json(); }).then(function (j) {
        if (!data || data.subject.mls !== forMls) return; // a different home was valued meanwhile
        photoRead = j; photoRead.auto = !!auto; photoReadBusy = false;
        // fixers: the photos decide. development land: keep the land discount unless the photos say worse (buyers pay for the lot).
        // apply the read unless the agent moved the slider while it was reading
        if (!j.error && cond === condAtStart) cond = data.projectKind === "development" ? Math.min(j.suggested_pct, data.autoCondition || 0) : j.suggested_pct;
        render();
      }).catch(function (e) { photoRead = { error: e.message }; photoReadBusy = false; render(); });
    }
    function wirePhotoRead() {
      var go = document.getElementById("pr-go"); if (go) go.onclick = function () { startPhotoRead(false); };
      var again = document.getElementById("pr-again"); if (again) again.onclick = function () { startPhotoRead(false, true); };
      var ap = document.getElementById("pr-apply"); if (ap) ap.onclick = function () { cond = photoRead.suggested_pct; render(); };
    }
    function condText() { return condLabel() + (cond ? " (" + (cond > 0 ? "+" : "") + cond + "%)" : ""); }
    function condNote(sm) {
      if (!sm) return "";
      if (!cond) return "Comps alone: <strong>" + money(sm.base) + "</strong> · no condition adjustment";
      if (photoRead && !photoRead.error && cond === photoRead.suggested_pct) return "Comps alone: <strong>" + money(sm.base) + "</strong> → set from the photos " + (cond > 0 ? "+" : "") + cond + "%: <strong>" + money(sm.likely) + "</strong> (<span class=\"delta\">" + signed(sm.likely - sm.base) + "</span>)";
      if (data.autoCondition && cond === data.autoCondition) return "Comps alone: <strong>" + money(sm.base) + "</strong> → auto-set for " + (data.projectKind === "fixer" ? "a fixer listing " : "an older house on development land ") + cond + "%: <strong>" + money(sm.likely) + "</strong> (<span class=\"delta\">" + signed(sm.likely - sm.base) + "</span>)";
      return "Comps alone: <strong>" + money(sm.base) + "</strong> → with condition " + (cond > 0 ? "+" : "") + cond + "%: <strong>" + money(sm.likely) + "</strong> (<span class=\"delta\">" + signed(sm.likely - sm.base) + "</span>)";
    }
    function condBlock(sm) {
      return '<div class="condbox' + condCls() + '"><div class="condhead"><strong>Condition adjustment</strong><span class="condval" id="cl">' + condText() + '</span></div>' +
        '<p class="condcall"><span class="condcall-i">!</span><span><strong>The comps can\'t see condition.</strong> MLS data doesn\'t know about updates, renos or wear. Set this to what you saw at the home; it moves the whole value range.</span></p>' +
        '<div class="no-print condslide"><span class="condbub" id="condbub"></span><span class="mid" aria-hidden="true"></span><input type="range" id="cond" min="-20" max="10" step="1" value="' + cond + '" list="cond-ticks" title="Double-click to reset to average" /><datalist id="cond-ticks"><option value="0"></option></datalist><div class="ticks"><span>Fixer / project −20%</span><button type="button" class="avg" id="cond-reset">Average</button><span>Updated +10%</span></div></div>' +
        '<p class="condnote" id="cn">' + condNote(sm) + '</p>' + photoReadBlock() + '</div>';
    }

    function render() {
      var s = data.subject, sm = summary();
      var maxW = Math.max.apply(null, data.comps.map(function (c) { return c.weight; }).concat([1]));
      // cma-subjcard-v1
      var facts = [
        ["Beds", s.beds], ["Baths", s.baths],
        ["Size", s.sqft ? Math.round(s.sqft).toLocaleString("en-CA") + " sq ft" : null],
        ["Built", s.year ? s.year + '<em>' + (new Date().getFullYear() - s.year) + " yrs</em>" : null],
        ["Lot", s.lot ? Math.round(s.lot).toLocaleString("en-CA") + " sq ft" + '<em>' + (s.lot / 43560).toFixed(2) + " ac</em>" : null],
        s.waterfront ? ["Waterfront", "Yes"] : null,
      ].filter(function (x) { return x && x[1] != null && x[1] !== ""; }).map(function (x) { return '<span class="sf"><span>' + x[0] + "</span><strong>" + x[1] + "</strong></span>"; }).join("");
      var subTitle = [nice(s.type || s.family), nice(s.area), s.mls ? "MLS® " + esc(s.mls) : "Entered by hand"].filter(Boolean).join(" · ");
      if (s.lastSold) subTitle += ' · <span class="subj-sold">Last sold <b>' + money(s.lastSold.price) + "</b> " + prettyDate(s.lastSold.date) + "</span>";
      var html = '<section class="card subjcard">' +
        (s.image ? '<img class="subj-img' + (s.status === "A" || s.lastSold ? ' subj-open" data-subj-open="1" title="Open listing' : "") + '" src="' + esc(s.image) + '" alt="" />' : "") +
