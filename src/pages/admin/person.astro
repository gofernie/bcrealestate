  <ListingViewer />
  </main>
  {p && (
    <script is:inline define:vars={{ siteId, pkey: p.key, pCity }}>
      (function () {
        function post(body) {
          return fetch("/admin/api/people", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(Object.assign({ site_id: siteId, key: pkey }, body)) }).then(function (r) { return r.json(); });
        }
        function flash(id, msg) { var el = document.getElementById(id); if (el) el.textContent = msg; }
