        document.querySelectorAll(".tk-x").forEach(function (x) { x.addEventListener("click", function () { if (!confirm("Delete this task?")) return; post({ action: "task_delete", id: x.dataset.id }).then(function (j) { if (j.ok) location.reload(); }); }); });
function v(id) { var el = document.getElementById(id); return el ? el.value.trim() : ""; }
        var dsv = document.getElementById("d-save"); if (dsv) dsv.addEventListener("click", function () { flash("d-saved", "Saving…"); post({ action: "details", address: v("d-address"), birthday: v("d-bday") }).then(function (j) { if (j.ok) location.reload(); else flash("d-saved", j.error || "Failed"); }); });
        document.querySelectorAll(".stats i[data-k]").forEach(function (c) { c.addEventListener("click", function () { var hits = document.querySelectorAll(".ti.k-" + c.dataset.k + (c.dataset.k === "love" ? ", .ti.k-react" : "")); if (!hits.length) return; hits[0].scrollIntoView({ behavior: "smooth", block: "center" }); hits.forEach(function (h) { h.classList.add("hl"); }); setTimeout(function () { hits.forEach(function (h) { h.classList.remove("hl"); }); }, 2500); }); });
        var emM = document.getElementById("em-modal");
        if (emM) {
          var emAuto = new URLSearchParams(location.search).get("email") || "", emIdeas = null, emCur = -1, emTx = document.getElementById("em-text"), emSub = document.getElementById("em-subject"), emMsg = document.getElementById("em-msg");
          emTx.addEventListener("input", function () { emTx.dataset.dirty = "1"; });
          var emPick = function (i) { var it = emIdeas && emIdeas[i]; if (!it) return; if (emTx.dataset.dirty === "1" && emTx.value.trim() && !confirm("Replace your draft with this idea?")) return; emSub.value = it.subject; emTx.value = it.body; emTx.dataset.dirty = "0"; emCur = i; document.querySelectorAll("#em-list .em-idea").forEach(function (b, k) { b.classList.toggle("on", k === i); }); emTx.focus(); emTx.setSelectionRange(0, 0); emTx.scrollTop = 0; };
          var emLoad = function () { var list = document.getElementById("em-list"); fetch("/admin/api/person-email?site_id=" + encodeURIComponent(siteId) + "&key=" + encodeURIComponent(pkey)).then(function (r) { return r.json(); }).then(function (j) { var cx = document.getElementById("em-ctx"); if (cx && j.context) { cx.textContent = j.context; cx.hidden = false; } emIdeas = j.ideas || []; list.innerHTML = ""; if (!emIdeas.length) { list.textContent = j.error || "No ideas right now."; return; } emIdeas.forEach(function (it, i) { var b = document.createElement("button"); b.type = "button"; b.className = "em-idea"; var tt = document.createElement("b"); tt.textContent = it.icon + " " + it.label; var s = document.createElement("span"); s.textContent = it.why || ""; b.appendChild(tt); b.appendChild(s); b.addEventListener("click", function () { emPick(i); }); list.appendChild(b); }); if (emAuto) { var ai = 0; emIdeas.forEach(function (it, i) { if (it.id === emAuto) ai = i; }); emPick(ai); emAuto = ""; } }).catch(function () { list.textContent = "Couldn't load ideas."; }); };
          var emOpen = function (to) { emM.hidden = false; document.body.style.overflow = "hidden"; if (to) document.getElementById("em-to").value = to; if (!emIdeas) emLoad(); };
          var emClose = function () { emM.hidden = true; document.body.style.overflow = ""; };
          var emBtn = document.getElementById("em-open"); if (emBtn) emBtn.addEventListener("click", function () { emOpen(""); });
          document.querySelectorAll(".em-link").forEach(function (a) { a.addEventListener("click", function (e) { e.preventDefault(); emOpen(a.dataset.to); }); });
          document.getElementById("em-close").addEventListener("click", emClose);
          if (emAuto) emOpen("");
          emM.addEventListener("click", function (e) { if (e.target === emM) emClose(); });
          document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !emM.hidden) emClose(); });
          document.getElementById("em-random").addEventListener("click", function () { if (!emIdeas || !emIdeas.length) return; var i = emIdeas.length === 1 ? 0 : emCur; while (emIdeas.length > 1 && i === emCur) i = Math.floor(Math.random() * emIdeas.length); emPick(i); });
          document.getElementById("em-send").addEventListener("click", function () {
            var btn = this, to = document.getElementById("em-to").value;
            if (!emSub.value.trim() || !emTx.value.trim()) { emMsg.textContent = "Add a subject and message"; return; }
            if (!confirm("Send this email to " + to + "?")) return;
            btn.disabled = true; btn.textContent = "Sending…"; emMsg.textContent = "";
            fetch("/admin/api/person-email", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ site_id: siteId, key: pkey, to: to, subject: emSub.value, body: emTx.value, idea: emCur >= 0 && emIdeas && emIdeas[emCur] ? emIdeas[emCur].id : "" }) })
              .then(function (r) { return r.json(); })
              .then(function (j) { if (j.ok) { emMsg.textContent = "Sent ✓"; setTimeout(function () { location.reload(); }, 700); } else { btn.disabled = false; btn.textContent = "Send"; emMsg.textContent = j.error || "Failed"; } })
              .catch(function () { btn.disabled = false; btn.textContent = "Send"; emMsg.textContent = "Failed"; });
          });
        }
        var homeBtns = Array.prototype.slice.call(document.querySelectorAll(".home-link")), byMls = {}, homeList = [];
        homeBtns.forEach(function (b) { var m = b.dataset.mls; if (!m || byMls[m]) return; byMls[m] = { mls: m, o: { mls: m, address: b.dataset.addr || "" }, url: b.dataset.url || "", city: pCity }; homeList.push(byMls[m]); });
        homeBtns.forEach(function (b) { b.addEventListener("click", function () { var o = byMls[b.dataset.mls]; if (o && window.ListingViewer) window.ListingViewer.open(Object.assign({}, o, { list: homeList })); }); });
var et = document.getElementById("edit-toggle");
        function setEdit(on) { document.body.classList.toggle("editing", on); if (et) { et.textContent = on ? "Done" : "Edit"; et.classList.toggle("dark", on); } try { if (on) sessionStorage.setItem("person-edit:" + pkey, "1"); else sessionStorage.removeItem("person-edit:" + pkey); } catch (e) {} }
        try { if (sessionStorage.getItem("person-edit:" + pkey)) setEdit(true); } catch (e) {}
        var pfIds = ["pf-name", "pf-email", "pf-phone", "pf-address", "pf-bday", "pf-listing", "pf-bprice", "pf-bmonth", "pf-btype"], pfInit = pfIds.map(function (id) { return v(id); });
        function saveProfile() {
          var dirty = pfIds.some(function (id, i) { return v(id) !== pfInit[i]; });
          if (!dirty) { setEdit(false); return; }
          et.textContent = "Saving…";
          post({ action: "profile", name: v("pf-name"), email: v("pf-email"), phone: v("pf-phone"), address: v("pf-address"), birthday: v("pf-bday"), listing_mls: v("pf-listing"), bought_price: v("pf-bprice"), bought_month: v("pf-bmonth"), bought_type: v("pf-btype") }).then(function (j) { if (j.ok) { setEdit(false); location.reload(); } else { et.textContent = "Done"; flash("pf-saved", j.error || "Failed"); } });
        }
        if (et) et.addEventListener("click", function () { if (document.body.classList.contains("editing")) saveProfile(); else { setEdit(true); var n = document.getElementById("pf-name"); if (n) { n.focus(); n.select(); } } });
        pfIds.forEach(function (id) { var el = document.getElementById(id); if (el) el.addEventListener("keydown", function (e) { if (e.key === "Enter") saveProfile(); }); });
        var spp = document.getElementById("sp-promote"); if (spp) spp.addEventListener("click", function () { var c = document.getElementById("pt-create"); if (c) { spp.textContent = "Saving…"; c.click(); } });
        var ptj = document.getElementById("pt-jump"); if (ptj) ptj.addEventListener("click", function () { setEdit(true); var c = document.getElementById("pt-card"); if (c) { c.scrollIntoView({ behavior: "smooth", block: "center" }); setTimeout(function () { var n = document.getElementById("pt-name"); if (n) n.focus(); }, 400); } });
        var ptc = document.getElementById("pt-create");
        if (ptc) ptc.addEventListener("click", function () { if (!v("pt-name")) { flash("pt-saved", "Name needed"); return; } if (!v("pt-email") && !v("pt-phone")) { flash("pt-saved", "Email or phone needed"); return; } flash("pt-saved", "Saving…"); post({ action: "create_person", name: v("pt-name"), email: v("pt-email"), phone: v("pt-phone"), birthday: v("pt-bday"), link: true }).then(function (j) { if (j.ok) location.reload(); else flash("pt-saved", j.error || "Failed"); }); });
        var ptl = document.getElementById("pt-link");
        if (ptl) ptl.addEventListener("click", function () { var val = v("pt-pick"), k = ""; document.querySelectorAll("#pt-people option").forEach(function (o) { if (o.value === val) k = o.dataset.key; }); if (!k) { flash("pt-saved", "Pick someone from the list"); return; } flash("pt-saved", "Linking…"); post({ action: "link_partner", partner_key: k }).then(function (j) { if (j.ok) location.reload(); else flash("pt-saved", j.error || "Failed"); }); });
        var ptu = document.getElementById("pt-unlink");
