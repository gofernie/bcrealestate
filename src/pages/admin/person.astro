  document.getElementById("em-preview").addEventListener("click", function () {
    var q = new URLSearchParams(location.search), w = window.open("", "_blank");
    if (w) w.document.write("<p style='font-family:Arial;padding:24px;color:#555'>Building preview\u2026</p>");
    var sub = document.getElementById("em-sub") || document.querySelector("#em-text") && tx.closest("form,div") && tx.closest("div").parentElement.querySelector("input[type=text],input:not([type])");
    fetch("/admin/api/person-email", { method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ site_id: q.get("site_id"), key: q.get("key"), to: (document.getElementById("em-to") || {}).value || "", subject: (sub && sub.value) || "Preview", body: tx.value, preview: true }) })
      .then(function (r) { return r.json(); })
      .then(function (j) { if (!w) return; w.document.open(); w.document.write(j.ok && j.html ? "<title>Email preview</title><div style='background:#f3f1ec;padding:24px'><div style='background:#fff;max-width:620px;margin:0 auto;padding:24px;border-radius:8px'>" + j.html + "</div></div>" : "<p style='font-family:Arial;padding:24px'>" + (j.error || "Preview failed") + "</p>"); w.document.close(); })
      .catch(function () { if (w) w.document.body.innerHTML = "<p style='font-family:Arial;padding:24px'>Preview failed</p>"; });
  });
  mark();
})();
</script>
