        var at = tx.dataset.pv === v && tx.dataset.pos != null ? Math.min(Number(tx.dataset.pos), v.length) : v.length;
        var before = v.slice(0, at), after = v.slice(at);
        var pre = before && !/\n$/.test(before) ? "\n" : "", post = after && !/^\n/.test(after) ? "\n" : "";
        tx.value = before + pre + line + post + after;
