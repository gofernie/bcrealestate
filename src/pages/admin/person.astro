    var L = (document.getElementById("em-list") || {}).textContent || "";
    var n = L.match(/([A-Z][A-Za-z .'-]+?) market update/); return n ? n[1].trim() : "";
  };
  var mark = function () { btns.forEach(function (b) { var on = new RegExp("\\[" + esc(b.dataset.intel) + " \u00b7 ").test(tx.value); b.classList.toggle("on", on); b.textContent = (on ? "\u2713 " : "+ ") + b.textContent.replace(/^(\+|\u2713) /, ""); }); };
  var save = function () { tx.dataset.pos = String(tx.selectionStart); tx.dataset.pv = tx.value; }; ["keyup", "mouseup"].forEach(function (e) { tx.addEventListener(e, save); });
  tx.addEventListener("input", mark);
