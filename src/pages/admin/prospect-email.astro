---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Prospect Email Generator">
  <main class="peg-page">
    <div class="peg-shell">

      <header class="peg-header">
        <div>
          <p class="peg-kicker">LOCUS SALES</p>
          <h1>Prospect Email Generator</h1>
          <p class="peg-intro">
            Personalize the note, choose what to showcase,
            and send the agent directly into the working parts
            of their own Locus site.
          </p>
        </div>

        <a class="peg-back" href="/admin">
          Back to admin
        </a>
      </header>


      <div class="peg-layout">

        <section class="peg-builder">

          <div class="peg-card">
            <div class="peg-card-head">
              <div>
                <p class="peg-label">PROSPECT</p>
                <h2>Who are we sending this to?</h2>
              </div>
            </div>

            <div class="peg-grid peg-grid--2">
              <label>
                <span>Agent name</span>
                <input
                  id="agent-name"
                  type="text"
                  value="Tammy"
                />
              </label>

              <label>
                <span>Website</span>
                <input
                  id="site-domain"
                  type="text"
                  value="tammygalvin.bc.realestate"
                />
              </label>

              <label>
                <span>Primary market</span>
                <input
                  id="primary-market"
                  type="text"
                  value="Nanaimo"
                />
              </label>

              <label>
                <span>Other markets</span>
                <input
                  id="other-markets"
                  type="text"
                  value="Parksville, Qualicum Beach, Lantzville"
                />
              </label>
            </div>
          </div>


          <div class="peg-card">
            <div class="peg-card-head">
              <div>
                <p class="peg-label">OPENING</p>
                <h2>Personal note</h2>
              </div>

              <select id="tone">
                <option value="casual">Casual</option>
                <option value="concise">Concise</option>
                <option value="sales">More sales-focused</option>
                <option value="technical">More technical</option>
              </select>
            </div>

            <textarea
              id="personal-note"
              rows="6"
            >Rather than send you a long sales pitch, I thought it would be more useful to give you a working Locus site and a few things to actually try.</textarea>
          </div>


          <div class="peg-card">
            <div class="peg-card-head">
              <div>
                <p class="peg-label">PRESET</p>
                <h2>What story do you want to tell?</h2>
              </div>
            </div>

            <div class="peg-presets">
              <button type="button" data-preset="quick">
                Quick intro
              </button>

              <button type="button" data-preset="buyer">
                Buyer experience
              </button>

              <button type="button" data-preset="leads">
                Lead generation
              </button>

              <button type="button" data-preset="seo">
                SEO / Google
              </button>

              <button type="button" data-preset="power">
                Power user
              </button>

              <button
                type="button"
                data-preset="full"
                class="is-active"
              >
                Full platform tour
              </button>
            </div>
          </div>


          <div class="peg-card">
            <div class="peg-card-head">
              <div>
                <p class="peg-label">SHOWCASE</p>
                <h2>Choose the talking points</h2>
              </div>

              <button
                class="peg-small-button"
                id="select-all"
                type="button"
              >
                Select all
              </button>
            </div>

            <div class="peg-features">

              <label>
                <input
                  type="checkbox"
                  data-feature="search"
                  checked
                />
                <span>
                  <strong>Smart search</strong>
                  <small>
                    Inventory-aware prices, same-floor bedrooms,
                    primary bedroom on main.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="listing"
                  checked
                />
                <span>
                  <strong>Listing experience</strong>
                  <small>
                    Pics, Floorplan, Map, automatic floorplan
                    surfacing and downloads.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="reactions"
                  checked
                />
                <span>
                  <strong>Love / Like / Nope</strong>
                  <small>
                    Buyer interaction becomes useful intent.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="shortlist"
                  checked
                />
                <span>
                  <strong>Shortlists</strong>
                  <small>
                    Show the buyer version and how easy it is
                    for the agent to create one.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="alerts"
                  checked
                />
                <span>
                  <strong>Email / SMS alerts</strong>
                  <small>
                    Let buyers choose how they want new listings.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="entry"
                  checked
                />
                <span>
                  <strong>Entry Points</strong>
                  <small>
                    Show what the ad promised before asking
                    for contact information.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="type"
                  checked
                />
                <span>
                  <strong>Type pages</strong>
                  <small>
                    Homes, condos, townhouses and other focused
                    search pages.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="area"
                  checked
                />
                <span>
                  <strong>Area pages</strong>
                  <small>
                    Listings plus OpenStreetMap and Census data.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="market"
                  checked
                />
                <span>
                  <strong>Market Intelligence</strong>
                  <small>
                    Inventory, pricing, activity and
                    market-to-market comparison.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="markets"
                  checked
                />
                <span>
                  <strong>Multiple markets</strong>
                  <small>
                    One primary market plus the other places
                    the agent actually works.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="speed"
                  checked
                />
                <span>
                  <strong>Fast by design</strong>
                  <small>
                    Sell the actual page-to-page experience,
                    not just a performance score.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="google"
                  checked
                />
                <span>
                  <strong>Google / site structure</strong>
                  <small>
                    Real URLs, type pages, area pages,
                    listing pages and sitemap XML.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="intent"
                  checked
                />
                <span>
                  <strong>Intent Sessions</strong>
                  <small>
                    Show the agent what buyer behaviour looks
                    like from their side.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="leads"
                  checked
                />
                <span>
                  <strong>Leads</strong>
                  <small>
                    Connect the buyer experience to the agent
                    workflow.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="admin"
                  checked
                />
                <span>
                  <strong>Easy admin / content</strong>
                  <small>
                    Markets, Entry Points, content, leads and
                    shortlists without calling a developer.
                  </small>
                </span>
              </label>

              <label>
                <input
                  type="checkbox"
                  data-feature="upgrades"
                  checked
                />
                <span>
                  <strong>Platform upgrades</strong>
                  <small>
                    Locus keeps improving and the agent benefits.
                  </small>
                </span>
              </label>

            </div>
          </div>


          <div class="peg-card">
            <div class="peg-card-head">
              <div>
                <p class="peg-label">DEEP LINKS</p>
                <h2>Where should they click?</h2>
              </div>

              <button
                class="peg-small-button"
                id="build-default-links"
                type="button"
              >
                Build defaults
              </button>
            </div>

            <p class="peg-help">
              Defaults are generated from the agent's domain
              and primary market. Replace any of them with a
              better demo URL when you have one.
            </p>

            <div class="peg-links">

              <label>
                <span>Search</span>
                <input id="link-search" type="text" />
              </label>

              <label>
                <span>Good listing with floorplan</span>
                <input id="link-listing" type="text" />
              </label>

              <label>
                <span>Buyer browsing / reactions</span>
                <input id="link-reactions" type="text" />
              </label>

              <label>
                <span>Buyer shortlist demo</span>
                <input id="link-shortlist-demo" type="text" />
              </label>

              <label>
                <span>Create shortlist</span>
                <input id="link-shortlist-create" type="text" />
              </label>

              <label>
                <span>Entry Point</span>
                <input id="link-entry" type="text" />
              </label>

              <label>
                <span>Create Entry Point</span>
                <input id="link-entry-create" type="text" />
              </label>

              <label>
                <span>Type page</span>
                <input id="link-type" type="text" />
              </label>

              <label>
                <span>Area page</span>
                <input id="link-area" type="text" />
              </label>

              <label>
                <span>Market Intelligence</span>
                <input id="link-market" type="text" />
              </label>

              <label>
                <span>Intent Sessions</span>
                <input id="link-intent" type="text" />
              </label>

              <label>
                <span>Leads</span>
                <input id="link-leads" type="text" />
              </label>

              <label>
                <span>Manage site / markets</span>
                <input id="link-admin" type="text" />
              </label>

              <label>
                <span>XML sitemap</span>
                <input id="link-sitemap" type="text" />
              </label>

            </div>
          </div>


          <div class="peg-card peg-card--closing">
            <div class="peg-card-head">
              <div>
                <p class="peg-label">CLOSE</p>
                <h2>Price and sign-off</h2>
              </div>
            </div>

            <div class="peg-grid peg-grid--2">
              <label>
                <span>Price</span>
                <input
                  id="price"
                  type="text"
                  value="$59/month"
                />
              </label>

              <label>
                <span>Sender</span>
                <input
                  id="sender"
                  type="text"
                  value="Chris"
                />
              </label>
            </div>
          </div>


          <button
            class="peg-generate"
            id="generate"
            type="button"
          >
            Generate Email
          </button>

          <button
            class="peg-generate"
            id="publish-prospect"
            type="button"
            style="margin-top:12px;"
          >
            Publish Prospect Page
          </button>

          <div
            id="prospect-publish-result"
            hidden
            style="
              margin-top:16px;
              padding:16px;
              border:1px solid rgba(0,0,0,.12);
              border-radius:14px;
              background:#fff;
            "
          >
            <strong id="prospect-publish-status">
              Prospect page published
            </strong>

            <div
              id="prospect-publish-url"
              style="
                margin-top:8px;
                font-size:.9rem;
                overflow-wrap:anywhere;
              "
            ></div>

            <div
              style="
                display:flex;
                gap:10px;
                flex-wrap:wrap;
                margin-top:12px;
              "
            >
              <button
                id="copy-prospect-link"
                type="button"
              >
                Copy link
              </button>

              <a
                id="open-prospect-page"
                href="#"
                target="_blank"
                rel="noopener"
              >
                Open page →
              </a>
            </div>
          </div>

        </section>


        <aside class="peg-preview">

          <div class="peg-preview-card">
            <div class="peg-preview-head">
              <div>
                <p class="peg-label">EMAIL PREVIEW</p>
                <h2>Ready to send</h2>
              </div>

              <div class="peg-copy-buttons">
                <button id="copy-subject" type="button">
                  Copy subject
                </button>

                <button id="copy-email" type="button">
                  Copy email
                </button>
              </div>
            </div>

            <label class="peg-subject-wrap">
              <span>Subject</span>
              <input
                id="email-subject"
                type="text"
                readonly
              />
            </label>

            <pre id="email-preview"></pre>
          </div>

        </aside>

      </div>

    </div>
  </main>
</Layout>


<style>
  :global(body) {
    margin: 0;
    background: #f5f7f7;
    color: #10283b;
  }

  .peg-page,
  .peg-page button,
  .peg-page input,
  .peg-page textarea,
  .peg-page select {
    font-family:
      var(--sans),
      ui-sans-serif,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .peg-page {
    min-height: 100vh;
    padding: 44px 0 90px;
  }

  .peg-shell {
    width: min(1500px, calc(100% - 40px));
    margin: 0 auto;
  }

  .peg-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 32px;
  }

  .peg-kicker,
  .peg-label {
    margin: 0 0 8px;
    color: #28777d;
    font-size: .68rem;
    font-weight: 850;
    letter-spacing: .15em;
  }

  .peg-header h1 {
    margin: 0;
    font-size: clamp(2.3rem, 4vw, 4.5rem);
    line-height: .96;
    letter-spacing: -.055em;
  }

  .peg-intro {
    max-width: 680px;
    margin: 18px 0 0;
    color: #61727c;
    font-size: 1rem;
    line-height: 1.6;
  }

  .peg-back {
    color: #28777d;
    font-size: .85rem;
    font-weight: 750;
    text-decoration: none;
  }

  .peg-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(400px, .95fr);
    gap: 24px;
    align-items: start;
  }

  .peg-builder {
    display: grid;
    gap: 18px;
  }

  .peg-card,
  .peg-preview-card {
    border: 1px solid #dfe7e7;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 14px 45px rgba(16,40,59,.045);
  }

  .peg-card {
    padding: 24px;
  }

  .peg-card h2,
  .peg-preview h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -.03em;
  }

  .peg-card-head,
  .peg-preview-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 20px;
  }

  .peg-grid {
    display: grid;
    gap: 14px;
  }

  .peg-grid--2 {
    grid-template-columns: repeat(2, minmax(0,1fr));
  }

  .peg-card label,
  .peg-subject-wrap {
    display: grid;
    gap: 6px;
  }

  .peg-card label > span,
  .peg-subject-wrap > span {
    color: #65767f;
    font-size: .72rem;
    font-weight: 750;
  }

  .peg-card input,
  .peg-card textarea,
  .peg-card select,
  .peg-subject-wrap input {
    box-sizing: border-box;
    width: 100%;
    border: 1px solid #d8e1e1;
    border-radius: 9px;
    background: #fff;
    color: #183440;
    font-size: .87rem;
    outline: none;
  }

  .peg-card input,
  .peg-card select,
  .peg-subject-wrap input {
    min-height: 42px;
    padding: 9px 11px;
  }

  .peg-card textarea {
    padding: 12px;
    line-height: 1.55;
    resize: vertical;
  }

  .peg-card input:focus,
  .peg-card textarea:focus,
  .peg-card select:focus {
    border-color: #28777d;
    box-shadow: 0 0 0 3px rgba(40,119,125,.08);
  }

  #tone {
    width: auto;
    min-width: 160px;
  }

  .peg-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .peg-presets button,
  .peg-small-button,
  .peg-copy-buttons button {
    border: 1px solid #d7e2e2;
    border-radius: 999px;
    background: #fff;
    color: #35505a;
    cursor: pointer;
    font-size: .74rem;
    font-weight: 750;
  }

  .peg-presets button {
    padding: 9px 13px;
  }

  .peg-presets button.is-active {
    border-color: #28777d;
    background: #eaf4f3;
    color: #236970;
  }

  .peg-small-button {
    padding: 7px 11px;
  }

  .peg-features {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 10px;
  }

  .peg-features label {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: flex-start;
    padding: 13px;
    border: 1px solid #e3e9e9;
    border-radius: 11px;
    cursor: pointer;
  }

  .peg-features input {
    width: 16px;
    min-height: 16px;
    margin-top: 2px;
    accent-color: #28777d;
  }

  .peg-features label > span {
    display: grid;
    gap: 3px;
  }

  .peg-features strong {
    color: #183540;
    font-size: .78rem;
  }

  .peg-features small {
    color: #71818a;
    font-size: .68rem;
    line-height: 1.4;
  }

  .peg-help {
    margin: -5px 0 18px;
    color: #72828a;
    font-size: .76rem;
    line-height: 1.5;
  }

  .peg-links {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 11px 14px;
  }

  .peg-generate {
    width: 100%;
    padding: 16px;
    border: 0;
    border-radius: 12px;
    background: #28777d;
    color: #fff;
    cursor: pointer;
    font-size: .9rem;
    font-weight: 850;
  }

  .peg-preview {
    position: sticky;
    top: 22px;
  }

  .peg-preview-card {
    overflow: hidden;
  }

  .peg-preview-head {
    padding: 22px 22px 0;
  }

  .peg-copy-buttons {
    display: flex;
    gap: 7px;
  }

  .peg-copy-buttons button {
    padding: 8px 11px;
  }

  .peg-subject-wrap {
    margin: 0 22px 18px;
  }

  .peg-subject-wrap input {
    background: #f7f9f9;
  }

  #email-preview {
    box-sizing: border-box;
    overflow: auto;
    width: 100%;
    max-height: calc(100vh - 230px);
    min-height: 620px;
    margin: 0;
    padding: 24px;
    border-top: 1px solid #e3e9e9;
    background: #fbfcfc;
    color: #29444f;
    font:
      .82rem/1.65
      var(--sans),
      ui-sans-serif,
      sans-serif;
    white-space: pre-wrap;
  }

  @media (max-width: 1050px) {
    .peg-layout {
      grid-template-columns: 1fr;
    }

    .peg-preview {
      position: static;
    }

    #email-preview {
      max-height: none;
    }
  }

  @media (max-width: 700px) {
    .peg-shell {
      width: min(100% - 24px,1500px);
    }

    .peg-header {
      display: grid;
    }

    .peg-grid--2,
    .peg-features,
    .peg-links {
      grid-template-columns: 1fr;
    }

    .peg-card-head,
    .peg-preview-head {
      display: grid;
    }
  }
</style>


<script is:inline>
(() => {
  const $ = (id) =>
    document.getElementById(id);

  const featureBoxes =
    Array.from(
      document.querySelectorAll(
        "[data-feature]"
      )
    );

  const presets = {
    quick: [
      "search",
      "listing",
      "shortlist",
      "entry",
      "market",
      "speed",
      "upgrades"
    ],

    buyer: [
      "search",
      "listing",
      "reactions",
      "shortlist",
      "alerts",
      "entry",
      "type",
      "area",
      "market"
    ],

    leads: [
      "reactions",
      "shortlist",
      "alerts",
      "entry",
      "intent",
      "leads",
      "admin",
      "upgrades"
    ],

    seo: [
      "entry",
      "type",
      "area",
      "market",
      "markets",
      "speed",
      "google",
      "upgrades"
    ],

    power: [
      "search",
      "listing",
      "reactions",
      "shortlist",
      "entry",
      "market",
      "intent",
      "leads",
      "admin",
      "google",
      "upgrades"
    ],

    full: [
      "search",
      "listing",
      "reactions",
      "shortlist",
      "alerts",
      "entry",
      "type",
      "area",
      "market",
      "markets",
      "speed",
      "google",
      "intent",
      "leads",
      "admin",
      "upgrades"
    ]
  };

  const cleanDomain = (value) =>
    String(value || "")
      .trim()
      .replace(/^https?:\/\//i, "")
      .replace(/\/+$/g, "");

  const slugify = (value) =>
    String(value || "")
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

  const link = (id) =>
    $(id)?.value.trim() || "";

  const withLink = (
    label,
    url
  ) => {
    if (!url) return "";
    return `${label}\n${url}`;
  };

  const selected =
    (feature) =>
      featureBoxes.some(
        (box) =>
          box.dataset.feature === feature &&
          box.checked
      );

  function buildDefaultLinks() {
    const domain =
      cleanDomain($("site-domain")?.value);

    const market =
      slugify($("primary-market")?.value);

    if (!domain || !market) return;

    const base =
      `https://${domain}`;

    $("link-search").value =
      `${base}/${market}`;

    if (!$("link-listing").value) {
      $("link-listing").placeholder =
        `${base}/${market}/your-demo-listing`;
    }

    $("link-reactions").value =
      `${base}/${market}`;

    $("link-shortlist-create").value =
      `${base}/listings`;

    $("link-entry").value =
      `${base}/${market}/homes?price=under-500000`;

    $("link-type").value =
      `${base}/${market}/condos`;

    $("link-area").value =
      `${base}/${market}/north-${market}`;

    $("link-market").value =
      `${base}/${market}/market-intelligence`;

    $("link-intent").value =
      `${base}/admin/intent-sessions`;

    $("link-leads").value =
      `${base}/admin/leads`;

    $("link-admin").value =
      `${base}/admin/sites`;

    $("link-sitemap").value =
      `${base}/sitemap.xml`;
  }


  function featureSection(
    title,
    body,
    label,
    url
  ) {
    const parts = [
      title,
      body
    ];

    const linked =
      withLink(label, url);

    if (linked) {
      parts.push(linked);
    }

    return parts.join("\n\n");
  }


  function generate() {
    const agent =
      $("agent-name")?.value.trim() ||
      "there";

    const domain =
      cleanDomain(
        $("site-domain")?.value
      );

    const primary =
      $("primary-market")?.value.trim() ||
      "your market";

    const others =
      $("other-markets")?.value.trim();

    const personal =
      $("personal-note")?.value.trim();

    const price =
      $("price")?.value.trim() ||
      "$59/month";

    const sender =
      $("sender")?.value.trim() ||
      "Chris";

    const subject =
      `${agent}, I built this for you`;

    $("email-subject").value =
      subject;

    const sections = [];

    sections.push(
      `Hi ${agent},`
    );

    if (personal) {
      sections.push(personal);
    }

    if (domain) {
      sections.push(
        `Here's the working site:\nhttps://${domain}`
      );
    }


    if (selected("search")) {
      sections.push(
        featureSection(
          "SEARCH LIKE AN ACTUAL BUYER",
          `You know that family that wants 3 or 4 bedrooms on the same floor? Or the retired couple who needs the primary bedroom on the main? Locus can search for both.\n\nThe price choices also adapt to actual market inventory, so buyers aren't being offered searches that simply lead to zero homes.`,
          "Try the search →",
          link("link-search")
        )
      );
    }


    if (selected("listing")) {
      sections.push(
        featureSection(
          "OPEN A LISTING",
          `Try Pics · Floorplan · Map. When a floorplan exists, Locus recognises it and brings it forward instead of leaving the buyer to hunt through listing photos.\n\nFloorplans and property brochures can also be downloaded.`,
          "Open a listing →",
          link("link-listing")
        )
      );
    }


    if (selected("reactions")) {
      sections.push(
        featureSection(
          "PRETEND YOU'RE THE BUYER",
          `Love a couple of homes. Like one. Nope another.\n\nThose simple reactions make browsing easier for the buyer while giving the agent a much clearer idea of what actually matters to them.`,
          "Try Love / Like / Nope →",
          link("link-reactions")
        )
      );
    }


    if (selected("shortlist")) {
      let shortlist =
        `SHORTLISTS\n\nYou know the buyer who says, "Can you send me those three places again?" Locus makes that easy.\n\nBuild a shortlist, send it, and give the buyer a clean place to keep the homes they're considering.`;

      const demo =
        withLink(
          "See what a buyer receives →",
          link("link-shortlist-demo")
        );

      const create =
        withLink(
          "Create a shortlist yourself →",
          link("link-shortlist-create")
        );

      if (demo) shortlist +=
        `\n\n${demo}`;

      if (create) shortlist +=
        `\n\n${create}`;

      sections.push(shortlist);
    }


    if (selected("alerts")) {
      sections.push(
        `LET THE BUYER CHOOSE\n\nWhen someone wants new matches, let them choose how they want to hear about them — email or SMS.\n\nThe contact request comes after Locus has already been useful, rather than before the buyer has seen anything.`
      );
    }


    if (selected("entry")) {
      let entry =
        `SHOW THEM WHAT YOU PROMISED TO SHOW THEM\n\nIf an ad says "${primary} homes under $500k", the click should show ${primary} homes under $500k.\n\nNot a form asking for their name, email and phone number before they're allowed to see the homes.\n\nLocus Entry Points let the buyer explore first, demonstrate value and build trust. Then you ask for contact when there's actually a reason to.`;

      const view =
        withLink(
          "See an Entry Point →",
          link("link-entry")
        );

      const create =
        withLink(
          "Create one yourself →",
          link("link-entry-create")
        );

      if (view) entry +=
        `\n\n${view}`;

      if (create) entry +=
        `\n\n${create}`;

      sections.push(entry);
    }


    if (selected("type")) {
      sections.push(
        featureSection(
          "GO CONDO SHOPPING",
          `Type pages aren't just static landing pages. Open the ${primary} condo page and try changing the area, price or bedrooms while staying inside a proper focused page.`,
          `Explore ${primary} condos →`,
          link("link-type")
        )
      );
    }


    if (selected("area")) {
      sections.push(
        featureSection(
          "EXPLORE A NEIGHBOURHOOD",
          `Listings are only part of deciding where to live. Locus area pages can combine homes with OpenStreetMap amenities and Census data so the page actually helps someone understand the neighbourhood.`,
          "Explore an area →",
          link("link-area")
        )
      );
    }


    if (selected("market")) {
      sections.push(
        featureSection(
          "WHICH MARKET IS ACTUALLY DOING BETTER?",
          `Market Intelligence gives buyers useful context around inventory, sales, pricing and activity — and lets them compare how different markets are performing rather than relying on a feeling that one place is "busier".`,
          "Open Market Intelligence →",
          link("link-market")
        )
      );
    }


    if (selected("markets")) {
      let text =
        `ONE SITE. MULTIPLE MARKETS.\n\nYour homepage can lead with ${primary} without pretending you don't work anywhere else.`;

      if (others) {
        text +=
          `\n\nThe same site can also properly represent ${others}.`;
      }

      sections.push(text);
    }


    if (selected("speed")) {
      sections.push(
        `ONE MORE TEST: CLICK AROUND QUICKLY\n\nResults → listing → floorplan → back → area → another listing.\n\nNotice how it feels.\n\nLocus is built to feel fast because buyers experience a website as fast or frustrating — not as a technical performance score. Good performance supports the kind of user experience search engines increasingly expect as well.`
      );
    }


    if (selected("google")) {
      sections.push(
        featureSection(
          "GOOGLE CAN ACTUALLY FIND THE SITE",
          `Markets, areas, property types and listings can live on real URLs instead of disappearing inside an embedded IDX widget.\n\nLocus gives the site a proper technical structure around that too — real pages, internal discovery and XML sitemap coverage.`,
          "View the XML sitemap →",
          link("link-sitemap")
        )
      );
    }


    if (selected("intent")) {
      sections.push(
        featureSection(
          "NOW SEE WHAT THE AGENT SEES",
          `Locus Intent Sessions let you refer back to what a buyer searched, viewed and reacted to instead of trying to reconstruct their behaviour from memory.`,
          "View Intent Sessions →",
          link("link-intent")
        )
      );
    }


    if (selected("leads")) {
      sections.push(
        featureSection(
          "LEADS DON'T LIVE IN A VACUUM",
          `The buyer experience connects back to the agent side, where you can see the people who have engaged and the context around that engagement.`,
          "Open Leads →",
          link("link-leads")
        )
      );
    }


    if (selected("admin")) {
      sections.push(
        featureSection(
          "THE AGENT SIDE STAYS SIMPLE",
          `Manage markets, create Entry Points and content, work with leads, review Intent Sessions and build shortlists without needing a developer every time you want to change something.`,
          "Open the admin →",
          link("link-admin")
        )
      );
    }


    if (selected("upgrades")) {
      sections.push(
        `AND LOCUS WON'T STAND STILL\n\nI'm continually working on Locus — improving existing features, polishing the experience and building new ones.\n\nOngoing Locus platform improvements are included with your subscription, so as Locus gets better, your site benefits too.\n\nI also genuinely like feedback. If something could work better, or there's something you wish Locus could do, tell me. I'm the person building it and I want to hear it.`
      );
    }


    sections.push(
      `${price}.\nYour name. Your markets. Your site.`
    );

    sections.push(sender);

    $("email-preview").textContent =
      sections.join("\n\n\n");
  }


  document
    .querySelectorAll("[data-preset]")
    .forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const preset =
            button.dataset.preset;

          const enabled =
            presets[preset] || [];

          featureBoxes.forEach(
            (box) => {
              box.checked =
                enabled.includes(
                  box.dataset.feature
                );
            }
          );

          document
            .querySelectorAll(
              "[data-preset]"
            )
            .forEach((item) => {
              item.classList.toggle(
                "is-active",
                item === button
              );
            });

          generate();
        }
      );
    });


  $("select-all")?.addEventListener(
    "click",
    () => {
      const allChecked =
        featureBoxes.every(
          (box) => box.checked
        );

      featureBoxes.forEach(
        (box) => {
          box.checked = !allChecked;
        }
      );

      generate();
    }
  );


  $("build-default-links")
    ?.addEventListener(
      "click",
      () => {
        buildDefaultLinks();
        generate();
      }
    );


  $("generate")?.addEventListener(
    "click",
    generate
  );


  $("copy-subject")
    ?.addEventListener(
      "click",
      async () => {
        const value =
          $("email-subject")?.value || "";

        await navigator.clipboard.writeText(
          value
        );

        const button =
          $("copy-subject");

        const original =
          button.textContent;

        button.textContent =
          "Copied";

        setTimeout(() => {
          button.textContent =
            original;
        }, 1200);
      }
    );


  $("copy-email")
    ?.addEventListener(
      "click",
      async () => {
        const value =
          $("email-preview")
            ?.textContent || "";

        await navigator.clipboard.writeText(
          value
        );

        const button =
          $("copy-email");

        const original =
          button.textContent;

        button.textContent =
          "Copied";

        setTimeout(() => {
          button.textContent =
            original;
        }, 1200);
      }
    );


  [
    "agent-name",
    "site-domain",
    "primary-market",
    "other-markets",
    "personal-note",
    "tone",
    "price",
    "sender"
  ].forEach((id) => {
    $(id)?.addEventListener(
      "input",
      generate
    );
  });


  featureBoxes.forEach(
    (box) => {
      box.addEventListener(
        "change",
        generate
      );
    }
  );


  function getProspectSlug() {
    const name =
      $("agent-name")?.value.trim() || "prospect";

    return slugify(name) || "prospect";
  }

  function getProspectSections() {
    const sections = {};

    featureBoxes.forEach((box) => {
      const key =
        box.dataset.feature ||
        box.value ||
        box.id
          ?.replace(/^feature-/, "");

      if (key) {
        sections[key] = box.checked;
      }
    });

    return sections;
  }

  function normalizeListingLink() {
    const raw =
      $("link-listing")?.value.trim() || "";

    if (!raw) return "";

    // Accept:
    // 1048347
    // /nanaimo/listing/1048347
    // https://bc.realestate/nanaimo/listing/1048347
    const match = raw.match(
      /(?:\/listing\/)?(\d{6,})\/?(?:[?#].*)?$/
    );

    if (!match) return raw;

    const listingId = match[1];

    const domain = String(
      $("site-domain")?.value || ""
    )
      .trim()
      .replace(/^https?:\/\//, "")
      .replace(/\/.*$/, "");

    const market =
      slugify(
        $("primary-market")?.value || ""
      ) || "nanaimo";

    return `https://${domain}/${market}?listing_id=${encodeURIComponent(listingId)}`;
  }

  function getProspectLinks() {
    const read = (id) =>
      $(id)?.value.trim() || "";

    return {
      search: read("link-search"),
      listing: normalizeListingLink(),
      reactions: read("link-reactions"),
      shortlist_demo:
        read("link-shortlist-demo"),
      shortlist_create:
        read("link-shortlist-create"),
      entry: read("link-entry"),
      entry_create:
        read("link-entry-create"),
      type: read("link-type"),
      area: read("link-area"),
      market: read("link-market"),
      intent: read("link-intent"),
      leads: read("link-leads"),
      admin: read("link-admin"),
      sitemap: read("link-sitemap")
    };
  }

  async function publishProspectPage() {
    const button =
      $("publish-prospect");

    const result =
      $("prospect-publish-result");

    const status =
      $("prospect-publish-status");

    const urlEl =
      $("prospect-publish-url");

    const openLink =
      $("open-prospect-page");

    if (!button) return;

    const originalText =
      button.textContent;

    button.disabled = true;
    button.textContent = "Publishing...";

    try {
      const domain = String(
        $("site-domain")?.value || ""
      )
        .trim()
        .replace(/^https?:\/\//, "")
        .replace(/\/.*$/, "");

      const otherMarkets = String(
        $("other-markets")?.value || ""
      )
        .split(",")
        .map((value) => value.trim())
        .filter(Boolean);

      const response = await fetch(
        "/api/prospect-pages/save",
        {
          method: "POST",
          headers: {
            "Content-Type":
              "application/json"
          },
          body: JSON.stringify({
            agentName:
              $("agent-name")?.value.trim(),
            domain,
            slug: getProspectSlug(),
            primaryMarket:
              $("primary-market")?.value.trim(),
            otherMarkets,
            personalNote:
              $("personal-note")?.value.trim(),
            price:
              $("price")?.value.trim(),
            sections:
              getProspectSections(),
            links:
              getProspectLinks()
          })
        }
      );

      const data = await response.json();

      if (!response.ok || !data.ok) {
        throw new Error(
          data.error ||
          "Unable to publish prospect page."
        );
      }

      if (result) result.hidden = false;

      if (status) {
        status.textContent =
          "Prospect page published";
      }

      if (urlEl) {
        urlEl.textContent = data.url;
      }

      if (openLink) {
        const slug = getProspectSlug();

        openLink.href =
          `${window.location.origin}/for/${slug}?domain=${encodeURIComponent(domain)}`;
      }

      result?.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
      });
    } catch (error) {
      if (result) result.hidden = false;

      if (status) {
        status.textContent =
          error instanceof Error
            ? error.message
            : "Unable to publish prospect page.";
      }

      if (urlEl) {
        urlEl.textContent = "";
      }
    } finally {
      button.disabled = false;
      button.textContent = originalText;
    }
  }

  $("publish-prospect")
    ?.addEventListener(
      "click",
      publishProspectPage
    );

  $("copy-prospect-link")
    ?.addEventListener(
      "click",
      async () => {
        const value =
          $("prospect-publish-url")
            ?.textContent?.trim() || "";

        if (!value) return;

        await navigator.clipboard.writeText(
          value
        );

        const button =
          $("copy-prospect-link");

        const original =
          button.textContent;

        button.textContent = "Copied";

        setTimeout(() => {
          button.textContent = original;
        }, 1200);
      }
    );

  buildDefaultLinks();
  generate();
})();
</script>




