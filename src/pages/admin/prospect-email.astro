---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Prospect Email Generator">
  <main class="peg-page">
    <div class="peg-shell">

      <header class="peg-header">
        <div>
          <p class="peg-kicker">LOCUS SALES</p>
          <h1>Prospect Email Generator</h1>
          <p class="peg-intro">
            Personalize the prospect, add the best demo links,
            and send the agent directly into the working parts
            of their own Locus site.
          </p>
        </div>

        <a class="peg-back" href="/admin">
          Back to admin
        </a>
      </header>


      <div class="peg-layout">

        <section class="peg-builder">

          <div class="peg-card">
            <div class="peg-card-head">
              <div>
                <p class="peg-label">PROSPECT</p>
                <h2>Who are we sending this to?</h2>
              </div>
            </div>

            <div class="peg-grid peg-grid--2">
              <label>
                <span>Agent name</span>
                <input
                  id="agent-name"
                  type="text"
                  value="Tammy"
                />
              </label>

              <label>
                <span>Website</span>
                <input
                  id="site-domain"
                  type="text"
                  value="tammygalvin.bc.realestate"
                />
              </label>

              <label>
                <span>Primary market</span>
                <input
                  id="primary-market"
                  type="text"
                  value="Nanaimo"
                />
              </label>

              <label>
                <span>Other markets</span>
                <input
                  id="other-markets"
                  type="text"
                  value="Parksville, Qualicum Beach, Lantzville"
                />
              </label>
            </div>
          </div>


          <div class="peg-card">
            <div class="peg-card-head">
              <div>
                <p class="peg-label">OPENING</p>
                <h2>Personal note</h2>
              </div>
            </div>

            <textarea
              id="personal-note"
              rows="6"
            >Rather than send you a long sales pitch, I thought it would be more useful to give you a working Locus site and a few things to actually try.</textarea>
          </div><div class="peg-card">
            <div class="peg-card-head">
              <div>
                <p class="peg-label">DEMO LINKS</p>
                <h2>Best examples to show them</h2>
              </div>

              <button
                class="peg-small-button"
                id="build-default-links"
                type="button"
              >
                Build defaults
              </button>
            </div>

            <p class="peg-help">
              Defaults are generated from the agent's domain
              and primary market. Replace any of them with a
              better demo URL when you have one.
            </p>

            <div class="peg-links">

              <label>
                <span>Good listing with floorplan</span>
                <input id="link-listing" type="text" />
              </label>

              <label>
                <span>Buyer browsing / reactions</span>
                <input id="link-reactions" type="text" />
              </label>

              <label>
                <span>Create shortlist</span>
                <input id="link-shortlist-create" type="text" />
              </label>
              <label>
                <span>Save Search demo</span>
                <input id="link-alerts" type="text" />
              </label>

              <label>
                <span>Area page</span>
                <input id="link-area" type="text" />
              </label>

              <label>
                <span>Market Intelligence</span>
                <input id="link-market" type="text" />
              </label>

              <label>
                <span>Intent Sessions</span>
                <input id="link-intent" type="text" />
              </label>

              <label>
                <span>Leads</span>
                <input id="link-leads" type="text" />
              </label>
              <label>
                <span>PageSpeed test</span>
                <input id="link-pagespeed" type="text" />
              </label>

            </div>
          </div>


          <div class="peg-card peg-card--closing">
            <div class="peg-card-head">
              <div>
                <p class="peg-label">CLOSE</p>
                <h2>Price and sign-off</h2>
              </div>
            </div>

            <div class="peg-grid peg-grid--2">
              <label>
                <span>Price</span>
                <input
                  id="price"
                  type="text"
                  value="$59/month"
                />
              </label>

              <label>
                <span>Sender</span>
                <input
                  id="sender"
                  type="text"
                  value="Chris"
                />
              </label>
            </div>
          </div>


          <button
            class="peg-generate"
            id="generate"
            type="button"
          >
            Generate Email
          </button>

          <button
            class="peg-generate"
            id="publish-prospect"
            type="button"
            style="margin-top:12px;"
          >
            Publish Prospect Page
          </button>

          <div
            id="prospect-publish-result"
            hidden
            style="
              margin-top:16px;
              padding:16px;
              border:1px solid rgba(0,0,0,.12);
              border-radius:14px;
              background:#fff;
            "
          >
            <strong id="prospect-publish-status">
              Prospect page published
            </strong>

            <div
              id="prospect-publish-url"
              style="
                margin-top:8px;
                font-size:.9rem;
                overflow-wrap:anywhere;
              "
            ></div>

            <div
              style="
                display:flex;
                gap:10px;
                flex-wrap:wrap;
                margin-top:12px;
              "
            >
              <button
                id="copy-prospect-link"
                type="button"
              >
                Copy link
              </button>

              <a
                id="open-prospect-page"
                href="#"
                target="_blank"
                rel="noopener"
              >
                Open page →
              </a>
            </div>
          </div>

        </section>


        <aside class="peg-preview">

          <div class="peg-preview-card">
            <div class="peg-preview-head">
              <div>
                <p class="peg-label">EMAIL PREVIEW</p>
                <h2>Ready to send</h2>
              </div>

              <div class="peg-copy-buttons">
                <button id="copy-subject" type="button">
                  Copy subject
                </button>

                <button id="copy-email" type="button">
                  Copy email
                </button>
              </div>
            </div>

            <label class="peg-subject-wrap">
              <span>Subject</span>
              <input
                id="email-subject"
                type="text"
                readonly
              />
            </label>

            <pre id="email-preview"></pre>
          </div>

        </aside>

      </div>

    </div>
  </main>
</Layout>


<style>
  :global(body) {
    margin: 0;
    background: #f5f7f7;
    color: #10283b;
  }

  .peg-page,
  .peg-page button,
  .peg-page input,
  .peg-page textarea,
  .peg-page select {
    font-family:
      var(--sans),
      ui-sans-serif,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .peg-page {
    min-height: 100vh;
    padding: 44px 0 90px;
  }

  .peg-shell {
    width: min(1500px, calc(100% - 40px));
    margin: 0 auto;
  }

  .peg-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 32px;
  }

  .peg-kicker,
  .peg-label {
    margin: 0 0 8px;
    color: #28777d;
    font-size: .68rem;
    font-weight: 850;
    letter-spacing: .15em;
  }

  .peg-header h1 {
    margin: 0;
    font-size: clamp(2.3rem, 4vw, 4.5rem);
    line-height: .96;
    letter-spacing: -.055em;
  }

  .peg-intro {
    max-width: 680px;
    margin: 18px 0 0;
    color: #61727c;
    font-size: 1rem;
    line-height: 1.6;
  }

  .peg-back {
    color: #28777d;
    font-size: .85rem;
    font-weight: 750;
    text-decoration: none;
  }

  .peg-layout {
    display: grid;
    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(400px, .95fr);
    gap: 24px;
    align-items: start;
  }

  .peg-builder {
    display: grid;
    gap: 18px;
  }

  .peg-card,
  .peg-preview-card {
    border: 1px solid #dfe7e7;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 14px 45px rgba(16,40,59,.045);
  }

  .peg-card {
    padding: 24px;
  }

  .peg-card h2,
  .peg-preview h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -.03em;
  }

  .peg-card-head,
  .peg-preview-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 20px;
  }

  .peg-grid {
    display: grid;
    gap: 14px;
  }

  .peg-grid--2 {
    grid-template-columns: repeat(2, minmax(0,1fr));
  }

  .peg-card label,
  .peg-subject-wrap {
    display: grid;
    gap: 6px;
  }

  .peg-card label > span,
  .peg-subject-wrap > span {
    color: #65767f;
    font-size: .72rem;
    font-weight: 750;
  }

  .peg-card input,
  .peg-card textarea,
  .peg-card select,
  .peg-subject-wrap input {
    box-sizing: border-box;
    width: 100%;
    border: 1px solid #d8e1e1;
    border-radius: 9px;
    background: #fff;
    color: #183440;
    font-size: .87rem;
    outline: none;
  }

  .peg-card input,
  .peg-card select,
  .peg-subject-wrap input {
    min-height: 42px;
    padding: 9px 11px;
  }

  .peg-card textarea {
    padding: 12px;
    line-height: 1.55;
    resize: vertical;
  }

  .peg-card input:focus,
  .peg-card textarea:focus,
  .peg-card select:focus {
    border-color: #28777d;
    box-shadow: 0 0 0 3px rgba(40,119,125,.08);
  }

  #tone {
    width: auto;
    min-width: 160px;
  }

  .peg-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .peg-presets button,
  .peg-small-button,
  .peg-copy-buttons button {
    border: 1px solid #d7e2e2;
    border-radius: 999px;
    background: #fff;
    color: #35505a;
    cursor: pointer;
    font-size: .74rem;
    font-weight: 750;
  }

  .peg-presets button {
    padding: 9px 13px;
  }

  .peg-presets button.is-active {
    border-color: #28777d;
    background: #eaf4f3;
    color: #236970;
  }

  .peg-small-button {
    padding: 7px 11px;
  }

  .peg-features {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 10px;
  }

  .peg-features label {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 10px;
    align-items: flex-start;
    padding: 13px;
    border: 1px solid #e3e9e9;
    border-radius: 11px;
    cursor: pointer;
  }

  .peg-features input {
    width: 16px;
    min-height: 16px;
    margin-top: 2px;
    accent-color: #28777d;
  }

  .peg-features label > span {
    display: grid;
    gap: 3px;
  }

  .peg-features strong {
    color: #183540;
    font-size: .78rem;
  }

  .peg-features small {
    color: #71818a;
    font-size: .68rem;
    line-height: 1.4;
  }

  .peg-help {
    margin: -5px 0 18px;
    color: #72828a;
    font-size: .76rem;
    line-height: 1.5;
  }

  .peg-links {
    display: grid;
    grid-template-columns: repeat(2,minmax(0,1fr));
    gap: 11px 14px;
  }

  .peg-generate {
    width: 100%;
    padding: 16px;
    border: 0;
    border-radius: 12px;
    background: #28777d;
    color: #fff;
    cursor: pointer;
    font-size: .9rem;
    font-weight: 850;
  }

  .peg-preview {
    position: sticky;
    top: 22px;
  }

  .peg-preview-card {
    overflow: hidden;
  }

  .peg-preview-head {
    padding: 22px 22px 0;
  }

  .peg-copy-buttons {
    display: flex;
    gap: 7px;
  }

  .peg-copy-buttons button {
    padding: 8px 11px;
  }

  .peg-subject-wrap {
    margin: 0 22px 18px;
  }

  .peg-subject-wrap input {
    background: #f7f9f9;
  }

  #email-preview {
    box-sizing: border-box;
    overflow: auto;
    width: 100%;
    max-height: calc(100vh - 230px);
    min-height: 620px;
    margin: 0;
    padding: 24px;
    border-top: 1px solid #e3e9e9;
    background: #fbfcfc;
    color: #29444f;
    font:
      .82rem/1.65
      var(--sans),
      ui-sans-serif,
      sans-serif;
    white-space: pre-wrap;
  }

  @media (max-width: 1050px) {
    .peg-layout {
      grid-template-columns: 1fr;
    }

    .peg-preview {
      position: static;
    }

    #email-preview {
      max-height: none;
    }
  }

  @media (max-width: 700px) {
    .peg-shell {
      width: min(100% - 24px,1500px);
    }

    .peg-header {
      display: grid;
    }

    .peg-grid--2,
    .peg-features,
    .peg-links {
      grid-template-columns: 1fr;
    }

    .peg-card-head,
    .peg-preview-head {
      display: grid;
    }
  }
</style>


<script is:inline>
(() => {
  const $ = (id) =>
    document.getElementById(id);

  const featureBoxes =
    Array.from(
      document.querySelectorAll(
        "[data-feature]"
      )
    );

  const presets = {
    quick: [
      "search",
      "listing",
      "shortlist",
      "entry",
      "market",
      "speed",
      "upgrades"
    ],

    buyer: [
      "search",
      "listing",
      "reactions",
      "shortlist",
      "alerts",
      "entry",
      "type",
      "area",
      "market"
    ],

    leads: [
      "reactions",
      "shortlist",
      "alerts",
      "entry",
      "intent",
      "leads",
      "admin",
      "upgrades"
    ],

    seo: [
      "entry",
      "type",
      "area",
      "market",
      "markets",
      "speed",
      "google",
      "upgrades"
    ],

    power: [
      "search",
      "listing",
      "reactions",
      "shortlist",
      "entry",
      "market",
      "intent",
      "leads",
      "admin",
      "google",
      "upgrades"
    ],

    full: [
      "search",
      "listing",
      "reactions",
      "shortlist",
      "alerts",
      "entry",
      "type",
      "area",
      "market",
      "markets",
      "speed",
      "google",
      "intent",
      "leads",
      "admin",
      "upgrades"
    ]
  };

  const cleanDomain = (value) =>
    String(value || "")
      .trim()
      .replace(/^https?:\/\//i, "")
      .replace(/\/+$/g, "");

  const slugify = (value) =>
    String(value || "")
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

  const link = (id) =>
    $(id)?.value.trim() || "";

  const withLink = (
    label,
    url
  ) => {
    if (!url) return "";
    return `${label}\n${url}`;
  };

  const selected =
    (feature) =>
      featureBoxes.some(
        (box) =>
          box.dataset.feature === feature &&
          box.checked
      );

  function buildDefaultLinks() {
    const domain =
      cleanDomain($("site-domain")?.value);

    const market =
      slugify($("primary-market")?.value);

    if (!domain || !market) return;

    const base = `https://${domain}`;

    if ($("link-listing") && !$("link-listing").value) {
      $("link-listing").placeholder =
        "Enter MLS number or listing URL";
    }

    if ($("link-reactions")) {
      $("link-reactions").value =
        `${base}/${market}`;
    }

    if ($("link-shortlist-create")) {
      $("link-shortlist-create").value =
        `${base}/listings`;
    }
    if ($("link-alerts")) {
      $("link-alerts").value =
        `${base}/${market}?type=condo&maxPrice=500000&save_search=open`;
    }

    if ($("link-area")) {
      $("link-area").value =
        `${base}/${market}/areas`;
    }

    if ($("link-market")) {
      $("link-market").value =
        `${base}/${market}/market-intelligence`;
    }

    if ($("link-intent")) {
      $("link-intent").value =
        `${base}/admin/intent-sessions`;
    }

    if ($("link-leads")) {
      $("link-leads").value =
        `${base}/admin/leads`;
    }
    if ($("link-pagespeed")) {
      $("link-pagespeed").value =
        `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(base)}`;
    }
  }



  function featureSection(
    title,
    body,
    label,
    url
  ) {
    const parts = [
      title,
      body
    ];

    const linked =
      withLink(label, url);

    if (linked) {
      parts.push(linked);
    }

    return parts.join("\n\n");
  }


  function generate() {
    const agent =
      $("agent-name")?.value.trim() ||
      "there";

    const domain =
      cleanDomain(
        $("site-domain")?.value
      );

    const price =
      $("price")?.value.trim() ||
      "$59/month";

    const sender =
      $("sender")?.value.trim() ||
      "Chris";

    const slug =
      slugify(agent) ||
      "prospect";

    const prospectUrl =
      `https://bc.realestate/for/${slug}?domain=${encodeURIComponent(domain)}`;

    $("email-subject").value =
      `${agent} - have a look at this`;

    const email = [
      `Hi ${agent},`,
      "",
      "I built you a quick Locus demo using your markets so you can see what I've been working on.",
      "",
      "Have a look:",
      prospectUrl,
      "",
      `If you like it, it's ${price}.`,
      "",
      sender
    ].join("\n");

    $("email-preview").textContent =
      email;
  }



  document
    .querySelectorAll("[data-preset]")
    .forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          const preset =
            button.dataset.preset;

          const enabled =
            presets[preset] || [];

          featureBoxes.forEach(
            (box) => {
              box.checked =
                enabled.includes(
                  box.dataset.feature
                );
            }
          );

          document
            .querySelectorAll(
              "[data-preset]"
            )
            .forEach((item) => {
              item.classList.toggle(
                "is-active",
                item === button
              );
            });

          generate();
        }
      );
    });


  $("select-all")?.addEventListener(
    "click",
    () => {
      const allChecked =
        featureBoxes.every(
          (box) => box.checked
        );

      featureBoxes.forEach(
        (box) => {
          box.checked = !allChecked;
        }
      );

      generate();
    }
  );


  $("build-default-links")
    ?.addEventListener(
      "click",
      () => {
        buildDefaultLinks();
        generate();
      }
    );


  $("generate")?.addEventListener(
    "click",
    generate
  );


  $("copy-subject")
    ?.addEventListener(
      "click",
      async () => {
        const value =
          $("email-subject")?.value || "";

        await navigator.clipboard.writeText(
          value
        );

        const button =
          $("copy-subject");

        const original =
          button.textContent;

        button.textContent =
          "Copied";

        setTimeout(() => {
          button.textContent =
            original;
        }, 1200);
      }
    );


  $("copy-email")
    ?.addEventListener(
      "click",
      async () => {
        const value =
          $("email-preview")
            ?.textContent || "";

        await navigator.clipboard.writeText(
          value
        );

        const button =
          $("copy-email");

        const original =
          button.textContent;

        button.textContent =
          "Copied";

        setTimeout(() => {
          button.textContent =
            original;
        }, 1200);
      }
    );


  [
    "agent-name",
    "site-domain",
    "primary-market",
    "other-markets",
    "personal-note",
    "tone",
    "price",
    "sender"
  ].forEach((id) => {
    $(id)?.addEventListener(
      "input",
      generate
    );
  });


  featureBoxes.forEach(
    (box) => {
      box.addEventListener(
        "change",
        generate
      );
    }
  );


  function getProspectSlug() {
    const name =
      $("agent-name")?.value.trim() || "prospect";

    return slugify(name) || "prospect";
  }

  function getProspectSections() {
    const sections = {};

    featureBoxes.forEach((box) => {
      const key =
        box.dataset.feature ||
        box.value ||
        box.id
          ?.replace(/^feature-/, "");

      if (key) {
        sections[key] = box.checked;
      }
    });

    return sections;
  }

  function normalizeListingLink() {
    const raw =
      $("link-listing")?.value.trim() || "";

    if (!raw) return "";

    // Accept:
    // 1048347
    // /nanaimo/listing/1048347
    // https://bc.realestate/nanaimo/listing/1048347
    const match = raw.match(
      /(?:\/listing\/)?(\d{6,})\/?(?:[?#].*)?$/
    );

    if (!match) return raw;

    const listingId = match[1];

    const domain = String(
      $("site-domain")?.value || ""
    )
      .trim()
      .replace(/^https?:\/\//, "")
      .replace(/\/.*$/, "");

    const market =
      slugify(
        $("primary-market")?.value || ""
      ) || "nanaimo";

    return `https://${domain}/${market}?listing_id=${encodeURIComponent(listingId)}`;
  }

  function getProspectLinks() {
    const read = (id) =>
      $(id)?.value.trim() || "";

    return {
      search: read("link-search"),
      listing: normalizeListingLink(),
      reactions: read("link-reactions"),
      shortlist_demo:
        read("link-shortlist-demo"),
      shortlist_create:
        read("link-shortlist-create"),
      alerts: read("link-alerts"),
      entry: read("link-entry"),
      entry_create:
        read("link-entry-create"),
      type: read("link-type"),
      area: read("link-area"),
      market: read("link-market"),
      intent: read("link-intent"),
      leads: read("link-leads"),
      pagespeed: read("link-pagespeed"),
      admin: read("link-admin"),
    };
  }

  async function publishProspectPage() {
    const button =
      $("publish-prospect");

    const result =
      $("prospect-publish-result");

    const status =
      $("prospect-publish-status");

    const urlEl =
      $("prospect-publish-url");

    const openLink =
      $("open-prospect-page");

    if (!button) return;

    const originalText =
      button.textContent;

    button.disabled = true;
    button.textContent = "Publishing...";

    try {
      const domain = String(
        $("site-domain")?.value || ""
      )
        .trim()
        .replace(/^https?:\/\//, "")
        .replace(/\/.*$/, "");

      const otherMarkets = String(
        $("other-markets")?.value || ""
      )
        .split(",")
        .map((value) => value.trim())
        .filter(Boolean);

      const response = await fetch(
        "/api/prospect-pages/save",
        {
          method: "POST",
          headers: {
            "Content-Type":
              "application/json"
          },
          body: JSON.stringify({
            agentName:
              $("agent-name")?.value.trim(),
            domain,
            slug: getProspectSlug(),
            primaryMarket:
              $("primary-market")?.value.trim(),
            otherMarkets,
            personalNote:
              $("personal-note")?.value.trim(),
            price:
              $("price")?.value.trim(),
            sections: {},
            links:
              getProspectLinks()
          })
        }
      );

      const data = await response.json();

      if (!response.ok || !data.ok) {
        throw new Error(
          data.error ||
          "Unable to publish prospect page."
        );
      }

      if (result) result.hidden = false;

      if (status) {
        status.textContent =
          "Prospect page published";
      }

      if (urlEl) {
        urlEl.textContent = data.url;
      }

      if (openLink) {
        const slug = getProspectSlug();

        openLink.href =
          `${window.location.origin}/for/${slug}?domain=${encodeURIComponent(domain)}`;
      }

      result?.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
      });
    } catch (error) {
      if (result) result.hidden = false;

      if (status) {
        status.textContent =
          error instanceof Error
            ? error.message
            : "Unable to publish prospect page.";
      }

      if (urlEl) {
        urlEl.textContent = "";
      }
    } finally {
      button.disabled = false;
      button.textContent = originalText;
    }
  }

  $("publish-prospect")
    ?.addEventListener(
      "click",
      publishProspectPage
    );

  $("copy-prospect-link")
    ?.addEventListener(
      "click",
      async () => {
        const value =
          $("prospect-publish-url")
            ?.textContent?.trim() || "";

        if (!value) return;

        await navigator.clipboard.writeText(
          value
        );

        const button =
          $("copy-prospect-link");

        const original =
          button.textContent;

        button.textContent = "Copied";

        setTimeout(() => {
          button.textContent = original;
        }, 1200);
      }
    );

  buildDefaultLinks();
  generate();
})();
</script>




