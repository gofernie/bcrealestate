---
import AdminSidebar from "../../components/AdminSidebar.astro";
import { createClient } from "@supabase/supabase-js";

export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

// "Refresh next": same queue-jump as doing it by hand in SQL
let flash = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const city = String(form.get("city") || "").trim();
  const action = String(form.get("action") || "queue");
  if (city && action === "add") {
    const providerCity = city.replace(/\b\w/g, (c) => c.toUpperCase());
    const { error } = await supabase.from("listing_markets").insert({
      city, provider_city: providerCity, enabled: true, refresh_priority: 20,
      last_refresh_at: "2000-01-01T00:00:00Z", last_success_at: "2000-01-01T00:00:00Z",
    });
    flash = error
      ? `Couldn't add ${city}: ${error.message}`
      : `${city} added to the rotation and queued. Check its row after the next run.`;
  } else if (city) {
    const { error } = await supabase
      .from("listing_markets")
      .update({ last_refresh_at: "2000-01-01T00:00:00Z", last_success_at: "2000-01-01T00:00:00Z" })
      .eq("city", city);
    flash = error
      ? `Couldn't queue ${city}: ${error.message}`
      : `${city} queued. It refreshes on the next run, within about 20 minutes.`;
  }
}

const { data, error: loadError } = await supabase.from("city_fetch_status").select("*");
const { data: townData } = await supabase.from("city_town_counts").select("*");
const now = Date.now();
const isQueued = (iso: any) => !!iso && new Date(iso).getFullYear() < 2001;

const ago = (iso: any) => {
  if (!iso) return "never";
  if (isQueued(iso)) return "queued";
  const m = Math.round((now - new Date(iso).getTime()) / 60000);
  if (m < 60) return `${m}m ago`;
  const h = m / 60;
  return h < 48 ? `${Math.round(h)}h ago` : `${Math.round(h / 24)}d ago`;
};

const LABEL: Record<string, string> = {
  error: "Error", drop: "Big drop", stale: "Stale", running: "Running", queued: "Queued",
  aging: "Aging", ok: "OK", disabled: "Disabled", off: "Not in rotation",
};
const RANK: Record<string, number> = {
  error: 0, drop: 1, stale: 2, running: 3, queued: 4, aging: 5, ok: 6, disabled: 7, off: 8,
};

function stateOf(r: any) {
  if (!r.in_rotation) return "off";
  if (!r.enabled) return "disabled";
  if (isQueued(r.last_success_at)) return "queued";
  const status = String(r.last_refresh_status || "");
  if (status && status !== "completed") {
    const startedMin = r.last_refresh_at ? (now - new Date(r.last_refresh_at).getTime()) / 60000 : 9999;
    return startedMin < 30 && !r.last_error ? "running" : "error";
  }
  const dropped = Number(r.off_24h || 0);
  const active = Number(r.active || 0);
  if (dropped >= 10 && dropped > 0.15 * (active + dropped)) return "drop";
  const h = Number(r.hours_since ?? 9999);
  if (h > 36) return "stale";
  if (h > 12) return "aging";
  return "ok";
}

// Towns fetched as part of another city's refresh: shown under their parent, not as separate rows.
const GROUPS: Record<string, string[]> = {
  comox: ["courtenay", "cumberland", "royston", "union bay", "black creek", "fanny bay", "merville", "denman island"],
  victoria: ["victoria west"],
  parksville: ["qualicum beach", "french creek", "nanoose bay"],
  duncan: ["ladysmith", "chemainus", "mill bay"],
};
const parentOf: Record<string, string> = {};
for (const [parent, kids] of Object.entries(GROUPS)) for (const k of kids) parentOf[k] = parent;

const all = (data || []).map((r: any) => ({ ...r, state: stateOf(r), parent: parentOf[r.city] || "" }));
const cityNames = new Set(all.map((r: any) => r.city));
const byParent: Record<string, any[]> = {};
for (const r of all) if (r.parent && cityNames.has(r.parent)) (byParent[r.parent] ||= []).push(r);
const parents = all
  .filter((r: any) => !r.parent || !cityNames.has(r.parent))
  .sort((a: any, b: any) =>
    RANK[a.state] - RANK[b.state] || Number(b.hours_since ?? 0) - Number(a.hours_since ?? 0)
  );
// town-breakdown-v1: towns whose listings are stored under each city
const townsBy: Record<string, any[]> = {};
for (const tr of townData || []) (townsBy[tr.normalized_city] ||= []).push(tr);
const pushTowns = (r: any) => {
  const towns = (townsBy[r.city] || [])
    .filter((tw: any) => String(tw.town).toLowerCase() !== r.city)
    .sort((a: any, b: any) => Number(b.active) - Number(a.active));
  for (const tw of towns) rows.push({
    city: tw.town, active: tw.active, isChild: true, isTown: true,
    parent: r.city, parentState: r.state, newest_seen: r.last_success_at || r.newest_seen,
  });
};
const rows: any[] = [];
for (const p of parents) {
  const kids = (byParent[p.city] || []).sort((a: any, b: any) => Number(b.active || 0) - Number(a.active || 0));
  p.kidCount = kids.length;
  p.kidActive = kids.reduce((s: number, k: any) => s + Number(k.active || 0), 0);
  rows.push(p);
  pushTowns(p);
  for (const k of kids) { const kr = { ...k, isChild: true, parentState: p.state }; rows.push(kr); pushTowns(kr); }
}

// sortable-v1: each city + its towns sorts as one block
const groups: any[][] = [];
for (const r of rows) { if (!r.isChild || !groups.length) groups.push([r]); else groups[groups.length - 1].push(r); }
const counts: Record<string, number> = {};
for (const r of rows) if (!r.isChild) counts[r.state] = (counts[r.state] || 0) + 1;
const totalActive = rows.reduce((s: number, r: any) => s + Number(r.active || 0), 0);

// Same scoring as the picker in listing-refresh-schedule.ts (priority-picker-v1)
const TARGET_H = (p: any) => { const n = Number(p) || 0; return n >= 90 ? 2 : n >= 50 ? 4 : 12; };
const nextUp = rows
  .filter((r: any) => r.in_rotation && r.enabled && r.state !== "running")
  .map((r: any) => {
    const last = r.last_success_at ? new Date(r.last_success_at).getTime() : 0;
    const hours = last ? (now - last) / 3600000 : Infinity;
    return { city: r.city, score: hours / TARGET_H(r.refresh_priority), p: Number(r.refresh_priority) || 0 };
  })
  .sort((a: any, b: any) => b.score - a.score || b.p - a.p)
  .slice(0, 3)
  .map((x: any) => x.city);

const updated = new Date().toLocaleString("en-CA", { timeZone: "America/Edmonton", dateStyle: "medium", timeStyle: "short" });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Fetch Status</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
  .fs-wrap { display: block; min-height: 100vh; background: #f6f6f4; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #101828; }
  .fs-main { max-width: 1180px; margin: 0 auto; padding: 40px 20px 80px; }
  .eyebrow { margin: 0 0 8px; font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #667085; }
  .fs-main h1 { margin: 0; font-size: clamp(2rem, 4vw, 3.25rem); letter-spacing: -.04em; line-height: 1.05; }
  .fs-sub { max-width: 680px; margin: 12px 0 28px; color: #667085; font-size: 1rem; line-height: 1.5; }
  .fs-flash { background: #e8f4ec; border: 1px solid #b7dcc3; padding: 12px 14px; border-radius: 12px; font-size: 14px; }
  .fs-err { background: #fdecec; border-color: #f2b8b8; }
  .fs-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; margin: 28px 0; }
  .fs-tile { display: flex; flex-direction: column-reverse; justify-content: flex-end; padding: 20px; background: #fff; border: 1px solid #eaecf0; border-radius: 22px; box-shadow: 0 14px 40px rgba(16, 24, 40, .06); color: #667085; font-size: .86rem; font-weight: 700; }
  .fs-tile b { display: block; margin-top: 8px; color: #101828; font-size: 2rem; letter-spacing: -.04em; }
  .fs-next { margin: 0 0 14px; color: #475467; font-size: .9rem; }
  .fs-table-wrap { overflow-x: auto; padding: 8px 22px 22px; background: #fff; border: 1px solid #eaecf0; border-radius: 22px; box-shadow: 0 14px 40px rgba(16, 24, 40, .06); }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { padding: 12px 10px; border-top: 1px solid #f2f4f7; text-align: left; white-space: nowrap; }
  thead th { border-top: 0; }
  th { position: sticky; top: 0; background: #fff; color: #667085; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  th[data-dir="asc"]::after { content: " \25B2"; font-size: 10px; }
  th[data-dir="desc"]::after { content: " \25BC"; font-size: 10px; }
  button { font: inherit; font-size: 12px; padding: 5px 12px; border-radius: 999px; border: 1px solid #d0d5dd; background: #fff; cursor: pointer; }
  button:hover { background: #f2f4f7; }  td.err { white-space: normal; max-width: 280px; color: #b42318; font-size: 12px; }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
  .s-ok { background: #12b76a; } .s-aging { background: #f5a524; } .s-stale, .s-error, .s-drop { background: #e5484d; }
  .s-running, .s-queued { background: #3b82f6; } .s-disabled, .s-off { background: #b0b7c3; }
  tr.r-error td, tr.r-drop td, tr.r-stale td { background: #fff6f6; }
  .warn { color: #b42318; font-weight: 600; }
  th[data-k] { cursor: pointer; user-select: none; }
  th[data-k]:hover { color: #101828; }
  tr.r-child td { background: #fcfcfd; font-size: .84rem; padding-top: 6px; padding-bottom: 6px; }
  .kid { padding-left: 14px; color: #475467; }
  .via { color: #667085; }
  .grp { color: #98a2b3; font-size: 12px; }
</style>
  </head>
  <body>
    <div class="fs-wrap">
      <AdminSidebar />
      <main class="fs-main">
        <p class="eyebrow">Listing feed</p><h1>Listing fetch status</h1>
        <p class="fs-sub">One row per city. The rotation refreshes one city every 10 minutes, busiest cities most often (priority 90+ every ~2h, 50+ every ~4h, others every ~12h).</p>

        {flash && <p class="fs-flash">{flash}</p>}
        {loadError && <p class="fs-flash fs-err">Couldn't load status: {loadError.message}. Has the city_fetch_status view been created?</p>}

        <div class="fs-tiles">
          <div class="fs-tile"><b>{totalActive.toLocaleString()}</b>Active listings</div>
          {Object.keys(RANK).filter((k) => counts[k]).map((k) => (
            <div class="fs-tile"><b><span class={`dot s-${k}`}></span>{counts[k]}</b>{LABEL[k]}</div>
          ))}
        </div>

        {nextUp.length > 0 && <p class="fs-next">Likely next: {nextUp.join(" → ")}</p>}

        <div class="fs-table-wrap">
          <table>
            <thead>
              <tr>
                <th data-k="status">Status</th><th data-k="city">City</th><th data-k="last">Last success</th><th data-k="active">Active</th><th data-k="new">New 7d</th>
                <th data-k="bom">Back on mkt</th><th data-k="drop">Dropped 24h</th><th data-k="priority">Priority</th><th>Error</th><th></th>
              </tr>
            </thead>
            {groups.map((g: any[]) => (
            <tbody class="grp-body" data-status={RANK[g[0].state]} data-city={g[0].city} data-last={g[0].hours_since ?? 99999} data-active={Number(g[0].active || 0) + Number(g[0].kidActive || 0)} data-new={g[0].new_7d || 0} data-bom={g[0].bom_14d || 0} data-drop={g[0].off_24h || 0} data-priority={g[0].refresh_priority ?? -1}>
              {g.map((r: any) => (
                <tr class={r.isChild ? "r-child" : `r-${r.state}`}>
                  <td>{r.isChild
                    ? <span class="via"><span class={`dot s-${r.parentState}`}></span>via {r.parent}</span>
                    : <><span class={`dot s-${r.state}`}></span>{LABEL[r.state]}</>}</td>
                  <td>{r.isChild
                    ? <span class="kid">↳ {r.city}</span>
                    : <>{r.city}{r.kidActive ? <span class="grp"> + {r.kidCount} towns · {Number(r.kidActive).toLocaleString()} listings</span> : null}</>}</td>
                  <td title={r.last_success_at || r.newest_seen || ""}>{ago(r.in_rotation ? r.last_success_at : r.newest_seen)}</td>
                  <td class="num">{Number(r.active || 0).toLocaleString()}</td>
                  <td class="num">{r.new_7d}</td>
                  <td class="num">{r.bom_14d}</td>
                  <td class={`num ${r.state === "drop" ? "warn" : ""}`}>{r.off_24h}</td>
                  <td class="num">{r.refresh_priority ?? ""}</td>
                  <td class="err">{r.last_error || ""}</td>
                  <td>
                    {!r.in_rotation && !r.isChild && (
                      <form method="post" onsubmit="return confirm('Add ' + this.city.value + ' to the rotation?')"><input type="hidden" name="action" value="add" /><input type="hidden" name="city" value={r.city} /><button type="submit">Add to rotation</button></form>
                    )}
                    {r.in_rotation && r.enabled && r.state !== "queued" && (
                      <form method="post"><input type="hidden" name="city" value={r.city} /><button type="submit">Refresh next</button></form>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
            ))}
          </table>
        </div>
      </main>
    </div>
    <script is:inline>
    (() => {
      const table = document.querySelector(".fs-table-wrap table");
      if (!table) return;
      let key = "status", dir = 1;
      table.querySelectorAll("th[data-k]").forEach((th) => {
        th.addEventListener("click", () => {
          const k = th.dataset.k;
          dir = key === k ? -dir : (k === "city" || k === "status" ? 1 : -1);
          key = k;
          const bodies = [...table.querySelectorAll("tbody.grp-body")];
          bodies.sort((a, b) => {
            const av = a.dataset[k] || "", bv = b.dataset[k] || "";
            const c = k === "city" ? av.localeCompare(bv) : Number(av) - Number(bv);
            return c * dir;
          });
          bodies.forEach((b) => table.appendChild(b));
          table.querySelectorAll("th[data-k]").forEach((h) => h.removeAttribute("data-dir"));
          th.dataset.dir = dir > 0 ? "asc" : "desc";
        });
      });
    })();
  </script>
</body>
</html>