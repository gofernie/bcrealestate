---
import { createClient } from "@supabase/supabase-js";
import AdminSidebar from "../../components/AdminSidebar.astro";

export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

/*
 * Agents
 */
const {
  data: agentsData,
  error: agentsError,
} = await supabase
  .from("agents")
  .select("*")
  .order("name");

if (agentsError) {
  console.error("Agents lookup failed:", agentsError);
}

const agents = agentsData || [];

/*
 * Sites linked to agents
 */
const {
  data: sitesData,
  error: sitesError,
} = await supabase
  .from("sites")
  .select(`
    id,
    agent_id,
    domain,
    city,
    site_name,
    accent_color
  `)
  .not("agent_id", "is", null);

if (sitesError) {
  console.error("Agent sites lookup failed:", sitesError);
}

const sites = sitesData || [];

const siteByAgent = sites.reduce(
  (accumulator: Record<string, any>, site: any) => {
    if (!site.agent_id) return accumulator;

    /*
     * For now use the first linked site as the
     * agent's primary site.
     */
    if (!accumulator[site.agent_id]) {
      accumulator[site.agent_id] = site;
    }

    return accumulator;
  },
  {}
);

/*
 * Lead counts
 */
const { data: sessions } = await supabase
  .from("intent_sessions")
  .select("session_id, assigned_agent_id")
  .not("assigned_agent_id", "is", null);

const leadCountByAgent: Record<string, number> = {};

(sessions || []).forEach((session: any) => {
  if (!session.assigned_agent_id) return;

  leadCountByAgent[session.assigned_agent_id] =
    (leadCountByAgent[session.assigned_agent_id] || 0) + 1;
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Agents</title>

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <style is:global>
      @media (min-width: 769px) {
        .mobile-topbar,
        .drawer-overlay {
          display: none !important;
        }
      }

      @media (max-width: 768px) {
        .mobile-topbar {
          display: flex !important;
          width: 100% !important;
        }
      }
    </style>

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap"
      rel="stylesheet"
    />

    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg: #f5f4f1;
        --surface: #fff;
        --border: rgba(0, 0, 0, 0.08);
        --border-md: rgba(0, 0, 0, 0.13);
        --ink: #111110;
        --muted: #6b6864;
        --green: #16a34a;
        --green-bg: #dcfce7;
        --radius: 16px;
        --sidebar: 220px;
        --sans: "DM Sans", system-ui, sans-serif;
      }

      body {
        font-family: var(--sans);
        background: var(--bg);
        color: var(--ink);
        font-size: 14px;
      }

      .layout {
        display: grid;
        grid-template-columns: var(--sidebar) 1fr;
        min-height: 100vh;
      }

      .main {
        min-width: 0;
        padding: 40px 48px 80px;
      }

      .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 32px;
      }

      .page-head h1 {
        font-size: 2.2rem;
        font-weight: 700;
        letter-spacing: -0.04em;
      }

      .page-head p {
        margin-top: 5px;
        color: var(--muted);
        font-size: 0.86rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 16px;
        border: 1px solid var(--border-md);
        border-radius: 999px;
        background: var(--surface);
        color: var(--ink);
        font: inherit;
        font-size: 0.82rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition:
          background 0.12s,
          border-color 0.12s;
      }

      .btn:hover {
        background: var(--bg);
      }

      .btn-primary {
        border-color: var(--ink);
        background: var(--ink);
        color: #fff;
      }

      .btn-primary:hover {
        background: #333;
      }

      .btn-small {
        padding: 6px 12px;
        font-size: 0.74rem;
      }

      /*
       * Agent cards
       */
      .agents-grid {
        display: grid;
        grid-template-columns:
          repeat(auto-fill, minmax(320px, 1fr));
        gap: 16px;
      }

      .agent-card {
        display: flex;
        flex-direction: column;
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: var(--surface);
      }

      .agent-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
      }

      .agent-name {
        font-size: 1.05rem;
        font-weight: 700;
      }

      .agent-title {
        margin-top: 2px;
        color: var(--muted);
        font-size: 0.78rem;
      }

      .agent-brokerage {
        margin-top: 10px;
        font-size: 0.84rem;
        font-weight: 600;
      }

      .lead-count {
        flex-shrink: 0;
        padding: 4px 9px;
        border-radius: 999px;
        background: var(--green-bg);
        color: var(--green);
        font-size: 0.72rem;
        font-weight: 700;
      }

      .agent-contact {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-top: 12px;
      }

      .agent-contact span {
        color: var(--muted);
        font-size: 0.8rem;
      }

      /*
       * Site information
       */
      .site-box {
        margin-top: 18px;
        padding: 14px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg);
      }

      .site-label {
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 0.67rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .site-name {
        font-weight: 700;
      }

      .site-domain {
        margin-top: 3px;
        color: var(--muted);
        font-size: 0.78rem;
        word-break: break-word;
      }

      .site-city {
        margin-top: 5px;
        color: var(--muted);
        font-size: 0.72rem;
        text-transform: capitalize;
      }

      .agent-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: auto;
        padding-top: 18px;
      }

      .empty {
        padding: 60px 20px;
        color: var(--muted);
        text-align: center;
      }

      /*
       * Modal
       */
      .modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(0, 0, 0, 0.38);
      }

      .modal-backdrop.open {
        display: flex;
      }

      .modal {
        width: 100%;
        max-width: 560px;
        max-height: 92vh;
        overflow-y: auto;
        padding: 28px;
        border-radius: 18px;
        background: var(--surface);
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.18);
      }

      .modal h2 {
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: -0.025em;
      }

      .modal-intro {
        margin-top: 4px;
        margin-bottom: 22px;
        color: var(--muted);
        font-size: 0.82rem;
      }

      .form-section {
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
      }

      .form-section:first-of-type {
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
      }

      .form-section-title {
        margin-bottom: 12px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .field-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-bottom: 12px;
      }

      .field label {
        color: var(--muted);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      .field input,
      .field select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border-md);
        border-radius: 10px;
        outline: none;
        background: var(--bg);
        color: var(--ink);
        font: inherit;
        font-size: 0.86rem;
      }

      .field input:focus,
      .field select:focus {
        border-color: var(--ink);
      }

      .domain-field {
        display: flex;
        align-items: stretch;
      }

      .domain-field input {
        min-width: 0;
        border-radius: 10px 0 0 10px;
      }

      .domain-suffix {
        display: flex;
        align-items: center;
        padding: 0 11px;
        border: 1px solid var(--border-md);
        border-left: 0;
        border-radius: 0 10px 10px 0;
        background: #fff;
        color: var(--muted);
        font-size: 0.78rem;
        white-space: nowrap;
      }

      .field-hint {
        color: var(--muted);
        font-size: 0.7rem;
      }

      .modal-actions {
        display: flex;
        gap: 8px;
        margin-top: 20px;
      }

      .modal-actions .btn-primary {
        flex: 1;
      }

      .status {
        min-height: 18px;
        margin-top: 12px;
        color: var(--muted);
        font-size: 0.78rem;
        line-height: 1.45;
      }

      .status.error {
        color: #b91c1c;
      }

      .status.success {
        color: #15803d;
      }

      @media (max-width: 768px) {
        .layout {
          display: block;
        }

        .main {
          padding: 20px 16px 60px;
        }

        .page-head {
          align-items: flex-start;
        }

        .agents-grid {
          grid-template-columns: 1fr;
        }

        .field-grid {
          grid-template-columns: 1fr;
          gap: 0;
        }

        .modal {
          padding: 22px;
        }
      }
    </style>
  </head>

  <body>
    <div class="layout">
      <AdminSidebar active="agents" />

      <main class="main">
        <header class="page-head">
          <div>
            <h1>Agents</h1>
            <p>
              Create and manage Locus agent sites.
            </p>
          </div>

          <button
            class="btn btn-primary"
            id="open-modal"
            type="button"
          >
            + Add agent
          </button>
        </header>

        {
          agents.length > 0 ? (
            <div class="agents-grid">
              {agents.map((agent: any) => {
                const site =
                  siteByAgent[agent.id];

                return (
                  <article
                    class="agent-card"
                    data-agent-id={agent.id}
                  >
                    <div class="agent-top">
                      <div>
                        <div class="agent-name">
                          {agent.name}
                        </div>

                        {agent.title && (
                          <div class="agent-title">
                            {agent.title}
                          </div>
                        )}
                      </div>

                      <span class="lead-count">
                        {leadCountByAgent[agent.id] || 0} leads
                      </span>
                    </div>

                    <div class="agent-brokerage">
                      {agent.brokerage || "Brokerage not set"}
                    </div>

                    <div class="agent-contact">
                      {agent.email && (
                        <span>{agent.email}</span>
                      )}

                      {agent.phone && (
                        <span>{agent.phone}</span>
                      )}
                    </div>

                    {site ? (
                      <div class="site-box">
                        <div class="site-label">
                          Locus site
                        </div>

                        <div class="site-name">
                          {site.site_name ||
                            `${agent.name} Real Estate`}
                        </div>

                        <div class="site-domain">
                          {site.domain}
                        </div>

                        <div class="site-city">
                          {site.city}
                        </div>
                      </div>
                    ) : (
                      <div class="site-box">
                        <div class="site-label">
                          Locus site
                        </div>

                        <div class="site-domain">
                          No site attached
                        </div>
                      </div>
                    )}

                    <div class="agent-footer">
                      {site && (
                        <>
                          <a
                            class="btn btn-small"
                            href={`/admin/agent-page?id=${site.id}`}
                          >
                            Edit site
                          </a>

                          <a
                            class="btn btn-small"
                            href={`https://${site.domain}`}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            View site ↗
                          </a>
                        </>
                      )}

                      <a
                        class="btn btn-small"
                        href={`/admin/intent-sessions?agent=${agent.id}`}
                      >
                        Leads
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          ) : (
            <div class="empty">
              No agents yet. Create your first Locus site.
            </div>
          )
        }
      </main>
    </div>

    <!-- Create Locus site -->
    <div
      class="modal-backdrop"
      id="modal"
    >
      <div class="modal">
        <h2>Create Locus site</h2>

        <p class="modal-intro">
          Create the agent account, site and primary market in one step.
        </p>

        <div class="form-section">
          <div class="form-section-title">
            Agent
          </div>

          <div class="field">
            <label for="m-name">
              Name
            </label>

            <input
              id="m-name"
              autocomplete="off"
              placeholder="Jane Smith"
            />
          </div>

          <div class="field">
            <label for="m-email">
              Email
            </label>

            <input
              id="m-email"
              type="email"
              autocomplete="off"
              placeholder="jane@brokerage.com"
            />
          </div>

          <div class="field-grid">
            <div class="field">
              <label for="m-phone">
                Phone
              </label>

              <input
                id="m-phone"
                autocomplete="off"
                placeholder="250 555 0100"
              />
            </div>

            <div class="field">
              <label for="m-title">
                Title
              </label>

              <input
                id="m-title"
                value="REALTOR®"
              />
            </div>
          </div>

          <div class="field">
            <label for="m-brokerage">
              Brokerage
            </label>

            <input
              id="m-brokerage"
              autocomplete="off"
              placeholder="eXp Realty"
            />
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title">
            Site
          </div>

          <div class="field">
            <label for="m-subdomain">
              Subdomain
            </label>

            <div class="domain-field">
              <input
                id="m-subdomain"
                autocomplete="off"
                placeholder="janesmith"
              />

              <span class="domain-suffix">
                .bc.realestate
              </span>
            </div>

            <div class="field-hint">
              You will add this domain as a Netlify alias after creation.
            </div>
          </div>

          <div class="field">
            <label for="m-site-name">
              Site name
            </label>

            <input
              id="m-site-name"
              autocomplete="off"
              placeholder="Jane Smith Real Estate"
            />
          </div>

          <div class="field-grid">
            <div class="field">
              <label for="m-city">
                Primary city
              </label>

              <input
                id="m-city"
                value="nanaimo"
              />
            </div>

            <div class="field">
              <label for="m-accent">
                Accent colour
              </label>

              <input
                id="m-accent"
                value="#2f6f73"
              />
            </div>
          </div>
        </div>

        <div class="modal-actions">
          <button
            class="btn btn-primary"
            id="save-agent-btn"
            type="button"
          >
            Create site
          </button>

          <button
            class="btn"
            id="close-modal"
            type="button"
          >
            Cancel
          </button>
        </div>

        <div
          class="status"
          id="modal-status"
        ></div>
      </div>
    </div>

    <script>
      const modal =
        document.getElementById("modal");

      const openButton =
        document.getElementById("open-modal");

      const closeButton =
        document.getElementById("close-modal");

      const saveButton =
        document.getElementById("save-agent-btn");

      const status =
        document.getElementById("modal-status");

      const nameInput =
        document.getElementById("m-name");

      const subdomainInput =
        document.getElementById("m-subdomain");

      const siteNameInput =
        document.getElementById("m-site-name");

      let subdomainWasEdited = false;
      let siteNameWasEdited = false;

      function slugifyName(value) {
        return String(value || "")
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9]+/g, "")
          .replace(/^-+|-+$/g, "");
      }

      function openModal() {
        modal?.classList.add("open");

        setTimeout(() => {
          nameInput?.focus();
        }, 30);
      }

      function closeModal() {
        modal?.classList.remove("open");
      }

      openButton?.addEventListener(
        "click",
        openModal
      );

      closeButton?.addEventListener(
        "click",
        closeModal
      );

      modal?.addEventListener(
        "click",
        (event) => {
          if (event.target === modal) {
            closeModal();
          }
        }
      );

      subdomainInput?.addEventListener(
        "input",
        () => {
          subdomainWasEdited = true;
        }
      );

      siteNameInput?.addEventListener(
        "input",
        () => {
          siteNameWasEdited = true;
        }
      );

      nameInput?.addEventListener(
        "input",
        () => {
          const name =
            nameInput.value.trim();

          if (!subdomainWasEdited) {
            subdomainInput.value =
              slugifyName(name);
          }

          if (!siteNameWasEdited) {
            siteNameInput.value =
              name
                ? `${name} Real Estate`
                : "";
          }
        }
      );

      saveButton?.addEventListener(
        "click",
        async () => {
          if (!status || !saveButton) {
            return;
          }

          const name =
            document.getElementById("m-name")?.value?.trim();

          const email =
            document.getElementById("m-email")?.value?.trim();

          const subdomain =
            document.getElementById("m-subdomain")?.value?.trim();

          if (!name) {
            status.textContent =
              "Enter the agent name.";
            status.className =
              "status error";
            return;
          }

          if (!email) {
            status.textContent =
              "Enter the agent email.";
            status.className =
              "status error";
            return;
          }

          if (!subdomain) {
            status.textContent =
              "Enter a subdomain.";
            status.className =
              "status error";
            return;
          }

          status.textContent =
            "Creating agent and site…";

          status.className =
            "status";

          saveButton.disabled = true;

          try {
            const response =
              await fetch(
                "/api/create-agent",
                {
                  method: "POST",

                  headers: {
                    "Content-Type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({
                      name,

                      email,

                      phone:
                        document.getElementById(
                          "m-phone"
                        )?.value || "",

                      title:
                        document.getElementById(
                          "m-title"
                        )?.value || "",

                      brokerage:
                        document.getElementById(
                          "m-brokerage"
                        )?.value || "",

                      subdomain,

                      siteName:
                        document.getElementById(
                          "m-site-name"
                        )?.value || "",

                      city:
                        document.getElementById(
                          "m-city"
                        )?.value || "nanaimo",

                      accentColor:
                        document.getElementById(
                          "m-accent"
                        )?.value || "#2f6f73",
                    }),
                }
              );

            const json =
              await response.json();

            if (!response.ok || !json.ok) {
              throw new Error(
                json.error ||
                  "Unable to create site."
              );
            }

            status.innerHTML =
              `Created <strong>${json.domain}</strong>.<br>` +
              `Add this domain alias in Netlify, then the site will be live.`;

            status.className =
              "status success";

            setTimeout(() => {
              window.location.reload();
            }, 2500);
          } catch (error) {
            status.textContent =
              `Error: ${
                error?.message ||
                "Unable to create site."
              }`;

            status.className =
              "status error";

            saveButton.disabled = false;
          }
        }
      );
    </script>
  </body>
</html>