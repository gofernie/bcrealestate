---
import { createClient } from "@supabase/supabase-js";
import AdminTopNav from "../../../../components/AdminTopNav.astro";

export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const siteId = String(Astro.params.id || "").trim();

const { data: site, error: siteError } = await supabase
  .from("sites")
  .select(`
    id,
    domain,
    city,
    site_name,
    accent_color,
    nav_property_types,
    secondary_markets
  `)
  .eq("id", siteId)
  .maybeSingle();

if (!site && !siteError) {
  return Astro.redirect("/admin");
}

const city = String(site?.city || "")
  .trim()
  .toLowerCase()
  .replace(/-/g, " ")
  .replace(/\s+/g, " ");

const citySlug = city.replace(/\s+/g, "-");

const cityLabel = city.replace(
  /\b\w/g,
  (letter) => letter.toUpperCase()
);

const siteName =
  String(site?.site_name || site?.domain || "Website");

const secondaryMarkets =
  Array.isArray(site?.secondary_markets)
    ? site.secondary_markets
        .map((market: any) =>
          String(
            typeof market === "object" && market !== null
              ? market.city || ""
              : market || ""
          ).trim()
        )
        .filter(Boolean)
        .slice(0, 3)
    : [];

const visibleCoreTypes =
  Array.isArray(site?.nav_property_types)
    ? site.nav_property_types.map((value: unknown) =>
        String(value).trim().toLowerCase()
      )
    : [
        "house",
        "condo",
        "townhouse",
        "mobile",
        "land",
      ];

const corePages = [
  {
    label: "Homepage",
    description: `${cityLabel} website homepage`,
    href: `/${citySlug}`,
    propertyType: "",
    alwaysVisible: true,
  },
  {
    label: "Areas",
    description: "Neighbourhood and area directory",
    href: `/${citySlug}/areas`,
    propertyType: "",
    alwaysVisible: true,
  },
  {
    label: "Homes",
    description: "Detached house listings",
    href: `/${citySlug}/homes`,
    propertyType: "house",
  },
  {
    label: "Condos",
    description: "Condo and apartment listings",
    href: `/${citySlug}/condos`,
    propertyType: "condo",
  },
  {
    label: "Townhomes",
    description: "Townhouse listings",
    href: `/${citySlug}/townhomes`,
    propertyType: "townhouse",
  },
  {
    label: "Mobile homes",
    description: "Manufactured and mobile homes",
    href: `/${citySlug}/mobile-homes`,
    propertyType: "mobile",
  },
  {
    label: "Land",
    description: "Lots and land for sale",
    href: `/${citySlug}/land`,
    propertyType: "land",
  },
].map((page) => ({
  ...page,
  isVisible:
    page.alwaysVisible ||
    visibleCoreTypes.includes(page.propertyType),
}));

// order-core-pages-from-site-setting
const coreTypeOrder = new Map(
  visibleCoreTypes.map(
    (propertyType: string, index: number) => [
      propertyType,
      index,
    ]
  )
);

corePages.sort((a, b) => {
  if (!a.propertyType && !b.propertyType) {
    return 0;
  }

  if (!a.propertyType) {
    return -1;
  }

  if (!b.propertyType) {
    return 1;
  }

  const aRank =
    coreTypeOrder.get(a.propertyType) ?? 999;

  const bRank =
    coreTypeOrder.get(b.propertyType) ?? 999;

  return aRank - bRank;
});

const pageIdeas = [
  {
    label: "Waterfront",
    description: "Homes directly on the water",
    template: "waterfront",
  },
  {
    label: "Ocean view",
    description: "Homes featuring ocean views",
    template: "ocean_view_homes",
  },
  {
    label: "Luxury",
    description: "Premium and luxury listings",
    template: "luxury_homes",
  },
  {
    label: "Homes with suites",
    description: "Mortgage-helper and income suites",
    template: "homes_with_suites",
  },
  {
    label: "Family homes",
    description: "Yards, garages, and family-friendly layouts",
    template: "family_homes",
  },
  {
    label: "Updated homes",
    description: "Renovated and updated properties",
    template: "updated_homes",
  },
  {
    label: "Walkable homes",
    description: "Homes close to daily amenities",
    template: "walkable_homes",
  },
  {
    label: "Investment properties",
    description: "Income and investment opportunities",
    template: "investment_properties",
  },
];

const { data: customPages = [], error: pagesError } = await supabase
  .from("intent_pages")
  .select(`
    id,
    slug,
    city,
    hero_heading,
    nav_label,
    lifestyle_angle,
    property_type,
    is_published,
    show_in_nav,
    sort_order,
    created_at
  `)
  .eq("site_id", siteId)
  .eq("is_published", true)
  .order("sort_order", { ascending: true })
  .order("created_at", { ascending: false });

function titleCase(value: unknown) {
  return String(value || "")
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function publicPageHref(page: any) {
  const pageCity = String(page?.city || city)
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "-");

  const siteDomain = String(site?.domain || "")
    .trim()
    .replace(/^https?:\/\//, "")
    .replace(/\/+$/, "");

  const siteOrigin = siteDomain
    ? `https://${siteDomain}`
    : "";

  return `${siteOrigin}/${pageCity}/${page.slug}`;
}

function ideaHref(template: string) {
  const params = new URLSearchParams({
    site_id: siteId,
    city: citySlug,
    page_type: "intent",
    template,
  });

  return `/admin/intent-pages/new?${params.toString()}`;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{siteName} Website Pages</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style is:global>
      .mobile-topbar,
      .drawer-overlay {
        display: none;
      }

      @media (max-width: 768px) {
        .mobile-topbar {
          display: flex !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="page">
      <AdminTopNav active="pages" siteId={siteId} siteName={site?.site_name || ""} city={site?.city || ""} />

      <main class="main">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/admin">Websites</a>
          <span>›</span>
          <a href={`/admin/sites/${siteId}/settings`}>
            {siteName}
          </a>
          <span>›</span>
          <strong>Pages</strong>
        </nav>

        <header class="workspace-header workspace-header--focused">
  <div>
    <p class="eyebrow">Agent website</p>

    <div class="focused-title-row">
      <h1>{siteName}</h1>
      <span class="focused-live-badge">
        <span></span>
        Live
      </span>
    </div>

    <p class="workspace-meta">
      {site?.domain || `${cityLabel} website`}
      {" · "}
      Primary market: {cityLabel}
    </p>
  </div>

  <div class="header-actions">
    <a
      class="button button--secondary"
      href={`/${citySlug}`}
      target="_blank"
      rel="noreferrer"
    >
      View website
    </a>
  </div>
</header>

        {siteError && (
          <div class="notice notice--error">
            {siteError.message}
          </div>
        )}

        
<section class="focused-setup">
  <div class="focused-setup-heading">
    <p class="section-kicker">Website setup</p>
    <h2>Build the agent's website</h2>
    <p>
      Work from the top down. The important decisions
      come first; the website details stay out of the way.
    </p>
  </div>

  <div class="focused-step-list">

    <article class="focused-step">
      <div class="focused-step-number">1</div>

      <div class="focused-step-main">
        <div class="focused-step-heading">
          <div>
            <h3>Agent</h3>
            <p>
              Branding, contact details and website appearance.
            </p>
          </div>

          <a
            href={`/admin/sites/${siteId}/settings`}
            class="focused-step-link"
          >
            Edit agent →
          </a>
        </div>

        <div class="focused-summary">
          <strong>{siteName}</strong>
          <span>{site?.domain || "Domain not set"}</span>
        </div>
      </div>
    </article>


    <article class="focused-step">
      <div class="focused-step-number">2</div>

      <div class="focused-step-main">
        <div class="focused-step-heading">
          <div>
            <h3>Markets</h3>
            <p>
              One primary market plus up to three
              secondary markets.
            </p>
          </div>

          <a
            href={`/admin/sites/${siteId}/settings`}
            class="focused-step-link"
          >
            Manage markets →
          </a>
        </div>

        <div class="focused-market-grid">
          <div>
            <span class="focused-label">Primary</span>
            <strong class="focused-market focused-market--primary">
              {cityLabel}
            </strong>
          </div>

          <div>
            <span class="focused-label">Also serves</span>

            <div class="focused-market-row">
              {
                secondaryMarkets.length ? (
                  secondaryMarkets.map((market) => (
                    <span class="focused-market">
                      {String(market)
                        .replace(/[-_]+/g, " ")
                        .replace(
                          /\b\w/g,
                          (letter) => letter.toUpperCase()
                        )}
                    </span>
                  ))
                ) : (
                  <span class="focused-empty">
                    No secondary markets yet
                  </span>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </article>


    <article class="focused-step">
      <div class="focused-step-number">3</div>

      <div class="focused-step-main">
        <div class="focused-step-heading">
          <div>
            <h3>Website</h3>
            <p>
              Core buyer pages and navigation.
            </p>
          </div>

          <a
            href="#core-pages"
            class="focused-step-link"
            data-open-section="core-pages"
          >
            Customize →
          </a>
        </div>

        <div class="focused-page-summary">
          {
            corePages.map((page) => (
              <div>
                <span>{page.label}</span>

                <strong
                  class:list={[
                    "focused-page-state",
                    {
                      "focused-page-state--off":
                        !page.isVisible
                    }
                  ]}
                >
                  <i></i>
                  {page.isVisible ? "On" : "Off"}
                </strong>
              </div>
            ))
          }
        </div>
      </div>
    </article>


    <article class="focused-step">
      <div class="focused-step-number">4</div>

      <div class="focused-step-main">
        <div class="focused-step-heading">
          <div>
            <h3>Lead generation</h3>
            <p>
              Build discovery pages and see what buyers
              are responding to.
            </p>
          </div>

          <a
            href={`/admin/intent-pages/new?site_id=${encodeURIComponent(
              siteId
            )}&city=${encodeURIComponent(citySlug)}`}
            class="focused-step-link"
          >
            Create page →
          </a>
        </div>

        <div class="focused-lead-grid">
          <a
            href="#my-pages"
            data-open-section="my-pages"
          >
            <strong>{customPages.length}</strong>
            <span>Intent pages</span>
          </a>

          <a href={`/admin/intent-sessions?site_id=${encodeURIComponent(siteId)}`}>
            <strong>◎</strong>
            <span>Intent sessions</span>
          </a>

          <a href={`/admin/leads?site_id=${encodeURIComponent(siteId)}`}>
            <strong>→</strong>
            <span>Leads</span>
          </a>

          <a href={`/shortlists?site_id=${encodeURIComponent(siteId)}`}>
  <strong>♥</strong>
  <span>Shortlists</span>
</a>
<a href={`/listings?site_id=${encodeURIComponent(siteId)}&agent_id=${encodeURIComponent(String(site?.agent_id || ""))}`}>
            <strong>⌂</strong>
            <span>Create shortlist</span>
          </a>
        </div>
      </div>
    </article>

  </div>
</section>


<section class="focused-share">
  <div>
    <p class="section-kicker">Ready to share</p>
    <h2>{site?.domain || `${cityLabel} website`}</h2>
    <p>
      Open the finished site and send it to the agent.
    </p>
  </div>

  <a
    href={`/${citySlug}`}
    target="_blank"
    rel="noreferrer"
    class="button focused-open-button"
  >
    Open website →
  </a>
</section>
<section class="workspace-section" id="core-pages">
          <div class="section-heading">
            <div>
              <p class="section-kicker">Website foundation</p>
              <h2>Core pages</h2>

              <p>
                Essential listing and location pages created automatically
                for this website.
              </p>
            </div>
          </div>

          <div class="core-nav-tools">
  <span>
    Drag visible pages into the order you want.
  </span>

  <button
    type="button"
    class="small-button small-button--dark"
    data-save-core-nav-order
  >
    Save nav order
  </button>
</div>
<div class="page-grid" data-core-nav-sort-list data-site-id={siteId}>
            {corePages.map((corePage) => (
              <article
  class="website-page-card"
  draggable={Boolean(
    corePage.propertyType &&
    corePage.isVisible
  )}
  data-core-nav-item={
    corePage.propertyType || undefined
  }
  data-core-nav-visible={
    String(corePage.isVisible)
  }
>
                <div class="page-card-copy">
                  <div class="page-title-row">
                    <h3>{corePage.label}</h3>

                    <span
                      class:list={[
                        "status",
                        {
                          "status--live": corePage.isVisible,
                          "status--hidden": !corePage.isVisible,
                        },
                      ]}
                    >
                      {corePage.isVisible ? "In navigation" : "Hidden"}
                    </span>
                  </div>

                  <p>{corePage.description}</p>
                </div>

                <div class="page-card-actions">
                  <a
                    class="small-button"
                    href={corePage.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Open
                  </a>

                  {
                    corePage.propertyType && (
                      <button
                        type="button"
                        class:list={[
                          "small-button",
                          "nav-toggle",
                          {
                            "nav-toggle--remove": corePage.isVisible,
                          },
                        ]}
                        data-core-nav-toggle
                        data-site-id={siteId}
                        data-property-type={corePage.propertyType}
                        data-visible={String(corePage.isVisible)}
                      >
                        {corePage.isVisible
                          ? "Remove from nav"
                          : "Add to nav"}
                      </button>
                    )
                  }
                </div>
              </article>
            ))}
          </div>
        </section>


        <section class="workspace-section" id="my-pages">
          <div class="section-heading section-heading--actions">
            <div>
              <p class="section-kicker">Made for this website</p>
              <h2>My pages</h2>

              <p>
                Custom category, lifestyle, and buyer-discovery pages.
              </p>
            </div>

            <a
              class="button button--primary"
              href={`/admin/intent-pages/new?site_id=${encodeURIComponent(
                siteId
              )}&city=${encodeURIComponent(citySlug)}`}
            >
              + Create custom page
            </a>
          </div>

          {pagesError && (
            <div class="notice notice--error">
              {pagesError.message}
            </div>
          )}

          {!customPages.length ? (
            <div class="empty-state">
              <h3>No custom pages yet</h3>

              <p>
                Start with one of the ideas above or create your own page.
              </p>
            </div>
          ) : (
            <div class="custom-pages">
              {customPages.map((customPage) => (
                <article class="custom-page-row">
                  <div>
                    <div class="page-title-row">
                      <h3>
                        {customPage.hero_heading ||
                          customPage.nav_label ||
                          titleCase(customPage.slug)}
                      </h3>

                      <span
                        class:list={[
                          "status",
                          {
                            "status--live":
                              customPage.is_published !== false,
                            "status--hidden":
                              customPage.is_published === false,
                          },
                        ]}
                      >
                        {customPage.is_published === false
                          ? "Draft"
                          : "Published"}
                      </span>
                    </div>

                    <p class="page-path">
                      {publicPageHref(customPage)}
                    </p>

                    <div class="page-tags">
                      <span>
                        {customPage.lifestyle_angle
                          ? titleCase(customPage.lifestyle_angle)
                          : "Custom"}
                      </span>

                      {customPage.property_type && (
                        <span>
                          {titleCase(customPage.property_type)}
                        </span>
                      )}

                      {customPage.show_in_nav && (
                        <span>In navigation</span>
                      )}
                    </div>
                  </div>

                  <div class="page-card-actions">
                    <a
                      class="small-button"
                      href={publicPageHref(customPage)}
                      target="_blank"
                      rel="noreferrer"
                    >
                      Open
                    </a>

                    <a
                      class="small-button small-button--dark"
                      href={`/admin/intent-pages/${customPage.id}/edit`}
                    >
                      Edit
                    </a>
<button
  type="button"
  class="small-button small-button--danger"
  data-delete-intent-page
  data-page-id={customPage.id}
  data-site-id={siteId}
  data-page-name={
    customPage.hero_heading ||
    customPage.nav_label ||
    customPage.slug
  }
>
  Delete
</button>
                  </div>
                </article>
              ))}
            </div>
          )}

          <div class="advanced-link">
            <a
              href={`/admin/intent-pages?site_id=${encodeURIComponent(
                siteId
              )}&city=${encodeURIComponent(citySlug)}`}
            >
              Open advanced page manager →
            </a>
          </div>
        </section>
      </main>
    </div>

    <script>
      const navSortList =
        document.querySelector("[data-nav-sort-list]");

      const navSaveButton =
        document.querySelector("[data-save-nav-order]");

      let draggedNavItem = null;

      navSortList?.addEventListener("dragstart", (event) => {
        draggedNavItem =
          event.target.closest("[data-nav-sort-item]");

        if (event.dataTransfer) {
          event.dataTransfer.effectAllowed = "move";
        }
      });

      navSortList?.addEventListener("dragover", (event) => {
        event.preventDefault();

        const target =
          event.target.closest("[data-nav-sort-item]");

        if (!target || target === draggedNavItem || !draggedNavItem) {
          return;
        }

        const rect = target.getBoundingClientRect();
        const insertAfter =
          event.clientY > rect.top + rect.height / 2;

        navSortList.insertBefore(
          draggedNavItem,
          insertAfter ? target.nextSibling : target
        );
      });

      navSaveButton?.addEventListener("click", async () => {
        const items = Array.from(
          document.querySelectorAll("[data-nav-sort-item]")
        ).map((item, index) => ({
          id: item.getAttribute("data-id"),
          sort_order: index + 1,
        }));

        const originalText =
          navSaveButton.textContent || "Save navigation order";

        navSaveButton.disabled = true;
        navSaveButton.textContent = "Saving...";

        try {
          const response = await fetch(
            "/api/admin/save-nav-order",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({ items }),
            }
          );

          const result = await response.json();

          if (!response.ok) {
            throw new Error(
              result?.error || "Could not save navigation order"
            );
          }

          navSaveButton.textContent = "Saved!";
        } catch (error) {
          console.error(error);

          navSaveButton.textContent =
            error instanceof Error
              ? error.message
              : "Save failed";
        }

        setTimeout(() => {
          navSaveButton.textContent = originalText;
          navSaveButton.disabled = false;
        }, 1400);
      });
      document
        .querySelectorAll("[data-core-nav-toggle]")
        .forEach((button) => {
          button.addEventListener("click", async () => {
            const siteId =
              button.getAttribute("data-site-id") || "";

            const propertyType =
              button.getAttribute("data-property-type") || "";

            if (!siteId || !propertyType) {
              return;
            }

            button.disabled = true;

            const originalText =
              button.textContent || "";

            button.textContent = "Saving...";

            try {
              const response = await fetch(
                "/api/admin/toggle-core-nav",
                {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                  },
                  body: JSON.stringify({
                    site_id: siteId,
                    property_type: propertyType,
                  }),
                }
              );

              const result = await response.json();

              if (!response.ok) {
                throw new Error(
                  result?.error ||
                    "Could not update navigation"
                );
              }

              window.location.reload();
            } catch (error) {
              console.error(error);

              button.textContent =
                error instanceof Error
                  ? error.message
                  : "Save failed";

              setTimeout(() => {
                button.textContent = originalText;
              }, 1800);

              button.disabled = false;
            }
          });
        });

      // delete-custom-intent-page
      document
        .querySelectorAll("[data-delete-intent-page]")
        .forEach((button) => {
          button.addEventListener("click", async () => {
            const pageId =
              button.getAttribute("data-page-id") || "";

            const siteId =
              button.getAttribute("data-site-id") || "";

            const pageName =
              button.getAttribute("data-page-name") ||
              "this page";

            const confirmed = window.confirm(
              `Delete "${pageName}" permanently? ` +
              "Its public URL will become a 404 page."
            );

            if (!confirmed) {
              return;
            }

            const originalText =
              button.textContent || "Delete";

            button.disabled = true;
            button.textContent = "Deleting...";

            try {
              const response = await fetch(
                "/api/admin/delete-intent-page",
                {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                  },
                  body: JSON.stringify({
                    page_id: pageId,
                    site_id: siteId,
                  }),
                }
              );

              const result = await response.json();

              if (!response.ok) {
                throw new Error(
                  result?.error ||
                  "The page could not be deleted."
                );
              }

              window.location.reload();
            } catch (error) {
              console.error(error);

              button.textContent =
                error instanceof Error
                  ? error.message
                  : "Delete failed";

              window.setTimeout(() => {
                button.textContent = originalText;
                button.disabled = false;
              }, 2200);
            }
          });
        });

      // sortable-core-navigation
      const coreNavList =
        document.querySelector(
          "[data-core-nav-sort-list]"
        );

      const saveCoreNavButton =
        document.querySelector(
          "[data-save-core-nav-order]"
        );

      let draggedCoreNavItem = null;

      coreNavList?.addEventListener(
        "dragstart",
        (event) => {
          const item = event.target.closest(
            '[data-core-nav-item]'
          );

          if (
            !item ||
            item.getAttribute(
              "data-core-nav-visible"
            ) !== "true"
          ) {
            event.preventDefault();
            return;
          }

          draggedCoreNavItem = item;
          item.classList.add("is-dragging");

          if (event.dataTransfer) {
            event.dataTransfer.effectAllowed =
              "move";
          }
        }
      );

      coreNavList?.addEventListener(
        "dragover",
        (event) => {
          if (!draggedCoreNavItem) {
            return;
          }

          event.preventDefault();

          const target = event.target.closest(
            '[data-core-nav-item][data-core-nav-visible="true"]'
          );

          if (
            !target ||
            target === draggedCoreNavItem
          ) {
            return;
          }

          const rect =
            target.getBoundingClientRect();

          const insertAfter =
            event.clientY >
            rect.top + rect.height / 2;

          coreNavList.insertBefore(
            draggedCoreNavItem,
            insertAfter
              ? target.nextSibling
              : target
          );
        }
      );

      coreNavList?.addEventListener(
        "dragend",
        () => {
          draggedCoreNavItem?.classList.remove(
            "is-dragging"
          );

          draggedCoreNavItem = null;
        }
      );

      saveCoreNavButton?.addEventListener(
        "click",
        async () => {
          const siteId =
            coreNavList?.getAttribute(
              "data-site-id"
            ) || "";

          const propertyTypes = Array.from(
            coreNavList?.querySelectorAll(
              '[data-core-nav-item][data-core-nav-visible="true"]'
            ) || []
          ).map(
            (item) =>
              item.getAttribute(
                "data-core-nav-item"
              ) || ""
          ).filter(Boolean);

          const originalText =
            saveCoreNavButton.textContent ||
            "Save nav order";

          saveCoreNavButton.disabled = true;
          saveCoreNavButton.textContent =
            "Saving...";

          try {
            const response = await fetch(
              "/api/admin/save-core-nav-order",
              {
                method: "POST",
                headers: {
                  "Content-Type":
                    "application/json",
                },
                body: JSON.stringify({
                  site_id: siteId,
                  property_types: propertyTypes,
                }),
              }
            );

            const result =
              await response.json();

            if (!response.ok) {
              throw new Error(
                result?.error ||
                "Could not save nav order."
              );
            }

            saveCoreNavButton.textContent =
              "Saved!";
          } catch (error) {
            console.error(error);

            saveCoreNavButton.textContent =
              error instanceof Error
                ? error.message
                : "Save failed";
          }

          window.setTimeout(() => {
            saveCoreNavButton.textContent =
              originalText;

            saveCoreNavButton.disabled = false;
          }, 1600);
        }
      );
    </script>

