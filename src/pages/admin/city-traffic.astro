---
import AdminSidebar from "../../components/AdminSidebar.astro";
export const prerender = false;
const key = import.meta.env.FATHOM_API_KEY || process.env.FATHOM_API_KEY;
const site = import.meta.env.FATHOM_SITE_ID || process.env.FATHOM_SITE_ID || "AGYCZBFE";
const weeksBack = Math.min(12, Math.max(2, Number(Astro.url.searchParams.get("weeks")) || 8));
const metric = Astro.url.searchParams.get("metric") === "visitors" ? "uniques" : "pageviews";

let error = "";
let rows: any[] = [];
let weekList: string[] = [];
let entryRows: any[] = [];
if (!key || !site) {
  error = "Missing FATHOM_API_KEY or FATHOM_SITE_ID environment variable.";
} else {
  const DAY = 86400000;
  const now = new Date();
  const dow = (now.getUTCDay() + 6) % 7;
  const thisMonday = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() - dow));
  const ymd = (d: Date) => d.toISOString().slice(0, 10);
  const starts = Array.from({ length: weeksBack }, (_, i) => new Date(thisMonday.getTime() - (weeksBack - 1 - i) * 7 * DAY));
  weekList = starts.map(ymd);
  try {
    const fetchWeek = async (start: Date) => {
      const end = new Date(start.getTime() + 6 * DAY);
      const p = new URLSearchParams({ entity: "pageview", entity_id: site, aggregates: metric, field_grouping: "pathname", sort_by: metric + ":desc", timezone: "America/Edmonton", limit: "1000", date_from: ymd(start) + " 00:00:00", date_to: ymd(end) + " 23:59:59" });
      const r = await fetch("https://api.usefathom.com/v1/aggregations?" + p, { headers: { Authorization: `Bearer ${key}` } });
      if (!r.ok) throw new Error(`Fathom API ${r.status}: ${(await r.text()).slice(0, 300)}`);
      const data = await r.json();
      return (Array.isArray(data) ? data : []).map((row: any) => ({ ...row, date: ymd(start) }));
    };
    const results: any[] = []; for (let i = 0; i < starts.length; i += 4) results.push(...(await Promise.all(starts.slice(i, i + 4).map(fetchWeek)))); rows = results.flat(); const pE = new URLSearchParams({ entity: "pageview", entity_id: site, aggregates: "visits", field_grouping: "entry_page,referrer_hostname", sort_by: "visits:desc", timezone: "America/Edmonton", limit: "1000", date_from: ymd(starts[0]) + " 00:00:00" }); const rE = await fetch("https://api.usefathom.com/v1/aggregations?" + pE, { headers: { Authorization: `Bearer ${key}` } }); if (rE.ok) entryRows = await rE.json(); else error = `Fathom API (sources) ${rE.status}: ${(await rE.text()).slice(0, 300)}`;
  } catch (e) { error = e instanceof Error ? e.message : String(e); }
}

const SKIP = new Set(["admin", "api", "_astro", ".netlify"]);
const weekSet = new Set<string>();
const byCity = new Map<string, Map<string, number>>();
for (const row of Array.isArray(rows) ? rows : []) {
  const seg = String(row.pathname || "").split("/")[1] || "(home)";
  if (SKIP.has(seg)) continue;
  const wk = String(row.date || "").slice(0, 10);
  const n = Number(row[metric] || 0);
  weekSet.add(wk);
  if (!byCity.has(seg)) byCity.set(seg, new Map());
  const m = byCity.get(seg)!;
  m.set(wk, (m.get(wk) || 0) + n);
}
const weeks = weekList.length ? weekList : [...weekSet].sort();
const SEARCH_RE = /\b(google|bing|duckduckgo|yahoo|ecosia|brave|yandex|baidu|startpage|qwant)\./i;
const OWN_RE = /bc\.realestate/i;
const srcByCity = new Map<string, { search: number; direct: number; other: number }>();
for (const row of Array.isArray(entryRows) ? entryRows : []) {
  const seg = String(row.entry_page || "").split("/")[1] || "(home)";
  if (SKIP.has(seg)) continue;
  const ref = String(row.referrer_hostname || "").trim().toLowerCase();
  const n = Number(row.visits || 0);
  if (!srcByCity.has(seg)) srcByCity.set(seg, { search: 0, direct: 0, other: 0 });
  const s = srcByCity.get(seg)!;
  if (!ref || OWN_RE.test(ref)) s.direct += n; else if (SEARCH_RE.test(ref)) s.search += n; else s.other += n;
}
const cities = [...byCity.entries()].map(([city, m]) => {
  const vals = weeks.map((w) => m.get(w) || 0);
  const total = vals.reduce((a, b) => a + b, 0);
  const last = vals.at(-1) || 0, prev = vals.at(-2) || 0;
  const change = prev ? Math.round(((last - prev) / prev) * 100) : last ? null : 0;
  const rowMax = Math.max(1, ...vals);
  const step = vals.length > 1 ? 90 / (vals.length - 1) : 0;
  const spark = vals.map((v, i) => `${(i * step).toFixed(1)},${(22 - (v / rowMax) * 19).toFixed(1)}`).join(" ");
  const srcs = srcByCity.get(city) || { search: 0, direct: 0, other: 0 }; return { city, vals, total, change, spark, ...srcs };
}).sort((a, b) => b.total - a.total);
const max = Math.max(1, ...cities.flatMap((c) => c.vals));
const label = (w: string) => new Date(w + "T12:00:00").toLocaleDateString("en-CA", { month: "short", day: "numeric" });
const pretty = (s: string) => s.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const link = (q: Record<string, string>) => "?" + new URLSearchParams({ weeks: String(weeksBack), metric: metric === "uniques" ? "visitors" : "views", ...q });
---
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex" />
<title>City traffic</title>
<style>
  .fs-wrap { display: block; min-height: 100vh; background: #f6f6f4; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #101828; }
  .fs-main { max-width: 1180px; margin: 0 auto; padding: 40px 20px 80px; }
  .eyebrow { margin: 0 0 8px; font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #667085; }
  .fs-main h1 { margin: 0; font-size: clamp(2rem, 4vw, 3.25rem); letter-spacing: -.04em; line-height: 1.05; }
  .fs-sub { max-width: 680px; margin: 12px 0 28px; color: #667085; font-size: 1rem; line-height: 1.5; }
  .fs-flash { background: #e8f4ec; border: 1px solid #b7dcc3; padding: 12px 14px; border-radius: 12px; font-size: 14px; }
  .fs-err { background: #fdecec; border-color: #f2b8b8; }
  .fs-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; margin: 28px 0; }
  .fs-tile { display: flex; flex-direction: column-reverse; justify-content: flex-end; padding: 20px; background: #fff; border: 1px solid #eaecf0; border-radius: 22px; box-shadow: 0 14px 40px rgba(16, 24, 40, .06); color: #667085; font-size: .86rem; font-weight: 700; }
  .fs-tile b { display: block; margin-top: 8px; color: #101828; font-size: 2rem; letter-spacing: -.04em; }
  .fs-next { margin: 0 0 14px; color: #475467; font-size: .9rem; }
  .fs-table-wrap { overflow-x: auto; padding: 8px 22px 22px; background: #fff; border: 1px solid #eaecf0; border-radius: 22px; box-shadow: 0 14px 40px rgba(16, 24, 40, .06); }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { padding: 12px 10px; border-top: 1px solid #f2f4f7; text-align: left; white-space: nowrap; }
  thead th { border-top: 0; }
  th { position: sticky; top: 0; background: #fff; color: #667085; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  th[data-dir="asc"]::after { content: " \25B2"; font-size: 10px; }
  th[data-dir="desc"]::after { content: " \25BC"; font-size: 10px; }
  button { font: inherit; font-size: 12px; padding: 5px 12px; border-radius: 999px; border: 1px solid #d0d5dd; background: #fff; cursor: pointer; }
  button:hover { background: #f2f4f7; }  .bar { display: flex; flex-wrap: wrap; gap: 16px; margin: 0 0 14px; }
  .bar span { display: inline-flex; gap: 4px; }
  .bar a { font-size: 12px; padding: 5px 12px; border-radius: 999px; border: 1px solid #d0d5dd; background: #fff; color: #101828; text-decoration: none; }
  .bar a:hover { background: #f2f4f7; }
  .bar a.on { background: #101828; border-color: #101828; color: #fff; }
  th, td { text-align: right; font-variant-numeric: tabular-nums; }
  th:nth-child(-n+2), td:nth-child(-n+2) { text-align: left; }
  th { cursor: pointer; user-select: none; }
  th:nth-child(2) { cursor: default; }
  th:hover { color: #101828; }
  td.city a { color: #101828; font-weight: 700; text-decoration: none; }
  td.city a:hover { text-decoration: underline; }
  td.total { font-weight: 800; }
  td.src, th.src { background: #fcfcfd; color: #475467; }
  .up { color: #067647; font-weight: 700; } .down { color: #b42318; font-weight: 700; } .flat { color: #98a2b3; }
  .note { margin-top: 12px; color: #98a2b3; font-size: 12px; }
</style>
</head>
<body>
<div class="fs-wrap"><AdminSidebar /><main class="fs-main">
  <p class="eyebrow">Analytics</p><h1>City traffic</h1>
  <p class="fs-sub">bc.realestate · {metric === "uniques" ? "page visitors (summed across pages)" : "page views"} by city, per week · source: Fathom</p>
  <div class="fs-tiles"><div class="fs-tile"><b>{cities.reduce((a, c) => a + c.total, 0).toLocaleString()}</b>{metric === "uniques" ? "page visitors" : "page views"}</div><div class="fs-tile"><b>{cities.filter((c) => c.total > 0).length}</b>sections with traffic</div><div class="fs-tile"><b>{cities.reduce((a, c) => a + (c.search || 0), 0).toLocaleString()}</b>entries from search</div><div class="fs-tile"><b>{cities.reduce((a, c) => a + (c.direct || 0), 0).toLocaleString()}</b>direct entries</div></div>
  <div class="bar">
    <span>{[4, 8, 12].map((n) => <a class={n === weeksBack ? "on" : ""} href={link({ weeks: String(n) })}>{n} wks</a>)}</span>
    <span><a class={metric === "pageviews" ? "on" : ""} href={link({ metric: "views" })}>Views</a> <a class={metric === "uniques" ? "on" : ""} href={link({ metric: "visitors" })}>Visitors</a></span>
  </div>
  {error ? <p class="fs-flash fs-err">{error}</p> : (
    <div class="fs-table-wrap"><table>
      <thead><tr><th>City</th><th>Trend</th>{weeks.map((w) => <th>{label(w)}</th>)}<th class="src" title="Visits that entered on this city from a search engine">Search</th><th class="src" title="Visits with no referrer">Direct</th><th class="src" title="Social, AI tools, other sites">Other</th><th>Total</th><th>vs last wk</th></tr></thead>
      <tbody>
        {cities.map((c) => (
          <tr>
            <td class="city"><a href={c.city === "(home)" ? "/" : `/${c.city}/`} target="_blank">{c.city === "(home)" ? "(home)" : pretty(c.city)}</a></td>
            <td><svg width="92" height="24" viewBox="0 0 92 24"><polyline points={c.spark} fill="none" stroke="#2f6f73" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" /></svg></td>
            {c.vals.map((v) => <td style={`background: rgba(47,111,115,${(v / max * 0.5).toFixed(3)}); color: ${v / max > 0.6 ? "#fff" : "inherit"}`}>{v || ""}</td>)}
            <td class="src">{c.search || ""}</td><td class="src">{c.direct || ""}</td><td class="src">{c.other || ""}</td><td class="total">{c.total}</td>
            <td class={c.change === null ? "up" : c.change > 0 ? "up" : c.change < 0 ? "down" : "flat"}>{c.change === null ? "new" : c.change > 0 ? `+${c.change}%` : c.change < 0 ? `${c.change}%` : "–"}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
  )}
  <p class="note">Search / Direct / Other count visits that <em>entered</em> the site on that city, totalled over the whole period shown. The last column is the current week, so it's partial until Sunday. "vs last wk" compares the current partial week to the previous full week.</p>
<script is:inline>
(() => {
  const table = document.querySelector("table"); if (!table) return;
  const tbody = table.tBodies[0];
  const ths = [...table.tHead.rows[0].cells];
  const val = (td) => {
    const t = (td?.textContent || "").trim();
    if (t === "new") return 1e9;
    const n = parseFloat(t.replace(/[^\d.-]/g, ""));
    if (!isNaN(n)) return n;
    return /[a-z(]/i.test(t) ? t.toLowerCase() : 0;
  };
  let state = { col: -1, dir: 1 };
  ths.forEach((th, i) => {
    if (i === 1) return;
    th.style.cursor = "pointer";
    th.style.userSelect = "none";
    th.addEventListener("click", () => {
      state = { col: i, dir: state.col === i ? -state.dir : (i === 0 ? 1 : -1) };
      const rows = [...tbody.rows];
      rows.sort((a, b) => {
        const x = val(a.cells[i]), y = val(b.cells[i]);
        if (typeof x === "string" || typeof y === "string") return String(x).localeCompare(String(y)) * state.dir;
        return (x - y) * state.dir;
      });
      rows.forEach((r) => tbody.appendChild(r));
      ths.forEach((h) => h.removeAttribute("data-dir"));
      th.setAttribute("data-dir", state.dir > 0 ? "asc" : "desc");
    });
  });
})();
</script>
</main></div>
</body>
</html>