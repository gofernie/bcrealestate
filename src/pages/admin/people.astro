---
// crm-v1: People — one record per buyer, with a Today list
import AdminTopNav from "../../components/AdminTopNav.astro";
import CrmStyles from "../../components/crm/CrmStyles.astro";
import { loadPeople, STAGES, stageLabel, fmtPhone, sbAdmin, todayStr, ago, fuText } from "../../lib/crm";
export const prerender = false;

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const access: any = (Astro.locals as any).adminAccess || null;
let siteId = String(Astro.url.searchParams.get("site_id") || "").trim();
if (!UUID.test(siteId)) {
  const host = String(Astro.request.headers.get("x-forwarded-host") || Astro.request.headers.get("host") || "").split(",")[0].trim().toLowerCase().replace(/^www\./, "").split(":")[0].replace(/\.localhost$/, ".bc.realestate");
  if (host && !["localhost", "127.0.0.1", "bc.realestate"].includes(host)) {
    const { data } = await sbAdmin().from("sites").select("id").eq("domain", host).maybeSingle();
    siteId = String(data?.id || "");
  }
}
if (!UUID.test(siteId)) siteId = String(access?.currentSiteId || "");
if (access && !access.isPlatformAdmin && !(access.siteIds || []).includes(siteId)) siteId = access.siteIds?.[0] || "";

const { site, people } = UUID.test(siteId) ? await loadPeople(siteId) : { site: null, people: [] as any[] };
const today = todayStr();
const href = (p: any) => `/admin/person?site_id=${encodeURIComponent(siteId)}&key=${encodeURIComponent(p.key)}`;
const contact = (p: any) => p.emails[0] || (p.phones[0] ? fmtPhone(p.phones[0]) : "");

const day3 = Date.now() - 3 * 864e5, day14 = Date.now() - 14 * 864e5;
const openT = UUID.test(siteId) ? ((await sbAdmin().from("crm_tasks").select("person_key, title, due_on").eq("site_id", siteId).is("done_at", null)).data || []) : [];
const tmap = new Map();
for (const x of openT) { if (!tmap.has(x.person_key)) tmap.set(x.person_key, []); tmap.get(x.person_key).push(x); }
const tasksOf = (p: any) => p.keys.flatMap((k: string) => tmap.get(k) || []).sort((a: any, b: any) => String(a.due_on || "9999").localeCompare(String(b.due_on || "9999")));
const dueOf = (p: any) => tasksOf(p).filter((x: any) => x.due_on && x.due_on <= today);
const due = people.filter((p) => dueOf(p).length).sort((a, b) => String(dueOf(a)[0].due_on).localeCompare(String(dueOf(b)[0].due_on)));
const hot = people.filter((p) => !["closed", "past", "notnow"].includes(p.stage) && p.lastActivity > day3 && p.lastActivity > p.lastAgentTouch && (p.counts.loves + p.counts.likes + p.counts.enquiries) > 0 && !due.includes(p))
  .sort((a, b) => b.recentLoves - a.recentLoves || b.lastActivity - a.lastActivity);
const fresh = people.filter((p) => !p.manual && p.stage === "new" && !p.lastAgentTouch && p.firstSeen > day14 && !due.includes(p) && !hot.includes(p));
const sellers = people.filter((p) => p.listingMls && Date.now() - (p.lastAgentTouch || 0) > 7 * 864e5).sort((a, b) => (a.lastAgentTouch || 0) - (b.lastAgentTouch || 0));
const stageCount = (s: string) => people.filter((p) => p.stage === s).length;
const fc: any = {
  buyers: people.filter((p) => p.isBuyer).length, sellers: people.filter((p) => p.isSeller).length, tasks: people.filter((p) => tasksOf(p).length).length,
  overdue: people.filter((p) => { const t0 = tasksOf(p)[0]; return t0?.due_on && t0.due_on < today; }).length,
  loved: people.filter((p) => p.counts.loves).length,
  uncontacted: people.filter((p) => !p.lastAgentTouch).length,
  watching: people.filter((p) => p.counts.watches).length,
  shortlists: people.filter((p) => p.counts.shortlists).length,
};
const FILTERS = [["buyers", "Buyers"], ["sellers", "Sellers"], ["tasks", "Has tasks"], ["overdue", "Overdue"], ["loved", "Loved homes"], ["uncontacted", "Not contacted"], ["watching", "Watching"], ["shortlists", "Shortlists"]];
---
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>People · Locus Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <CrmStyles />
</head>
<body>
  <AdminTopNav siteId={siteId} />
  <main class="crm">
    <h1>People</h1>
    <p class="sub">Everyone who's enquired, saved a search, got a shortlist or is watching a home, merged into one record each.</p>

    {!site && <p>Choose a site first.</p>}
    {site && (
      <>
        <h2>Today</h2>
        <section class="today">
          <div class="crm-card">
            <h3>Tasks due {!!(due.length) && <span class="n">{due.length}</span>}</h3>
            <p class="hint">Due today or overdue.</p>
            {due.slice(0, 8).map((p) => { const t0 = dueOf(p)[0]; const more = tasksOf(p).length - 1; return <a class="t" href={href(p)}><strong>{p.name}</strong><span class={today > t0.due_on ? "overdue" : ""}>{fuText(t0.due_on)} · {t0.title}{more > 0 ? ` · +${more} more` : ""}</span></a>; })}
            {due.length > 8 && <div class="empty">+{due.length - 8} more people with tasks due</div>}
            {!due.length && <div class="empty">Nothing due.</div>}
          </div>
          <div class="crm-card">
            <h3>Active since you last reached out {!!(hot.length) && <span class="n">{hot.length}</span>}</h3>
            <p class="hint">Loved, liked or asked about homes in the last 3 days.</p>
            {hot.slice(0, 8).map((p) => <a class="t" href={href(p)}><strong>{p.name}</strong><span>{p.lastWhat} · {ago(p.lastActivity)}{p.recentLoves ? ` · ♥ ${p.recentLoves} this week` : ""}</span></a>)}
            {!hot.length && <div class="empty">No new buyer activity.</div>}
          </div>
          <div class="crm-card">
            <h3>New, not contacted {!!(fresh.length) && <span class="n">{fresh.length}</span>}</h3>
            <p class="hint">First seen in the last 2 weeks, no email or note yet.</p>
            {fresh.slice(0, 8).map((p) => <a class="t" href={href(p)}><strong>{p.name}</strong><span>{p.lastWhat || "New"} · {ago(p.firstSeen)}</span></a>)}
            {!fresh.length && <div class="empty">All caught up.</div>}
          </div>
          <div class="crm-card">
            <h3>Sellers to update {!!(sellers.length) && <span class="n">{sellers.length}</span>}</h3>
            <p class="hint">Your listings with no contact in 7+ days.</p>
            {sellers.slice(0, 8).map((p) => <a class="t" href={href(p) + "&email=price"}><strong>{p.name}</strong><span>{p.lastAgentTouch ? `Last contact ${ago(p.lastAgentTouch)}` : "No contact logged yet"} · send an update</span></a>)}
            {!sellers.length && <div class="empty">All sellers up to date.</div>}
          </div>
        </section>

        <h2 style="display:flex;align-items:center;justify-content:space-between;gap:12px;"><span>Everyone <span style="font-weight:600;color:#a8a196;">· {people.length}</span></span><button class="btn dark" id="add-person" type="button" style="text-transform:none;letter-spacing:0;">+ Add person</button></h2>
        <div class="crm-card" id="add-form" data-site={siteId} style="display:none;padding:16px;margin:0 0 14px;">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:8px;">
            <input id="ap-name" placeholder="Name" autocomplete="off" style="border:1px solid #d9d2c6;border-radius:6px;padding:9px 10px;font:inherit;font-size:.9rem;" />
            <input id="ap-email" type="email" placeholder="Email" autocomplete="off" style="border:1px solid #d9d2c6;border-radius:6px;padding:9px 10px;font:inherit;font-size:.9rem;" />
            <input id="ap-phone" type="tel" placeholder="Phone" autocomplete="off" style="border:1px solid #d9d2c6;border-radius:6px;padding:9px 10px;font:inherit;font-size:.9rem;" />
          </div>
          <div style="display:flex;gap:8px;margin-top:10px;align-items:center;"><button class="btn dark" id="ap-save" type="button">Add person</button><button class="btn" id="ap-cancel" type="button">Cancel</button><span id="ap-msg" style="font-size:.8rem;color:#a3352a;"></span></div>
        </div>
        <div class="bar">
          <input type="search" id="q" placeholder="Search name, email or phone" autocomplete="off" />
          <button class="chip on" data-stage="">All<span class="c">{people.length}</span></button>
          {STAGES.map(([k, l]) => !!(stageCount(k)) && <button class="chip" data-stage={k}>{l}<span class="c">{stageCount(k)}</span></button>)}
          <span style="width:1px;height:22px;background:#d9d2c6;margin:0 4px;align-self:center;"></span>
          {FILTERS.map(([k, l]) => !!(fc[k]) && <button class="chip fchip" data-f={k}>{l}<span class="c">{fc[k]}</span></button>)}
          <select id="sort" style="margin-left:auto;height:34px;border:1px solid #d9d2c6;border-radius:6px;padding:0 10px;font:inherit;font-size:.85rem;background:#fff;cursor:pointer;">
            <option value="recent">Sort: Recent activity</option>
            <option value="task">Sort: Next task due</option>
            <option value="touch">Sort: Longest since contact</option>
            <option value="loves">Sort: Most loved</option>
            <option value="enq">Sort: Most enquiries</option>
            <option value="newest">Sort: Newest first</option>
            <option value="name">Sort: Name A–Z</option>
          </select>
        </div>
        <div class="crm-card plist" id="plist" data-today={today}>
          {people.map((p) => (
            <a class="prow" href={href(p)} data-stage={p.stage} data-buyer={p.isBuyer ? "1" : ""} data-seller={p.isSeller ? "1" : ""} data-q={[p.name, ...p.emails, ...p.phones, p.address || "", p.spouseName || ""].join(" ").toLowerCase()} data-name={String(p.name).toLowerCase()} data-last={p.lastActivity} data-first={p.firstSeen} data-touch={p.lastAgentTouch} data-loves={p.counts.loves} data-enq={p.counts.enquiries} data-sl={p.counts.shortlists} data-watch={p.counts.watches} data-ntask={tasksOf(p).length} data-task={tasksOf(p)[0]?.due_on || (tasksOf(p).length ? "9999" : "")}>
              <div class="nm"><strong>{p.name}</strong><span>{contact(p)}</span>{p.address && <span style="font-size:.78rem;color:#a8a196;">{p.address}</span>}</div>
              <div><span class={"stage stage-" + p.stage}>{stageLabel(p.stage)}</span></div>
              <div class="last"><b>{p.lastWhat || "—"}</b><span>{ago(p.lastActivity)}{p.lastAgentTouch ? ` · you: ${ago(p.lastAgentTouch)}` : ""}</span></div>
              <div class="cnt">
                {!!(p.counts.loves) && <i class="love">♥ {p.counts.loves}</i>}
                {!!(p.counts.enquiries) && <i>{p.counts.enquiries} enquir{p.counts.enquiries === 1 ? "y" : "ies"}</i>}
                {!!(p.counts.shortlists) && <i>{p.counts.shortlists} shortlist{p.counts.shortlists === 1 ? "" : "s"}</i>}
                {!!(p.counts.watches) && <i>{p.counts.watches} watching</i>}
              </div>
              {(() => { const n = tasksOf(p); const t0 = n[0]; return <div class={"fu" + (t0?.due_on && today > t0.due_on ? " overdue" : "")} title={t0 ? t0.title : ""}>{t0 ? (t0.due_on ? fuText(t0.due_on) : "Open task") + (n.length > 1 ? ` · ${n.length} tasks` : "") : ""}</div>; })()}
            </a>
          ))}
          {!people.length && <div style="padding:22px 18px;color:#8a8378;">No people yet. They appear here when a buyer enquires, saves a search, gets a shortlist or watches a home.</div>}
        </div>
      </>
    )}
  </main>
  <script is:inline>
    (function () {
      var q = document.getElementById("q"), list = document.getElementById("plist"), sel = document.getElementById("sort"), stage = "", filters = {};
      if (!q || !list) return;
      var today = list.dataset.today || "";
      var rows = Array.prototype.slice.call(list.querySelectorAll(".prow"));
      function num(r, k) { return Number(r.dataset[k] || 0); }
      var F = { buyers: function (r) { return r.dataset.buyer === "1"; }, sellers: function (r) { return r.dataset.seller === "1"; },
        tasks: function (r) { return num(r, "ntask") > 0; },
        overdue: function (r) { var t = r.dataset.task; return !!t && t !== "9999" && t < today; },
        loved: function (r) { return num(r, "loves") > 0; },
        uncontacted: function (r) { return num(r, "touch") === 0; },
        watching: function (r) { return num(r, "watch") > 0; },
        shortlists: function (r) { return num(r, "sl") > 0; }
      };
      var S = {
        recent: function (a, b) { return num(b, "last") - num(a, "last"); },
        task: function (a, b) { return String(a.dataset.task || "zzzz").localeCompare(String(b.dataset.task || "zzzz")); },
        touch: function (a, b) { return num(a, "touch") - num(b, "touch"); },
        loves: function (a, b) { return num(b, "loves") - num(a, "loves"); },
        enq: function (a, b) { return num(b, "enq") - num(a, "enq"); },
        newest: function (a, b) { return num(b, "first") - num(a, "first"); },
        name: function (a, b) { return String(a.dataset.name).localeCompare(String(b.dataset.name)); }
      };
      function apply() { var y0 = window.scrollY; document.body.style.minHeight = (y0 + window.innerHeight) + "px";
        var v = q.value.trim().toLowerCase();
        rows.forEach(function (r) {
          var show = (!stage || r.dataset.stage === stage) && (!v || r.dataset.q.indexOf(v) >= 0);
          for (var k in filters) if (filters[k] && !F[k](r)) show = false;
          r.style.display = show ? "" : "none";
        }); var vis = rows.some(function (r) { return r.style.display !== "none"; }); var nr = document.getElementById("noresults"); if (!nr) { nr = document.createElement("div"); nr.id = "noresults"; nr.style.cssText = "padding:22px 18px;color:#8a8378;"; nr.textContent = "No one matches these filters."; list.appendChild(nr); } nr.style.display = vis ? "none" : ""; window.scrollTo(0, y0);
      }
      function sort() {
        var s = sel && S[sel.value] ? sel.value : "recent";
        rows.sort(function (a, b) { return S[s](a, b) || num(b, "last") - num(a, "last"); });
        rows.forEach(function (r) { list.appendChild(r); });
        try { localStorage.setItem("people-sort", s); } catch (e) {}
      }
      q.addEventListener("input", apply);
      document.querySelectorAll(".bar .chip[data-stage]").forEach(function (c) {
        c.addEventListener("click", function () {
          document.querySelectorAll(".bar .chip[data-stage]").forEach(function (x) { x.classList.remove("on"); });
          c.classList.add("on"); stage = c.dataset.stage || ""; apply();
        });
      });
      document.querySelectorAll(".bar .fchip").forEach(function (c) {
        c.addEventListener("click", function () { var k = c.dataset.f, was = !!filters[k]; filters = {}; document.querySelectorAll(".bar .fchip").forEach(function (x) { x.classList.remove("on"); }); if (!was) { filters[k] = true; c.classList.add("on"); } apply(); });
      });
      if (sel) {
        try { var saved = localStorage.getItem("people-sort"); if (saved && S[saved]) sel.value = saved; } catch (e) {}
        sel.addEventListener("change", sort);
      }
      sort(); apply();
    })();
  </script>
<script is:inline>
    (function () {
      var f = document.getElementById("add-form"), b = document.getElementById("add-person");
      if (!f || !b) return;
      function g(id) { return document.getElementById(id).value.trim(); }
      b.addEventListener("click", function () { f.style.display = f.style.display === "none" ? "" : "none"; if (f.style.display === "") document.getElementById("ap-name").focus(); });
      document.getElementById("ap-cancel").addEventListener("click", function () { f.style.display = "none"; });
      document.getElementById("ap-save").addEventListener("click", function () {
        var m = document.getElementById("ap-msg");
        if (!g("ap-name")) { m.textContent = "Name needed"; return; }
        if (!g("ap-email") && !g("ap-phone")) { m.textContent = "Email or phone needed"; return; }
        m.textContent = "";
        fetch("/admin/api/people", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ site_id: f.dataset.site, key: "", action: "create_person", name: g("ap-name"), email: g("ap-email"), phone: g("ap-phone") }) })
          .then(function (r) { return r.json(); })
          .then(function (j) { if (j.ok) location.href = "/admin/person?site_id=" + encodeURIComponent(f.dataset.site) + "&key=" + encodeURIComponent(j.key); else m.textContent = j.error || "Failed"; });
      });
    })();
  </script>
</body>
</html>
