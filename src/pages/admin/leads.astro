---
import { createClient } from "@supabase/supabase-js";
import AdminTopNav from "../../components/AdminTopNav.astro";

export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

let requestedSiteId =
  String(
    Astro.url.searchParams.get("site_id") || ""
  ).trim();

const requestHost =
  (
    Astro.request.headers.get("x-forwarded-host") ||
    Astro.request.headers.get("host") ||
    Astro.url.hostname ||
    ""
  )
    .split(",")[0]
    .trim()
    .toLowerCase()
    .replace(/^www\./, "")
    .split(":")[0];

const globalAdminHosts = new Set([
  "localhost",
  "127.0.0.1",
  "bc.realestate",
]);

if (
  !requestedSiteId &&
  requestHost &&
  !globalAdminHosts.has(requestHost)
) {
  const { data: domainSite } = await supabase
    .from("sites")
    .select("id")
    .eq("domain", requestHost)
    .maybeSingle();

  requestedSiteId =
    String(domainSite?.id || "").trim();
}

function sortHref(sort: string) {
  const params = new URLSearchParams();

  if (requestedSiteId) {
    params.set("site_id", requestedSiteId);
  }

  params.set("sort", sort);

  return `?${params.toString()}`;
}

const sortParam = Astro.url.searchParams.get("sort") || "newest";
const sortMap: Record<string, { column: string; ascending: boolean }> = {
  newest: { column: "created_at", ascending: false },
  oldest: { column: "created_at", ascending: true },
  name:   { column: "name",       ascending: true  },
  source: { column: "source",     ascending: true  },
};
const { column, ascending } = sortMap[sortParam] ?? sortMap.newest;

let leadsQuery = supabase
  .from("intent_leads")
  .select("*")
  .order(column, { ascending });

if (requestedSiteId) {
  leadsQuery =
    leadsQuery.eq("site_id", requestedSiteId);
}

const { data: leads = [], error } =
  await leadsQuery;

function fmtDate(value) {
  if (!value) return "";
  return new Date(value).toLocaleString();
}
// lead-source-badges
// lead-linkify
const escHtml = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const linkify = (s: string) => escHtml(s).replace(/https?:\/\/[^\s<]+/g, (u) => `<a href="${u}" target="_blank" rel="noopener" class="lead-link">${u}</a>`);const SRC_LABELS: Record<string, string> = { saved_search: "Saved search", intent_refined_search: "Refined search" };
const srcLabel = (s?: string | null) => { const v = String(s || "").trim(); if (!v) return "Unknown"; if (SRC_LABELS[v]) return SRC_LABELS[v]; const t = v.replace(/_/g, " "); return t.charAt(0).toUpperCase() + t.slice(1); };
const srcKey = (s?: string | null) => String(s || "unknown").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const cleanMessage = (m?: string | null, q?: string | null) => String(m || "").split("\n").filter((l) => !/^\s*Criteria:/.test(l) && !(q && /^\s*Question:/.test(l))).join("\n");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Leads</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      /* lead-source-badges */
      .src-badge { display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; line-height:1.4; white-space:nowrap; background:#eef0f3; color:#4a5263; border:1px solid #e0e3e8; }
      .src-saved-search { background:#e6f3f1; color:#1f6b60; border-color:#c9e6e1; }
      .src-ask-a-question { background:#eaf0fb; color:#2c4f8c; border-color:#d3e0f6; }
      .src-book-a-showing { background:#fdf1e3; color:#8a5414; border-color:#f4dcbc; }
      .src-intent-refined-search { background:#f1edf8; color:#5b3f8c; border-color:#e1d8f1; }
      .lead { min-width:0; overflow:hidden; }
      .lead-row { min-width:0; overflow-wrap:anywhere; word-break:break-word; }
      :global(:root) {
        --bg: #f7f4ef;
        --ink: #181614;
        --font-body: "DM Sans", system-ui, sans-serif;
        --font-display: "Instrument Serif", Georgia, serif;
      }

      :global(body) {
        margin: 0;
        font-family: var(--font-body);
        background: var(--bg);
        color: var(--ink);
        font-size: 15px;
        line-height: 1.5;
      }

      .page {
        min-height: 100vh;
        }

      .main {
        padding: 48px 48px 64px;
        max-width: 1100px;
      }

    h1 {
        margin: 0 0 8px;
        font-family: var(--font-body);
        font-size: 2.2rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.03em;
      }

      .sub {
        color: #6f6a63;
        margin: 0 0 28px;
      }

      .lead {
        background: #fff;
        border: 1px solid #e3ddd2;
        border-radius: 18px;
        padding: 20px;
        margin-bottom: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
      }

      .top {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
      }

      .name {
        font-weight: 800;
        font-size: 1.05rem;
      }

      .meta {
        color: #777;
        font-size: 0.88rem;
        margin-top: 4px;
      }

     .lead-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 20px;
        margin-top: 6px;
        font-size: 0.88rem;
        color: #444;
      }

      .lead-row span::before {
        content: "·";
        margin-right: 6px;
        color: #bbb;
      }

      .lead-row span:first-child::before {
        content: none;
      }

      .actions {
        margin-top: 16px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

     .btn {
        display: inline-flex;
        padding: 8px 12px;
        border-radius: 6px;
        border: 1px solid rgba(24, 22, 20, 0.2);
        color: #181614;
        text-decoration: none;
        font-size: 0.82rem;
        font-weight: 800;
      }

      .btn:hover {
        background: #f7f4ef;
      }

      .sort-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 20px;
        flex-wrap: wrap;
      }

      .sort-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-right: 2px;
      }

      .sort-btn {
        padding: 5px 12px;
        border-radius: 6px;
        border: 1px solid rgba(24, 22, 20, 0.2);
        color: #555;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 700;
      }

      .sort-btn:hover { background: #f0ece5; }

      .sort-btn.active {
        background: #181614;
        color: #fff;
        border-color: #181614;
      }

      @media (max-width: 860px) {
        .page {
          display: block;
        }

        .main {
          padding: 28px 18px 48px;
        }

        .grid {
          grid-template-columns: 1fr;
        }
      }
    
      /* lead-card-tidy-v2 */
      .src-badge { align-self:flex-start; height:auto; border-radius:6px !important; padding:4px 10px; }
      .lead { border-radius:10px !important; }
      .lead-row { border-radius:6px !important; }
      .btn { display:inline-flex; align-items:center; height:34px; padding:0 14px; border-radius:6px !important; }
      .lead :global(a.lead-link) { color:#1f6b60; text-decoration:underline; text-underline-offset:2px; }
      .lead :global(a.lead-link:hover) { color:#13453e; }
    </style>
  </head>

  <body>
    <div class="page">
      <AdminTopNav active="leads" siteId={requestedSiteId} />

      <main class="main">
        <h1>Leads</h1>
      <p class="sub">
          All captured buyer leads from intent pages, ask-a-question, and showing requests.
        </p>

       <div class="sort-bar">
          <span class="sort-label">Sort:</span>
          <a href={sortHref("newest")} class={"sort-btn" + (sortParam === "newest" ? " active" : "")}>Newest</a>
          <a href={sortHref("oldest")} class={"sort-btn" + (sortParam === "oldest" ? " active" : "")}>Oldest</a>
          <a href={sortHref("name")}   class={"sort-btn" + (sortParam === "name"   ? " active" : "")}>Name</a>
          <a href={sortHref("source")} class={"sort-btn" + (sortParam === "source" ? " active" : "")}>Source</a>
        </div>

        {error && <p>Error loading leads: {error.message}</p>}

        {leads.length === 0 && <p>No leads yet.</p>}

        {leads.map((lead) => (
          <article class="lead">
            <div class="top">
              <div>
                <div class="name">{lead.name || "Unnamed lead"}</div>
                <div class="meta">{fmtDate(lead.created_at)}</div>
              </div>

              <span class={"src-badge src-" + srcKey(lead.source)}>{srcLabel(lead.source)}</span>
            </div>

           <div class="lead-row">
              {lead.email && <span>{lead.email}</span>}
              {lead.phone && <span>{lead.phone}</span>}
              {(lead.city || lead.slug) && <span>{lead.city || "—"} / {lead.slug || "—"}</span>}
            </div>

            {(lead.question || lead.message) && (
              <div style="margin-top:14px;padding:12px 14px;border-radius:10px;background:#f7fbff;border:1px solid #d7e7f4;line-height:1.55;">
                {lead.question && <div><strong>Question:</strong> {lead.question}</div>}
                {lead.message && <div style="margin-top:6px;white-space:pre-line;overflow-wrap:anywhere;word-break:break-word;color:#586174;" set:html={linkify(cleanMessage(lead.message, lead.question))}></div>}
              </div>
            )}

            <div class="actions">
              {lead.email && <a class="btn" href={`mailto:${lead.email}`}>Email</a>}
              {lead.phone && <a class="btn" href={`tel:${lead.phone}`}>Call</a>}
              {lead.session_id && (
                <a class="btn" href={
  requestedSiteId
    ? `/admin/intent-sessions?site_id=${encodeURIComponent(
        requestedSiteId
      )}&session=${encodeURIComponent(
        lead.session_id
      )}`
    : `/admin/intent-sessions?session=${encodeURIComponent(
        lead.session_id
      )}`
}>
                  View session
                </a>
              )}
            </div>
          </article>
        ))}
      </main>
    </div>
    <script src="/look-search.js" defer is:inline></script>
</body>
</html>