---
import { createClient } from "@supabase/supabase-js";
import AdminTopNav from "../../components/AdminTopNav.astro";
import { createSupabaseServerClient } from "../../lib/supabaseServer";

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const auth = createSupabaseServerClient(Astro.cookies);

const {
  data: { user },
} = await auth.auth.getUser();

if (!user) {
  return Astro.redirect("/login");
}

const platformAdminUserIds = new Set([
  "e6ef2640-eeff-4d57-8df2-c4c5f820a182",
  "0282af0e-cef9-4f8e-a263-d456c6c26b1b",
]);

const isPlatformAdmin =
  platformAdminUserIds.has(user.id);

const requestedSiteId =
  String(
    Astro.url.searchParams.get("site_id") || ""
  ).trim();

const sitesQuery = supabase
  .from("sites")
  .select(
    "id, domain, city, site_name, accent_color, agent_id, admin_scope"
  )
  .order("domain");

if (requestedSiteId) {
  sitesQuery.eq("id", requestedSiteId);
}

if (isPlatformAdmin) {
  sitesQuery.eq("admin_scope", "platform");
} else {
  sitesQuery.eq("agent_id", user.id);
}

const { data: sites = [] } = await sitesQuery;
---


<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Your Sites</title>
 <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style is:global>
    .mobile-topbar, .drawer-overlay { display: none; }
    @media (max-width: 768px) { .mobile-topbar { display: flex !important; } }
  </style>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<div class="page">
  <AdminTopNav active="sites" siteId={requestedSiteId} />

  <main class="main">
    <h1>Your Sites</h1>

    <div class="sites">
      {sites.map((site) => (
        <article class="site-card">
          <div class="swatch" style={`background:${site.accent_color || "#2f6f73"}`}></div>

          <div class="site-card__copy">
            <h2>{site.site_name || site.domain}</h2>
            <p>{site.domain}</p>
            <small>{site.city}</small>
          </div>

          <div class="site-card__actions">
            <a href={`/admin/sites/${site.id}/settings`}>Settings</a>
            <a class="primary" href={`/admin/sites/${site.id}/pages`}>
              Pages &amp; navigation
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>
</div>

<style>
 :global(:root) {
  --bg: #f7f4ef;
  --ink: #181614;
  --font-body: "DM Sans", system-ui, sans-serif;
  --font-display: "Instrument Serif", Georgia, serif;
}

:global(body) {
  margin: 0;
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--ink);
  font-size: 15px;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
}

.main {
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 48px 48px 64px;
}

h1 {
  max-width: 1000px;
  margin: 0 0 24px;
  font-family: var(--font-body);
  font-size: 2.2rem;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.03em;
}

  .sites {
    max-width: 1000px;
    display: grid;
    gap: 16px;
  }

  .site-card {
    display: flex;
    gap: 18px;
    align-items: center;
    padding: 20px;
    border: 1px solid #e3ddd2;
    border-radius: 18px;
    background: #fff;
    color: inherit;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
  }

  .site-card__copy {
    min-width: 0;
    flex: 1;
  }

  .site-card__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .site-card__actions a {
    padding: 9px 13px;
    border: 1px solid #d9d2c7;
    border-radius: 9px;
    color: #3d3935;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .site-card__actions a.primary {
    border-color: #181614;
    background: #181614;
    color: #fff;
  }

  .site-card__actions a:hover {
    transform: translateY(-1px);
  }

  .swatch {
    width: 54px;
    height: 54px;
    border-radius: 16px;
    border: 1px solid rgba(0,0,0,0.08);
    flex: 0 0 auto;
  }

  h2 {
    margin: 0 0 4px;
    font-size: 20px;
  }

  p {
    margin: 0 0 4px;
    color: #5f6b76;
  }

  small {
    color: #8a949e;
  }

@media (max-width: 860px) {
  .page {
    display: block;
  }

  .main {
    width: 100%;
    padding: 28px 18px 48px;
  }

  .site-card {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .site-card__actions {
    width: 100%;
    justify-content: flex-start;
  }
}
</style>
</body>
</html>
