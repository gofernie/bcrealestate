---
import { createClient } from "@supabase/supabase-js";
import AdminTopNav from "../../components/AdminTopNav.astro";
import { createSupabaseServerClient } from "../../lib/supabaseServer";
export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const auth = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await auth.auth.getUser();
if (!user) return Astro.redirect("/login");

const platformAdminUserIds = new Set([
  "e6ef2640-eeff-4d57-8df2-c4c5f820a182",
  "0282af0e-cef9-4f8e-a263-d456c6c26b1b",
]);
const isPlatformAdmin = platformAdminUserIds.has(user.id);

let sitesQuery = supabase
  .from("sites")
  .select("id, domain, city, primary_city, site_name, accent_color, agent_id, admin_scope, created_at")
  .order("domain")
  .order("site_name");

if (!isPlatformAdmin) sitesQuery = sitesQuery.eq("agent_id", user.id);

const { data: sitesData, error: sitesError } = await sitesQuery;
const sites = (sitesData || []).sort((a, b) => (a.admin_scope === "platform" ? 1 : 0) - (b.admin_scope === "platform" ? 1 : 0));

if (!isPlatformAdmin && sites.length === 1) {
  return Astro.redirect(`/admin/sites/${sites[0].id}/pages`);
}

const siteIds = sites.map((s) => s.id);
const { data: pageRows } = siteIds.length
  ? await supabase.from("intent_pages").select("site_id, is_published").in("site_id", siteIds)
  : { data: [] };

const pageCounts = new Map();
for (const r of pageRows || []) {
  const c = pageCounts.get(r.site_id) || { total: 0, live: 0 };
  c.total++;
  if (r.is_published !== false) c.live++;
  pageCounts.set(r.site_id, c);
}

const titleCase = (v) =>
  String(v || "").replace(/[-_]+/g, " ").trim().replace(/\b\w/g, (ch) => ch.toUpperCase());

const totalLive = [...pageCounts.values()].reduce((n, c) => n + c.live, 0);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>All sites · Locus Admin</title>
  <style is:global>
    .mobile-topbar, .drawer-overlay { display: none; }
    @media (max-width: 768px) { .mobile-topbar { display: flex !important; } }
  </style>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
<div class="page">
  <AdminTopNav active="sites" siteId="" />

  <main class="main">
    <header class="head">
      <div>
        <p class="kicker">{isPlatformAdmin ? "Platform" : "Your account"}</p>
        <h1>{isPlatformAdmin ? "All sites" : "Your sites"}</h1>
        <p class="meta">{sites.length} {sites.length === 1 ? "site" : "sites"} · {totalLive} live pages</p>
      </div>
      {sites.length > 5 && (
        <input id="site-search" class="search" type="search" placeholder="Search sites, domains, cities…" autocomplete="off" />
      )}
    </header>

    {sitesError && <p class="error">Couldn't load sites: {sitesError.message}</p>}

    {sites.length === 0 && !sitesError ? (
      <div class="empty">No sites yet.</div>
    ) : (
      <div class="table">
        <div class="row row--head">
          <span></span><span>Site</span><span>Market</span><span>Pages</span><span></span>
        </div>
        {sites.map((site) => {
          const name = site.site_name || site.domain;
          const city = titleCase(site.primary_city || site.city);
          const counts = pageCounts.get(site.id) || { total: 0, live: 0 };
          const search = `${name} ${site.domain} ${city} ${site.admin_scope || ""}`.toLowerCase();
          return (
            <div class="row" data-search={search}>
              <span class="swatch" style={`background:${site.accent_color || "#2f6f73"}`}></span>
              <div class="name">
                <a href={`/admin/sites/${site.id}/pages`}>{name}</a>
                {site.admin_scope !== "platform" && <span class="badge">Agent site</span>}
                <div class="domain">{site.domain}</div>
              </div>
              <div class="city">{city || "—"}</div>
              <div class="pages"><strong>{counts.live}</strong> live <span>/ {counts.total}</span></div>
              <div class="actions">
                <a class="btn btn--primary" href={`/admin/sites/${site.id}/pages`}>Pages</a>
                <a class="btn" href={`/admin/sites/${site.id}/settings`}>Settings</a>
                <a class="btn btn--ghost" href={`https://${site.domain}${site.admin_scope === "platform" && (site.primary_city || site.city) ? `/${String(site.primary_city || site.city).trim().toLowerCase().split(" ").join("-")}` : ""}`} target="_blank" rel="noopener">View ↗</a>
              </div>
            </div>
          );
        })}
        <div class="no-match" hidden>No sites match that search.</div>
      </div>
    )}
  </main>
</div>

<style>
  :global(:root) { --bg:#f7f4ef; --ink:#181614; --muted:#6b655e; --line:#e3ddd2; --card:#fff; --accent:#2f6f73; }
  :global(body) { margin:0; font-family:"DM Sans", system-ui, sans-serif; background:var(--bg); color:var(--ink); font-size:15px; line-height:1.5; }
  .main { max-width:1100px; margin:0 auto; padding:40px 32px 64px; box-sizing:border-box; }
  .head { display:flex; justify-content:space-between; align-items:flex-end; gap:20px; margin-bottom:22px; flex-wrap:wrap; }
  .kicker { margin:0 0 6px; font-size:.72rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); }
  h1 { margin:0; font-size:2.2rem; font-weight:700; letter-spacing:-.03em; line-height:1; }
  .meta { margin:8px 0 0; color:var(--muted); font-size:.9rem; }
  .search { width:280px; max-width:100%; padding:10px 14px; border:1px solid var(--line); border-radius:10px; background:#fff; font:inherit; }
  .error { color:#a3302a; }
  .empty, .no-match { padding:28px; text-align:center; color:var(--muted); background:var(--card); border:1px solid var(--line); border-radius:14px; }
  .table { background:var(--card); border:1px solid var(--line); border-radius:16px; overflow:hidden; }
  .row { display:grid; grid-template-columns:36px minmax(0,1.6fr) minmax(0,1fr) 110px 250px; gap:16px; align-items:center; padding:14px 18px; border-top:1px solid var(--line); }
  .row:first-child { border-top:0; }
  .row--head { padding:10px 18px; background:#faf8f4; font-size:.7rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); }
  .row:not(.row--head):hover { background:#fcfbf8; }
  .swatch { width:32px; height:32px; border-radius:10px; border:1px solid rgba(0,0,0,.08); }
  .name a { color:var(--ink); font-weight:700; text-decoration:none; }
  .name a:hover { text-decoration:underline; }
  .badge { margin-left:8px; padding:2px 8px; border-radius:99px; background:#e8f1f1; color:var(--accent); font-size:.68rem; font-weight:700; vertical-align:middle; }
  .domain { color:var(--muted); font-size:.82rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .city { color:#3d3935; font-size:.9rem; }
  .pages { font-size:.88rem; color:var(--muted); }
  .pages strong { color:var(--ink); }
  .actions { display:flex; gap:6px; justify-content:flex-end; }
  .btn { padding:7px 12px; border:1px solid #d9d2c7; border-radius:9px; color:#3d3935; text-decoration:none; font-size:.8rem; font-weight:700; white-space:nowrap; background:#fff; }
  .btn:hover { border-color:#b9b1a5; }
  .btn--primary { background:var(--ink); border-color:var(--ink); color:#fff; }
  .btn--primary:hover { border-color:var(--ink); opacity:.9; }
  .btn--ghost { border-color:transparent; }
  @media (max-width: 820px) {
    .main { padding:24px 16px 48px; }
    .row--head { display:none; }
    .row { grid-template-columns:32px minmax(0,1fr); row-gap:8px; }
    .city, .pages { grid-column:2; }
    .actions { grid-column:1 / -1; justify-content:flex-start; flex-wrap:wrap; }
  }
</style>

<script is:inline>
  (function () {
    var input = document.getElementById("site-search");
    if (!input) return;
    var rows = Array.prototype.slice.call(document.querySelectorAll(".row[data-search]"));
    var none = document.querySelector(".no-match");
    input.addEventListener("input", function () {
      var q = input.value.trim().toLowerCase(), shown = 0;
      rows.forEach(function (r) { var ok = !q || r.dataset.search.indexOf(q) !== -1; r.hidden = !ok; if (ok) shown++; });
      if (none) none.hidden = shown !== 0;
    });
  })();
</script>
</body>
</html>
