---
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const { id } = Astro.params;

function clean(v) {
  return String(v || "").trim();
}

let message = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const sectionBlocksRaw = clean(form.get("section_blocks"));
  const sectionBlocks = sectionBlocksRaw ? JSON.parse(sectionBlocksRaw) : [];

  const { error } = await supabase
    .from("guide_pages")
    .update({
      title: clean(form.get("title")),
      slug: clean(form.get("slug")).toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "") || undefined,
      eyebrow: clean(form.get("eyebrow")) || null,
      hero_image_url: clean(form.get("hero_image_url")) || null,
      seo_title: clean(form.get("seo_title")) || null,
      meta_description: clean(form.get("meta_description")) || null,
      template: clean(form.get("template")) || "custom",
      status: clean(form.get("status")) || "draft",
      neighbourhood_copy: clean(form.get("neighbourhood_copy")) || null,
      section_blocks: sectionBlocks,
      updated_at: new Date().toISOString(),
    })
    .eq("id", id);

  if (error) {
    message = "Save failed: " + error.message;
  } else {
    message = "Saved.";
  }
}

const { data: page } = await supabase
  .from("guide_pages")
  .select("*")
  .eq("id", id)
  .single();

if (!page) return Astro.redirect("/admin/intent-pages");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Edit Guide Page</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; }
    label { display: block; font-weight: 600; margin: 16px 0 4px; }
    input, textarea, select { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; box-sizing: border-box; }
    textarea { min-height: 100px; font-family: inherit; }
    button { margin-top: 24px; padding: 10px 24px; background: #2f6f73; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 15px; }
    .message { margin-top: 12px; padding: 8px 12px; background: #f0f9f0; border-left: 3px solid #2f6f73; }
    .back { display: inline-block; margin-bottom: 24px; color: #2f6f73; text-decoration: none; }
    h1 { margin-bottom: 4px; }
    .subtitle { color: #666; margin-bottom: 32px; }
  </style>
</head>
<body>
  <a class="back" href="/admin/intent-pages">? Back to pages</a>
  <h1>Edit Guide Page</h1>
  <p class="subtitle">/{page.city}/guides/{page.slug}</p>
  {message && <div class="message">{message}</div>}
  <form method="POST">
    <label>Title</label>
    <input name="title" value={page.title || ""} required />

    <label>Page URL slug <span style="font-weight:400;color:#888">/{page.city}/guides/...</span></label>
    <input name="slug" value={page.slug || ""} placeholder="str-rules" />

    <label>Eyebrow <span style="font-weight:400;color:#888">� small label above title</span></label>
    <input name="eyebrow" value={page.eyebrow || ""} placeholder="e.g. Alberta Buyers Guide" />

    <label>Hero image URL</label>
    <input name="hero_image_url" value={page.hero_image_url || ""} placeholder="https://..." />

    <label>Template</label>
    <select name="template">
      <option value="custom" selected={page.template === "custom"}>Custom</option>
      <option value="alberta-buyers" selected={page.template === "alberta-buyers"}>Alberta buyers</option>
      <option value="str-rules" selected={page.template === "str-rules"}>STR rules</option>
      <option value="vs-canmore" selected={page.template === "vs-canmore"}>Fernie vs Canmore</option>
    </select>

    <label>Body copy <span style="font-weight:400;color:#888">� main guide text, supports paragraph breaks</span></label>
    <textarea name="neighbourhood_copy" rows="8">{page.neighbourhood_copy || ""}</textarea>
<!-- guide-gen:start -->
<div style="margin:.6rem 0 1.2rem;display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;">
  <input id="guide-gen-notes" placeholder="Optional: what to cover, angle, local details" style="flex:1;min-width:240px;" />
  <button type="button" id="guide-gen-btn">Generate with AI</button>
  <button type="button" id="guide-gen-insert" style="display:none;">Insert generated draft</button>
  <span id="guide-gen-status" style="font-size:.85rem;color:#777;"></span>
</div>
<script is:inline>
(function () {
  var btn = document.getElementById("guide-gen-btn"); if (!btn) return;
  var ins = document.getElementById("guide-gen-insert"), st = document.getElementById("guide-gen-status");
  var root = btn.closest("form") || document;
  var ta = root.querySelector('textarea[name="neighbourhood_copy"]');
  var id = (location.pathname.match(/guide-pages\/([^/]+)/) || [])[1] || "";
  var API = "/admin/api/generate-guide", draft = "";
  function show(d) {
    if (d.status === "working") { btn.disabled = true; st.textContent = "Researching and writing. This takes a minute or two. You can leave and come back."; return true; }
    btn.disabled = false;
    if (d.status === "done" && d.draft) { draft = d.draft; ins.style.display = ""; st.textContent = d.error ? "Draft ready, but it may be cut off. Check the ending before you save." : "Draft ready."; }
    else if (d.status === "failed") st.textContent = "Failed: " + (d.error || "unknown error");
    else st.textContent = "";
    return false;
  }
  async function check() {
    try { var r = await fetch(API + "?id=" + encodeURIComponent(id)); var d = await r.json(); var ne = document.getElementById("guide-gen-notes"); if (d.notes && ne && !ne.value) ne.value = d.notes; if (show(d)) setTimeout(check, 5000); }
    catch (e) { setTimeout(check, 8000); }
  }
  btn.addEventListener("click", async function () {
    if (!id || !ta) return;
    var t = root.querySelector('[name="title"]');
    ins.style.display = "none"; btn.disabled = true; st.textContent = "Starting...";
    try {
      var r = await fetch(API, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ id: id, title: t ? t.value : "", notes: document.getElementById("guide-gen-notes").value }) });
      var d = await r.json(); if (!r.ok) throw new Error(d.error || ("HTTP " + r.status));
      check();
    } catch (e) { btn.disabled = false; st.textContent = "Failed: " + e.message; }
  });
  ins.addEventListener("click", function () {
    if (ta.value.trim() && !confirm("Replace the current body copy with the generated draft?")) return;
    ta.value = draft; ins.style.display = "none"; st.textContent = "Inserted. Review it, then Save.";
    fetch(API, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ id: id, action: "dismiss" }) });
  });
  if (id) check();
})();
</script>
<!-- guide-gen:end -->

    <label>SEO title</label>
    <input name="seo_title" value={page.seo_title || ""} />

    <label>Meta description</label>
    <textarea name="meta_description" rows="3">{page.meta_description || ""}</textarea>

    <label>Status</label>
    <select name="status">
      <option value="draft" selected={page.status === "draft"}>Draft</option>
      <option value="live" selected={page.status === "live"}>Live</option>
    </select>

    <input type="hidden" name="section_blocks" value={JSON.stringify(page.section_blocks || [])} />

    <button type="submit">Save guide page</button>
  </form>
</body>
</html>
