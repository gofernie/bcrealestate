    var dots = '<span class="gg-dots"><i></i><i></i><i></i></span>';
    if (d.status === "working") {
      btn.disabled = true; ins.style.display = "none"; ins.classList.remove("gg-ready");
      st.innerHTML = dots + "Writing your guide..."; if (ast) ast.innerHTML = dots + "Writing your guide...";
      return true;
    }
    btn.disabled = false;
    if (d.status === "done" && d.draft) {
      draft = d.draft; ins.style.display = ""; ins.classList.add("gg-ready");
      var msg = d.error ? "Draft ready, but it may be cut off. Check the ending." : "\u2713 Draft ready - click Insert generated draft";
      st.innerHTML = '<span class="gg-done">' + msg + "</span>";
      if (ast) ast.innerHTML = '<span class="gg-done">' + msg + " below \u2193</span>";
    }
