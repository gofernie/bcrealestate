<!-- guide-gen:start -->
<div style="margin:.6rem 0 1.2rem;display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;">
  <input id="guide-gen-notes" placeholder="Optional: what to cover, angle, local details" style="flex:1;min-width:240px;" />
  <button type="button" id="guide-gen-btn">Generate with AI</button>
  <button type="button" id="guide-gen-insert" style="display:none;">Insert generated draft</button>
  <span id="guide-gen-status" style="font-size:.85rem;color:#777;"></span>
</div>
<script is:inline>
(function () {
  var btn = document.getElementById("guide-gen-btn"); if (!btn) return;
  var ins = document.getElementById("guide-gen-insert"), st = document.getElementById("guide-gen-status");
  var root = btn.closest("form") || document;
  var ta = root.querySelector('textarea[name="neighbourhood_copy"]');
  var id = (location.pathname.match(/guide-pages\/([^/]+)/) || [])[1] || "";
  var API = "/admin/api/generate-guide", draft = "";
  function show(d) {
    var ast = document.getElementById("agb-status");
    if (!document.getElementById("gg-css")) { var s = document.createElement("style"); s.id = "gg-css"; s.textContent = "@keyframes ggb{0%,80%,100%{transform:translateY(0);opacity:.35}40%{transform:translateY(-5px);opacity:1}}.gg-dots{display:inline-flex;gap:4px;margin-right:8px;vertical-align:middle}.gg-dots i{width:7px;height:7px;border-radius:50%;background:#2f6f73;display:block;animation:ggb 1.2s infinite ease-in-out}.gg-dots i:nth-child(2){animation-delay:.15s}.gg-dots i:nth-child(3){animation-delay:.3s}@keyframes ggp{0%{box-shadow:0 0 0 0 rgba(47,125,79,.55)}70%{box-shadow:0 0 0 12px rgba(47,125,79,0)}100%{box-shadow:0 0 0 0 rgba(47,125,79,0)}}.gg-ready{background:#2f7d4f!important;border-color:#2f7d4f!important;color:#fff!important;animation:ggp 1.6s infinite}.gg-done{color:#2f7d4f;font-weight:700;font-size:.95rem}"; document.head.appendChild(s); }
    var dots = '<span class="gg-dots"><i></i><i></i><i></i></span>';
    if (d.status === "working") {
      btn.disabled = true; ins.style.display = "none"; ins.classList.remove("gg-ready");
      st.innerHTML = dots + "Writing your guide..."; if (ast) ast.innerHTML = dots + "Writing your guide...";
      return true;
    }
    btn.disabled = false;
    if (d.status === "done" && d.draft) {
      draft = d.draft; ins.style.display = ""; ins.classList.add("gg-ready");
      var msg = d.error ? "Draft ready, but it may be cut off. Check the ending." : "\u2713 Draft ready - click Insert generated draft";
      st.innerHTML = '<span class="gg-done">' + msg + "</span>";
      if (ast) ast.innerHTML = '<span class="gg-done">' + msg + " below \u2193</span>";
    }
    else if (d.status === "failed") { st.textContent = "Failed: " + (d.error || "unknown error"); if (ast) ast.textContent = st.textContent; }
    else { st.textContent = ""; }
    return false;
  }
  async function check() {
    try { var r = await fetch(API + "?id=" + encodeURIComponent(id)); var d = await r.json(); var ne = document.getElementById("guide-gen-notes"); if (d.notes && ne && !ne.value) ne.value = d.notes; if (show(d)) setTimeout(check, 5000); }
    catch (e) { setTimeout(check, 8000); }
  }
  btn.addEventListener("click", async function () {
    if (!id || !ta) return;
    var t = root.querySelector('[name="title"]');
    ins.style.display = "none"; btn.disabled = true; st.textContent = "Starting...";
    try {
      var r = await fetch(API, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ id: id, title: t ? t.value : "", notes: document.getElementById("guide-gen-notes").value }) });
      var d = await r.json(); if (!r.ok) throw new Error(d.error || ("HTTP " + r.status));
      check();
    } catch (e) { btn.disabled = false; st.textContent = "Failed: " + e.message; }
  });
  ins.addEventListener("click", function () {
    if (ta.value.trim() && !confirm("Replace the current body copy with the generated draft?")) return;
    ta.value = draft; if (window.__seoFill) window.__seoFill(draft); ins.style.display = "none"; ins.classList.remove("gg-ready"); var __a = document.getElementById("agb-status"); if (__a) __a.textContent = "Inserted. Review it, then Save."; st.textContent = "Inserted. Review it, then Save.";
    fetch(API, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ id: id, action: "dismiss" }) });
  });
  window.__guideGenCheck = check; if (id) check();
})();
</script>
<!-- guide-gen:end -->

