---
// admin-nav-v2: one shortlist builder. The full picker lives at /listings.
export const prerender = false;
const siteId = Astro.url.searchParams.get("site_id") || (Astro.locals as any).adminAccess?.currentSiteId || "";
return Astro.redirect(siteId ? `/listings?site_id=${encodeURIComponent(siteId)}` : "/listings");
---
