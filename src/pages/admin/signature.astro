---
export const prerender = false;

const siteUrl = "https://bc.realestate";

const links = {
  homes: `${siteUrl}/go/chris/homes`,
  explore: `${siteUrl}/go/chris/explore`,
  contact: `${siteUrl}/go/chris/contact`,
};

const signatureHtml = `
<table cellpadding="0" cellspacing="0" border="0" style="font-family: Arial, Helvetica, sans-serif; color:#202020; font-size:14px; line-height:1.45;">
  <tr>
    <td style="padding-right:18px; vertical-align:top;">
      <div style="font-size:19px;font-weight:700;color:#111111;">
        Chris Crump
      </div>

      <div style="margin-top:2px;color:#444444;">
        REALTOR® | eXp Realty
      </div>

      <div style="margin-top:2px;color:#777777;font-size:13px;">
        Chris Crump Personal Real Estate Corporation
      </div>

      <div style="margin-top:12px;font-size:13px;color:#444444;">
        <div>
          <a href="mailto:YOUR_EMAIL_HERE" style="color:#444444;text-decoration:none;">
            YOUR_EMAIL_HERE
          </a>
        </div>

        <div style="margin-top:2px;">
          <a href="tel:YOUR_PHONE_HERE" style="color:#444444;text-decoration:none;">
            YOUR_PHONE_HERE
          </a>
        </div>
      </div>

      <div style="margin-top:14px;font-size:13px;">
        <a
          href="${links.homes}"
          style="color:#111111;text-decoration:none;font-weight:700;"
        >
          View Homes
        </a>

        <span style="color:#bbbbbb;">&nbsp;&nbsp;|&nbsp;&nbsp;</span>

        <a
          href="${links.explore}"
          style="color:#111111;text-decoration:none;font-weight:700;"
        >
          Explore Map
        </a>

        <span style="color:#bbbbbb;">&nbsp;&nbsp;|&nbsp;&nbsp;</span>

        <a
          href="${links.contact}"
          style="color:#111111;text-decoration:none;font-weight:700;"
        >
          bc.realestate
        </a>
      </div>

      <div style="margin-top:12px;font-size:12px;color:#999999;">
        Powered by Locus
      </div>
    </td>
  </tr>
</table>
`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Email Signature | Locus</title>

    <style>
      body {
        margin: 0;
        background: #f5f5f3;
        font-family: Arial, Helvetica, sans-serif;
        color: #202020;
      }

      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 48px 24px;
      }

      h1 {
        margin: 0 0 8px;
        font-size: 32px;
      }

      .intro {
        color: #666;
        margin-bottom: 32px;
      }

      .card {
        background: white;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        padding: 28px;
        margin-bottom: 24px;
      }

      .label {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #777;
        margin-bottom: 18px;
      }

      .signature {
        padding: 16px 0;
      }

      button {
        border: 0;
        border-radius: 8px;
        background: #111;
        color: white;
        padding: 12px 18px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
      }

      button:hover {
        opacity: 0.85;
      }

      .status {
        margin-left: 12px;
        font-size: 14px;
        color: #666;
      }

      textarea {
        width: 100%;
        min-height: 260px;
        box-sizing: border-box;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 14px;
        font-family: monospace;
        font-size: 12px;
        resize: vertical;
      }
    </style>
  </head>

  <body>
    <main>
      <h1>Email Signature</h1>
      <div class="intro">
        Your tracked Locus email signature.
      </div>

      <div class="card">
        <div class="label">Preview</div>

        <div id="signature" class="signature" set:html={signatureHtml}></div>

        <button id="copy-signature" type="button">
          Copy Signature
        </button>

        <span id="status" class="status"></span>
      </div>

      <div class="card">
        <div class="label">HTML</div>

        <textarea readonly>{signatureHtml}</textarea>
      </div>
    </main>

    <script>
      const button = document.getElementById("copy-signature");
      const signature = document.getElementById("signature");
      const status = document.getElementById("status");

      button?.addEventListener("click", async () => {
        if (!signature || !status) return;

        try {
          const html = signature.innerHTML;
          const plainText = signature.innerText;

          const clipboardItem = new ClipboardItem({
            "text/html": new Blob([html], { type: "text/html" }),
            "text/plain": new Blob([plainText], { type: "text/plain" }),
          });

          await navigator.clipboard.write([clipboardItem]);

          status.textContent = "Copied.";
        } catch (error) {
          console.error(error);
          status.textContent = "Copy failed.";
        }
      });
    </script>
  </body>
</html>