---
export const prerender = false;

const errorMessage =
  Astro.url.searchParams.get("error") || "";

const sent =
  Astro.url.searchParams.get("sent") === "1";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reset password | Locus</title>

    <style>
      :root {
        --ink: #181614;
        --muted: #726e68;
        --border: #dedbd5;
        --paper: #f6f5f2;
        --green: #2fb52c;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 20% 15%,
            rgba(47, 181, 44, 0.09),
            transparent 34%
          ),
          var(--paper);
        color: var(--ink);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      .shell {
        display: grid;
        min-height: 100dvh;
        place-items: center;
        padding: 28px 18px;
      }

      .card {
        width: min(100%, 430px);
        padding: 34px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: #fff;
        box-shadow:
          0 22px 60px rgba(24, 22, 20, 0.1);
      }

      .brand {
        margin-bottom: 32px;
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .brand span {
        color: var(--green);
      }

      h1 {
        margin: 0 0 8px;
        font-family:
          Georgia,
          "Times New Roman",
          serif;
        font-size: 2.45rem;
        font-weight: 500;
        letter-spacing: -0.04em;
      }

      .intro {
        margin: 0 0 26px;
        color: var(--muted);
        font-size: 0.94rem;
        line-height: 1.55;
      }

      label {
        display: block;
        margin-bottom: 7px;
        font-size: 0.79rem;
        font-weight: 800;
      }

      input {
        display: block;
        width: 100%;
        min-height: 48px;
        padding: 0 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        color: var(--ink);
        font: inherit;
        outline: none;
      }

      input:focus {
        border-color: var(--ink);
        box-shadow:
          0 0 0 3px rgba(24, 22, 20, 0.08);
      }

      button {
        appearance: none;
        display: flex;
        width: 100%;
        min-height: 49px;
        align-items: center;
        justify-content: center;
        margin-top: 18px;
        border: 0;
        border-radius: 9px;
        background: var(--ink);
        color: #fff;
        font: inherit;
        font-weight: 850;
        cursor: pointer;
      }

      .message {
        margin-bottom: 20px;
        padding: 12px 13px;
        border-radius: 9px;
        font-size: 0.86rem;
        line-height: 1.45;
      }

      .message.error {
        border: 1px solid #e1adad;
        background: #fff4f4;
        color: #982828;
      }

      .message.success {
        border: 1px solid #a9d6a8;
        background: #f2fff1;
        color: #246d22;
      }

      .back {
        display: block;
        margin-top: 20px;
        color: var(--ink);
        font-size: 0.82rem;
        font-weight: 750;
        text-align: center;
      }

      @media (max-width: 520px) {
        .shell {
          align-items: start;
          padding-top: 56px;
        }

        .card {
          padding: 27px 22px;
          border-radius: 14px;
        }
      }
    </style>
  </head>

  <body>
    <main class="shell">
      <section class="card">
        <div class="brand">
          <span>Locus</span> Agent
        </div>

        <h1>Reset password.</h1>

        {
          sent ? (
            <>
              <div
                class="message success"
                role="status"
              >
                Check your email for the password-reset
                link. You can close this page.
              </div>

              <a class="back" href="/login">
                Return to sign in
              </a>
            </>
          ) : (
            <>
              <p class="intro">
                Enter your agent email and we’ll send
                you a secure reset link.
              </p>

              {
                errorMessage && (
                  <div
                    class="message error"
                    role="alert"
                  >
                    {errorMessage}
                  </div>
                )
              }

              <form
                method="POST"
                action="/api/auth/request-password-reset"
              >
                <label for="email">
                  Email address
                </label>

                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  autofocus
                />

                <button type="submit">
                  Send reset link
                </button>
              </form>

              <a class="back" href="/login">
                Return to sign in
              </a>
            </>
          )
        }
      </section>
    </main>
  </body>
</html>