---
const returnTo = Astro.url.searchParams.get("returnTo") || "/admin";
import { createSupabaseServerClient } from "../lib/supabaseServer";

export const prerender = false;

const supabase =
  createSupabaseServerClient(Astro.cookies);

const {
  data: { user },
} = await supabase.auth.getUser();

if (user) {
  const safeReturnTo =
    returnTo.startsWith("/") && !returnTo.startsWith("//")
      ? returnTo
      : "/admin";

  return Astro.redirect(safeReturnTo);
}

const errorMessage =
  Astro.url.searchParams.get("error") || "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>Agent login | Locus</title>

    <style>
      :root {
        --ink: #181614;
        --muted: #726e68;
        --border: #dedbd5;
        --paper: #f6f5f2;
        --green: #2fb52c;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 20% 15%,
            rgba(47, 181, 44, 0.09),
            transparent 34%
          ),
          var(--paper);
        color: var(--ink);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      .login-shell {
        display: grid;
        min-height: 100dvh;
        place-items: center;
        padding: 28px 18px;
      }

      .login-card {
        width: min(100%, 430px);
        padding: 34px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: #fff;
        box-shadow:
          0 22px 60px rgba(24, 22, 20, 0.1);
      }

      .brand {
        margin-bottom: 32px;
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .brand span {
        color: var(--green);
      }

      h1 {
        margin: 0 0 8px;
        font-family:
          Georgia,
          "Times New Roman",
          serif;
        font-size: clamp(2rem, 7vw, 2.7rem);
        font-weight: 500;
        letter-spacing: -0.04em;
      }

      .intro {
        margin: 0 0 28px;
        color: var(--muted);
        font-size: 0.94rem;
        line-height: 1.55;
      }

      .error {
        margin-bottom: 20px;
        padding: 11px 13px;
        border: 1px solid #e1adad;
        border-radius: 9px;
        background: #fff4f4;
        color: #982828;
        font-size: 0.86rem;
        line-height: 1.4;
      }

      label {
        display: block;
        margin-bottom: 7px;
        font-size: 0.79rem;
        font-weight: 800;
      }

      .field {
        margin-bottom: 18px;
      }

      input {
        display: block;
        width: 100%;
        min-height: 48px;
        padding: 0 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: #fff;
        color: var(--ink);
        font: inherit;
        outline: none;
      }

      input:focus {
        border-color: var(--ink);
        box-shadow:
          0 0 0 3px rgba(24, 22, 20, 0.08);
      }

      button {
        appearance: none;
        display: flex;
        width: 100%;
        min-height: 49px;
        align-items: center;
        justify-content: center;
        margin-top: 6px;
        border: 0;
        border-radius: 9px;
        background: var(--ink);
        color: #fff;
        font: inherit;
        font-weight: 850;
        cursor: pointer;
      }

      button:hover {
        background: #302d29;
      }

      .note {
        margin: 20px 0 0;
        color: var(--muted);
        font-size: 0.76rem;
        line-height: 1.5;
        text-align: center;
      }

      @media (max-width: 520px) {
        .login-shell {
          align-items: start;
          padding-top: 56px;
        }

        .login-card {
          padding: 27px 22px;
          border-radius: 14px;
        }
      }
    </style>
  </head>

  <body>
    <main class="login-shell">
      <section class="login-card">
        <div class="brand">
          <span>Locus</span> Agent
        </div>

        <h1>Welcome back.</h1>

        <p class="intro">
          Sign in to manage shortlists, listings, and
          buyer activity.
        </p>

        {
          errorMessage && (
            <div class="error" role="alert">
              {errorMessage}
            </div>
          )
        }

        <form method="POST" action="/api/auth/login">
          <input type="hidden" name="returnTo" value={returnTo} />
          <div class="field">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              autofocus
            />
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
            />
          </div>

          <button type="submit">
            Sign in
          </button>
        </form>

        <a
          href="/forgot-password"
          style="
            display:block;
            margin-top:18px;
            color:#181614;
            font-size:.82rem;
            font-weight:750;
            text-align:center;
          "
        >
          Forgot your password?
        </a>

        <p class="note">
          This area is restricted to authorized agents.
        </p>
      </section>
    </main>
  </body>
</html>