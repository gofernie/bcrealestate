  slot="head"
/>

  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": city ? `${city} ${type ? type.replace(/-/g, " ") + "s" : "homes"} for sale` : "Homes for sale",
      "description": city ? `${listings.length} active listings in ${city}` : "Active real estate listings",
      "numberOfItems": listings.length,
      "url": Astro.url.href
    })}
  />

  <script
    id="home-intent-collections-json"
    type="application/json"
    set:html={JSON.stringify(allIntentCollections)}
  />
<script
    id="home-all-listings-json"
    type="application/json"
    set:html={JSON.stringify(listings.map((l: any) => ({
      lat: l.lat,
      lng: l.lng,
      id: l.id || l.mls_number || "",
      image: getListingImage(l),
      beds: getListingBeds(l),
      baths: getListingBaths(l),
      id: l.id || l.mls_number || "",
      image: getListingImage(l),
      beds: getListingBeds(l),
      baths: getListingBaths(l),
      price: l.price ? `$${Number(l.price).toLocaleString()}` : "",
      address: (() => { const v = l.address; if (!v) return ""; if (typeof v === "string" && !v.startsWith("{")) return v; try { const o = typeof v === "string" ? JSON.parse(v) : v; return [o.streetNumber, o.streetName || o.streetAddress, o.streetSuffix].filter(Boolean).join(" ").trim(); } catch { return ""; } })(),
    })))}
  />
  <div
