<script is:inline>
  (() => {
    const initializeStickyListingFilter = () => {
      const form =
        document.getElementById("home-hero-search");

      const listingSection =
        document.getElementById("homepage-listings");

      const siteNav =
        document.querySelector(".site-nav");

      if (
        !form ||
        !listingSection ||
        !siteNav ||
        form.dataset.stickyFilterReady === "true"
      ) {
        return;
      }

      form.dataset.stickyFilterReady = "true";

      const marker =
        document.createElement("div");

      marker.className =
        "listing-filter-original-position";

      marker.setAttribute("aria-hidden", "true");

      form.before(marker);

      const rail =
        document.createElement("div");

      rail.className = "listing-filter-rail";

      rail.innerHTML = `
        <div class="listing-filter-rail__mobile-bar">
          <button
            class="listing-filter-rail__mobile-open"
            type="button"
          >
            <span>Filter listings</span>
            <span
              class="listing-filter-rail__mobile-count"
              aria-label="Active filters"
            ></span>
          </button>
        </div>

        <button
          class="listing-filter-rail__mobile-close"
          type="button"
        >
          <span>Listing filters</span>
          <span aria-hidden="true">Close ×</span>
        </button>
      `;

      document.body.appendChild(rail);

      const mobileOpen =
        rail.querySelector(
          ".listing-filter-rail__mobile-open"
        );

      const mobileClose =
        rail.querySelector(
          ".listing-filter-rail__mobile-close"
        );

      const mobileCount =
        rail.querySelector(
          ".listing-filter-rail__mobile-count"
        );

      let isDocked = false;

      const activeFilterCount = () => {
        const values =
          new FormData(form);

        let count = 0;

        for (const [key, value] of values.entries()) {
          if (
            key !== "sort" &&
            String(value || "").trim()
          ) {
            count += 1;
          }
        }

        return count;
      };

      const updateFilterCount = () => {
        if (!mobileCount) return;

        const count = activeFilterCount();

        mobileCount.textContent =
          String(count);

        mobileCount.classList.toggle(
          "has-filters",
          count > 0
        );
      };

      const navBottom = () =>
        Math.max(
          0,
          siteNav.getBoundingClientRect().bottom
        );

      const updateRailTop = () => {
        rail.style.top =
          `${navBottom()}px`;
      };

      const dockForm = () => {
        if (isDocked) return;

        marker.style.height =
          `${form.getBoundingClientRect().height}px`;

        rail.appendChild(form);
        rail.classList.add("is-visible");
        isDocked = true;

        updateFilterCount();
        updateRailTop();
      };

      const restoreForm = () => {
        if (!isDocked) return;

        marker.after(form);
        marker.style.height = "";
        rail.classList.remove(
          "is-visible",
          "is-mobile-open"
        );

        document.body.classList.remove(
          "has-mobile-filter-open"
        );

        isDocked = false;
      };

      const updateDocking = () => {
        updateRailTop();

        const markerRect =
          marker.getBoundingClientRect();

        const listingRect =
          listingSection.getBoundingClientRect();

        const top =
          navBottom();

        const shouldDock =
          window.matchMedia("(min-width: 769px)").matches &&
          markerRect.top <= top;

        if (shouldDock) {
          dockForm();
        } else {
          restoreForm();
        }
      };

      mobileOpen?.addEventListener(
        "click",
        () => {
          rail.classList.add(
            "is-mobile-open"
          );

          document.body.classList.add(
            "has-mobile-filter-open"
          );
        }
      );

      mobileClose?.addEventListener(
        "click",
        () => {
          rail.classList.remove(
            "is-mobile-open"
          );

          document.body.classList.remove(
            "has-mobile-filter-open"
          );
        }
      );

      form.addEventListener(
        "change",
        updateFilterCount
      );

      window.addEventListener(
        "scroll",
        updateDocking,
        { passive: true }
      );

      window.addEventListener(
        "resize",
        updateDocking,
        { passive: true }
      );

      updateDocking();
      updateFilterCount();
    };

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        initializeStickyListingFilter,
        { once: true }
      );
    } else {
      initializeStickyListingFilter();
    }
  })();
</script></Layout>




