            </label>
          );
        })}
      </div>
    </div>

    <label class="locus-home-search__field">
      <span>Property type</span>

      <select name="type">
        <option value="">Any Type</option>

        {propertyTypeOptions.map((propertyType) => (
          <option value={propertyType === "homes" ? "house" : propertyType}>
            {propertyType === "homes"
              ? "Homes"
              : propertyType === "condo"
              ? "Condos"
              : propertyType === "mobile"
              ? "Mobile Homes"
              : propertyType === "townhouse"
              ? "Townhomes"
              : propertyType
                  .replace(/-/g, " ")
                  .replace(/\b\w/g, (char) => char.toUpperCase())}
          </option>
        ))}
      </select>
    </label>

    <label class="locus-home-search__field">
      <span>Price</span>

      <select name="maxPrice">
        <option value="" selected={!maxPrice}>Any Price</option>

        {priceBandOptions.map((band) => (
          <option
            value={band.value}
            selected={
              band.kind === "over"
                ? minPrice === band.threshold && !maxPrice
                : maxPrice === band.threshold && !minPrice
            }
