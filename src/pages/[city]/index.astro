---
import { createClient } from "@supabase/supabase-js";
import Layout from "../../layouts/Layout.astro";

import IntentModalController from "../../components/IntentModalController.astro";
import SlugSaveSearch from "../../components/SlugSaveSearch.astro";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/intent-modal.css";
import "../../styles/page-hero.css";
import { getNavIntentPages } from "../../lib/getNavIntentPages";

export const prerender = false;

const routeCity = String(Astro.params.city || "nanaimo").toLowerCase();

const cityLabel = routeCity
  .replace(/-/g, " ")
  .replace(/\b\w/g, (c) => c.toUpperCase());

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const host = Astro.request.headers.get("x-forwarded-host") || Astro.request.headers.get("host") || "";
const domain = host.split(",")[0].trim().replace(/^www\./, "").split(":")[0];
const isLocal = domain === "localhost" || domain.startsWith("localhost:");

const requestedLocalDomain = String(
  Astro.url.searchParams.get("siteDomain") ||
  "bc.realestate"
)
  .trim()
  .toLowerCase()
  .replace(/^www\./, "");

const isNetlifyProjectDomain =
  domain === "bc-realestate.netlify.app" ||
  domain.endsWith("--bc-realestate.netlify.app");

const effectiveSiteDomain =
  isLocal || isNetlifyProjectDomain
    ? requestedLocalDomain
    : domain;

const siteQuery = supabase
  .from("sites")
  .select("*")
  .eq("city", routeCity)
  .eq("domain", effectiveSiteDomain);

const { data: siteRow, error: siteError } =
  await siteQuery.maybeSingle();

if (siteError) {
  console.error(
    "Homepage site lookup failed:",
    siteError
  );
}

const site = {
  id: siteRow?.id,
  nav_property_types: siteRow?.nav_property_types,
  city: routeCity,
  site_name: siteRow?.site_name || `${cityLabel} Real Estate`,
  accent_color: siteRow?.accent_color || "#2f6f73",
  hero_image_url: siteRow?.hero_image_url || "",
  hero_eyebrow: siteRow?.hero_eyebrow || "Homes worth watching",
  hero_heading: siteRow?.hero_heading || `${cityLabel} Homes For Sale`,
  hero_copy: siteRow?.hero_copy || "Browse active homes for sale, including houses, condos, and townhomes.",
};

const siteCity = site.city;
const siteName = site.site_name;
const accentColor = site.accent_color;

const homepageHeroImageUrl =
  site.hero_image_url ||
  "https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?auto=format&fit=crop&w=1800&q=88";


const url = Astro.url;

const city = routeCity;
const areas = url.searchParams
  .getAll("area")
  .map((value) => String(value).trim().toLowerCase())
  .filter(Boolean);

const area = areas[0] || "";
const type = url.searchParams.get("type") || "";
const minPrice = Number(url.searchParams.get("minPrice") || 0);
const maxPrice = Number(url.searchParams.get("maxPrice") || 0);
const bedsSelection = String(url.searchParams.get("beds") || "").trim();
const planMode =
  String(url.searchParams.get("planMode") || "").trim() ||
  (["primary-on-main", "three-same-floor", "four-same-floor"].includes(bedsSelection)
    ? bedsSelection
    : "");
const beds = /^\d+$/.test(bedsSelection) ? Number(bedsSelection) : 0;
const sort = url.searchParams.get("sort") || "newest";

const hasActiveSearch =
  areas.length > 0 ||
  Boolean(type) ||
  minPrice > 0 ||
  maxPrice > 0 ||
  beds > 0;

const navIntentPages = await getNavIntentPages(
  supabase,
  city
);

const clean = (value: any) =>
  String(value || "")
    .toLowerCase()
    .trim();

const getListingMls = (listing: any) =>
  String(
    listing.mls_number ||
      listing.mlsNumber ||
      listing.id ||
      listing.repliers_listing_id ||
      listing.raw?.mlsNumber ||
      listing.raw?.id ||
      ""
  ).replace(/[^0-9]/g, "");

const getListingPrice = (listing: any) => {
  const num = Number(listing.price ?? listing.listPrice ?? listing.priceNumber ?? 0);
  if (Number.isFinite(num) && num > 1000) return `$${Math.round(num).toLocaleString()}`;
  return listing.price_text || listing.priceText || "Price on request";
};

const formatAddressValue = (value: any): string => {
  if (!value) return "";
  let obj = value;
  if (typeof value === "string") {
    const trimmed = value.trim();
    if (!trimmed.startsWith("{")) return trimmed;
    try { obj = JSON.parse(trimmed); } catch { return ""; }
  }
  if (typeof obj !== "object" || Array.isArray(obj)) return "";
  return [obj.streetNumber, obj.streetName || obj.streetAddress, obj.streetSuffix, obj.unitNumber ? `#${obj.unitNumber}` : ""]
    .filter(Boolean).join(" ").trim();
};
const getListingAddress = (listing: any) =>
  formatAddressValue(listing.address) ||
  formatAddressValue(listing.full_address) ||
  listing.addressText ||
  listing.addressObj?.streetAddress ||
  [listing.addressObj?.streetNumber, listing.addressObj?.streetName, listing.addressObj?.streetSuffix]
    .filter(Boolean)
    .join(" ") ||
  "Address available";

const normalizeListingImageUrl = (value: any) => {
  if (!value) return "";
  const raw = typeof value === "string" ? value : value.highRes || value.mediumRes || value.lowRes || value.url || value.src || value.href || value.path || "";
  if (!raw) return "";
  if (raw.startsWith("http://") || raw.startsWith("https://")) return raw;
  const cleaned = raw.startsWith("/") ? raw : `/${raw}`;
  if (cleaned.startsWith("/vreb/")) return `https://cdn.repliers.io${cleaned}`;
  if (cleaned.startsWith("/crea2/")) return `https://cdn.repliers.io${cleaned}`;
  return cleaned;
};

const getListingImage = (listing: any) => {
  const image = listing.image_url || listing.image || listing.photo || listing.images?.[0] || listing.images?.[1] || listing.raw?.images?.[0] || listing.raw?.images?.[1] || listing.raw?.images?.[0]?.url || listing.raw?.images?.[1]?.url;
  return normalizeListingImageUrl(image);
};

const getListingImages = (listing: any) => {
  const rawImages = listing.images || listing.photo_urls || listing.photos || listing.raw?.images || [];
  const images = Array.isArray(rawImages)
    ? rawImages.map((img: any) => typeof img === "string" ? normalizeListingImageUrl(img) : normalizeListingImageUrl(img.highRes || img.mediumRes || img.lowRes || img.url || img.src || img.href || img.path || "")).filter(Boolean)
    : [];
  const firstImage = getListingImage(listing);
  return Array.from(new Set([firstImage, ...images].filter(Boolean)));
};

const getListingBeds = (listing: any) => listing.beds || listing.bedrooms || listing.details?.numBedrooms || listing.raw?.details?.numBedrooms || 0;
const getListingBaths = (listing: any) => listing.baths || listing.bathrooms || listing.details?.numBathrooms || listing.raw?.details?.numBathrooms || 0;
const getListingSqft = (listing: any) => listing.sqft || listing.square_feet || listing.squareFeet || listing.details?.sqft || listing.details?.squareFeet || listing.raw?.details?.sqft || listing.raw?.details?.squareFeet || "";
const getListingDescription = (listing: any) => listing.description || listing.publicRemarks || listing.remarks || listing.details?.description || listing.details?.publicRemarks || listing.details?.remarks || listing.raw?.description || listing.raw?.publicRemarks || listing.raw?.remarks || listing.raw?.details?.description || listing.raw?.details?.publicRemarks || listing.raw?.details?.remarks || "A quiet preview of this property.";
const getListingYearBuilt = (listing: any) => listing.year_built || listing.yearBuilt || listing.details?.yearBuilt || listing.raw?.details?.yearBuilt || "";
const getListingLotSize = (listing: any) => listing.lot_size || listing.lotSize || listing.details?.lotSize || listing.raw?.details?.lotSize || "";
const getListingArea = (listing: any) => listing.normalized_area || listing.area || listing.neighborhood || listing.addressObj?.neighborhood || listing.address?.neighborhood || listing.details?.area || listing.details?.subArea || listing.raw?.address?.neighborhood || listing.raw?.details?.area || listing.raw?.details?.subArea || "";
const getListingPropertyType = (listing: any) => String(listing.normalized_type || listing.property_type || listing.propertyType || listing.type || listing.details?.propertyType || listing.raw?.details?.propertyType || "Home").replace(/[_-]+/g, " ").replace(/\b\w/g, (char: string) => char.toUpperCase());

const titleCase = (value: any) =>
  String(value || "")
    .replace(/-/g, " ")
    .replace(/\b\w/g, (char: string) => char.toUpperCase());

const cityName = titleCase(city || "nanaimo");

const selectedAreaName = area ? titleCase(area) : "";

const pageSubject = selectedAreaName
  ? `${selectedAreaName} ${cityName} Real Estate`
  : `${cityName} Real Estate`;

const propertyLabel = type
  ? titleCase(type === "house" ? "homes" : `${type}s`)
  : "Homes";

const seoTitle = `${pageSubject} & ${propertyLabel} For Sale | MLS® Listings`;

const seoDescription = `Browse ${pageSubject.toLowerCase()} including ${propertyLabel.toLowerCase()} for sale. View active MLS® listings with photos, prices, maps, and local search details.`;

const heroHeading =
  site?.hero_heading ||
  `${(city || "Nanaimo").replace(/\b\w/g, (char) => char.toUpperCase())} Homes For Sale`;


const buildFilterUrl = (updates: Record<string, string | number | null>) => {
  const params = new URLSearchParams();

  params.set("city", city || "nanaimo");

  if (area) params.set("area", area);
  if (type) params.set("type", type);
  if (minPrice) params.set("minPrice", String(minPrice));
  if (maxPrice) params.set("maxPrice", String(maxPrice));
  if (sort && sort !== "newest") params.set("sort", sort);

  Object.entries(updates).forEach(([key, value]) => {
    if (value === null || value === "" || value === 0) {
      params.delete(key);
    } else {
      params.set(key, String(value));
    }
  });

  return `?${params.toString()}`;
};
let intentPagesQuery = supabase
  .from("intent_pages")
  .select(`
    *,
    intent_page_features (
      feature_key
    )
  `)
  .eq("city", city || siteCity || "nanaimo")
  .or("is_published.eq.true,status.eq.published")
  .order("created_at", { ascending: false });

if (site?.id) {
  intentPagesQuery = intentPagesQuery.or(`site_id.eq.${site.id},site_id.is.null`);
}

const { data: intentPageRows } = await intentPagesQuery;

function shortenIntentTitle(title: string) {
  const t = title.toLowerCase();

  if (t.includes("first time buyers condos") && t.includes("500")) {
    return "First-Time Buyer Condos Under $500K";
  }

  if (t.includes("first time buyers mobiles")) {
    return "First-Time Buyer Mobile Homes";
  }

  if (t.includes("homes") && t.includes("1,000,000")) {
    return "Homes Over $1M";
  }

  if (t.includes("ocean view condos")) {
    return "Ocean View Condos";
  }

  if (t.includes("walkable condos")) {
    return "Walkable Condos";
  }

  if (t.includes("downsizers")) {
    return "Condos for Downsizers";
  }

  return title
    .replace(/worth a closer look/gi, "")
    .replace(/in nanaimo$/gi, "")
    .replace(/^nanaimo\s+/i, "Nanaimo ")
    .replace(/\s+/g, " ")
    .trim();
}

function shortenIntentDescription(text: string, title = "") {
  const t = title.toLowerCase();

  if (t.includes("first-time buyer condos")) {
    return "Affordable Nanaimo condos shaped around first-time buyers.";
  }

  if (t.includes("mobile homes")) {
    return "Entry-level mobile homes for buyers looking for a practical starting point.";
  }

  if (t.includes("homes over")) {
    return "Higher-end Nanaimo homes with more space, finish, and lifestyle upside.";
  }

  if (t.includes("nanaimo homes")) {
    return "A broad look at active Nanaimo homes across different areas and price points.";
  }

  if (t.includes("townhomes")) {
    return "Nanaimo townhomes for buyers who want more space without full detached-home upkeep.";
  }

  if (t.includes("ocean view")) {
    return "Condos with ocean-view potential, coastal appeal, and low-maintenance living.";
  }

  if (t.includes("downsizers")) {
    return "Lower-maintenance condos suited to comfort, convenience, and simpler living.";
  }

  if (t.includes("walkable")) {
    return "Condos close to amenities, services, parks, and daily conveniences.";
  }

  return String(text || "")
    .replace(/react to listings as you browse and the page will help surface better matches\.?/gi, "")
    .replace(/browse active nanaimo /gi, "")
    .replace(/explore nanaimo /gi, "")
    .replace(/\s+/g, " ")
    .trim();
}

const allIntentCollections = (intentPageRows || []).map((page: any) => ({
  type: String(page.property_type || "").toLowerCase(),
  title: shortenIntentTitle(page.hero_heading || page.slug),
  href: `/${page.city}/${page.slug}`,
description: shortenIntentDescription(page.intro_copy || "", shortenIntentTitle(page.hero_heading || page.slug)),  features: (page.intent_page_features || []).map((feature: any) => feature.feature_key),
}));

let intentCollections = allIntentCollections;

if (type) {
  intentCollections = allIntentCollections.filter(
    (card) => card.type === clean(type)
  );
}

intentCollections = intentCollections.slice(0, 8);
const propertyTypeOrder = [
  "homes",
  "condo",
  "townhouse",
  "mobile",
  "land",
];

const propertyTypeOptions = Array.from(
  new Set([
    "homes",
    ...allIntentCollections
      .map((card) => {
        const type = String(card.type || "").toLowerCase().trim();
        return type === "house" ? "homes" : type;
      })
      .filter(Boolean),
  ])
).sort((a, b) => {
  const aIndex = propertyTypeOrder.indexOf(a);
  const bIndex = propertyTypeOrder.indexOf(b);

  return (
    (aIndex === -1 ? 999 : aIndex) -
    (bIndex === -1 ? 999 : bIndex)
  );
});
const groupLabel = [  area || "",
  type ? type.replace(/-/g, " ") : "",
  maxPrice ? `under $${maxPrice}k` : "",
  minPrice ? `over $${minPrice}k` : ""
].filter(Boolean).join(" · ");

let areaOptions: string[] = [];
let homepageAreaCards: any[] = [];

try {
   const { data: boundaries = [] } = await supabase
    .from("area_boundaries")
    .select("area_slug, area_name, polygon_geojson")
    .eq("city", clean(city || "nanaimo"));

  const allowedAreas = (boundaries || [])
    .map((boundary: any) =>
      String(boundary.area_slug || boundary.area_name || "")
        .replace(/-/g, " ")
        .toLowerCase()
        .trim()
    )
    .filter(Boolean)
    .sort();

  const { data: listingsForAreaCounts = [] } = await supabase
    .from("listing_rows")
    .select("lat,lng")
    .eq("status", "A")
    .eq("normalized_city", clean(city || "nanaimo"))
    .not("lat", "is", null)
    .not("lng", "is", null);



  function pointInRing(point: [number, number], ring: any[]) {
    const [x, y] = point;
    let inside = false;

    for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      const xi = ring[i][0];
      const yi = ring[i][1];
      const xj = ring[j][0];
      const yj = ring[j][1];

      const intersect =
        yi > y !== yj > y &&
        x < ((xj - xi) * (y - yi)) / (yj - yi) + xi;

      if (intersect) inside = !inside;
    }

    return inside;
  }

  function polygonContainsPoint(geojson: any, lat: number, lng: number) {
    if (!geojson) return false;

    const geometry = geojson.type === "Feature"
      ? geojson.geometry
      : geojson;

    if (!geometry) return false;

    const point: [number, number] = [lng, lat];

    if (geometry.type === "Polygon") {
      return geometry.coordinates.some((ring: any[]) =>
        pointInRing(point, ring)
      );
    }

    if (geometry.type === "MultiPolygon") {
      return geometry.coordinates.some((poly: any[]) =>
        poly.some((ring: any[]) => pointInRing(point, ring))
      );
    }

    return false;
  }

  const areaCounts = new Map<string, number>();

  (boundaries || []).forEach((boundary: any) => {
    const slug = String(boundary.area_slug || boundary.area_name || "")
      .replace(/-/g, " ")
      .toLowerCase()
      .trim();

    if (!slug || !allowedAreas.includes(slug)) return;

    const count = (listingsForAreaCounts || []).filter((listing: any) =>
      polygonContainsPoint(
        boundary.polygon_geojson,
        Number(listing.lat),
        Number(listing.lng)
      )
    ).length;

    areaCounts.set(slug, count);
  });

  areaOptions = allowedAreas
    .filter((area) => areaCounts.has(area))
    .sort((a, b) => {
      const aSelected = areas.includes(a);
      const bSelected = areas.includes(b);

      if (aSelected !== bSelected) {
        return aSelected ? -1 : 1;
      }

      return a.localeCompare(b);
    });

  homepageAreaCards = (boundaries || [])
  .map((boundary: any) => {
    const slug = String(boundary.area_slug || boundary.area_name || "")
      .replace(/-/g, " ")
      .toLowerCase()
      .trim();

    return {
      name: slug,
      count: areaCounts.get(slug) || 0,
href: `/${city || "nanaimo"}/${String(boundary.area_slug || slug.replace(/\s+/g, "-")).trim()}`,
    };
  })
  .filter((card) => card.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 5);
} catch {}

let listings: any[] = [];
let errorMessage = "";

try {
let query = supabase.from("listing_rows").select("*").eq("status", "A").limit(1000);  if (city) query = query.eq("normalized_city", clean(city));

  // Homepage discovery preloads a broad pool.
  // Filters are applied client-side for instant UX.

  if (sort === "price-low" || sort === "price-asc") query = query.order("price", { ascending: true });
  else if (sort === "price-high" || sort === "price-desc") query = query.order("price", { ascending: false });
  else if (sort === "beds-high") query = query.order("beds", { ascending: false });
  else query = query.order("listed_at", { ascending: false });

  const { data, error } = await query;
  if (error) throw error;
  listings = (data || []).filter((listing: any) => {
    const listingText = [
      listing?.normalized_type,
      listing?.property_type,
      listing?.propertyType,
      listing?.type,
      listing?.transaction_type,
      listing?.transactionType,
      listing?.listing_type,
      listing?.listingType,
      listing?.description,
      listing?.publicRemarks,
      listing?.remarks,
      listing?.details?.propertyType,
      listing?.details?.transactionType,
      listing?.details?.publicRemarks,
      listing?.raw?.propertyType,
      listing?.raw?.transactionType,
      listing?.raw?.publicRemarks,
      listing?.raw?.remarks,
      listing?.raw?.details?.propertyType,
      listing?.raw?.details?.transactionType,
      listing?.raw?.details?.publicRemarks,
    ]
      .filter(Boolean)
      .join(" ")
      .toLowerCase();

    const isCommercialOrLease =
      /\b(lease|commercial|business|industrial|retail|office)\b/i.test(
        listingText
      );

    const numericPrice = Number(
      listing?.price ??
      listing?.listPrice ??
      listing?.priceNumber ??
      0
    );

    const isLeaseSizedPrice =
      Number.isFinite(numericPrice) &&
      numericPrice > 0 &&
      numericPrice < 50000;

    return !isCommercialOrLease && !isLeaseSizedPrice;
  });

 

} catch (error: any) {
  errorMessage = error?.message || "Could not load listings.";
}

const inventoryPrices = listings
  .map((listing: any) =>
    Number(
      listing?.price ??
      listing?.listPrice ??
      listing?.priceNumber ??
      0
    )
  )
  .filter(
    (price: number) =>
      Number.isFinite(price) &&
      price >= 50000
  )
  .sort((a: number, b: number) => a - b);

const inventoryPercentile = (percentile: number) => {
  if (!inventoryPrices.length) return 0;

  const index = Math.min(
    inventoryPrices.length - 1,
    Math.max(
      0,
      Math.round((inventoryPrices.length - 1) * percentile)
    )
  );

  return inventoryPrices[index];
};

const roundMarketPrice = (price: number) => {
  let increment = 50000;

  if (price >= 6000000) increment = 1000000;
  else if (price >= 3000000) increment = 500000;
  else if (price >= 1500000) increment = 250000;
  else if (price >= 750000) increment = 100000;

  return Math.max(
    increment,
    Math.round(price / increment) * increment
  );
};

const fallbackPriceBands = [500000, 700000, 900000, 1200000];

const calculatedPriceBands =
  inventoryPrices.length >= 8
    ? [0.2, 0.4, 0.6, 0.8].map((percentile) =>
        roundMarketPrice(inventoryPercentile(percentile))
      )
    : fallbackPriceBands;

const selectedMaxPriceDollars =
  maxPrice > 0 ? maxPrice * 1000 : 0;

const priceBandDollars = Array.from(
  new Set([
    ...calculatedPriceBands,
    ...(selectedMaxPriceDollars > 0
      ? [selectedMaxPriceDollars]
      : []),
  ])
)
  .filter((price) => price > 0)
  .sort((a, b) => a - b);

const formatPriceBand = (price: number) => {
  if (price >= 1000000) {
    const millions = price / 1000000;

    return `$${millions.toLocaleString("en-CA", {
      minimumFractionDigits: 0,
      maximumFractionDigits: 2,
    })}M`;
  }

  return `$${Math.round(price / 1000)}k`;
};

const underPriceBandOptions = priceBandDollars.map((price) => ({
  value: String(Math.round(price / 1000)),
  threshold: Math.round(price / 1000),
  kind: "under",
  label: `Under ${formatPriceBand(price)}`,
}));

const highestPriceBand =
  underPriceBandOptions[underPriceBandOptions.length - 1];

const priceBandOptions = highestPriceBand
  ? [
      ...underPriceBandOptions,
      {
        value: `over-${highestPriceBand.threshold}`,
        threshold: highestPriceBand.threshold,
        kind: "over",
        label: `Over ${formatPriceBand(
          highestPriceBand.threshold * 1000
        )}`,
      },
    ]
  : underPriceBandOptions;

// Homepage presentation data
const homepageFeaturedResidentialTypes = new Set([
  "house",
  "condo",
  "townhouse",
  "townhome",
  "mobile",
  "multi-family",
  "multifamily",
]);

const isHomepageFeaturedCandidate = (listing: any) => {
  const normalizedType = String(
    listing?.normalized_type ||
    listing?.property_type ||
    listing?.propertyType ||
    listing?.type ||
    ""
  )
    .trim()
    .toLowerCase()
    .replace(/[_\s]+/g, "-");

  const transactionText = [
    listing?.transaction_type,
    listing?.transactionType,
    listing?.listing_type,
    listing?.listingType,
    listing?.details?.transactionType,
    listing?.raw?.details?.transactionType,
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();


  const searchableListingText = [
    transactionText,
    listing?.normalized_type,
    listing?.property_type,
    listing?.propertyType,
    listing?.type,
    listing?.description,
    listing?.publicRemarks,
    listing?.remarks,
    listing?.details?.propertyType,
    listing?.details?.description,
    listing?.details?.publicRemarks,
    listing?.raw?.propertyType,
    listing?.raw?.publicRemarks,
    listing?.raw?.remarks,
    listing?.raw?.details?.propertyType,
    listing?.raw?.details?.publicRemarks,
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();

  const exclusionPattern =
    /\b(lease|commercial|business|industrial|retail|office)\b/i;

  const price = Number(getListingPrice(listing) || 0);

  return (
    homepageFeaturedResidentialTypes.has(normalizedType) &&
    !exclusionPattern.test(searchableListingText) &&
    price >= 50000 &&
    Boolean(getListingImage(listing))
  );
};

const homepageFeaturedListings = listings
  .filter(isHomepageFeaturedCandidate)
  .slice(0, 4);

const homepageListingPrices = listings
  .map((listing: any) => Number(getListingPrice(listing) || 0))
  .filter((price: number) => Number.isFinite(price) && price > 0)
  .sort((a: number, b: number) => a - b);

const homepageMedianPrice = homepageListingPrices.length
  ? homepageListingPrices[Math.floor(homepageListingPrices.length / 2)]
  : 0;

const homepageNewThisWeek = listings.filter((listing: any) => {
  const rawDate = listing?.listed_at || listing?.created_at || listing?.updated_at;
  if (!rawDate) return false;

  const listed = new Date(rawDate).getTime();
  if (!Number.isFinite(listed)) return false;

  return Date.now() - listed <= 7 * 24 * 60 * 60 * 1000;
}).length;

const homepageNeighbourhoodCount = homepageAreaCards.length;

const homepageNeighbourhoodImages = [
  "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=82",
  "https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?auto=format&fit=crop&w=900&q=82",
  "https://images.unsplash.com/photo-1480714378408-67cf0d13bc1b?auto=format&fit=crop&w=900&q=82",
  "https://images.unsplash.com/photo-1449157291145-7efd050a4d0e?auto=format&fit=crop&w=900&q=82",
  "https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=900&q=82",
  "https://images.unsplash.com/photo-1511818966892-d7d671e672a2?auto=format&fit=crop&w=900&q=82"
];

