          <option value="three-same-floor" selected={planMode === "three-same-floor"}>3 beds on same floor</option>
          <option value="four-same-floor" selected={planMode === "four-same-floor"}>4 beds on same floor</option>
        </optgroup>
      </select>
    </label>

    <div class="locus-home-search__popular">
      <span>Popular searches:</span>

      <a href={`/${city || "nanaimo"}/areas`}>Neighbourhoods</a>
      <a href={`/${city || "nanaimo"}/homes`}>Family Homes</a>
      <a href={`/${city || "nanaimo"}/condos`}>Condos</a>
      <a href={`/${city || "nanaimo"}/townhomes`}>Townhomes</a>
      <a href={`/${city || "nanaimo"}/mobile-homes`}>Mobile Homes</a>
    </div>

  </form>


</header>

