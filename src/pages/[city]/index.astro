    loadMapStylesheet(leafletCss);
    loadMapStylesheet(clusterCss);
    loadMapStylesheet(clusterDefaultCss);

    await loadMapScript(
      "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js",
      () => Boolean(window.L)
