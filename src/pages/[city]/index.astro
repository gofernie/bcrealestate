  color: #cf2336;
  font-weight: 750;
}

.area-multiselect__option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.area-multiselect__check {
  color: #cf2336;
  font-size: .95rem;
  font-weight: 850;
  text-align: right;
}
.locus-home-search__submit {
  min-height: 50px;
  margin-left: 16px;
  padding: 0 24px;
  border: 0;
  border-radius: 10px;
  background: var(--locus-navy);
  color: #fff;
  font-weight: 850;
  cursor: pointer;
}

.locus-home-search__popular {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  padding: 15px 5px 0;
}

.locus-home-search__popular > span {
  margin-right: 8px;
  color: #727f88;
  font-size: .72rem;
}

.locus-home-search__popular a {
  padding: 7px 12px;
  border-radius: 999px;
  background: #f5f5f3;
  color: #344653;
  font-size: .7rem;
  font-weight: 700;
  text-decoration: none;
}


/* BENEFITS */

.locus-home-benefits {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  width: min(1400px, 100%);
  margin: 18px auto 52px;
  border: 1px solid var(--locus-line);
  border-radius: 18px;
  background: #fff;
}

.locus-home-benefit {
  display: grid;
  grid-template-columns: 44px 1fr;
  gap: 14px;
  padding: 26px 24px;
  border-right: 1px solid var(--locus-line);
}

.locus-home-benefit:last-child {
  border-right: 0;
}

.locus-home-benefit__icon {
  color: var(--locus-green);
  font-size: 1.7rem;
}

.locus-home-benefit strong {
  display: block;
  margin-bottom: 5px;
  color: var(--locus-ink);
  font-size: .88rem;
}

.locus-home-benefit p {
  margin: 0;
  color: var(--locus-muted);
  font-size: .75rem;
  line-height: 1.5;
}


/* SHARED SECTION HEAD */

.locus-home-section-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 20px;
}

.locus-home-section-head h2 {
  margin: 5px 0 0;
  color: var(--locus-ink);
  font-family: var(--sans, Arial, sans-serif);
  font-size: clamp(1.65rem, 2.6vw, 2.35rem);
  letter-spacing: -.035em;
}

.locus-home-section-head > a {
  color: var(--locus-ink);
  font-size: .78rem;
  font-weight: 800;
  text-decoration: none;
}


/* NEIGHBOURHOODS - EDITORIAL */

.locus-home-neighbourhoods {
  margin: 0 0 54px;
}

.locus-home-neighbourhood-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 16px;
}

.locus-home-neighbourhood-card {
  position: relative;
  min-height: 190px;
  overflow: hidden;
  border: 1px solid rgba(8, 36, 58, 0.12);
  border-radius: 14px;
  background: #f7f3eb !important;
  color: var(--locus-ink);
  text-decoration: none;
  box-shadow: 0 10px 24px rgba(8, 36, 58, 0.035);
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease;
}

.locus-home-neighbourhood-card:nth-child(2) {
  background: #f1f0eb !important;
}

.locus-home-neighbourhood-card:nth-child(3) {
  background: #f7eeee !important;
}

.locus-home-neighbourhood-card:nth-child(4) {
  background: #eef1e9 !important;
}

.locus-home-neighbourhood-card:nth-child(5) {
  background: #edf2f4 !important;
}

.locus-home-neighbourhood-card:hover {
  transform: translateY(-4px);
  border-color: rgba(8, 36, 58, 0.28);
  box-shadow: 0 16px 32px rgba(8, 36, 58, 0.09);
}

.locus-home-neighbourhood-card__shade {
  position: absolute;
  inset: 16px 12px auto auto;
  width: 112px;
  height: 84px;
  color: var(--accent);
  opacity: 0.16;
  border-radius: 50%;
  transform: rotate(-8deg);
  background:
    repeating-radial-gradient(
      ellipse at 100% 0%,
      transparent 0 9px,
      currentColor 10px 11px
    );
}

.locus-home-neighbourhood-card__copy {
  position: absolute;
  z-index: 2;
  left: 20px;
  right: 20px;
  bottom: 18px;
  color: var(--locus-ink);
}

.locus-home-neighbourhood-card__copy strong,
.locus-home-neighbourhood-card__copy span {
  display: block;
}

.locus-home-neighbourhood-card__copy strong {
  max-width: calc(100% - 12px);
  font-size: 1.06rem;
  line-height: 1.15;
  letter-spacing: -0.025em;
}

.locus-home-neighbourhood-card__copy span {
  margin-top: 8px;
  color: var(--locus-muted);
  font-size: 0.76rem;
}

.locus-home-neighbourhood-card__copy::after {
  display: block;
  margin-top: 16px;
  color: var(--accent);
  content: "View area  \2192";
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.02em;
}

/* FEATURED */

.locus-home-featured {
  margin-bottom: 54px;
}

.locus-home-featured-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  gap: 18px;
}

.locus-home-featured-card {
  overflow: hidden;
  border: 1px solid var(--locus-line);
  border-radius: 12px;
  background: #fff;
  color: var(--locus-ink);
  text-decoration: none;
  box-shadow: 0 5px 18px rgba(8,36,58,.06);
}

.locus-home-featured-card__image {
  position: relative;
  aspect-ratio: 1.45;
  overflow: hidden;
  background: #eef1f2;
}

.locus-home-featured-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.locus-home-featured-card__heart {
  position: absolute;
  top: 12px;
  right: 12px;
  color: #fff;
  font-size: 1.6rem;
  text-shadow: 0 2px 8px rgba(0,0,0,.28);
}

.locus-home-featured-card__body {
  padding: 15px 16px 17px;
}

.locus-home-featured-card__price {
  display: block;
  margin-bottom: 9px;
  font-size: 1.15rem;
}

.locus-home-featured-card__meta {
  display: flex;
  gap: 10px;
  color: #64717a;
  font-size: .7rem;
}

.locus-home-featured-card__body p {
  margin: 11px 0 0;
  font-size: .75rem;
  font-weight: 750;
}


/* MARKET */

.locus-home-market {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  margin-bottom: 58px;
  overflow: hidden;
  border: 1px solid rgba(47,125,87,.2);
  border-radius: 16px;
  background: linear-gradient(90deg, #f8fbf8, #f3f8f4);
}

.locus-home-market__stats,
.locus-home-market__intel {
  padding: 26px 30px;
}

.locus-home-market__stats {
  border-right: 1px solid rgba(47,125,87,.15);
}

.locus-home-market__heading {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 22px;
}

.locus-home-market__heading strong {
  color: var(--locus-ink);
  font-size: 1rem;
}

.locus-home-market__heading span {
  color: var(--locus-green);
  font-size: .64rem;
  font-weight: 800;
}

.locus-home-market__numbers {
  display: grid;
  grid-template-columns: repeat(4,1fr);
}

.locus-home-market__numbers > div {
  padding-right: 15px;
  border-right: 1px solid var(--locus-line);
}

.locus-home-market__numbers > div + div {
  padding-left: 15px;
}
.locus-home-market__numbers > div:last-child {
  border-right: 0;
}

.locus-home-market__numbers strong,
.locus-home-market__numbers span {
  display: block;
}

.locus-home-market__numbers strong {
  color: var(--locus-ink);
  font-size: 1.35rem;
}

.locus-home-market__numbers span {
  margin-top: 5px;
  color: var(--locus-muted);
  font-size: .65rem;
}

.locus-home-market__intel {
  display: grid;
  grid-template-columns: 1fr 150px;
  gap: 20px;
  align-items: center;
}

.locus-home-market__intel h3 {
  margin: 6px 0 8px;
  color: var(--locus-ink);
  font-size: 1.25rem;
}

.locus-home-market__intel p {
  margin: 0 0 14px;
  color: var(--locus-muted);
  font-size: .72rem;
  line-height: 1.5;
}

.locus-home-market__intel a {
  display: inline-flex;
  padding: 9px 14px;
  border-radius: 7px;
  background: var(--locus-green);
  color: #fff;
  font-size: .7rem;
  font-weight: 800;
  text-decoration: none;
}

.locus-home-market__chart {
  display: flex;
  align-items: end;
  gap: 12px;
  height: 90px;
}

.locus-home-market__chart span {
  width: 18px;
  border-radius: 999px 999px 3px 3px;
  background: rgba(47,125,87,.55);
}

.locus-home-market__chart span:nth-child(1) { height: 24%; }
.locus-home-market__chart span:nth-child(2) { height: 45%; }
.locus-home-market__chart span:nth-child(3) { height: 38%; }
.locus-home-market__chart span:nth-child(4) { height: 72%; }
.locus-home-market__chart span:nth-child(5) { height: 90%; }


/* FULL LISTINGS INTRO */

.locus-home-listing-intro {
  display: grid;
  grid-template-columns: 1fr minmax(280px,480px);
  gap: 40px;
  align-items: end;
  margin: 76px 0 24px;
}

.locus-home-listing-intro h2 {
  margin: 5px 0 0;
  color: var(--locus-ink);
  font-size: clamp(1.75rem, 2.5vw, 2.25rem);
  line-height: 1.08;
  letter-spacing: -.035em;
}

.locus-home-listing-intro p {
  margin: 0;
  color: var(--locus-muted);
  line-height: 1.6;
}


/* FINAL CTA */

.locus-home-final-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  margin: 70px 0 20px;
  padding: 25px 32px;
  border-radius: 16px;
  background: var(--locus-navy);
  color: #fff;
}

.locus-home-final-cta > div {
  display: flex;
  align-items: center;
  gap: 18px;
}

.locus-home-final-cta__icon {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border: 1px solid #5fc66f;
  border-radius: 50%;
  color: #5fc66f;
  font-size: 1.4rem;
}

.locus-home-final-cta strong {
  display: block;
  font-size: 1.05rem;
}

.locus-home-final-cta p {
  margin: 4px 0 0;
  color: rgba(255,255,255,.7);
  font-size: .75rem;
}

.locus-home-final-cta > a {
  padding: 12px 18px;
  border-radius: 8px;
  background: #fff;
  color: var(--locus-navy);
  font-size: .75rem;
  font-weight: 850;
  text-decoration: none;
}


/* MOBILE */

@media (max-width: 900px) {

  .locus-home-hero {
    min-height: auto;
    margin-bottom: 190px;
  }

  .locus-home-hero__inner {
    grid-template-columns: 1fr;
    min-height: auto;
    padding: 70px 0 160px;
  }

  .locus-home-intel {
    display: none;
  }

  .locus-home-search {
    grid-template-columns: repeat(2,1fr);
    bottom: -110px;
  }

  .area-multiselect {
  position: relative;
}

.area-multiselect__trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--locus-ink);
  font: inherit;
  font-size: .9rem;
  font-weight: 750;
  text-align: left;
  cursor: pointer;
}

.area-multiselect__chevron {
  font-size: 1rem;
  line-height: 1;
  transition: transform .18s ease;
}

.area-multiselect.is-open .area-multiselect__chevron {
  transform: rotate(180deg);
}

.area-multiselect__menu {
  position: absolute;
  z-index: 50;
  top: calc(100% + 18px);
  left: 0;
  width: 100%;
  max-width: none;
  box-sizing: border-box;
  max-height: 430px;
  overflow-y: auto;
  border: 1px solid #d9dfe2;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 22px 48px rgba(8, 36, 58, .18);
}

.area-multiselect__option {
  display: grid;
  grid-template-columns: 1fr 24px;
  align-items: center;
  width: 100%;
  min-height: 44px;
  padding: 10px 14px;
  border: 0;
  border-bottom: 1px solid #e6e9eb;
  background: #fff;
  color: var(--locus-ink);
  font: inherit;
  font-size: .86rem;
  text-align: left;
  cursor: pointer;
}

.area-multiselect__option:last-child {
  border-bottom: 0;
}

.area-multiselect__option:hover {
  background: #f8faf9;
}

.area-multiselect__option.is-selected {
  background: #fff1f2;
  color: #cf2336;
  font-weight: 750;
}

.area-multiselect__option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.area-multiselect__check {
  color: #cf2336;
  font-size: .95rem;
  font-weight: 850;
  text-align: right;
}
.locus-home-search__submit {
    margin-left: 0;
  }

  .locus-home-search__popular {
    grid-column: 1 / -1;
  }

  .locus-home-benefits {
    grid-template-columns: repeat(2,1fr);
  }

  .locus-home-benefit:nth-child(2) {
    border-right: 0;
  }

  .locus-home-neighbourhood-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .locus-home-featured-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .locus-home-market {
    grid-template-columns: 1fr;
  }

  .locus-home-market__stats {
    border-right: 0;
    border-bottom: 1px solid rgba(47,125,87,.15);
  }

}

@media (max-width: 620px) {

  .locus-home-hero {
    margin-bottom: 310px;
  }

  .locus-home-hero__inner {
    width: calc(100% - 32px);
    padding: 54px 0 175px;
  }

  .locus-home-hero h1 {
    font-size: clamp(3.15rem,14vw,4.8rem);
  }

  .locus-home-hero__actions {
    align-items: stretch;
    flex-direction: column;
  }

  .locus-home-search {
    position: relative !important;
    left: auto !important;
    right: auto !important;
    top: -10px !important;
    bottom: auto !important;
    transform: none !important;

    grid-template-columns: 1fr;
    width: calc(100% - 48px);
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box !important;
    padding-bottom: 22px !important;
    margin: 18px auto 28px !important;
  }

  .locus-home-search__field {
    padding: 8px 10px 12px;
    border-right: 0;
    border-bottom: 1px solid var(--locus-line);
  }

  .locus-home-search__popular {
    display: none;
  }

  .locus-home-benefits {
    grid-template-columns: 1fr;
  }

  .locus-home-benefit {
    border-right: 0;
    border-bottom: 1px solid var(--locus-line);
  }

  .locus-home-benefit:last-child {
    border-bottom: 0;
  }

  .locus-home-section-head {
    align-items: start;
    flex-direction: column;
    gap: 10px;
  }

  .locus-home-neighbourhood-grid {
    display: flex;
    overflow-x: auto;
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
  }

  .locus-home-neighbourhood-card {
    flex: 0 0 74vw;
    scroll-snap-align: start;
  }

  .locus-home-featured-grid {
    grid-template-columns: 1fr;
  }

  .locus-home-market__numbers {
    grid-template-columns: repeat(2,1fr);
    gap: 22px 0;
  }

  .locus-home-market__intel {
    grid-template-columns: 1fr;
  }

  .locus-home-market__chart {
    display: none;
  }

  .locus-home-listing-intro {
    grid-template-columns: 1fr;
  }

  .locus-home-final-cta {
    align-items: stretch;
    flex-direction: column;
  }

}


/* Results toolbar: hero search is the primary filter interface */
#home-filter-form select[name="area"],
#home-filter-form select[name="type"],
#home-filter-form select[name="maxPrice"],
#home-filter-form select[name="beds"],
#home-filter-form select[name="baths"] {
  display: none;
}

#home-filter-form {
  display: flex;
  align-items: center;
  gap: 10px;
}

#home-filter-form select[name="sort"] {
  min-width: 150px;
}
/* Align filtered listings with the primary homepage content width */
.home-results-experience.is-filtered {
  width: min(1360px, calc(100% - 72px)) !important;
  max-width: none !important;
}

/* Keep the bottom actions comfortably inside the results panel */
.home-results-experience.is-filtered .homepage-interruptor {
  box-sizing: border-box;
  width: 100%;
  margin-left: 0;
  margin-right: 0;
  padding: 20px 24px;
}

.home-results-experience.is-filtered .homepage-interruptor-actions {
  flex-shrink: 0;
  padding-right: 4px;
}

.home-results-experience.is-filtered .homepage-interruptor-actions button {
  white-space: nowrap;
}

@media (max-width: 760px) {
  .home-results-experience.is-filtered {
    width: calc(100% - 24px) !important;
  }

  .home-results-experience.is-filtered .homepage-interruptor {
    padding: 18px 16px;
  }

  .home-results-experience.is-filtered .homepage-interruptor-actions {
    width: 100%;
    padding-right: 0;
  }
}
/* Match listings panel to the 1400px homepage content width */
.home-results-experience.is-filtered {
  box-sizing: border-box !important;
  width: min(1400px, calc(100% - 80px)) !important;
}

/* More breathing room around the bottom action buttons */
.home-results-experience.is-filtered .homepage-interruptor {
  padding-right: 32px !important;
  padding-left: 32px !important;
}

.home-results-experience.is-filtered .homepage-interruptor-actions {
  gap: 12px;
  padding-right: 0 !important;
}

@media (max-width: 760px) {
  .home-results-experience.is-filtered {
    width: calc(100% - 24px) !important;
  }

  .home-results-experience.is-filtered .homepage-interruptor {
    padding-right: 16px !important;
    padding-left: 16px !important;
  }
}
/* Final neighbourhood dropdown corrections */
#home-hero-search .area-multiselect__menu {
  box-sizing: border-box !important;
  overflow-x: hidden !important;
  overflow-y: auto !important;
  overscroll-behavior: contain;
}

#home-hero-search .area-multiselect__option {
  box-sizing: border-box !important;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  grid-template-columns: minmax(0, 1fr) 24px !important;
}

#home-hero-search .area-multiselect__option > span:first-of-type {
  min-width: 0;
  overflow-wrap: anywhere;
}

#home-hero-search .area-multiselect__option.is-selected {
  background: color-mix(in srgb, var(--accent) 12%, white) !important;
  color: var(--accent) !important;
}

#home-hero-search .area-multiselect__check {
  color: var(--accent) !important;
}
/* Prevent duplicate custom controls when the homepage script initializes twice */
:global(#home-hero-search .locus-home-search__field > .hero-single-dropdown:not(:last-of-type)) {
  display: none !important;
}
/* Shared custom Property Type, Price and Beds dropdowns */
:global(#home-hero-search .hero-native-select) {
  display: none !important;
}

:global(#home-hero-search .hero-single-dropdown) {
  position: relative;
  width: 100%;
}

:global(#home-hero-search .hero-single-dropdown__trigger) {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 22px;
  align-items: center;
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--locus-ink);
  font: inherit;
  font-size: .9rem;
  font-weight: 750;
  text-align: left;
  cursor: pointer;
}

:global(#home-hero-search .hero-single-dropdown__summary) {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

:global(#home-hero-search .hero-single-dropdown__chevron) {
  font-size: 1rem;
  line-height: 1;
  text-align: right;
  transition: transform .18s ease;
}

:global(#home-hero-search .hero-single-dropdown.is-open
  .hero-single-dropdown__chevron) {
  transform: rotate(180deg);
}

:global(#home-hero-search .hero-single-dropdown__menu) {
  position: absolute;
  z-index: 60;
  top: calc(100% + 18px);
  left: -14px;
  box-sizing: border-box;
  width: calc(100% + 28px);
  min-width: 210px;
  max-height: 360px;
  overflow-x: hidden;
  overflow-y: auto;
  border: 1px solid #d9dfe2;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 22px 48px rgba(8, 36, 58, .18);
}

:global(#home-hero-search .hero-single-dropdown__menu[hidden]) {
  display: none !important;
}

:global(#home-hero-search .hero-single-dropdown__option) {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 24px;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  padding: 10px 14px;
  border: 0;
  border-bottom: 1px solid #e6e9eb;
