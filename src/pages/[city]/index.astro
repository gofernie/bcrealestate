<script is:inline>
  (() => {
    const results =
      document.getElementById("home-results-experience");

    const hero =
      document.querySelector(".locus-home-hero");

    if (!results || !hero) return;

    const originalParent = results.parentNode;
    const originalNextSibling = results.nextSibling;

    window.positionHomeResults = (hasActiveSearch) => {
      results.dataset.activeSearch =
        hasActiveSearch ? "true" : "false";

      results.classList.toggle(
        "is-filtered",
        hasActiveSearch
      );

      if (hasActiveSearch) {
        hero.insertAdjacentElement("afterend", results);
        return;
      }

      if (originalParent) {
        originalParent.insertBefore(
          results,
          originalNextSibling
        );
      }
    };

    window.positionHomeResults(
      results.dataset.activeSearch === "true"
    );
  })();
</script>

<script is:inline>
  (() => {
    const heroForm =
      document.getElementById("home-hero-search");

    heroForm?.addEventListener("submit", () => {
      const heroPriceSelect =
        heroForm.querySelector('select[name="maxPrice"]');

      const heroMinPriceInput =
        heroForm.querySelector('input[name="minPrice"]');

      const heroPriceSelection =
        String(heroPriceSelect?.value || "");

      const heroOverPriceMatch =
        heroPriceSelection.match(/^over-(\d+)$/);

      if (
        heroPriceSelect instanceof HTMLSelectElement &&
        heroMinPriceInput instanceof HTMLInputElement
      ) {
        if (heroOverPriceMatch) {
          heroMinPriceInput.value = heroOverPriceMatch[1];
          heroPriceSelect.disabled = true;
        } else {
          heroMinPriceInput.value = "";
          heroPriceSelect.disabled = false;
        }
      }
    });

    const multiselect =
      heroForm?.querySelector("[data-area-multiselect]");

    const trigger =
      multiselect?.querySelector("[data-area-trigger]");

    const menu =
      multiselect?.querySelector("[data-area-menu]");

    const summary =
      multiselect?.querySelector("[data-area-summary]");

    const clearButton =
      multiselect?.querySelector("[data-area-clear]");

    if (!heroForm || !multiselect || !trigger || !menu || !summary) {
      return;
    }

    const options = () =>
      Array.from(
        multiselect.querySelectorAll("[data-area-option]")
      );

    const checkedOptions = () =>
      options().filter((option) =>
        option.querySelector('input[name="area"]')?.checked
      );

    const labelText = (option) =>
      String(
        option.querySelector(
          "span:not(.area-multiselect__check)"
        )?.textContent || ""
      ).trim();

    function closeMenu() {
      menu.hidden = true;
      multiselect.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
    }

    function openMenu() {
      document.dispatchEvent(
        new CustomEvent("hero-dropdown:opened", { detail: multiselect })
      );
      menu.hidden = false;
      menu.scrollTop = 0;

      requestAnimationFrame(() => {
        menu.scrollTop = 0;
      });

      multiselect.classList.add("is-open");
      trigger.setAttribute("aria-expanded", "true");
    }

    function syncDropdown() {
      const selected = checkedOptions();
      const selectedSet = new Set(selected);

      options().forEach((option) => {
        const input =
          option.querySelector('input[name="area"]');

        const check =
          option.querySelector(".area-multiselect__check");

        option.classList.toggle(
          "is-selected",
          Boolean(input?.checked)
        );

        if (check) {
          check.textContent = input?.checked ? "✓" : "";
        }
      });

      options()
        .sort((a, b) => {
          const aSelected = selectedSet.has(a);
          const bSelected = selectedSet.has(b);

          if (aSelected !== bSelected) {
            return aSelected ? -1 : 1;
          }

          return labelText(a).localeCompare(labelText(b));
        })
        .forEach((option) => menu.appendChild(option));

      clearButton?.classList.toggle(
        "is-selected",
        selected.length === 0
      );

      const clearCheck =
        clearButton?.querySelector(
          ".area-multiselect__check"
        );

      if (clearCheck) {
        clearCheck.textContent =
          selected.length === 0 ? "✓" : "";
      }

      if (clearButton) {
        menu.prepend(clearButton);
      }

      summary.textContent =
        selected.length === 0
          ? "All Neighbourhoods"
          : selected.length === 1
          ? labelText(selected[0])
          : `${selected.length} neighbourhoods`;
    }

    trigger.addEventListener("click", () => {
      menu.hidden ? openMenu() : closeMenu();
    });

    multiselect.addEventListener("change", (event) => {
      if (
        event.target instanceof HTMLInputElement &&
        event.target.name === "area"
      ) {
        syncDropdown();
      }
    });

    clearButton?.addEventListener("click", () => {
      options().forEach((option) => {
        const input =
          option.querySelector('input[name="area"]');

        if (input) {
          input.checked = false;
        }
      });

      syncDropdown();
      heroForm.requestSubmit();
    });

    document.addEventListener("click", (event) => {
      if (!multiselect.contains(event.target)) {
        closeMenu();
      }
    });

    document.addEventListener("hero-dropdown:opened", (event) => {
      if (event.detail !== multiselect) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
        trigger.focus();
      }
    });

    syncDropdown();
  })();
</script>
<script is:inline>
  const listViewBtn = document.getElementById("list-view-btn");
