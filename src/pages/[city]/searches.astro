---
import { createClient } from "@supabase/supabase-js";
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { getSite } from "../../lib/getSite";
import { getNavIntentPages } from "../../lib/getNavIntentPages";
import { loadGreaterVictoriaData } from "../../lib/greaterVictoria";
import { countIntentListings } from "../../lib/intentCounts";

export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const city = String(Astro.params.city || Astro.url.pathname.split("/").filter(Boolean)[0] || "nanaimo").toLowerCase().trim().replace(/-intent$/, "");
const requestHostname = Astro.url.hostname
  .toLowerCase()
  .replace(/^www\./, "");

const siteHostname =
  requestHostname === "localhost" ||
  requestHostname === "127.0.0.1"
   ? "bc.realestate"
    : requestHostname;
const siteRow: any = await getSite(siteHostname, city);
const siteCityLabel = city.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const site: any = { ...(siteRow || {}), city, site_name: `${siteCityLabel} Homes`, accent_color: siteRow?.accent_color || "#2f6f73" };
const navIntentPages = await getNavIntentPages(supabase, site?.id);

const titleCase = (value: unknown) =>
  String(value || "").replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()).trim();

const cityLabel = titleCase(city);
const accent = (site as any)?.accent_color || (site as any)?.accent || "#2a6f73";

let query = supabase.from("intent_pages").select("*");
query = query.eq("city", city);
if (site?.id) query = query.eq("site_id", site.id);
const { data: rows } = await query;

let inventory: any[] = [];
if (city === "greater-victoria") {
  const gv: any = await loadGreaterVictoriaData();
  inventory = gv?.listings || [];
} else {
  const keys = Array.from(new Set(
    ["saanich-east", "saanich-west"].includes(city) ? [city, city.replace(/-/g, " "), "saanich"]
      : city === "comox" ? ["comox", "courtenay", "cumberland", "black creek", "merville", "union bay", "fanny bay", "royston", "denman island"]
      : [city, city.replace(/-/g, " ")]
  ));
  const { data: inv } = await supabase
    .from("listing_rows")
    .select("normalized_type, property_type, normalized_area, price, waterfront, waterfront_type, view_type, beds, baths, sqft, lot_size_sqft, lot_size_acres")
    .in("normalized_city", keys)
    .eq("status", "A")
    .neq("property_type", "Lease")
    .range(0, 9999);
  inventory = inv || [];
}

const typeLabels: Record<string, string> = {
  house: "Homes",
  condo: "Condos",
  townhouse: "Townhomes",
  mobile: "Mobile Homes",
  land: "Land",
};
const typeOrder = ["Homes", "Condos", "Townhomes", "Mobile Homes", "Land", "More searches"];
const cityPrefix = new RegExp(`^${cityLabel}\\s+(?=\\S)`, "i");

const pages = (rows || [])
  .filter((row: any) => row.slug && String(row.city || "").toLowerCase() === city)
  .map((row: any) => ({
    count: countIntentListings(row, inventory),
    href: `/${row.city || city}/${String(row.slug).replace(/^\/+/, "")}`,
    title: String(row.hero_heading || row.seo_heading || titleCase(row.slug)).replace(cityPrefix, ""),
    type: String(row.property_type || "").toLowerCase(),
    area: String(row.area || "").toLowerCase(),
    copy: String(row.meta_description || row.intro_copy || "").replace(/\s+/g, " ").trim(),
  }))
  .sort((a: any, b: any) => a.title.localeCompare(b.title));

const byType = new Map<string, any[]>();
for (const p of pages) {
  const key = typeLabels[p.type] || "More searches";
  if (!byType.has(key)) byType.set(key, []);
  byType.get(key)!.push(p);
}
const typeGroups = typeOrder.filter((k) => byType.has(k)).map((k) => [k, byType.get(k)!] as const);

const byArea = new Map<string, any[]>();
for (const p of pages.filter((p: any) => p.area)) {
  const key = titleCase(p.area);
  if (!byArea.has(key)) byArea.set(key, []);
  byArea.get(key)!.push(p);
}
const areaGroups = [...byArea.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const short = (text: string) => (text.length > 140 ? `${text.slice(0, 137).trim()}…` : text);
---

<Layout
  title={`${cityLabel} Home Searches`}
  description={`Every curated ${cityLabel} home search in one place, organized by home type and area.`}
  accentColor={accent}
  city={city}
  site={site}
>
  <SiteNav
    city={city}
    site={site}
    areas={[]}
    types={["house", "condo", "townhouse", "mobile", "land"]}
    intentPages={navIntentPages}
    showAreaNav={false}
    areaListingCounts={{}}
  />

  <main class="searches-hub">
    <header class="searches-hub__head">
      <p class="searches-hub__kicker">All searches</p>
      <h1>Every {cityLabel} search.</h1>
      <p class="searches-hub__lede">
        {pages.length} curated searches, each one live and updated as listings change.
        <a href={`/${city}#homepage-listings`}>Or browse every listing &rarr;</a>
      </p>
    </header>

    <section class="searches-hub__section">
      <h2>By home type</h2>
      <div class="searches-hub__groups">
        {typeGroups.map(([label, items]) => (
          <div class="searches-hub__group">
            <h3>{label} <small>{items.length}</small></h3>
            <ul>
              {items.map((p: any) => (
                <li>
                  <a href={p.href}>{p.title}</a>{p.count > 0 && <em class="searches-hub__count">{`${p.count.toLocaleString()} for sale`}</em>}
                  {p.copy && <span>{short(p.copy)}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {areaGroups.length > 0 && (
      <section class="searches-hub__section">
        <h2>By area</h2>
        <div class="searches-hub__groups">
          {areaGroups.map(([label, items]) => (
            <div class="searches-hub__group">
              <h3>{label} <small>{items.length}</small></h3>
              <ul>
                {items.map((p: any) => (
                  <li><a href={p.href}>{p.title}</a>{p.count > 0 && <em class="searches-hub__count">{`${p.count.toLocaleString()} for sale`}</em>}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

<style is:global>
html body main.searches-hub { max-width: 1120px !important; margin: 0 auto !important; padding: 48px 20px 88px !important; }
html body main.searches-hub .searches-hub__kicker { margin: 0 0 6px !important; font-size: .72rem !important; font-weight: 800 !important; letter-spacing: .1em !important; text-transform: uppercase !important; opacity: .65 !important; }
html body main.searches-hub .searches-hub__head h1 { margin: 0 0 12px !important; font-family: "Instrument Serif", Georgia, serif !important; font-weight: 400 !important; font-size: clamp(2.1rem, 4vw, 3rem) !important; line-height: 1.05 !important; }
html body main.searches-hub .searches-hub__lede { margin: 0 !important; max-width: 680px !important; font-size: 1.02rem !important; opacity: .82 !important; }
html body main.searches-hub .searches-hub__lede a { display: inline-block !important; white-space: nowrap !important; margin-left: 6px !important; font-weight: 700 !important; color: var(--accent, #2a6f73) !important; text-decoration: none !important; }
html body main.searches-hub .searches-hub__section { margin-top: 52px !important; }
html body main.searches-hub .searches-hub__section > h2 { margin: 0 0 6px !important; font-family: "Instrument Serif", Georgia, serif !important; font-weight: 400 !important; font-size: 1.75rem !important; }
html body main.searches-hub .searches-hub__groups { display: block !important; }
html body main.searches-hub .searches-hub__group { display: grid !important; grid-template-columns: 200px 1fr !important; gap: 24px !important; padding: 22px 0 !important; border-top: 1px solid rgba(15, 30, 45, .1) !important; background: transparent !important; box-shadow: none !important; border-radius: 0 !important; }
html body main.searches-hub .searches-hub__group h3 { display: flex !important; align-items: center !important; gap: 10px !important; align-self: start !important; margin: 6px 0 0 !important; padding: 0 !important; border: 0 !important; font-size: .78rem !important; font-weight: 800 !important; letter-spacing: .09em !important; text-transform: uppercase !important; }
html body main.searches-hub .searches-hub__group h3 small { padding: 2px 8px !important; border-radius: 999px !important; background: color-mix(in srgb, var(--accent, #2a6f73) 12%, #fff) !important; color: var(--accent, #2a6f73) !important; font-size: .72rem !important; letter-spacing: 0 !important; }
html body main.searches-hub .searches-hub__group ul { list-style: none !important; margin: 0 !important; padding: 0 !important; display: grid !important; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)) !important; gap: 12px !important; }
html body main.searches-hub .searches-hub__group li { position: relative !important; padding: 14px 16px !important; margin: 0 !important; background: #fff !important; border: 1px solid rgba(15, 30, 45, .1) !important; border-radius: 12px !important; transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease !important; }
html body main.searches-hub .searches-hub__group li:hover { border-color: color-mix(in srgb, var(--accent, #2a6f73) 40%, #d8dde2) !important; box-shadow: 0 8px 20px rgba(15, 30, 45, .07) !important; transform: translateY(-1px) !important; }
html body main.searches-hub .searches-hub__group li a { display: block !important; font-family: "Instrument Serif", Georgia, serif !important; font-size: 1.15rem !important; font-weight: 400 !important; line-height: 1.25 !important; color: #142330 !important; text-decoration: none !important; }
html body main.searches-hub .searches-hub__group li a::after { content: "" !important; position: absolute !important; inset: 0 !important; border-radius: 12px !important; }
html body main.searches-hub .searches-hub__group li span { display: -webkit-box !important; -webkit-line-clamp: 2 !important; -webkit-box-orient: vertical !important; overflow: hidden !important; margin-top: 4px !important; font-size: .84rem !important; line-height: 1.45 !important; opacity: .68 !important; }
@media (max-width: 720px) { html body main.searches-hub .searches-hub__group { grid-template-columns: 1fr !important; gap: 12px !important; } }
html body main.searches-hub .searches-hub__count { display: inline-block !important; margin-top: 6px !important; font-style: normal !important; font-size: .72rem !important; font-weight: 800 !important; letter-spacing: .06em !important; text-transform: uppercase !important; color: var(--accent, #2a6f73) !important; }
</style>