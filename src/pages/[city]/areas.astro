  .areas-discovery {
    position: relative;
    margin-bottom: 58px;
    padding: 54px 0 48px;
    background:
      linear-gradient(
        180deg,
        #e9edf1 0%,
        #f2eef5 38%,
        #faf9fa 100%
      );
    box-shadow: 0 0 0 100vmax #f2eef5;
    clip-path: inset(0 -100vmax);
  }

  .areas-lifestyle-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .areas-lifestyle-card {
    display: flex;
    min-height: 152px;
    gap: 18px;
    padding: 20px;
    border: 1px solid rgba(28, 25, 23, 0.1);
    border-radius: 12px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    box-shadow: 0 4px 24px rgba(28, 25, 23, 0.04);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  /* areas-tonal-lifestyle-cards */
.areas-lifestyle-card {
  border-color: color-mix(
    in srgb,
    var(--areas-accent) 11%,
    rgba(28, 25, 23, 0.08)
  );
  box-shadow: 0 7px 22px rgba(39, 34, 45, 0.045);
}

.areas-lifestyle-card:nth-child(3n + 1) {
  background: #eef3f4;
}

.areas-lifestyle-card:nth-child(3n + 2) {
  background: #f2eef7;
}

.areas-lifestyle-card:nth-child(3n) {
  background: #f6f1ee;
}
.areas-lifestyle-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(
      in srgb,
      var(--areas-accent) 45%,
      transparent
    );
    box-shadow: 0 16px 38px rgba(28, 25, 23, 0.09);
  }

  .areas-lifestyle-icon {
    display: grid;
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 50%;
    background: color-mix(
      in srgb,
      var(--areas-accent) 12%,
      white
    );
    color: var(--areas-accent);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .areas-lifestyle-card small {
    display: block;
    margin-bottom: 5px;
    color: var(--areas-accent);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .areas-lifestyle-card strong {
    display: block;
    font-family: Georgia, serif;
    font-size: 1.2rem;
    line-height: 1.15;
  }

  .areas-lifestyle-card p {
    margin: 7px 0 11px;
    color: #625f5b;
    font-size: 0.9rem;
    line-height: 1.48;
  }

  .areas-lifestyle-card b {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--areas-accent);
    font-size: 0.82rem;
  }

  .areas-featured {
    display: grid;
    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(340px, 1.1fr);
    overflow: hidden;
    margin: 72px 0;
