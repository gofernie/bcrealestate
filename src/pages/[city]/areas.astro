---
import { createClient } from "@supabase/supabase-js";
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { getSite } from "../../lib/getSite";
import { getNavIntentPages } from "../../lib/getNavIntentPages";

export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const city = String(
  Astro.params.city ||
  Astro.url.searchParams.get("city") ||
  "nanaimo"
)
  .toLowerCase()
  .trim();

const reservedCityRoutes = new Set([
  "404",
  "about",
  "about-bc",
  "bc",
  "buying-guide",
  "contact",
  "explore",
  "market-insights",
  "privacy",
  "terms",
  "admin",
  "api",
  "listings",
  "shortlists",
  "for",
  "learn",
  "sitemap",
  "sitemap.xml",
  "robots",
  "robots.txt",
  "favicon",
]);

const legacyMarketSuffix =
  /(?:-real-estate-market)+$/i;

if (legacyMarketSuffix.test(city)) {
  const cleanCity = city
    .replace(/(?:-real-estate-market)+$/i, "")
    .replace(/-+$/g, "")
    .trim();

  if (!cleanCity || reservedCityRoutes.has(cleanCity)) {
    return Astro.rewrite("/404");
  }

  return Astro.redirect(`/${cleanCity}/areas`, 301);
}

if (reservedCityRoutes.has(city)) {
  return Astro.rewrite("/404");
}

const cityDatabaseKeys = Array.from(
  new Set(
    ["saanich-east", "saanich-west"].includes(city) ? [city, city.replace(/-/g, " "), "saanich"]
      : city === "comox"
        ? ["comox", "courtenay", "cumberland", "black creek", "merville", "union bay", "fanny bay", "royston", "denman island"]
        : [city, city.replace(/-/g, " ")]
  )
);

const {
  data: validCityRow,
  error: validCityError,
} = await supabase
  .from("listing_rows")
  .select("normalized_city")
  .in("normalized_city", cityDatabaseKeys)
  .limit(1)
  .maybeSingle();

if (validCityError) {
  console.error(
    "Areas city validation failed:",
    validCityError
  );
}

if (!validCityError && !validCityRow) {
  return Astro.rewrite("/404");
}

const cityLabel = city
  .replace(/-/g, " ")
  .replace(/\b\w/g, (character) => character.toUpperCase());

const site = await getSite(Astro.url.hostname, city);

const isNanaimoMobilesSite =
  Astro.url.hostname
    .toLowerCase()
    .replace(/^www\./, "") === "nanaimomobiles.com" ||
  Astro.url.searchParams
    .get("siteDomain")
    ?.toLowerCase()
    .replace(/^www\./, "") === "nanaimomobiles.com";

let listingQuery = supabase
  .from("listing_rows")
  .select("lat, lng")
  .in("normalized_city", cityDatabaseKeys)
  .eq("status", "A");

if (isNanaimoMobilesSite) {
  listingQuery = listingQuery.eq("normalized_type", "mobile");
}

const { data: listings = [], error: listingsError } =
  await listingQuery;

if (listingsError) {
  console.error("Areas listing query failed:", listingsError);
}

const { data: rawAreaRows = [], error: areasError } =
  await supabase
    .from("area_boundaries")
    .select(`
      area_slug,
      area_name,
      short_description,
      hero_image_url,
      polygon_geojson
    `)
    .in("city", cityDatabaseKeys)
    .order("area_name", { ascending: true });

if (areasError) {
  console.error("Area metadata query failed:", areasError);
}

/*
  Saanich East and Saanich West are parent MLS regions.
  Hide them from the city-wide neighbourhood directory/map when
  the named neighbourhood boundaries are also available.
*/
const areaRows =
  ["saanich", "saanich-east", "saanich-west"].includes(city) && rawAreaRows.length > 2
    ? rawAreaRows.filter((row) => {
        const slug = String(
          row.area_slug || row.area_name || ""
        )
          .toLowerCase()
          .trim();

        return !["saanich-east", "saanich-west"].includes(slug);
      })
    : rawAreaRows;

const areaToSlug = (value) =>
  String(value || "")
    .toLowerCase()
    .replace(/^pq[\s-]+/i, "")
    .replace(/&/g, "and")
    .replace(/\//g, "-")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const titleCase = (value) =>
  String(value || "")
    .replace(/^pq[\s-]+/i, "")
    .replace(/-/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/\b\w/g, (character) => character.toUpperCase());

function pointInRing(point, ring) {
  const [x, y] = point;
  let inside = false;

  for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
    const xi = Number(ring[i][0]);
    const yi = Number(ring[i][1]);
    const xj = Number(ring[j][0]);
    const yj = Number(ring[j][1]);

    if (
      yi > y !== yj > y &&
      x < ((xj - xi) * (y - yi)) / (yj - yi) + xi
    ) inside = !inside;
  }

  return inside;
}

function polygonContainsPoint(geojson, lat, lng) {
  if (!geojson) return false;

  const geometry = geojson.type === "Feature"
    ? geojson.geometry
    : geojson;

  if (!geometry) return false;

  const point = [lng, lat];

  if (geometry.type === "Polygon") {
    return geometry.coordinates.some((ring) =>
      pointInRing(point, ring)
    );
  }

  if (geometry.type === "MultiPolygon") {
    return geometry.coordinates.some((poly) =>
      poly.some((ring) => pointInRing(point, ring))
    );
  }

  return false;
}

/*
  Saanich East is a distinct market made from its named
  neighbourhood boundaries, while the listing feed is broadly
  labelled "saanich". Keep only listings inside those boundaries.
*/
const scopedListings =
  ["saanich-east", "saanich-west"].includes(city) ? listings.filter((listing) =>
        areaRows.some((row) =>
          polygonContainsPoint(
            row.polygon_geojson,
            Number(listing.lat),
            Number(listing.lng)
          )
        )
      )
    : listings;

const areaCountMap = areaRows.reduce((result, row) => {
  const slug = areaToSlug(row.area_slug || row.area_name);

  result[slug] = scopedListings.filter((listing) =>
    polygonContainsPoint(
      row.polygon_geojson,
      Number(listing.lat),
      Number(listing.lng)
    )
  ).length;

  return result;
}, {});

const areas = areaRows
  .map((row) => {
    const slug = areaToSlug(row.area_slug || row.area_name);

    return {
      name: titleCase(row.area_name || row.area_slug),
      slug,
      count: Number(areaCountMap[slug] || 0),
      description: String(row.short_description || "").trim(),
      image: String(row.hero_image_url || "").trim(),
    };
  })
  .filter((area) => area.slug)
  .sort(
    (a, b) =>
      b.count - a.count ||
      a.name.localeCompare(b.name)
  );

const areaMapBoundaries = areaRows
  .map((row) => {
    const slug = areaToSlug(row.area_slug || row.area_name);

    return {
      name: titleCase(row.area_name || row.area_slug),
      slug,
      count: Number(areaCountMap[slug] || 0),
      href: `/${city}/${slug}`,
      geometry: row.polygon_geojson || null,
    };
  })
  .filter((area) => area.slug && area.geometry);
const heroImageUrl = String(
  areaRows.find((row) =>
    String(row.hero_image_url || "").trim()
  )?.hero_image_url ||
  site?.hero_image_url ||
  ""
).trim();

const safeHeroImage =
  heroImageUrl.replace(/"/g, "%22");

const topArea =
  areas[0]?.name ||
  cityLabel;

const navAreas =
  areas.map((area) => area.name);

const navIntentPages =
  await getNavIntentPages(
    supabase,
    site?.id
  );

const navTypes = [
  "house",
  "condo",
  "townhouse",
  "mobile",
  "land",
];

const accent =
  site?.accent_color ||
  "#633a98";


const findArea = (
  keywords: string[],
  fallbackIndex = 0
) => {
  const match = areas.find((area) => {
    const searchable = `${area.name} ${area.slug} ${area.description}`
      .toLowerCase();

    return keywords.some((keyword) =>
      searchable.includes(keyword)
    );
  });

  return match || areas[fallbackIndex] || areas[0] || null;
};

const skiCities = new Set([
  "fernie",
  "whistler",
  "revelstoke",
  "golden",
  "rossland",
  "kimberley",
  "invermere",
  "panorama",
  "sun-peaks",
  "big-white",
  "silver-star",
]);

const coastalCities = new Set([
  "nanaimo",
  "parksville",
  "qualicum-beach",
  "tofino",
  "ucluelet",
  "victoria",
  "saanich",
  "comox",
  "courtenay",
  "campbell-river",
  "ladysmith",
  "lantzville",
]);

const isSkiTown =
  skiCities.has(city);

const isCoastalTown =
  coastalCities.has(city);

const primaryLifestyleRecommendation =
  isSkiTown
    ? {
        eyebrow: "Mountain lifestyle",
        title: "Ski access",
        description:
          "Start close to the slopes, trails, and year-round mountain recreation.",
        icon: "mountain",
        area: findArea(
          ["alpine resort", "ski", "resort"],
          0
        ),
      }
    : isCoastalTown
      ? {
          eyebrow: "Coastal lifestyle",
          title: "Ocean and waterfront",
          description:
            "Explore communities near the ocean, beaches, marinas, and coastal trails.",
          icon: "water",
          area: findArea(
            [
              "waterfront",
              "ocean",
              "bay",
              "beach",
              "harbour",
              "harbor",
            ],
            0
          ),
        }
      : {
          eyebrow: "Outdoor lifestyle",
          title: "Parks and nature",
          description:
            "Start near trails, parks, green space, and outdoor recreation.",
          icon: "trees",
          area: findArea(
            ["park", "trail", "nature", "rural"],
            0
          ),
        };

const lifestyleRecommendations = [
  primaryLifestyleRecommendation,
  {
    eyebrow: "Everyday convenience",
    title: "Walkable living",
    description:
      "Explore neighbourhoods close to shops, restaurants, and local services.",
    icon: "walk",
    area: findArea(
      [
        "downtown",
        "old city",
        "centre",
        "center",
      ],
      1
    ),
  },
  {
    eyebrow: "Room to settle in",
    title: "Family friendly",
    description:
      "Look for quieter streets, parks, schools, and practical home layouts.",
    icon: "family",
    area: findArea(
      [
        "family",
        "west",
        "annex",
        "heights",
      ],
      2
    ),
  },
  {
    eyebrow: "Trail connections",
    title: "Bike and explore",
    description:
      "Find areas with quick access to trails, parks, and outdoor recreation.",
    icon: "bike",
    area: findArea(
      [
        "montane",
        "trail",
        "mountain",
        "park",
      ],
      3
    ),
  },
  {
    eyebrow: "A little more space",
    title: "Quiet living",
    description:
      "Browse neighbourhoods known for privacy, larger lots, and a calmer pace.",
    icon: "trees",
    area: findArea(
      [
        "ridgemont",
        "rural",
        "acreage",
        "quiet",
        "cedar",
      ],
      4
    ),
  },
  {
    eyebrow: "Compare your options",
    title: "More for your budget",
    description:
      "See where current inventory offers the widest range of homes and prices.",
    icon: "value",
    area:
      [...areas]
        .filter((area) => area.count > 0)
        .sort((a, b) => b.count - a.count)[0] ||
      areas[0] ||
      null,
  },
].filter((item) => item.area);

const featureCandidates =
  areas.filter((area) => area.count > 0);

const cityRotationValue =
  [...city].reduce(
    (total, character) =>
      total + character.charCodeAt(0),
    0
  );

const currentDayNumber =
  Math.floor(Date.now() / 86400000);

const featuredArea =
  featureCandidates.length > 0
    ? featureCandidates[
        (
          currentDayNumber +
          cityRotationValue
        ) % featureCandidates.length
      ]
    : areas[0] || null;

const areasWithListings =
  areas.filter((area) => area.count > 0).length;

const averageListingsPerArea =
  areasWithListings > 0
    ? Math.round(
        listings.length / areasWithListings
      )
    : 0;
const jawgAccessToken =
  import.meta.env.PUBLIC_JAWG_ACCESS_TOKEN || "";
---

<script
  id="areas-jawg-map-config"
  is:inline
  define:vars={{ jawgAccessToken }}
>
  window.__JAWG_TILE_URL__ = jawgAccessToken
    ? `https://tile.jawg.io/8dcad843-ebe7-4a16-8db9-b11d0562bb6d/{z}/{x}/{y}.png?access-token=${encodeURIComponent(jawgAccessToken)}`
    : "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png";

  window.__JAWG_ATTRIBUTION__ = jawgAccessToken
    ? '&copy; <a href="https://www.jawg.io/" target="_blank" rel="noopener">Jawg Maps</a> &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>'
    : "&copy; OpenStreetMap contributors";
</script>
<Layout
  title={`${cityLabel} Neighbourhoods and Areas`}
  description={`Explore ${cityLabel} neighbourhoods and homes for sale.`}
  accentColor={accent}
  city={city}
>
  <SiteNav
    city={city}
    site={site}
    areas={navAreas}
    types={navTypes}
    intentPages={navIntentPages}
    showAreaNav={false}
  />

  <div class="areas-page">
    <header class="areas-intro">
      <div><h1>Explore {cityLabel}</h1><p>Find a neighbourhood that fits.</p></div>
      <div class="areas-totals">
        <div><strong>{scopedListings.length.toLocaleString()}</strong><span>Active listings</span></div>
        <div><strong>{areas.length}</strong><span>Neighbourhoods</span></div>
      </div>
    </header>
    <main>
      <div class="areas-explorer">
        <div class="areas-map-resizer">
  <button class="areas-resize-button" type="button" aria-expanded="false" aria-controls="areas-overview-map">Expand map +</button>
        <section class="areas-map-panel" aria-label={`${cityLabel} neighbourhood map`}>
          <div id="areas-overview-map" class="areas-overview-map__canvas" aria-label={`Map of ${cityLabel} neighbourhoods`}></div>
          <span class="areas-map-hint">Select an area to explore</span>
        </section>
        </div>
        <section id="neighbourhoods" class="areas-directory" aria-labelledby="areas-directory-title">
          <div class="areas-directory-head">
            <h2 id="areas-directory-title">Neighbourhoods</h2>
            <label><span class="areas-sr-only">Sort neighbourhoods</span><select id="areas-sort"><option value="count">Most listings</option><option value="name">A–Z</option></select></label>
          </div>
          <div class="areas-rows">
            {areas.map((area) => (
              <a class="areas-row" href={`/${city}/${area.slug}`} data-area-slug={area.slug} data-area-name={area.name} data-area-count={area.count}>
                <span class="areas-row-accent" aria-hidden="true"></span>
                <span class="areas-row-copy"><strong>{area.name.replace(/\s+neighbourhood$/i, "")}</strong><span>{area.count.toLocaleString()} {area.count === 1 ? "listing" : "listings"}</span></span>
                <span class="areas-row-arrow" aria-hidden="true">›</span>
              </a>
            ))}
            {areas.length === 0 && <p class="areas-empty">Neighbourhood guides are being added.</p>}
          </div>
          <p class="areas-directory-note">Select a neighbourhood to view homes and local insights.</p>
        </section>
      </div>
      <div class="areas-browse-all"><h2>Prefer to browse all of {cityLabel}?</h2><a href={`/${city}#homepage-listings`}>View all homes <span aria-hidden="true">→</span></a></div>
    </main>
  </div>
  <script id="areas-overview-map-data" type="application/json" set:html={JSON.stringify(areaMapBoundaries)} />
  <style is:global>
    .areas-page { --areas-ink:#242421; --areas-surface:#fff; --areas-bg:#f1efe9; --areas-muted:#626660; --areas-line:rgba(40,45,40,.14); color:var(--areas-ink); background:var(--areas-bg); padding:30px max(24px, calc((100vw - 1440px)/2)) 48px; }
    .areas-page * { box-sizing:border-box; }
    .areas-intro { display:flex; align-items:center; justify-content:space-between; gap:28px; padding:0 0 24px; margin-bottom:22px; border-bottom:1px solid var(--areas-line); }
    .areas-intro h1 { margin:0 0 9px; font:500 clamp(2.2rem,4vw,3.6rem)/1.06 Georgia,serif; letter-spacing:-.04em; }
    .areas-intro p { margin:0; color:var(--areas-muted); font-size:1.15rem; }
    .areas-totals { display:flex; gap:36px; padding-left:32px; border-left:1px solid var(--areas-line); }
    .areas-totals div { display:grid; gap:6px; }
    .areas-totals strong { font:500 2.3rem/1 Georgia,serif; }
    .areas-totals span { color:var(--areas-muted); font-size:.9rem; }
    .areas-explorer { display:grid; grid-template-columns:minmax(0,1.85fr) minmax(320px,1fr); gap:16px; align-items:stretch; }
    .areas-map-panel { position:relative; min-width:0; }
    .areas-overview-map__canvas { height:620px; position:relative; overflow:hidden; border:1px solid var(--areas-line); border-radius:5px; background:#e8ece8; }
    .areas-overview-map__canvas::before { content:"Loading neighbourhood map"; position:absolute; inset:0; display:grid; place-items:center; color:#626660; }
    .areas-overview-map__canvas.is-ready::before { display:none; }
    .areas-map-hint { position:absolute; z-index:450; top:14px; left:54px; padding:10px 13px; border-radius:4px; background:#fff; color:#242421; font-size:.8rem; pointer-events:none; box-shadow:0 2px 8px #0001; }
    .areas-directory { min-width:0; display:flex; flex-direction:column; height:620px; background:var(--areas-surface); border:1px solid var(--areas-line); border-radius:5px; overflow:hidden; }
    .areas-directory-head { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:22px 20px; border-bottom:1px solid var(--areas-line); }
    .areas-directory-head h2 { margin:0; font:500 clamp(1.5rem,2vw,2rem)/1.1 Georgia,serif; letter-spacing:-.035em; }
    .areas-directory-head select { max-width:125px; font:inherit; font-size:.78rem; color:var(--areas-muted); border:0; background:var(--areas-surface); cursor:pointer; padding:8px 0; }
    .areas-rows { overflow:auto; flex:1; min-height:0; }
    .areas-row { display:flex; align-items:center; gap:15px; padding:18px 20px; min-height:78px; border-bottom:1px solid var(--areas-line); text-decoration:none; color:var(--areas-ink); transition:background .15s; }
    .areas-row:hover,.areas-row.is-highlighted { background:color-mix(in srgb,#2f6f73 12%,var(--areas-surface)); }
    .areas-row:focus-visible { outline:2px solid #2f6f73; outline-offset:-3px; }
    .areas-row-accent { align-self:stretch; min-height:34px; width:6px; flex-shrink:0; border-radius:4px; background:var(--area-colour,#728e90); }
    .areas-row-copy { display:grid; gap:6px; flex:1; min-width:0; }
    .areas-row-copy strong { font:500 1.25rem/1.15 Georgia,serif; overflow-wrap:anywhere; }
    .areas-row-copy > span { color:var(--areas-muted); font-size:.82rem; }
    .areas-row-arrow { font-size:1.65rem; color:var(--areas-muted); }
    .areas-directory-note,.areas-empty { padding:18px 20px; margin:0; color:var(--areas-muted); font-size:.8rem; line-height:1.5; }
    .areas-directory-note { border-top:1px solid var(--areas-line); }
    .areas-browse-all { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-top:16px; padding:24px 28px; background:color-mix(in srgb,#2f6f73 4%,var(--areas-bg)); border-radius:4px; }
    .areas-browse-all h2 { margin:0; font:500 clamp(1.3rem,2.2vw,2rem)/1.2 Georgia,serif; letter-spacing:-.03em; }
    .areas-browse-all a { display:inline-flex; gap:24px; padding:13px 18px; border:1px solid currentColor; border-radius:4px; text-decoration:none; color:var(--areas-ink); white-space:nowrap; }
    .areas-sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    .areas-overview-map__canvas .leaflet-tooltip { color:#242421; background:#fff; border:0; border-radius:5px; font:600 11px/1.35 Arial,sans-serif; box-shadow:0 2px 9px #0002; }
    .areas-overview-map__canvas .areas-count-label { padding:4px 8px; }
    .areas-overview-map__canvas .leaflet-control-attribution { font-size:9px; }
    html[data-theme="dark"] .areas-page, body[data-theme="dark"] .areas-page, html.dark .areas-page { --areas-ink:#f1efe9; --areas-surface:#1b1e21; --areas-bg:#151b22; --areas-muted:#b4babc; --areas-line:rgba(255,255,255,.13); }
    @media(max-width:900px) {
      .areas-explorer { grid-template-columns:1fr; }
      .areas-directory { height:auto; }
      .areas-rows { max-height:none; overflow:visible; }
      .areas-overview-map__canvas { height:440px; }
      .areas-intro { align-items:flex-start; }
      .areas-totals { gap:20px; padding-left:20px; }
    }
    @media(max-width:600px) {
      .areas-page { padding:24px 20px 32px; }
      .areas-intro { display:block; padding-bottom:20px; margin-bottom:0; border:0; }
      .areas-intro h1 { font-size:2.2rem; }
      .areas-intro p { font-size:1rem; }
      .areas-totals { border:0; padding:0; margin-top:16px; gap:24px; }
      .areas-totals div { display:flex; gap:5px; align-items:baseline; }
      .areas-totals strong { font:700 .85rem/1.3 Arial,sans-serif; }
      .areas-totals span { font-size:.8rem; }
      .areas-explorer { gap:20px; }
      .areas-map-panel { margin:0 -20px; }
      .areas-overview-map__canvas { height:380px; border-radius:0; border-left:0; border-right:0; }
      .areas-directory-head { padding:18px 16px; }
      .areas-directory-head h2 { font-size:1.5rem; }
      .areas-row { padding:16px; min-height:76px; }
      .areas-row-copy strong { font-size:1.15rem; }
      .areas-browse-all { display:block; padding:22px 16px; }
      .areas-browse-all a { margin-top:16px; }
    }
  </style>
      <script is:inline>
        (() => {
          const mapElement = document.getElementById(
            "areas-overview-map"
          );
          const dataElement = document.getElementById(
            "areas-overview-map-data"
          );

          if (!mapElement || !dataElement) return;

          const sortControl = document.getElementById("areas-sort");
          sortControl?.addEventListener("change", () => {
            const list = document.querySelector(".areas-rows");
            const rows = Array.from(list.querySelectorAll(".areas-row"));
            rows.sort((a, b) => sortControl.value === "name"
              ? a.dataset.areaName.localeCompare(b.dataset.areaName)
              : Number(b.dataset.areaCount) - Number(a.dataset.areaCount) || a.dataset.areaName.localeCompare(b.dataset.areaName));
            rows.forEach((row) => list.appendChild(row));
          });
          let areas = [];

          try {
            areas = JSON.parse(dataElement.textContent || "[]");
          } catch {
            return;
          }

          if (!areas.length) {
            mapElement.classList.add("is-ready");
            mapElement.textContent =
              "Neighbourhood boundaries are being added.";
            return;
          }

          const leafletCss =
            "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
          const leafletJs =
            "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";

          if (!document.querySelector(`link[href="${leafletCss}"]`)) {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = leafletCss;
            document.head.appendChild(link);
          }

          const startMap = () => {
            if (!window.L || mapElement.dataset.mapReady === "true") return;

            mapElement.dataset.mapReady = "true";

            const map = window.L.map(mapElement, {
              attributionControl: true,
              scrollWheelZoom: false,
              zoomControl: true,
              preferCanvas: true,
            });

            window.L.tileLayer(window.__JAWG_TILE_URL__, {
              maxZoom: 19,
              attribution: window.__JAWG_ATTRIBUTION__,
            }).addTo(map);

            const colours = [
              "#315f87",
              "#8d4964",
              "#8a6a22",
              "#44785f",
              "#735fa3",
              "#a3533e",
              "#3e7580",
              "#7a6a50",
            ];

            const rows = Array.from(document.querySelectorAll(".areas-row"));
            areas.forEach((area, index) => {
              const row = rows.find((item) => item.dataset.areaSlug === area.slug);
              if (row) row.style.setProperty("--area-colour", colours[index % colours.length]);
            });
            const layersBySlug = new Map();
            const features = areas
              .map((area) => {
                let geometry = area.geometry;

                if (typeof geometry === "string") {
                  try {
                    geometry = JSON.parse(geometry);
                  } catch {
                    geometry = null;
                  }
                }

                const actualGeometry =
                  geometry?.type === "Feature"
                    ? geometry.geometry
                    : geometry;

                if (!actualGeometry?.type) return null;

                return {
                  type: "Feature",
                  properties: area,
                  geometry: actualGeometry,
                };
              })
              .filter(Boolean);

            let boundaryLayer;

            boundaryLayer = window.L.geoJSON(
              {
                type: "FeatureCollection",
                features,
              },
              {
                style(feature) {
                  const index = Math.max(
                    0,
                    features.indexOf(feature)
                  );
                  const colour = colours[index % colours.length];

                  return {
                    color: colour,
                    weight: 2,
                    opacity: .88,
                    fillColor: colour,
                    fillOpacity: .24,
                  };
                },
                onEachFeature(feature, areaLayer) {
                  const area = feature.properties || {};
                  layersBySlug.set(area.slug, areaLayer);
                  const count = Number(area.count || 0);
                  const label =
                    `${area.name || "Area"} · ` +
                    `${count.toLocaleString()} ` +
                    `${count === 1 ? "listing" : "listings"}`;
                  areaLayer.bindTooltip(label, {
                    permanent: false,
                    sticky: true,
                    direction: "top",
                    offset: [0, -8],
                    opacity: .98,
                    className: "areas-overview-map__label",
                  });

                  areaLayer.on({
                    mouseover() {
                      rows.find((row) => row.dataset.areaSlug === area.slug)?.classList.add("is-highlighted");
                      areaLayer.setStyle({
                        weight: 3,
                        fillOpacity: .45,
                      });
                      areaLayer.bringToFront();
                    },
                    mouseout() {
                      rows.find((row) => row.dataset.areaSlug === area.slug)?.classList.remove("is-highlighted");
                      boundaryLayer.resetStyle(areaLayer);
                    },
                    click() {
                      if (area.href) window.location.assign(area.href);
                    },
                  });
                },
              }
            ).addTo(map);

            rows.forEach((row) => {
              const highlight = () => {
                const layer = layersBySlug.get(row.dataset.areaSlug);
                if (layer) { layer.setStyle({weight:3, fillOpacity:.45}); layer.bringToFront(); }
              };
              const reset = () => {
                const layer = layersBySlug.get(row.dataset.areaSlug);
                if (layer) boundaryLayer.resetStyle(layer);
              };
              row.addEventListener("mouseenter", highlight);
              row.addEventListener("mouseleave", reset);
              row.addEventListener("focus", highlight);
              row.addEventListener("blur", reset);
            });
            // One-finger page scroll; two fingers can pan the mobile map.
            if (window.matchMedia("(pointer: coarse)").matches) {
              map.dragging.disable();
              mapElement.addEventListener("touchstart", (event) => {
                if (event.touches.length > 1) map.dragging.enable();
                else map.dragging.disable();
              }, {passive:true});
              mapElement.addEventListener("touchend", () => map.dragging.disable(), {passive:true});
            }
            const bounds = boundaryLayer.getBounds();

            if (bounds.isValid()) {
              map.fitBounds(bounds, {
                padding: [18, 18],
                maxZoom: 14,
              });
            } else {
              map.setView([49.1659, -123.9401], 11);
            }

            mapElement.classList.add("is-ready");

            window.addEventListener(
              "resize",
              () => map.invalidateSize(),
              { passive: true }
            );
          };

          if (window.L) {
            startMap();
            return;
          }

          const script = document.createElement("script");
          script.src = leafletJs;
          script.async = true;
          script.onload = startMap;
          document.head.appendChild(script);
        })();
      </script>
<style is:global>
