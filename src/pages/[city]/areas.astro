<script is:inline>
(() => {
  function initialise() {
    const wrapper = document.querySelector(".areas-map-resizer");
    const button = wrapper?.querySelector(".areas-resize-button");
    if (!button || button.dataset.ready) return;
    button.dataset.ready = "true";

    button.addEventListener("click", () => {
      const expanded = wrapper.classList.toggle("is-expanded");
      button.textContent = expanded ? "Collapse map −" : "Expand map +";
      button.setAttribute("aria-expanded", String(expanded));
      requestAnimationFrame(() => {
        window.dispatchEvent(new Event("resize"));
      });
    });
  }

  initialise();
  document.addEventListener("astro:page-load", initialise);
})();
</script>
<script is:inline>
(() => {
  if (window.__areasResizeClickHandler) {
    document.removeEventListener("click", window.__areasResizeClickHandler, true);
  }

  window.__areasResizeClickHandler = (event) => {
    const button = event.target.closest?.(".areas-resize-button");
    if (!button) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    const wrapper = button.closest(".areas-map-resizer");
    const canvas = wrapper?.querySelector(".areas-overview-map__canvas");
    if (!canvas) return;

    const expanded = button.getAttribute("aria-expanded") !== "true";
    wrapper.classList.toggle("is-expanded", expanded);
    button.setAttribute("aria-expanded", String(expanded));
    button.textContent = expanded ? "Collapse map −" : "Expand map +";

    canvas.style.setProperty("height", expanded ? "560px" : "300px", "important");
    canvas.style.setProperty("min-height", expanded ? "560px" : "300px", "important");

    requestAnimationFrame(() => window.dispatchEvent(new Event("resize")));
  };

  document.addEventListener("click", window.__areasResizeClickHandler, true);
})();
</script>
