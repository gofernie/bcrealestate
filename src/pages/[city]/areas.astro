    .areas-map-toggle { display:block; list-style:none; cursor:pointer; padding:12px 16px; margin-bottom:16px; border:1px solid var(--areas-line); border-radius:4px; background:var(--areas-surface); color:var(--areas-ink); text-align:center; font-size:.9rem; }
    .areas-map-toggle::-webkit-details-marker { display:none; }
    .areas-map-details:not([open]) .areas-map-open-label { display:none; }
    .areas-map-details:not([open]) .areas-map-closed-label { display:inline; }
