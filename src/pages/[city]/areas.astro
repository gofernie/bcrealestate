  .areas-map-preview__area--1 {
    top: 18%;
    left: 13%;
  }

  .areas-map-preview__area--2 {
    top: 31%;
    right: 13%;
  }

  .areas-map-preview__area--3 {
    top: 55%;
    left: 31%;
  }

  .areas-map-preview__area--4 {
    right: 21%;
