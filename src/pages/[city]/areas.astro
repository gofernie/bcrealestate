---
import { createClient } from "@supabase/supabase-js";
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { getSite } from "../../lib/getSite";
import { getNavIntentPages } from "../../lib/getNavIntentPages";

export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const city = String(
  Astro.params.city ||
  Astro.url.searchParams.get("city") ||
  "nanaimo"
)
  .toLowerCase()
  .trim();

const reservedCityRoutes = new Set([
  "404",
  "about",
  "about-bc",
  "bc",
  "buying-guide",
  "contact",
  "explore",
  "market-insights",
  "privacy",
  "terms",
  "admin",
  "api",
  "listings",
  "shortlists",
  "for",
  "learn",
  "sitemap",
  "sitemap.xml",
  "robots",
  "robots.txt",
  "favicon",
]);

const legacyMarketSuffix =
  /(?:-real-estate-market)+$/i;

if (legacyMarketSuffix.test(city)) {
  const cleanCity = city
    .replace(/(?:-real-estate-market)+$/i, "")
    .replace(/-+$/g, "")
    .trim();

  if (!cleanCity || reservedCityRoutes.has(cleanCity)) {
    return Astro.rewrite("/404");
  }

  return Astro.redirect(`/${cleanCity}/areas`, 301);
}

if (reservedCityRoutes.has(city)) {
  return Astro.rewrite("/404");
}

const cityDatabaseKeys = Array.from(
  new Set(
    city === "comox"
      ? ["comox", "courtenay", "black creek", "denman island", "union bay", "cumberland"]
      : [city, city.replace(/-/g, " ")]
  )
);

const {
  data: validCityRow,
  error: validCityError,
} = await supabase
  .from("listing_rows")
  .select("normalized_city")
  .in("normalized_city", cityDatabaseKeys)
  .limit(1)
  .maybeSingle();

if (validCityError) {
  console.error(
    "Areas city validation failed:",
    validCityError
  );
}

if (!validCityError && !validCityRow) {
  return Astro.rewrite("/404");
}

const cityLabel = city
  .replace(/-/g, " ")
  .replace(/\b\w/g, (character) => character.toUpperCase());

const site = await getSite(Astro.url.hostname, city);

const { data: listings = [], error: listingsError } =
  await supabase
    .from("listing_rows")
    .select("normalized_area")
    .in("normalized_city", cityDatabaseKeys)
    .eq("status", "A");

if (listingsError) {
  console.error("Areas listing query failed:", listingsError);
}

const { data: areaRows = [], error: areasError } =
  await supabase
    .from("area_boundaries")
    .select(`
      area_slug,
      area_name,
      short_description,
      hero_image_url
    `)
    .ilike("city", city);

if (areasError) {
  console.error("Area metadata query failed:", areasError);
}

const areaToSlug = (value) =>
  String(value || "")
    .toLowerCase()
    .replace(/^pq[\s-]+/i, "")
    .replace(/&/g, "and")
    .replace(/\//g, "-")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const titleCase = (value) =>
  String(value || "")
    .replace(/^pq[\s-]+/i, "")
    .replace(/-/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/\b\w/g, (character) => character.toUpperCase());

const areaCountMap = listings.reduce((result, listing) => {
  const slug = areaToSlug(listing.normalized_area);

  if (slug) {
    result[slug] = Number(result[slug] || 0) + 1;
  }

  return result;
}, {});

const areas = areaRows
  .map((row) => {
    const slug = areaToSlug(row.area_slug || row.area_name);

    return {
      name: titleCase(row.area_name || row.area_slug),
      slug,
      count: Number(areaCountMap[slug] || 0),
      description: String(row.short_description || "").trim(),
      image: String(row.hero_image_url || "").trim(),
    };
  })
  .filter((area) => area.slug)
  .sort(
    (a, b) =>
      b.count - a.count ||
      a.name.localeCompare(b.name)
  );

const heroImageUrl = String(
  areaRows.find((row) =>
    String(row.hero_image_url || "").trim()
  )?.hero_image_url ||
  site?.hero_image_url ||
  ""
).trim();

const safeHeroImage =
  heroImageUrl.replace(/"/g, "%22");

const topArea =
  areas[0]?.name ||
  cityLabel;

const navAreas =
  areas.map((area) => area.name);

const navIntentPages =
  await getNavIntentPages(
    supabase,
    site?.id
  );

const navTypes = [
  "house",
  "condo",
  "townhouse",
  "mobile",
  "land",
];

const accent =
  site?.accent_color ||
  "#633a98";


const findArea = (
  keywords: string[],
  fallbackIndex = 0
) => {
  const match = areas.find((area) => {
    const searchable = `${area.name} ${area.slug} ${area.description}`
      .toLowerCase();

    return keywords.some((keyword) =>
      searchable.includes(keyword)
    );
  });

  return match || areas[fallbackIndex] || areas[0] || null;
};

const skiCities = new Set([
  "fernie",
  "whistler",
  "revelstoke",
  "golden",
  "rossland",
  "kimberley",
  "invermere",
  "panorama",
  "sun-peaks",
  "big-white",
  "silver-star",
]);

const coastalCities = new Set([
  "nanaimo",
  "parksville",
  "qualicum-beach",
  "tofino",
  "ucluelet",
  "victoria",
  "saanich",
  "comox",
  "courtenay",
  "campbell-river",
  "ladysmith",
  "lantzville",
]);

const isSkiTown =
  skiCities.has(city);

const isCoastalTown =
  coastalCities.has(city);

const primaryLifestyleRecommendation =
  isSkiTown
    ? {
        eyebrow: "Mountain lifestyle",
        title: "Ski access",
        description:
          "Start close to the slopes, trails, and year-round mountain recreation.",
        icon: "mountain",
        area: findArea(
          ["alpine resort", "ski", "resort"],
          0
        ),
      }
    : isCoastalTown
      ? {
          eyebrow: "Coastal lifestyle",
          title: "Ocean and waterfront",
          description:
            "Explore communities near the ocean, beaches, marinas, and coastal trails.",
          icon: "water",
          area: findArea(
            [
              "waterfront",
              "ocean",
              "bay",
              "beach",
              "harbour",
              "harbor",
            ],
            0
          ),
        }
      : {
          eyebrow: "Outdoor lifestyle",
          title: "Parks and nature",
          description:
            "Start near trails, parks, green space, and outdoor recreation.",
          icon: "trees",
          area: findArea(
            ["park", "trail", "nature", "rural"],
            0
          ),
        };

const lifestyleRecommendations = [
  primaryLifestyleRecommendation,
  {
    eyebrow: "Everyday convenience",
    title: "Walkable living",
    description:
      "Explore neighbourhoods close to shops, restaurants, and local services.",
    icon: "walk",
    area: findArea(
      [
        "downtown",
        "old city",
        "centre",
        "center",
      ],
      1
    ),
  },
  {
    eyebrow: "Room to settle in",
    title: "Family friendly",
    description:
      "Look for quieter streets, parks, schools, and practical home layouts.",
    icon: "family",
    area: findArea(
      [
        "family",
        "west",
        "annex",
        "heights",
      ],
      2
    ),
  },
  {
    eyebrow: "Trail connections",
    title: "Bike and explore",
    description:
      "Find areas with quick access to trails, parks, and outdoor recreation.",
    icon: "bike",
    area: findArea(
      [
        "montane",
        "trail",
        "mountain",
        "park",
      ],
      3
    ),
  },
  {
    eyebrow: "A little more space",
    title: "Quiet living",
    description:
      "Browse neighbourhoods known for privacy, larger lots, and a calmer pace.",
    icon: "trees",
    area: findArea(
      [
        "ridgemont",
        "rural",
        "acreage",
        "quiet",
        "cedar",
      ],
      4
    ),
  },
  {
    eyebrow: "Compare your options",
    title: "More for your budget",
    description:
      "See where current inventory offers the widest range of homes and prices.",
    icon: "value",
    area:
      [...areas]
        .filter((area) => area.count > 0)
        .sort((a, b) => b.count - a.count)[0] ||
      areas[0] ||
      null,
  },
].filter((item) => item.area);

const featureCandidates =
  areas.filter((area) => area.count > 0);

const cityRotationValue =
  [...city].reduce(
    (total, character) =>
      total + character.charCodeAt(0),
    0
  );

const currentDayNumber =
  Math.floor(Date.now() / 86400000);

const featuredArea =
  featureCandidates.length > 0
    ? featureCandidates[
        (
          currentDayNumber +
          cityRotationValue
        ) % featureCandidates.length
      ]
    : areas[0] || null;

const areasWithListings =
  areas.filter((area) => area.count > 0).length;

const averageListingsPerArea =
  areasWithListings > 0
    ? Math.round(
        listings.length / areasWithListings
      )
    : 0;
---

<Layout
  title={`${cityLabel} Neighbourhoods and Areas`}
  description={`Explore ${cityLabel} neighbourhoods and homes for sale.`}
  accentColor={accent}
  city={city}
>
  <SiteNav
    city={city}
    site={site}
    areas={navAreas}
    types={navTypes}
    intentPages={navIntentPages}
    showAreaNav={false}
  />

  <div
    class="areas-page"
    style="--areas-accent:var(--accent, #633a98);"
  >
    <section
      class="areas-hero"
      style={
        safeHeroImage
          ? `--areas-hero-image:url("${safeHeroImage}");`
          : undefined
      }
    >
      <div class="areas-hero__shade"></div>

      <div class="areas-hero__inner">
        <div class="areas-hero__content">
          <p class="areas-eyebrow">
            {cityLabel} neighbourhoods
          </p>

          <h1>
            Explore {cityLabel}
            <br />
            by Area<span>.</span>
          </h1>

          <p class="areas-hero__copy">
            From waterfront living to family-friendly communities,
            explore neighbourhoods and find the area that fits your lifestyle.
          </p>

          <div class="areas-stats">
            <article>
              <strong>{listings.length.toLocaleString()}</strong>
              <small>Active listings</small>
            </article>

            <article>
              <strong>{areas.length}</strong>
              <small>Neighbourhoods</small>
            </article>

            <article>
              <strong>{topArea}</strong>
              <small>Most listings</small>
            </article>
          </div>
        </div>
      </div>
    </section>

    <main class="areas-main">
      <section class="areas-discovery">
        <div class="areas-heading">
          <div>
            <p class="areas-eyebrow">
              Find your fit
            </p>

            <h2>
              What matters most to you?
            </h2>
          </div>

          <p>
            Choose a lifestyle and jump to a neighbourhood
            that may be worth exploring first.
          </p>
        </div>

        <div class="areas-lifestyle-grid">
          {
            lifestyleRecommendations.map((item) => (
              <a
                class="areas-lifestyle-card"
                href={`/${city}/${item.area.slug}`}
              >
                <span
                  class={`areas-lifestyle-icon areas-lifestyle-icon--${item.icon}`}
                  aria-hidden="true"
                >
                  {
                    item.icon === "mountain"
                      ? "▲"
                      : item.icon === "water"
                        ? "≈"
                        : item.icon === "walk"
                        ? "↟"
                        : item.icon === "family"
                          ? "⌂"
                          : item.icon === "bike"
                            ? "◉"
                            : item.icon === "trees"
                              ? "♧"
                              : "$"
                  }
                </span>

                <div>
                  <small>{item.eyebrow}</small>
                  <strong>{item.title}</strong>
                  <p>{item.description}</p>
                  <b>
                    Explore {item.area.name}
                    <span aria-hidden="true">→</span>
                  </b>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      {
        featuredArea && (
          <section class="areas-featured">
            <div class="areas-featured__copy">
              <p class="areas-eyebrow">
                Featured neighbourhood today
              </p>

              <h2>{featuredArea.name}</h2>

              <p>
                {
                  featuredArea.description ||
                  `Explore current homes, local information, and market activity in ${featuredArea.name}.`
                }
              </p>

              <div class="areas-featured__stats">
                <span>
                  <strong>
                    {featuredArea.count.toLocaleString()}
                  </strong>
                  active listings
                </span>

                <span>
                  <strong>{cityLabel}</strong>
                  local area guide
                </span>
              </div>

              <a
                class="areas-button areas-button--primary"
                href={`/${city}/${featuredArea.slug}`}
              >
                Explore {featuredArea.name}
              </a>
            </div>

            <a
              class="areas-featured__visual"
              href={`/${city}/${featuredArea.slug}`}
              aria-label={`Explore ${featuredArea.name}`}
              style={
                featuredArea.image || heroImageUrl
                  ? `--featured-area-image:url("${String(
                      featuredArea.image || heroImageUrl
                    ).replace(/"/g, "%22")}");`
                  : undefined
              }
            >
              <span>{featuredArea.name}</span>
              <b aria-hidden="true">→</b>
            </a>
          </section>
        )
      }

      <section>
        <div class="areas-heading">
          <div>
            <p class="areas-eyebrow">
              Browse by area
            </p>

            <h2>
              Choose a {cityLabel} neighbourhood
            </h2>
          </div>

          <p>
            Start with an area, then explore current listings,
            property types, prices, and local information.
          </p>
        </div>

        <div class="areas-grid">
          {
            areas.map((area) => (
              <a
                class="areas-card"
                href={`/${city}/${area.slug}`}
              >
                <div>
                  <strong>{area.name}</strong>

                  <span>
                    {area.count.toLocaleString()}{" "}
                    {area.count === 1
                      ? "listing"
                      : "listings"}
                  </span>

                  {
                    area.description && (
                      <p>{area.description}</p>
                    )
                  }
                </div>

                <b aria-hidden="true">→</b>
              </a>
            ))
          }
        </div>
      </section>
      <style is:global>
/* valuable-areas-market-guide */
  .areas-market-guide {
    display: grid;
    grid-template-columns:
      minmax(280px, .78fr)
      minmax(480px, 1.22fr);
    gap: clamp(42px, 7vw, 92px);
    align-items: center;
    margin: 74px 0 84px;
    padding: clamp(34px, 5vw, 64px);
    border: 1px solid
      color-mix(
        in srgb,
        var(--areas-accent) 13%,
        transparent
      );
    border-radius: 16px;
    background:
      linear-gradient(
        135deg,
        color-mix(
          in srgb,
          var(--areas-accent) 7%,
          white
        ),
        color-mix(
          in srgb,
          var(--areas-accent) 2%,
          white
        )
      );
  }

  .areas-market-guide__intro h2 {
    max-width: 500px;
    margin: 7px 0 18px;
    font-family: Georgia, serif;
    font-size: clamp(2.15rem, 4vw, 3.6rem);
    font-weight: 500;
    line-height: .98;
    letter-spacing: -.045em;
  }

  .areas-market-guide__intro > p:not(.areas-eyebrow) {
    max-width: 500px;
    margin: 0;
    color: #625f5b;
    font-size: .93rem;
    line-height: 1.65;
  }

  .areas-market-guide__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    margin-top: 27px;
  }

  .areas-market-guide__secondary {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    color: var(--areas-ink);
    font-size: .82rem;
    font-weight: 800;
    text-decoration: none;
  }

  .areas-inventory-ranking {
    overflow: hidden;
    border: 1px solid rgba(28, 25, 23, .1);
    border-radius: 13px;
    background: rgba(255, 255, 255, .8);
    box-shadow: 0 16px 44px rgba(28, 25, 23, .055);
  }

  .areas-inventory-ranking__head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: end;
    padding: 21px 23px 18px;
    border-bottom: 1px solid rgba(28, 25, 23, .09);
  }

  .areas-inventory-ranking__head div {
    display: grid;
    gap: 3px;
  }

  .areas-inventory-ranking__head small,
  .areas-inventory-ranking__head > span {
    color: #77716b;
    font-size: .67rem;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .areas-inventory-ranking__head strong {
    font-family: Georgia, serif;
    font-size: 1.18rem;
  }

  .areas-inventory-row {
    display: grid;
    grid-template-columns:
      30px
      minmax(0, 1fr)
      auto
      18px;
    gap: 14px;
    align-items: center;
    min-height: 66px;
    padding: 11px 22px;
    border-bottom: 1px solid rgba(28, 25, 23, .075);
    color: inherit;
    text-decoration: none;
    transition:
      background .18s ease,
      transform .18s ease;
  }

  .areas-inventory-row:hover {
    background:
      color-mix(
        in srgb,
        var(--areas-accent) 6%,
        white
      );
  }

  .areas-inventory-row__rank {
    color: var(--areas-accent);
    font-family: Georgia, serif;
    font-size: .9rem;
  }

  .areas-inventory-row__details {
    display: grid;
    gap: 8px;
  }

  .areas-inventory-row__details > strong {
    font-family: Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
  }

  .areas-inventory-row__track {
    display: block;
    width: 100%;
    height: 3px;
    overflow: hidden;
    border-radius: 999px;
    background:
      color-mix(
        in srgb,
        var(--areas-accent) 9%,
        #ece9e6
      );
  }

  .areas-inventory-row__track > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--areas-accent);
    opacity: .72;
  }

  .areas-inventory-row__count {
    display: grid;
    min-width: 55px;
    justify-items: end;
  }

  .areas-inventory-row__count strong {
    color: var(--areas-ink);
    font-size: .92rem;
  }

  .areas-inventory-row__count small {
    color: #77716b;
    font-size: .62rem;
  }

  .areas-inventory-row__arrow {
    color: var(--areas-accent);
    font-size: .9rem;
  }

  .areas-inventory-ranking__note {
    margin: 0;
    padding: 13px 22px 15px;
    color: #77716b;
    font-size: .68rem;
  }

  @media (max-width: 900px) {
    .areas-market-guide {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }

  @media (max-width: 620px) {
    .areas-market-guide {
      margin: 52px 0 62px;
      padding: 26px 18px;
      border-radius: 11px;
    }

    .areas-market-guide__intro h2 {
      font-size: clamp(2rem, 11vw, 3rem);
    }

    .areas-market-guide__actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .areas-inventory-row {
      grid-template-columns:
        25px
        minmax(0, 1fr)
        auto;
      gap: 10px;
      padding: 11px 14px;
    }

    .areas-inventory-row__arrow {
      display: none;
    }

    .areas-inventory-ranking__head {
      padding: 18px 15px 15px;
    }

    .areas-inventory-ranking__note {
      padding: 12px 15px 14px;
    }
  }
</style>

      <section class="areas-market-guide">
        <div class="areas-market-guide__intro">
          <p class="areas-eyebrow">
            Live neighbourhood inventory
          </p>

          <h2>
            Where buyers have the most choice.
          </h2>

          <p>
            Inventory changes constantly. These neighbourhoods currently
            offer the widest selection of homes in {cityLabel}.
          </p>

          <div class="areas-market-guide__actions">
            <a
              class="areas-button areas-button--primary"
              href={`/explore?city=${encodeURIComponent(city)}`}
            >
              Compare everything in Explore
            </a>

            <a
              class="areas-market-guide__secondary"
              href={`/${city}/market-intelligence`}
            >
              View market intelligence
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="areas-inventory-ranking">
          <div class="areas-inventory-ranking__head">
            <div>
              <small>Most active now</small>
              <strong>Neighbourhoods by listings</strong>
            </div>

            <span>Live inventory</span>
          </div>

          <div class="areas-inventory-ranking__rows">
            {
              areas
                .filter((area) => area.count > 0)
                .slice(0, 5)
                .map((area, index) => {
                  const largestAreaCount = Math.max(
                    ...areas.map((item) => item.count),
                    1
                  );

                  const inventoryWidth = Math.max(
                    8,
                    Math.round(
                      (area.count / largestAreaCount) * 100
                    )
                  );

                  return (
                    <a
                      class="areas-inventory-row"
                      href={`/${city}/${area.slug}`}
                    >
                      <span class="areas-inventory-row__rank">
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <span class="areas-inventory-row__details">
                        <strong>{area.name}</strong>

                        <span class="areas-inventory-row__track">
                          <span
                            style={`width: ${inventoryWidth}%`}
                          ></span>
                        </span>
                      </span>

                      <span class="areas-inventory-row__count">
                        <strong>{area.count}</strong>
                        <small>
                          {area.count === 1 ? "listing" : "listings"}
                        </small>
                      </span>

                      <span
                        class="areas-inventory-row__arrow"
                        aria-hidden="true"
                      >
                        →
                      </span>
                    </a>
                  );
                })
            }
          </div>

          <p class="areas-inventory-ranking__note">
            Counts reflect active listings currently available on this site.
          </p>
        </div>
      </section>
</main>
  </div>

  <style>
    .areas-page {
      --areas-ink: #17131c;
      --areas-muted: #6d6872;
      --areas-line: rgba(45, 35, 55, 0.11);
      overflow: hidden;
