  }
</style>
<script is:inline>
(() => {
  const initialise = () => {
    const details = document.querySelector(".areas-map-details");
    if (!details || details.dataset.toggleReady) return;
    details.dataset.toggleReady = "true";
    details.addEventListener("toggle", () => {
      if (details.open) requestAnimationFrame(() => window.dispatchEvent(new Event("resize")));
    });
    const desktop = window.matchMedia("(min-width:901px)");
    desktop.addEventListener("change", () => {
      if (desktop.matches) details.open = true;
    });
  };
  initialise();
  document.addEventListener("astro:page-load", initialise);
})();
</script>
