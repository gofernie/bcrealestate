  }

  .areas-map-callout > div > p:not(.areas-eyebrow) {
    max-width: 560px;
    margin: 18px 0 26px;
    color: #68635e;
    line-height: 1.7;
  }

  .areas-map-preview {
    position: relative;
    display: grid;
    min-height: 360px;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(28, 25, 23, 0.09);
    border-radius: 16px;
    background:
      linear-gradient(
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.08) 1px,
        transparent 1px
      ),
      linear-gradient(135deg, color-mix(in srgb, var(--areas-accent) 48%, #17131c), color-mix(in srgb, var(--areas-accent) 20%, #17131c));
    background-size: 42px 42px, 42px 42px, auto;
    color: #fff;
    text-decoration: none;
  }
  .areas-map-preview::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 24% 28%,
        color-mix(in srgb, var(--areas-accent) 30%, transparent),
        transparent 24%
      ),
      radial-gradient(
        circle at 72% 66%,
        rgba(74, 133, 112, 0.26),
        transparent 27%
      );
    content: "";
  }

  .areas-map-preview__road {
    position: absolute;
    z-index: 1;
    height: 4px;
    border-radius: 999px;
    background: rgba(217, 235, 226, 0.42);
