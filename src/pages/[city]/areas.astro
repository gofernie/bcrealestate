  /* editorial-lifestyle-layout-final */
  .areas-discovery {
    position: relative;
    z-index: 0;
    margin-bottom: 0;
    padding: 52px 0 58px;
    background: transparent;
    box-shadow: none;
    clip-path: none;
  }

  .areas-discovery::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background:
      linear-gradient(
        180deg,
        color-mix(
          in srgb,
          var(--areas-accent) 5%,
          #edf1f2
        ) 0%,
        color-mix(
          in srgb,
          var(--areas-accent) 4%,
          #f3f1f2
        ) 44%,
        color-mix(
          in srgb,
          var(--areas-accent) 1.5%,
          #faf9f8
        ) 100%
      );
  }

  .areas-lifestyle-grid {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 14px;
  }

  .areas-lifestyle-card {
    min-height: 0;
    grid-column: span 3;
  }

  .areas-lifestyle-card:nth-child(-n + 2) {
    grid-column: span 6;
    min-height: 170px;
    padding: 26px;
  }

  .areas-lifestyle-card:nth-child(n + 3) {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 13px;
    padding: 18px;
  }

  .areas-lifestyle-card:nth-child(n + 3)
    .areas-lifestyle-icon {
    width: 36px;
    height: 36px;
    flex-basis: 36px;
  }

  .areas-lifestyle-card:nth-child(n + 3) small {
    font-size: .62rem;
  }

  .areas-lifestyle-card:nth-child(n + 3) strong {
    font-size: 1.08rem;
  }

  .areas-lifestyle-card:nth-child(n + 3) p {
    margin: 6px 0 9px;
    font-size: .82rem;
    line-height: 1.42;
  }

  .areas-lifestyle-card:nth-child(n + 3) b {
    font-size: .75rem;
  }

  .areas-featured {
    margin-top: 58px;
  }

  @media (max-width: 1000px) {
    .areas-lifestyle-card,
    .areas-lifestyle-card:nth-child(-n + 2) {
      grid-column: span 6;
    }
  }

  @media (max-width: 620px) {
    .areas-discovery {
      padding: 42px 0 46px;
    }

    .areas-lifestyle-card,
    .areas-lifestyle-card:nth-child(-n + 2) {
      grid-column: 1 / -1;
      min-height: 0;
      padding: 19px;
    }

    .areas-lifestyle-card:nth-child(n + 3) {
      grid-template-columns: 36px minmax(0, 1fr);
    }

    .areas-featured {
      margin-top: 44px;
    }
  }

  /* restrained-lifestyle-cards-final */

  /* Remove the assorted pastel card colours. */
  .areas-lifestyle-card,
  .areas-lifestyle-card:nth-child(3n + 1),
  .areas-lifestyle-card:nth-child(3n + 2),
  .areas-lifestyle-card:nth-child(3n) {
    background: rgba(255, 255, 255, .46);
    border-color: rgba(28, 25, 23, .11);
    box-shadow: none;
  }

  /* The two lead cards remain quietly defined. */
  .areas-lifestyle-card:nth-child(-n + 2) {
    background: rgba(255, 255, 255, .58);
    border: 1px solid rgba(28, 25, 23, .12);
  }

  /* The four supporting choices become editorial links. */
  .areas-lifestyle-card:nth-child(n + 3) {
    border: 0;
    border-top: 1px solid rgba(28, 25, 23, .16);
    border-radius: 0;
    background: transparent;
    padding: 20px 4px 14px;
  }

  .areas-lifestyle-card:hover,
  .areas-lifestyle-card:nth-child(n + 3):hover {
    background: rgba(255, 255, 255, .68);
    border-color: rgba(28, 25, 23, .2);
    box-shadow: none;
    transform: translateY(-2px);
  }

  /* Lose the candy-coloured icon circles. */
  .areas-lifestyle-icon,
  .areas-lifestyle-card:nth-child(n + 3)
    .areas-lifestyle-icon {
    width: 30px;
    height: 30px;
    flex-basis: 30px;
    border: 1px solid rgba(28, 25, 23, .14);
    border-radius: 50%;
    background: rgba(255, 255, 255, .42);
    color: #514b54;
    font-size: .78rem;
