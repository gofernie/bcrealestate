---
import { createClient } from "@supabase/supabase-js";
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { getSite } from "../../lib/getSite";
import { getNavIntentPages } from "../../lib/getNavIntentPages";


const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const city = String(Astro.params.city || "nanaimo")
  .toLowerCase()
  .trim();

const cityLabel = city
  .replace(/-/g, " ")
  .replace(/\b\w/g, (character) => character.toUpperCase());

const cityDatabaseKeys = Array.from(
  new Set([
    city,
    city.replace(/-/g, " "),
  ])
);

const requestHost =
  Astro.request.headers.get("x-forwarded-host") ||
  Astro.request.headers.get("host") ||
  "";

const requestDomain = requestHost
  .split(",")[0]
  .trim()
  .replace(/^www\./, "")
  .split(":")[0];

const localSubdomainMatch =
  requestDomain.match(/^([a-z0-9-]+)\.localhost$/);

const isLocalRequest =
  requestDomain === "localhost" ||
  requestDomain === "127.0.0.1" ||
  Boolean(localSubdomainMatch);

const inferredLocalDomain = localSubdomainMatch
  ? `${localSubdomainMatch[1]}.bc.realestate`
  : "bc.realestate";

const requestedLocalDomain = String(
  Astro.url.searchParams.get("siteDomain") ||
  inferredLocalDomain
)
  .trim()
  .toLowerCase()
  .replace(/^www\./, "");

const isNetlifyProjectDomain =
  requestDomain === "bc-realestate.netlify.app" ||
  requestDomain.endsWith("--bc-realestate.netlify.app");

const effectiveSiteDomain =
  isLocalRequest || isNetlifyProjectDomain
    ? requestedLocalDomain
    : requestDomain;

const comparisonMarketScope =
  effectiveSiteDomain === "fernie.homes"
    ? ["fernie", "nanaimo", "victoria", "campbell river", "parksville", "comox", "tofino", "kelowna"]
    : null;

const site = await getSite(effectiveSiteDomain, city);
const accent = site?.accent_color || "#2f6f73";

const { data: listings = [], error: listingsError } =
  await supabase
    .from("listing_rows")
    .select("price, normalized_area, normalized_type, listed_at, created_at")
    .in("normalized_city", cityDatabaseKeys)
    .eq("status", "A")
    .limit(1000);

if (listingsError) {
  console.error("Market intelligence query failed:", listingsError);
}

const navAreas = Array.from(
  new Set(
    listings
      .map((listing) => String(listing.normalized_area || "").trim())
      .filter(Boolean)
  )
).sort();

const navTypes = [
  "house",
  "condo",
  "townhouse",
  "mobile",
  "land",
];

const navIntentPages =
  await getNavIntentPages(supabase, site?.id);

const numericPrice = (listing) => {
  const value = Number(
    String(listing?.price ?? "")
      .replace(/[^0-9.-]/g, "")
  );

  return Number.isFinite(value) && value >= 50000
    ? value
    : 0;
};

const median = (values) => {
  const sorted = values
    .filter((value) => Number.isFinite(value) && value > 0)
    .sort((a, b) => a - b);

  if (!sorted.length) return 0;

  const middle = Math.floor(sorted.length / 2);

  return sorted.length % 2
    ? sorted[middle]
    : (sorted[middle - 1] + sorted[middle]) / 2;
};

const formatPrice = (value) =>
  value >= 1000000
    ? `$${(value / 1000000).toFixed(2).replace(/\.?0+$/, "")}M`
    : `$${Math.round(value / 1000).toLocaleString()}K`;

const titleCase = (value) =>
  String(value || "")
    .replace(/^pq[\s-]+/i, "")
    .replace(/[_-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/\b\w/g, (character) => character.toUpperCase());

const listingPrices = listings
  .map(numericPrice)
  .filter((price) => price > 0);

const activeListings = listings.length;
const medianPrice = median(listingPrices);

const sevenDaysAgo =
  Date.now() - 7 * 24 * 60 * 60 * 1000;

const newThisWeek = listings.filter((listing) => {
  const rawDate = listing.listed_at || listing.created_at;
  if (!rawDate) return false;

  const timestamp = new Date(rawDate).getTime();

  return Number.isFinite(timestamp) &&
    timestamp >= sevenDaysAgo;
}).length;

const sortedListingPrices = [
  ...listingPrices
].sort((a, b) => a - b);

const percentilePrice = (ratio) => {
  if (!sortedListingPrices.length) return 0;

  const position =
    (sortedListingPrices.length - 1) * ratio;

  const lowerIndex = Math.floor(position);
  const upperIndex = Math.ceil(position);
  const weight = position - lowerIndex;

  const lower =
    sortedListingPrices[lowerIndex];

  const upper =
    sortedListingPrices[upperIndex];

  return lower + (upper - lower) * weight;
};

const priceBandStep =
  medianPrice >= 2500000
    ? 500000
    : medianPrice >= 1200000
      ? 250000
      : medianPrice >= 700000
        ? 100000
        : 50000;

const roundPriceBand = (value) =>
  Math.max(
    priceBandStep,
    Math.round(value / priceBandStep) *
      priceBandStep
  );

const priceBreaks = [
  percentilePrice(0.2),
  percentilePrice(0.4),
  percentilePrice(0.6),
  percentilePrice(0.8),
].reduce((breaks, value) => {
  const rounded = roundPriceBand(value);
  const previous =
    breaks[breaks.length - 1] || 0;

  breaks.push(
    rounded > previous
      ? rounded
      : previous + priceBandStep
  );

  return breaks;
}, []);

const priceBandDefinitions = [
  {
    min: 0,
    max: priceBreaks[0],
  },
  {
    min: priceBreaks[0],
    max: priceBreaks[1],
  },
  {
    min: priceBreaks[1],
    max: priceBreaks[2],
  },
  {
    min: priceBreaks[2],
    max: priceBreaks[3],
  },
  {
    min: priceBreaks[3],
    max: null,
  },
];

const priceBands = priceBandDefinitions.map(
  (band) => {
    const label = band.max === null
      ? `${formatPrice(band.min)}+`
      : band.min === 0
        ? `Under ${formatPrice(band.max)}`
        : `${formatPrice(band.min)}–${formatPrice(
            band.max
          )}`;

    const params =
      new URLSearchParams();

    if (band.min > 0) {
      params.set(
        "minPrice",
        String(Math.round(band.min / 1000))
      );
    }

    if (band.max !== null) {
      params.set(
        "maxPrice",
        String(Math.round(band.max / 1000))
      );
    }

    const count = listingPrices.filter(
      (price) =>
        price >= band.min &&
        (
          band.max === null ||
          price < band.max
        )
    ).length;

    return {
      label,
      href: `/${city}?${params.toString()}`,
      count,
    };
  }
);
const maxPriceBandCount = Math.max(
  ...priceBands.map((band) => band.count),
  1
);

const propertyTypeOrder = [
  "house",
  "condo",
  "townhouse",
  "mobile",
  "land",
];

const typeLabels = {
  house: "Detached Homes",
  condo: "Condos",
  townhouse: "Townhomes",
  mobile: "Manufactured Homes",
  land: "Lots & Land",
};

const typeMap = listings.reduce((result, listing) => {
  const type = String(listing.normalized_type || "other")
    .toLowerCase()
    .trim();

  if (!result[type]) {
    result[type] = {
      type,
      count: 0,
      prices: [],
    };
  }

  result[type].count += 1;

  const price = numericPrice(listing);
  if (price) result[type].prices.push(price);

  return result;
}, {});

const typeStats = Object.values(typeMap)
  .map((item) => ({
    ...item,
    label: typeLabels[item.type] || titleCase(item.type),
    medianPrice: median(item.prices),
  }))
  .filter(
    (item) =>
      item.count > 0 &&
      propertyTypeOrder.includes(item.type)
  )
  .sort(
    (a, b) =>
      propertyTypeOrder.indexOf(a.type) -
      propertyTypeOrder.indexOf(b.type)
  );

const areaMap = listings.reduce((result, listing) => {
  const area = String(listing.normalized_area || "").trim();
  if (!area) return result;

  if (!result[area]) {
    result[area] = {
      area,
      count: 0,
      prices: [],
    };
  }

  result[area].count += 1;

  const price = numericPrice(listing);
  if (price) result[area].prices.push(price);

  return result;
}, {});

const areaStats = Object.values(areaMap)
  .map((item) => ({
    ...item,
    name: titleCase(item.area),
    medianPrice: median(item.prices),
  }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 10);

const largestType = typeStats[0];
const largestBand = [...priceBands]
  .sort((a, b) => b.count - a.count)[0];

const marketSummary = [
  `${cityLabel} currently has ${activeListings.toLocaleString()} active residential listings.`,
  medianPrice
    ? `The median asking price across current inventory is ${formatPrice(medianPrice)}.`
    : "",
  largestType
    ? `${largestType.label} make up the largest property category, with ${largestType.count.toLocaleString()} active listings.`
    : "",
  largestBand
    ? `The largest share of available inventory is currently in the ${largestBand.label} price range.`
    : "",
]
  .filter(Boolean)
  .join(" ");

const { data: monthlyRows = [], error: monthlyError } =
  await supabase
    .from("market_monthly_stats")
    .select(`
      month_start,
      new_listings, active_listings,
      sales,
      median_sold_price,
      median_single_family_sold_price,
      average_sale_to_list_ratio,
      median_days_on_market
    `)
    .in("city", cityDatabaseKeys)
    .order("month_start", { ascending: false })
    .limit(24);

if (monthlyError) {
  console.error(
    "Monthly market history query failed:",
    monthlyError
  );
}

const allMonthlyHistory = [...monthlyRows]
  .reverse()
  .map((row) => ({
    month: String(row.month_start),
    label: new Intl.DateTimeFormat("en-CA", {
      month: "short",
      year: "2-digit",
      timeZone: "UTC",
    }).format(new Date(`${row.month_start}T00:00:00Z`)),
    newListings: Number(row.new_listings || 0), activeListings: Number((row as any).active_listings || 0),
    sales: Number(row.sales || 0),
    medianSoldPrice: Number(row.median_single_family_sold_price || 0),
    saleToList: ((v: number) => (v > 0 && v <= 2 ? v * 100 : v))(Number(row.average_sale_to_list_ratio || 0)),
    medianDaysOnMarket: Number(row.median_days_on_market || 0),
  }));

/* market-comparison-v2 */
const islandMarketKeys = [
  "campbell river",
  "colwood",
  "comox",
  "duncan",
  "french creek",
  "ladysmith",
  "lantzville",
  "nanaimo",
  "parksville",
  "port alberni",
  "qualicum beach",
  "saanich",
  "tofino",
];

const mountainMarketKeys = ["fernie", "sparwood", "elkford", "nelson", "rossland", "kimberley", "columbia valley", "columbia-valley", "golden", "revelstoke", "sun peaks", "sun-peaks", "whistler"];
const isMountainPage = cityDatabaseKeys.some((cityKey) => mountainMarketKeys.includes(cityKey));

const greaterVictoriaMarketKeys = [
  "victoria",
  "saanich",
  "oak bay",
  "esquimalt",
  "view royal",
  "langford",
  "colwood",
  "central saanich",
  "sidney",
];

const isGreaterVictoriaPage = cityDatabaseKeys.some((cityKey) =>
  greaterVictoriaMarketKeys.includes(cityKey)
);
const comparisonMarketKeys = comparisonMarketScope || (
  isGreaterVictoriaPage
    ? greaterVictoriaMarketKeys : isMountainPage ? mountainMarketKeys : islandMarketKeys
);
const comparisonRegionLabel = comparisonMarketScope != null ? "BC Markets" : isGreaterVictoriaPage ? "Greater Victoria" : isMountainPage ? "BC Mountain Markets" : "Vancouver Island";
const comparisonReadLabel = comparisonMarketScope != null ? "BC market read" : isGreaterVictoriaPage ? "Greater Victoria read" : isMountainPage ? "Mountain market read" : "Island read";
const comparisonReadHeading = comparisonMarketScope != null ? "BC markets are not all moving together." : isGreaterVictoriaPage ? "Greater Victoria is not moving as one market." : isMountainPage ? "Mountain markets are not moving as one market." : "The Island is not moving as one market.";
const allComparisonKeys = [...new Set([...comparisonMarketKeys, ...islandMarketKeys, ...greaterVictoriaMarketKeys, ...mountainMarketKeys, "kelowna"])];
const nearbyMarketKeySet = new Set(comparisonMarketKeys);

const {
  data: islandMonthlyRows = [],
  error: islandMonthlyError,
} = await supabase
  .from("market_monthly_stats")
  .select(`
    city,
    month_start,
    new_listings,
    sales,
    median_single_family_sold_price,
    median_days_on_market,
    average_sale_to_list_ratio
  `)
  .in("city", allComparisonKeys)
  .not("median_days_on_market", "is", null)
  .order("month_start", { ascending: false })
  .limit(3000);

if (islandMonthlyError) {
  console.error(
    "Island market comparison query failed:",
    islandMonthlyError
  );
}

const percentChange = (
  currentValue: number,
  previousValue: number
) =>
  currentValue > 0 && previousValue > 0
    ? (
        (currentValue - previousValue) /
        previousValue
      ) * 100
    : null;

const movementSignal = (
  value: number | null,
  threshold: number,
  inverse = false
) => {
  if (value == null) return 0;

  const signal =
    value >= threshold
      ? 1
      : value <= -threshold
        ? -1
        : 0;

  return inverse ? signal * -1 : signal;
};

const marketSlug = (value: string) =>
  String(value || "")
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const marketLabel = (value: string) =>
  String(value || "")
    .replace(/\b\w/g, (character) =>
      character.toUpperCase()
    );

const islandRowsByMarket = new Map<
  string,
  any[]
>();

for (const row of islandMonthlyRows || []) {
  const marketKey = String(row.city || "")
    .trim()
    .toLowerCase();

  if (!marketKey) continue;

  const rows =
    islandRowsByMarket.get(marketKey) || [];

  rows.push({
    month: String(row.month_start || ""),
    newListings:
      Number(row.new_listings || 0),
    sales:
      Number(row.sales || 0),
    medianSoldPrice:
      Number(
        row.median_single_family_sold_price ||
        0
      ),
    medianDaysOnMarket:
      Number(row.median_days_on_market || 0),
    saleToList:
      ((v: number) => (v > 0 && v <= 2 ? v * 100 : v))(Number(row.average_sale_to_list_ratio || 0)),
  });

  islandRowsByMarket.set(marketKey, rows);
}

const islandMarketComparisons =
  allComparisonKeys
    .map((marketKey) => {
      const history = [
        ...(islandRowsByMarket.get(marketKey) ||
          []),
      ]
        .sort((a, b) =>
          a.month.localeCompare(b.month)
        )
        .slice(-15);
      if (history.length < 15) return null;
      // momentum-yoy-v1: last 3 months vs the same 3 months a year earlier
      const avgOf = (rows: any[], key: string) => { const v = rows.map((r: any) => Number(r[key] || 0)).filter((x: number) => x > 0); return v.length ? v.reduce((a: number, b: number) => a + b, 0) / v.length : 0; };
      const sumOf = (rows: any[], key: string) => rows.reduce((t: number, r: any) => t + Number(r[key] || 0), 0);
      const rollup = (rows: any[]) => ({ ...rows.at(-1), medianSoldPrice: avgOf(rows, "medianSoldPrice"), medianDaysOnMarket: Math.round(avgOf(rows, "medianDaysOnMarket")), saleToList: avgOf(rows, "saleToList"), sales: sumOf(rows, "sales"), newListings: sumOf(rows, "newListings") });
      const baseline = rollup(history.slice(0, 3));
      const latest = rollup(history.slice(-3));

      if (!latest) return null;

      const baselineAbsorption =
        baseline.newListings > 0
          ? (
              baseline.sales /
              baseline.newListings
            ) * 100
          : 0;

      const latestAbsorption =
        latest.newListings > 0
          ? (
              latest.sales /
              latest.newListings
            ) * 100
          : 0;

      const priceChange = percentChange(
        latest.medianSoldPrice,
        baseline.medianSoldPrice
      );

      const domChange =
        latest.medianDaysOnMarket -
        baseline.medianDaysOnMarket;

      const saleToListChange =
        latest.saleToList -
        baseline.saleToList;

      const absorptionChange =
        latestAbsorption -
        baselineAbsorption;

      const signals = [
        movementSignal(priceChange, 2),
        movementSignal(domChange, 5, true),
        movementSignal(
          saleToListChange,
          0.5
        ),
        movementSignal(
          absorptionChange,
          5
        ),
      ];

      const positiveSignals =
        signals.filter(
          (signal) => signal > 0
        ).length;

      const negativeSignals =
        signals.filter(
          (signal) => signal < 0
        ).length;

      const score = signals.reduce(
        (total, signal) => total + signal,
        0
      );

      let classification = "Mixed";

      if (
        positiveSignals >= 2 &&
        score >= 2
      ) {
        classification = "Heating Up";
      } else if (
        negativeSignals >= 2 &&
        score <= -2
      ) {
        classification = "Slowing Down";
      } else if (
        positiveSignals <= 1 &&
        negativeSignals <= 1
      ) {
        classification = "Steady";
      }

      const totalSales = history.reduce(
        (total, row) =>
          total + row.sales,
        0
      );

      const thinSample =
        totalSales < 30 ||
        history.filter(
          (row) =>
            row.medianSoldPrice > 0
        ).length < 3;

      const interpretation =
        classification === "Heating Up"
          ? "Multiple demand indicators strengthened over the latest three-month period."
          : classification === "Slowing Down"
            ? "Multiple indicators softened, pointing to more buyer choice and slower market pressure."
            : classification === "Steady"
              ? "Most indicators stayed within a relatively narrow range."
              : "The indicators moved in different directions, without one clear market trend.";

      return {
        key: marketKey,
        slug: marketSlug(marketKey),
        label: marketLabel(marketKey),
        href:
          `/${marketSlug(marketKey)}/market-intelligence`,
        isCurrent:
          marketSlug(marketKey) === city,
        classification,
        interpretation,
        thinSample,
        score,
        priceChange,
        domChange,
        latestSaleToList:
          latest.saleToList,
        latestAbsorption,
        totalSales,
      };
    })
    .filter(Boolean)
    .sort((a: any, b: any) =>
      b.score - a.score ||
      a.label.localeCompare(b.label)
    );
const smallMarketCities = new Set([
  "fernie",
  "sparwood",
  "elkford",
  "nelson", "revelstoke", "golden", "columbia-valley", "columbia valley", "kimberley", "rossland", "sun-peaks", "sun peaks",
]);

const usesRollingSmallMarketTrend =
  smallMarketCities.has(city);

let rawSaleRows: any[] = [];

if (usesRollingSmallMarketTrend) {
  const {
    data: importedSaleRows,
    error: importedSaleError,
  } = await supabase
    .from("market_sale_records")
    .select("sold_date, sold_price, property_sub_type, is_single_family, is_fractional")
    .in("city", cityDatabaseKeys)
    .eq("eligible_for_market_stats", true)
    .order("sold_date", {
      ascending: true,
    });

  if (importedSaleError) {
    console.error(
      "Imported market-sale lookup failed:",
      importedSaleError
    );
  }

  rawSaleRows = importedSaleRows || [];
}

let rawFractionalRows: any[] = [];
if (usesRollingSmallMarketTrend) {
  const {
    data: importedFractionalRows,
    error: importedFractionalError,
  } = await supabase
    .from("market_sale_records")
    .select("sold_date, sold_price, property_sub_type, is_single_family, is_fractional")
    .in("city", cityDatabaseKeys)
    .eq("is_fractional", true)
    .order("sold_date", { ascending: true });
  if (importedFractionalError) {
    console.error("Fractional sale lookup failed:", importedFractionalError);
  }
  rawFractionalRows = importedFractionalRows || [];
}

const typeSegmentDefs = [
  { key: "homes", label: "Homes", filter: (r: any) => !r.is_fractional && (r.is_single_family || ["Half Duplex","Fourplex"].includes(r.property_sub_type)) },
  { key: "condos", label: "Condos", filter: (r: any) => !r.is_fractional && !r.is_single_family && ["Apartment","Townhouse"].includes(r.property_sub_type) },
  { key: "mobile", label: "Mobile Homes", filter: (r: any) => !r.is_fractional && r.property_sub_type === "Manufactured Home in Park" },
  { key: "land", label: "Land", filter: (r: any) => !r.is_fractional && ["Residential Lot","Residential Acreage","Commercial Lot","Commercial Acreage","Residential Development"].includes(r.property_sub_type) },
  { key: "fractional", label: "Fractional", filter: (r: any) => r.is_fractional },
];
const allTypeRows = [
  ...rawSaleRows.map((r: any) => ({ ...r, is_fractional: false })),
  ...rawFractionalRows,
];
const typeSegments = usesRollingSmallMarketTrend
  ? typeSegmentDefs.map((seg) => {
      const segRows = allTypeRows.filter(seg.filter);
      const oneYearAgo = new Date();
      oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
      const twoYearsAgo = new Date();
      twoYearsAgo.setFullYear(twoYearsAgo.getFullYear() - 2);
      const recentRows = segRows.filter(
        (r: any) => new Date(r.sold_date) >= oneYearAgo
      );
      const priorRows = segRows.filter(
        (r: any) => new Date(r.sold_date) >= twoYearsAgo && new Date(r.sold_date) < oneYearAgo
      );
      const prices = recentRows
        .map((r: any) => Number(r.sold_price || 0))
        .filter((p: number) => p > 0);
      const medianSeg = median(prices);
      const olderMedian = median(priorRows.map((r: any) => Number(r.sold_price || 0)).filter((p: number) => p > 0));
      const newerMedian = medianSeg;
      const trendPct = (olderMedian > 0 && newerMedian > 0) ? ((newerMedian - olderMedian) / olderMedian) * 100 : null;

      return {
        key: seg.key,
        label: seg.label,
        count: recentRows.length,
        medianPrice: prices.length >= 8 ? medianSeg : null,
        trendPct,
        thinSample: prices.length < 8,
      };
    })
  : [];

const listingOnlyMarket = [
  "sparwood",
  "whistler",
].includes(city);

const monthlyHistory = listingOnlyMarket
  ? allMonthlyHistory.slice(-12)
  : allMonthlyHistory;

const trendWidth = 1000;
const trendHeight = 360;
const trendPadding = {
  top: 25,
  right: 25,
  bottom: 48,
  left: 55,
};

const trendPlotWidth =
  trendWidth - trendPadding.left - trendPadding.right;

const trendPlotHeight =
  trendHeight - trendPadding.top - trendPadding.bottom;

const trendMaximumRaw = Math.max(
  1,
  ...monthlyHistory.flatMap((row) => [
    row.newListings,
    row.sales,
  ])
);

const trendStep =
  trendMaximumRaw <= 100
    ? 20
    : trendMaximumRaw <= 250
      ? 50
      : 100;

const trendMaximum =
  Math.ceil(trendMaximumRaw / trendStep) * trendStep;

const trendX = (index) =>
  trendPadding.left +
  (
    index /
    Math.max(monthlyHistory.length - 1, 1)
  ) * trendPlotWidth;

const trendY = (value) =>
  trendPadding.top +
  trendPlotHeight -
  (Number(value || 0) / trendMaximum) * trendPlotHeight;

const trendPath = (key) =>
  monthlyHistory
    .map((row, index) => {
      const x = trendX(index).toFixed(2);
      const y = trendY(row[key]).toFixed(2);

      return `${index === 0 ? "M" : "L"} ${x} ${y}`;
    })
    .join(" ");

