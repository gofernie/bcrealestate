<!-- island-market-sorting-v1 -->
<script is:inline>
  (() => {
    const tables =
      document.querySelectorAll(".island-market-table");

    tables.forEach((table) => {
      const rows = Array.from(
        table.querySelectorAll("[data-island-market-row]")
      );

      const headerButtons = Array.from(
        table.querySelectorAll("[data-island-sort]")
      );

      const mobileSelect =
        table.previousElementSibling?.querySelector(
          "#island-market-sort"
        );

      rows.forEach((row, index) => {
        row.dataset.originalOrder = String(index);
      });

      let activeKey = "";
      let activeDirection = "";

      const getValue = (row, key) => {
        const value =
          row.dataset[
            `sort${key
              .split("-")
              .map(
                (part) =>
                  part.charAt(0).toUpperCase() +
                  part.slice(1)
              )
              .join("")}`
          ];

        if (key === "market") {
          return String(value || "");
        }

        const numericValue = Number(value);

        return Number.isFinite(numericValue)
          ? numericValue
          : -9999;
      };

      const updateButtons = () => {
        headerButtons.forEach((button) => {
          const isActive =
            button.dataset.islandSort === activeKey;

          button.classList.toggle(
            "is-active",
            isActive
          );

          button.setAttribute(
            "aria-sort",
            !isActive
              ? "none"
              : activeDirection === "asc"
              ? "ascending"
              : "descending"
          );

          const indicator =
            button.querySelector("i");

          if (indicator) {
            indicator.textContent =
              isActive
                ? activeDirection === "asc"
                  ? "↑"
                  : "↓"
                : "↕";
          }
        });
      };

      const sortRows = (key, direction) => {
        activeKey = key;
        activeDirection = direction;

        const sortedRows = [...rows].sort(
          (first, second) => {
            const firstValue =
              getValue(first, key);

            const secondValue =
              getValue(second, key);

            let result = 0;

            if (key === "market") {
              result = firstValue.localeCompare(
                secondValue
              );
            } else {
              result = firstValue - secondValue;
            }

            if (result === 0) {
              result =
                Number(first.dataset.originalOrder) -
                Number(second.dataset.originalOrder);
            }

            return direction === "asc"
              ? result
              : -result;
          }
        );

        sortedRows.forEach((row) => {
          table.appendChild(row);
        });

        updateButtons();

        if (mobileSelect) {
          mobileSelect.value =
            `${key}:${direction}`;
        }
      };

      const restoreDefault = () => {
        [...rows]
          .sort(
            (first, second) =>
              Number(first.dataset.originalOrder) -
              Number(second.dataset.originalOrder)
          )
          .forEach((row) => {
            table.appendChild(row);
          });

        activeKey = "";
        activeDirection = "";
        updateButtons();
      };

      headerButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const key =
            button.dataset.islandSort;

          const defaultDirection =
            button.dataset.defaultDirection ||
            "desc";

          const direction =
            activeKey === key
              ? activeDirection === "asc"
                ? "desc"
                : "asc"
              : defaultDirection;

          sortRows(key, direction);
        });
      });

      mobileSelect?.addEventListener(
        "change",
        () => {
          if (mobileSelect.value === "default") {
            restoreDefault();
            return;
          }

          const [key, direction] =
            mobileSelect.value.split(":");

          sortRows(key, direction);
        }
      );

      updateButtons();
    });
  })();
</script>

