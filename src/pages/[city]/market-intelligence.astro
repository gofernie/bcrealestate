---
import { createClient } from "@supabase/supabase-js";
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { getSite } from "../../lib/getSite";
import { getNavIntentPages } from "../../lib/getNavIntentPages";


const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const city = String(Astro.params.city || "nanaimo")
  .toLowerCase()
  .trim();

const cityLabel = city
  .replace(/-/g, " ")
  .replace(/\b\w/g, (character) => character.toUpperCase());

const cityDatabaseKeys = Array.from(
  new Set([
    city,
    city.replace(/-/g, " "),
  ])
);

const site = await getSite(Astro.url.hostname, city);
const accent = site?.accent_color || "#633a98";

const { data: listings = [], error: listingsError } =
  await supabase
    .from("listing_rows")
    .select("price, normalized_area, normalized_type, listed_at, created_at")
    .in("normalized_city", cityDatabaseKeys)
    .eq("status", "A")
    .limit(1000);

if (listingsError) {
  console.error("Market intelligence query failed:", listingsError);
}

const navAreas = Array.from(
  new Set(
    listings
      .map((listing) => String(listing.normalized_area || "").trim())
      .filter(Boolean)
  )
).sort();

const navTypes = [
  "house",
  "condo",
  "townhouse",
  "mobile",
  "land",
];

const navIntentPages =
  await getNavIntentPages(supabase, site?.id);

const numericPrice = (listing) => {
  const value = Number(
    String(listing?.price ?? "")
      .replace(/[^0-9.-]/g, "")
  );

  return Number.isFinite(value) && value >= 50000
    ? value
    : 0;
};

const median = (values) => {
  const sorted = values
    .filter((value) => Number.isFinite(value) && value > 0)
    .sort((a, b) => a - b);

  if (!sorted.length) return 0;

  const middle = Math.floor(sorted.length / 2);

  return sorted.length % 2
    ? sorted[middle]
    : (sorted[middle - 1] + sorted[middle]) / 2;
};

const formatPrice = (value) =>
  value >= 1000000
    ? `$${(value / 1000000).toFixed(2).replace(/\.?0+$/, "")}M`
    : `$${Math.round(value / 1000).toLocaleString()}K`;

const titleCase = (value) =>
  String(value || "")
    .replace(/^pq[\s-]+/i, "")
    .replace(/[_-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .replace(/\b\w/g, (character) => character.toUpperCase());

const listingPrices = listings
  .map(numericPrice)
  .filter((price) => price > 0);

const activeListings = listings.length;
const medianPrice = median(listingPrices);

const sevenDaysAgo =
  Date.now() - 7 * 24 * 60 * 60 * 1000;

const newThisWeek = listings.filter((listing) => {
  const rawDate = listing.listed_at || listing.created_at;
  if (!rawDate) return false;

  const timestamp = new Date(rawDate).getTime();

  return Number.isFinite(timestamp) &&
    timestamp >= sevenDaysAgo;
}).length;

const priceBands = [
  {
    label: "Under $500K",
    href: `/${city}?maxPrice=500000`,
    count: listingPrices.filter((price) => price < 500000).length,
  },
  {
    label: "$500K–$700K",
    href: `/${city}?minPrice=500000&maxPrice=700000`,
    count: listingPrices.filter(
      (price) => price >= 500000 && price < 700000
    ).length,
  },
  {
    label: "$700K–$900K",
    href: `/${city}?minPrice=700000&maxPrice=900000`,
    count: listingPrices.filter(
      (price) => price >= 700000 && price < 900000
    ).length,
  },
  {
    label: "$900K–$1.2M",
    href: `/${city}?minPrice=900000&maxPrice=1200000`,
    count: listingPrices.filter(
      (price) => price >= 900000 && price < 1200000
    ).length,
  },
  {
    label: "$1.2M+",
    href: `/${city}?minPrice=1200000`,
    count: listingPrices.filter((price) => price >= 1200000).length,
  },
];

const maxPriceBandCount = Math.max(
  ...priceBands.map((band) => band.count),
  1
);

const typeLabels = {
  house: "Homes",
  condo: "Condos",
  townhouse: "Townhomes",
  mobile: "Mobile Homes",
  land: "Lots / Land",
};

const typeMap = listings.reduce((result, listing) => {
  const type = String(listing.normalized_type || "other")
    .toLowerCase()
    .trim();

  if (!result[type]) {
    result[type] = {
      type,
      count: 0,
      prices: [],
    };
  }

  result[type].count += 1;

  const price = numericPrice(listing);
  if (price) result[type].prices.push(price);

  return result;
}, {});

const typeStats = Object.values(typeMap)
  .map((item) => ({
    ...item,
    label: typeLabels[item.type] || titleCase(item.type),
    medianPrice: median(item.prices),
  }))
  .filter((item) => item.count > 0)
  .sort((a, b) => b.count - a.count)
  .slice(0, 6);

const areaMap = listings.reduce((result, listing) => {
  const area = String(listing.normalized_area || "").trim();
  if (!area) return result;

  if (!result[area]) {
    result[area] = {
      area,
      count: 0,
      prices: [],
    };
  }

  result[area].count += 1;

  const price = numericPrice(listing);
  if (price) result[area].prices.push(price);

  return result;
}, {});

const areaStats = Object.values(areaMap)
  .map((item) => ({
    ...item,
    name: titleCase(item.area),
    medianPrice: median(item.prices),
  }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 10);

const largestType = typeStats[0];
const largestBand = [...priceBands]
  .sort((a, b) => b.count - a.count)[0];

const marketSummary = [
  `${cityLabel} currently has ${activeListings.toLocaleString()} active residential listings.`,
  medianPrice
    ? `The median asking price across current inventory is ${formatPrice(medianPrice)}.`
    : "",
  largestType
    ? `${largestType.label} make up the largest property category, with ${largestType.count.toLocaleString()} active listings.`
    : "",
  largestBand
    ? `The largest share of available inventory is currently in the ${largestBand.label} price range.`
    : "",
]
  .filter(Boolean)
  .join(" ");

const { data: monthlyRows = [], error: monthlyError } =
  await supabase
    .from("market_monthly_stats")
    .select(`
      month_start,
      new_listings,
      sales,
      median_sold_price,
      median_single_family_sold_price,
      average_sale_to_list_ratio,
      median_days_on_market
    `)
    .in("city", cityDatabaseKeys)
    .order("month_start", { ascending: false })
    .limit(24);

if (monthlyError) {
  console.error(
    "Monthly market history query failed:",
    monthlyError
  );
}

const allMonthlyHistory = [...monthlyRows]
  .reverse()
  .map((row) => ({
    month: String(row.month_start),
    label: new Intl.DateTimeFormat("en-CA", {
      month: "short",
      year: "2-digit",
      timeZone: "UTC",
    }).format(new Date(`${row.month_start}T00:00:00Z`)),
    newListings: Number(row.new_listings || 0),
    sales: Number(row.sales || 0),
    medianSoldPrice: Number(row.median_single_family_sold_price || 0),
    saleToList: Number(row.average_sale_to_list_ratio || 0),
    medianDaysOnMarket: Number(row.median_days_on_market || 0),
  }));

/* island-market-comparison-v1 */
const islandMarketKeys = [
  "campbell river",
  "colwood",
  "comox",
  "duncan",
  "french creek",
  "ladysmith",
  "lantzville",
  "nanaimo",
  "parksville",
  "port alberni",
  "qualicum beach",
  "saanich",
  "tofino",
];

const {
  data: islandMonthlyRows = [],
  error: islandMonthlyError,
} = await supabase
  .from("market_monthly_stats")
  .select(`
    city,
    month_start,
    new_listings,
    sales,
    median_single_family_sold_price,
    median_days_on_market,
    average_sale_to_list_ratio
  `)
  .in("city", islandMarketKeys)
  .not("median_days_on_market", "is", null)
  .order("month_start", { ascending: false })
  .limit(96);

if (islandMonthlyError) {
  console.error(
    "Island market comparison query failed:",
    islandMonthlyError
  );
}

const percentChange = (
  currentValue: number,
  previousValue: number
) =>
  currentValue > 0 && previousValue > 0
    ? (
        (currentValue - previousValue) /
        previousValue
      ) * 100
    : null;

const movementSignal = (
  value: number | null,
  threshold: number,
  inverse = false
) => {
  if (value == null) return 0;

  const signal =
    value >= threshold
      ? 1
      : value <= -threshold
        ? -1
        : 0;

  return inverse ? signal * -1 : signal;
};

const marketSlug = (value: string) =>
  String(value || "")
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const marketLabel = (value: string) =>
  String(value || "")
    .replace(/\b\w/g, (character) =>
      character.toUpperCase()
    );

const islandRowsByMarket = new Map<
  string,
  any[]
>();

for (const row of islandMonthlyRows || []) {
  const marketKey = String(row.city || "")
    .trim()
    .toLowerCase();

  if (!marketKey) continue;

  const rows =
    islandRowsByMarket.get(marketKey) || [];

  rows.push({
    month: String(row.month_start || ""),
    newListings:
      Number(row.new_listings || 0),
    sales:
      Number(row.sales || 0),
    medianSoldPrice:
      Number(
        row.median_single_family_sold_price ||
        0
      ),
    medianDaysOnMarket:
      Number(row.median_days_on_market || 0),
    saleToList:
      Number(
        row.average_sale_to_list_ratio || 0
      ),
  });

  islandRowsByMarket.set(marketKey, rows);
}

const islandMarketComparisons =
  islandMarketKeys
    .map((marketKey) => {
      const history = [
        ...(islandRowsByMarket.get(marketKey) ||
          []),
      ]
        .sort((a, b) =>
          a.month.localeCompare(b.month)
        )
        .slice(-4);

      if (history.length < 4) return null;

      const baseline = history[0];
      const latest = history.at(-1);

      if (!latest) return null;

      const baselineAbsorption =
        baseline.newListings > 0
          ? (
              baseline.sales /
              baseline.newListings
            ) * 100
          : 0;

      const latestAbsorption =
        latest.newListings > 0
          ? (
              latest.sales /
              latest.newListings
            ) * 100
          : 0;

      const priceChange = percentChange(
        latest.medianSoldPrice,
        baseline.medianSoldPrice
      );

      const domChange =
        latest.medianDaysOnMarket -
        baseline.medianDaysOnMarket;

      const saleToListChange =
        latest.saleToList -
        baseline.saleToList;

      const absorptionChange =
        latestAbsorption -
        baselineAbsorption;

      const signals = [
        movementSignal(priceChange, 2),
        movementSignal(domChange, 5, true),
        movementSignal(
          saleToListChange,
          0.5
        ),
        movementSignal(
          absorptionChange,
          5
        ),
      ];

      const positiveSignals =
        signals.filter(
          (signal) => signal > 0
        ).length;

      const negativeSignals =
        signals.filter(
          (signal) => signal < 0
        ).length;

      const score = signals.reduce(
        (total, signal) => total + signal,
        0
      );

      let classification = "Mixed";

      if (
        positiveSignals >= 2 &&
        score >= 2
      ) {
        classification = "Heating Up";
      } else if (
        negativeSignals >= 2 &&
        score <= -2
      ) {
        classification = "Slowing Down";
      } else if (
        positiveSignals <= 1 &&
        negativeSignals <= 1
      ) {
        classification = "Steady";
      }

      const totalSales = history.reduce(
        (total, row) =>
          total + row.sales,
        0
      );

      const thinSample =
        totalSales < 30 ||
        history.filter(
          (row) =>
            row.medianSoldPrice > 0
        ).length < 3;

      const interpretation =
        classification === "Heating Up"
          ? "Multiple demand indicators strengthened over the latest three-month period."
          : classification === "Slowing Down"
            ? "Multiple indicators softened, pointing to more buyer choice and slower market pressure."
            : classification === "Steady"
              ? "Most indicators stayed within a relatively narrow range."
              : "The indicators moved in different directions, without one clear market trend.";

      return {
        key: marketKey,
        slug: marketSlug(marketKey),
        label: marketLabel(marketKey),
        href:
          `/${marketSlug(marketKey)}/market-intelligence`,
        isCurrent:
          marketSlug(marketKey) === city,
        classification,
        interpretation,
        thinSample,
        score,
        priceChange,
        domChange,
        latestSaleToList:
          latest.saleToList,
        latestAbsorption,
        totalSales,
      };
    })
    .filter(Boolean)
    .sort((a: any, b: any) =>
      b.score - a.score ||
      a.label.localeCompare(b.label)
    );
const listingOnlyMarket = [
  "fernie",
  "sparwood",
  "whistler",
].includes(city);

const monthlyHistory = listingOnlyMarket
  ? allMonthlyHistory.slice(-12)
  : allMonthlyHistory;

const trendWidth = 1000;
const trendHeight = 360;
const trendPadding = {
  top: 25,
  right: 25,
  bottom: 48,
  left: 55,
};

const trendPlotWidth =
  trendWidth - trendPadding.left - trendPadding.right;

const trendPlotHeight =
  trendHeight - trendPadding.top - trendPadding.bottom;

const trendMaximumRaw = Math.max(
  1,
  ...monthlyHistory.flatMap((row) => [
    row.newListings,
    row.sales,
  ])
);

const trendStep =
  trendMaximumRaw <= 100
    ? 20
    : trendMaximumRaw <= 250
      ? 50
      : 100;

const trendMaximum =
  Math.ceil(trendMaximumRaw / trendStep) * trendStep;

const trendX = (index) =>
  trendPadding.left +
  (
    index /
    Math.max(monthlyHistory.length - 1, 1)
  ) * trendPlotWidth;

const trendY = (value) =>
  trendPadding.top +
  trendPlotHeight -
  (Number(value || 0) / trendMaximum) * trendPlotHeight;

const trendPath = (key) =>
  monthlyHistory
    .map((row, index) => {
      const x = trendX(index).toFixed(2);
      const y = trendY(row[key]).toFixed(2);

      return `${index === 0 ? "M" : "L"} ${x} ${y}`;
    })
    .join(" ");

const newListingsPath = trendPath("newListings");
const salesPath = trendPath("sales");

const trendTicks = Array.from(
  { length: trendMaximum / trendStep + 1 },
  (_, index) => index * trendStep
);

const trendLabelIndexes = monthlyHistory
  .map((_, index) => index)
  .filter(
    (index) =>
      index === 0 ||
      index === monthlyHistory.length - 1 ||
      index % 3 === 0
  );
const listingHistoryMonths = monthlyHistory.filter(
  (row) => row.newListings > 0
).length;

const hasListingHistory =
  listingHistoryMonths >= 6;
const reliableSalesMonths = monthlyHistory.filter(
  (row) =>
    row.sales > 0 &&
    row.medianSoldPrice > 0
).length;

const hasReliableSalesHistory =
  !listingOnlyMarket &&
  reliableSalesMonths >= 6;
const latestMonth = monthlyHistory.at(-1);

const latestSalesToNewListings =
  latestMonth?.newListings > 0
    ? (
        latestMonth.sales /
        latestMonth.newListings
      ) * 100
    : 0;

const marketBehaviourSummary = latestMonth
  ? [
      latestSalesToNewListings > 0
        ? `Sales represented ${latestSalesToNewListings.toFixed(
            0
          )}% of new listings in ${latestMonth.label}. ${
            latestSalesToNewListings < 40
              ? "New supply substantially outpaced completed sales, indicating more buyer choice and stronger competition between sellers."
              : latestSalesToNewListings < 60
                ? "New supply and completed sales were relatively balanced."
                : "Sales kept pace closely with new supply, indicating firmer demand."
          }`
        : "",
      latestMonth.medianDaysOnMarket > 0
        ? `The median sold listing spent ${latestMonth.medianDaysOnMarket.toLocaleString()} days on market.`
        : "",
      latestMonth.saleToList > 0
        ? `Properties sold for ${latestMonth.saleToList.toFixed(
            1
          )}% of asking price on average.`
        : "",
    ]
      .filter(Boolean)
      .join(" ")
  : "";

const priceHistory = monthlyHistory.filter(
  (row) => row.medianSoldPrice > 0
);

const priceValues = priceHistory.map(
  (row) => row.medianSoldPrice
);

const priceMinimumRaw = Math.min(
  ...priceValues,
  0
);

const priceMaximumRaw = Math.max(
  ...priceValues,
  1
);

const priceRangeRaw =
  priceMaximumRaw - priceMinimumRaw;

const priceTickStep =
  priceRangeRaw <= 300000
    ? 50000
    : priceRangeRaw <= 600000
      ? 100000
      : 200000;

const priceMinimum = Math.max(
  0,
  Math.floor(
    Math.min(...priceValues) / priceTickStep
  ) * priceTickStep - priceTickStep
);

const priceMaximum = Math.ceil(
  Math.max(...priceValues) / priceTickStep
) * priceTickStep + priceTickStep;

const priceY = (value) =>
  trendPadding.top +
  trendPlotHeight -
  (
    (Number(value || 0) - priceMinimum) /
    Math.max(priceMaximum - priceMinimum, 1)
  ) * trendPlotHeight;

const pricePath = priceHistory
  .map((row, index) => {
    const historyIndex =
      monthlyHistory.findIndex(
        (item) => item.month === row.month
      );

    return `${index === 0 ? "M" : "L"} ${trendX(
      historyIndex
    ).toFixed(2)} ${priceY(
      row.medianSoldPrice
    ).toFixed(2)}`;
  })
  .join(" ");

const priceAreaPath = priceHistory.length
  ? `${pricePath} L ${trendX(
      monthlyHistory.findIndex(
        (item) =>
          item.month === priceHistory.at(-1)?.month
      )
    ).toFixed(2)} ${(
      trendPadding.top + trendPlotHeight
    ).toFixed(2)} L ${trendX(
      monthlyHistory.findIndex(
        (item) =>
          item.month === priceHistory[0]?.month
      )
    ).toFixed(2)} ${(
      trendPadding.top + trendPlotHeight
    ).toFixed(2)} Z`
  : "";

const priceTicks = Array.from(
  {
    length:
      Math.floor(
        (priceMaximum - priceMinimum) /
        priceTickStep
      ) + 1
  },
  (_, index) =>
    priceMinimum + index * priceTickStep
);

const firstMedianPrice =
  priceHistory[0]?.medianSoldPrice || 0;

const latestMedianPrice =
  priceHistory.at(-1)?.medianSoldPrice || 0;

const medianPriceChange =
  firstMedianPrice > 0
    ? (
        (
          latestMedianPrice -
          firstMedianPrice
        ) /
        firstMedianPrice
      ) * 100
    : 0;

const highestMedianMonth = [...priceHistory]
  .sort(
    (a, b) =>
      b.medianSoldPrice - a.medianSoldPrice
  )[0];

const lowestMedianMonth = [...priceHistory]
  .sort(
    (a, b) =>
      a.medianSoldPrice - b.medianSoldPrice
  )[0];
const updatedLabel = new Intl.DateTimeFormat("en-CA", {
  month: "long",
  day: "numeric",
  year: "numeric",
}).format(new Date());

const seoTitle =
  `${cityLabel} Real Estate Market Trends & Statistics`;

const seoDescription =
  `Track the ${cityLabel} real estate market with active listings, median prices, sales trends, days on market, sale-to-list ratios, property types, and neighbourhood activity.`;

const canonicalUrl =
  new URL(
    Astro.url.pathname,
    Astro.url.origin
  ).href;

const socialImage =
  "https://images.unsplash.com/photo-1542903660-eedba2cda473?auto=format&fit=crop&w=1200&q=72";

const marketSeoSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: seoTitle,
      description: seoDescription,
      inLanguage: "en-CA",
      about: {
        "@id": `${canonicalUrl}#dataset`,
      },
    },
    {
      "@type": "Dataset",
      "@id": `${canonicalUrl}#dataset`,
      name: `${cityLabel} Real Estate Market Data`,
      description: seoDescription,
      url: canonicalUrl,
      inLanguage: "en-CA",
      isAccessibleForFree: true,
      spatialCoverage: {
        "@type": "Place",
        name: `${cityLabel}, British Columbia, Canada`,
      },
      keywords: [
        `${cityLabel} real estate market`,
        `${cityLabel} housing market`,
        `${cityLabel} home prices`,
        `${cityLabel} days on market`,
        `${cityLabel} real estate statistics`,
      ],
      measurementTechnique:
        "Aggregated active and sold real-estate listing records from Repliers",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumbs`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: `${cityLabel} Homes`,
          item: new URL(
            `/${city}`,
            Astro.url.origin
          ).href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Market Intelligence",
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  accentColor={accent}
  city={city}
>
  <meta
    name="description"
    content={seoDescription}
    slot="head"
  />
  <link
    rel="canonical"
    href={canonicalUrl}
    slot="head"
  />
  <meta
    name="robots"
    content="index,follow,max-image-preview:large"
    slot="head"
  />

  <meta property="og:type" content="website" slot="head" />
  <meta property="og:title" content={seoTitle} slot="head" />
  <meta
    property="og:description"
    content={seoDescription}
    slot="head"
  />
  <meta property="og:url" content={canonicalUrl} slot="head" />
  <meta property="og:image" content={socialImage} slot="head" />
  <meta
    property="og:image:alt"
    content={`${cityLabel} real estate market intelligence`}
    slot="head"
  />

  <meta
    name="twitter:card"
    content="summary_large_image"
    slot="head"
  />
  <meta name="twitter:title" content={seoTitle} slot="head" />
  <meta
    name="twitter:description"
    content={seoDescription}
    slot="head"
  />
  <meta name="twitter:image" content={socialImage} slot="head" />

  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(marketSeoSchema)}
  />
  <SiteNav
    city={city}
    site={site}
    areas={navAreas}
    types={navTypes}
    intentPages={navIntentPages}
    showAreaNav={false}
  />

  <main
    class="market-page"
    style={`--market-hero-image:url("https://images.unsplash.com/photo-1542903660-eedba2cda473?auto=format&fit=crop&w=1200&q=72")`}
  >
    <section class="market-hero">
      <div>
        <p class="eyebrow">Market intelligence</p>
        <h1>See the {cityLabel} market more clearly.</h1>
        <p class="market-hero__copy">
          A live view of active inventory, asking-price ranges,
          property types, and neighbourhood activity.
        </p>
      </div>

      <div class="market-hero__stamp">
        <span>Current snapshot</span>
        <strong>{updatedLabel}</strong>
        <small>Updated from active listing data</small>
      </div>
    </section>

    <section class="snapshot-grid" aria-label="Market snapshot">
      <article>
        <span>Active listings</span>
        <strong>{activeListings.toLocaleString()}</strong>
        <small>Currently available</small>
      </article>

      <article>
        <span>New this week</span>
        <strong>{newThisWeek.toLocaleString()}</strong>
        <small>Listed in the last 7 days</small>
      </article>

      <article>
