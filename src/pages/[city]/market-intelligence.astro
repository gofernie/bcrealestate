            const t0 = total.textContent, c0 = cap.textContent;
            const slices = [...d.querySelectorAll('.type-donut__slice')], rows = [...d.querySelectorAll('.type-donut__legend a')];
            const on = (i) => { const r = rows[i]; if (!r) return; d.classList.add('is-focus');
              slices.forEach((s, k) => s.classList.toggle('is-on', k === i)); rows.forEach((x, k) => x.classList.toggle('is-on', k === i));
              total.textContent = r.dataset.share; cap.textContent = (r.dataset.label || '').toUpperCase(); };
            const off = () => { d.classList.remove('is-focus'); slices.concat(rows).forEach((x) => x.classList.remove('is-on')); total.textContent = t0; cap.textContent = c0; };
            slices.concat(rows).forEach((el) => { const i = Number(el.dataset.idx);
              el.addEventListener('mouseenter', () => on(i)); el.addEventListener('mouseleave', off);
