---
import { createClient } from "@supabase/supabase-js";
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import AgentBrandStrip from "../../../components/AgentBrandStrip.astro";
import { getSite } from "../../../lib/getSite";

const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.SUPABASE_SERVICE_ROLE_KEY);
const city = String(Astro.params.city || "").toLowerCase().trim();

const requestHost = Astro.request.headers.get("x-forwarded-host") || Astro.request.headers.get("host") || "";
const requestDomain = requestHost.split(",")[0].trim().replace(/^www\./, "").split(":")[0];
const localSubdomainMatch = requestDomain.match(/^([a-z0-9-]+)\.localhost$/);
const isLocalRequest = requestDomain === "localhost" || requestDomain === "127.0.0.1" || Boolean(localSubdomainMatch);
const isNetlifyProjectDomain = requestDomain === "bc-realestate.netlify.app" || requestDomain.endsWith("--bc-realestate.netlify.app");
const inferredLocalDomain = localSubdomainMatch ? `${localSubdomainMatch[1]}.bc.realestate` : "bc.realestate";
const requestedLocalDomain = String(Astro.url.searchParams.get("siteDomain") || inferredLocalDomain).trim().replace(/^www\./, "");
const effectiveSiteDomain = isLocalRequest || isNetlifyProjectDomain ? requestedLocalDomain : requestDomain;

const site = await getSite(effectiveSiteDomain, city);
const accent = site?.accent_color || "#2f6f73";

let guides = [];
if (site?.id) {
  const { data } = await supabase
    .from("guide_pages")
    .select("city,slug,title,meta_description,hero_image_url,updated_at")
    .eq("site_id", site.id)
    .in("status", isLocalRequest ? ["live", "draft"] : ["live"])
    .order("updated_at", { ascending: false });
  guides = (data || []).map((g) => ({
    ...g,
    thumb: String(g.hero_image_url || "").replace(/-lg\.webp$/, "-sm.webp"),
    href: `/${g.city}/guides/${g.slug}`,
  }));
}

const cityLabel = city.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const siteName = String(site?.site_name || "").trim();
const heading = siteName ? `Local guides from ${siteName}` : `${cityLabel} local guides`;
const title = `${cityLabel} Local Guides${siteName ? ` | ${siteName}` : ""}`;
const description = `What it's really like to live in and around ${cityLabel}, written from first-hand experience${siteName ? ` by ${siteName}` : ""}.`;
---
<Layout title={title} description={description} accent={accent} site={site} city={city}>
  <SiteNav site={site} city={city} accent={accent} />
  <main style="max-width:1448px;margin:0 auto;padding:48px 24px 40px;">
    <p style="font-size:.85rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent, #2f6f73);margin:0 0 8px;">{cityLabel} local guides</p>
    <h1 style="font-family:'Instrument Serif',serif;font-weight:400;font-size:clamp(2.4rem,5vw,3.6rem);line-height:1.05;margin:0 0 16px;text-wrap:balance;">{heading}</h1>
    <p style="font-size:1.05rem;line-height:1.65;color:#4b5550;max-width:680px;margin:0 0 40px;">What it's actually like to live here: the neighbourhoods, the seasons, the local spots and the things buyers usually miss. Written from first-hand experience, not a brochure.</p>
    {guides.length > 0 ? (
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:24px;">
        {guides.map((g) => (
          <a href={g.href} style="display:block;text-decoration:none;color:inherit;background:#fff;border:1px solid #e4e0d8;border-radius:14px;overflow:hidden;">
            {g.thumb ? <img src={g.thumb} alt="" loading="lazy" decoding="async" style="display:block;width:100%;aspect-ratio:16/9;object-fit:cover;" /> : <div style="aspect-ratio:16/9;background:color-mix(in srgb, var(--accent,#2f6f73) 14%, white);"></div>}
            <div style="padding:18px 20px 20px;">
              <div style="font-weight:700;font-size:1.1rem;line-height:1.3;margin:0 0 8px;">{g.title}</div>
              {g.meta_description && <div style="font-size:.92rem;color:#5b6660;line-height:1.5;">{g.meta_description}</div>}
              <div style="margin-top:12px;font-weight:600;color:var(--accent,#2f6f73);font-size:.92rem;">Read the guide &rarr;</div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p style="color:#5b6660;">No guides yet. Check back soon.</p>
    )}
    <div style="margin-top:64px;"><AgentBrandStrip site={site} city={city} variant="contact" /></div>
  </main>
</Layout>