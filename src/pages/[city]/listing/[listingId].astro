---
import { createClient } from "@supabase/supabase-js";
import Layout from "../../../layouts/Layout.astro";
import { getSite } from "../../../lib/getSite";

export const prerender = false;

const city = String(Astro.params.city || "nanaimo").toLowerCase();
const listingId = String(Astro.params.listingId || "").trim();

const hostname = Astro.url.hostname
  .toLowerCase()
  .replace(/^www\./, "");

const siteHostname =
  hostname === "localhost" || hostname === "127.0.0.1"
    ? "bc.realestate"
    : hostname;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const site = await getSite(siteHostname, city);

let listing: any = null;

if (listingId) {
  const byMls = await supabase
    .from("listing_rows")
    .select("*")
    .eq("normalized_city", city)
    .eq("mls_number", listingId)
    .maybeSingle();

  listing = byMls.data || null;

  if (!listing) {
    const byId = await supabase
      .from("listing_rows")
      .select("*")
      .eq("normalized_city", city)
      .eq("id", listingId)
      .maybeSingle();

    listing = byId.data || null;
  }
}

if (!listing) {
  Astro.response.status = 404;
}

const titleCase = (value: string) =>
  value
    .replace(/-/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());

const formatPrice = (value: any) => {
  const number = Number(String(value || "").replace(/[^\d.]/g, ""));
  return Number.isFinite(number) && number > 0
    ? `$${number.toLocaleString("en-CA")}`
    : "Price unavailable";
};

const normalizeImage = (image: any) => {
  const value =
    image?.highRes ||
    image?.mediumRes ||
    image?.lowRes ||
    image?.url ||
    image ||
    "";

  if (!value) return "";
  if (/^https?:\/\//i.test(value)) return value;
  if (String(value).startsWith("/")) return `https://cdn.repliers.io${value}`;
  return `https://cdn.repliers.io/${value}`;
};

const rawImages = Array.isArray(listing?.images)
  ? listing.images
  : [];

const images = [
  ...rawImages.map(normalizeImage),
  normalizeImage(listing?.image_url),
].filter((value, index, array) => value && array.indexOf(value) === index);

const address =
  listing?.address ||
  listing?.full_address ||
  "Property listing";

const cityLabel = titleCase(
  listing?.normalized_city ||
  listing?.city ||
  city
);

const status = String(listing?.status || "").toUpperCase();
const isActive = status === "A" || status === "I";

const normalizedType = String(
  listing?.normalized_type ||
  listing?.property_type ||
  "house"
).toLowerCase();

const listingTypePath =
  normalizedType === "condo"
    ? "condos"
    : normalizedType === "townhouse"
    ? "townhomes"
    : normalizedType === "mobile"
    ? "mobile-homes"
    : normalizedType === "land"
    ? "land"
    : "homes";

const listingBrowserUrl =
  `/${city}/${listingTypePath}` +
  `?listing_id=${encodeURIComponent(
    listing?.mls_number ||
    listing?.id ||
    listingId
  )}`;

const listingPrice = Number(listing?.price || 0);
const listingArea = String(
  listing?.normalized_area ||
  listing?.area ||
  ""
).toLowerCase();

let similarListings: any[] = [];

if (listing) {
  let similarQuery = supabase
    .from("listing_rows")
    .select(`
      id,
      mls_number,
      address,
      price,
      beds,
      baths,
      sqft,
      normalized_city,
      normalized_area,
      normalized_type,
      image_url,
      images
    `)
    .eq("status", "A")
    .eq("normalized_city", city)
    .limit(80);

  if (normalizedType) {
    similarQuery = similarQuery.eq(
      "normalized_type",
      normalizedType
    );
  }

  const similarResult = await similarQuery;
  const currentKey = String(
    listing.mls_number ||
    listing.id ||
    ""
  );

  similarListings = (similarResult.data || [])
    .filter((candidate) => {
      const candidateKey = String(
        candidate.mls_number ||
        candidate.id ||
        ""
      );

      return candidateKey !== currentKey;
    })
    .map((candidate) => {
      const candidatePrice = Number(candidate.price || 0);
      const candidateArea = String(
        candidate.normalized_area ||
        candidate.area ||
        ""
      ).toLowerCase();

      const sameArea =
        Boolean(listingArea) &&
        candidateArea === listingArea;

      const priceDifference =
        listingPrice > 0 && candidatePrice > 0
          ? Math.abs(candidatePrice - listingPrice) /
            listingPrice
          : 1;

      return {
        ...candidate,
        similarityScore:
          (sameArea ? 100 : 0) -
          Math.min(priceDifference, 2) * 40,
      };
    })
    .sort(
      (a, b) =>
        b.similarityScore -
        a.similarityScore
    )
    .slice(0, isActive ? 4 : 6);
}

const getListingKey = (item: any) =>
  String(
    item?.mls_number ||
    item?.id ||
    ""
  );

const getListingUrl = (item: any) =>
  `/${String(
    item?.normalized_city ||
    city
  )
    .toLowerCase()
    .replace(/\s+/g, "-")}/listing/${encodeURIComponent(
      getListingKey(item)
    )}`;

const getListingImage = (item: any) => {
  const firstImage =
    item?.image_url ||
    item?.images?.[0]?.highRes ||
    item?.images?.[0]?.mediumRes ||
    item?.images?.[0]?.lowRes ||
    item?.images?.[0]?.url ||
    item?.images?.[0] ||
    "";

  return normalizeImage(firstImage);
};

const cleanedDescription = String(
  listing?.description ||
  ""
)
  .replace(/<[^>]*>/g, " ")
  .replace(/\s+/g, " ")
  .trim();

const hasMeaningfulAddress =
  String(address || "").trim().length >= 5;

const hasMeaningfulDescription =
  cleanedDescription.length >= 80;

const hasListingImage =
  images.length > 0;

const isThinListing =
  !listing ||
  !hasMeaningfulAddress ||
  !hasMeaningfulDescription ||
  !hasListingImage;

const inactiveReferenceDate = new Date(
  listing?.updated_at ||
  listing?.listed_at ||
  listing?.created_at ||
  0
);

const inactiveCutoffTime =
  Date.now() -
  180 * 24 * 60 * 60 * 1000;

const inactiveTooOld =
  !isActive &&
  (
    !Number.isFinite(
      inactiveReferenceDate.getTime()
    ) ||
    inactiveReferenceDate.getTime() <
      inactiveCutoffTime
  );

const shouldNoIndex =
  isThinListing ||
  inactiveTooOld;

const browserCacheSeconds =
  isActive ? 900 : 86400;

const staleSeconds =
  isActive ? 3600 : 604800;

Astro.response.headers.set(
  "Cache-Control",
  `public, max-age=0, s-maxage=${browserCacheSeconds}, stale-while-revalidate=${staleSeconds}`
);

Astro.response.headers.set(
  "Netlify-CDN-Cache-Control",
  `public, durable, max-age=${browserCacheSeconds}, stale-while-revalidate=${staleSeconds}`
);

const canonicalUrl =
  `${Astro.url.origin}/${city}/listing/` +
  encodeURIComponent(
    listing?.mls_number ||
    listing?.id ||
    listingId
  );

const plainDescription = cleanedDescription;

const metaDescription = listing
  ? `${formatPrice(listing.price)} — ${address}, ${cityLabel}, BC. ` +
    `${listing.beds || "—"} beds, ${listing.baths || "—"} baths` +
    `${listing.sqft ? `, ${Number(listing.sqft).toLocaleString("en-CA")} sq ft` : ""}.`
  : "Property listing not found.";

const pageTitle = listing
  ? `${address}, ${cityLabel} | ${formatPrice(listing.price)}`
  : "Property listing not found";

const schema = listing
  ? {
      "@context": "https://schema.org",
      "@type": "RealEstateListing",
      name: `${address}, ${cityLabel}`,
      url: canonicalUrl,
      description: plainDescription || metaDescription,
      image: images,
      datePosted:
        listing.listed_at ||
        listing.created_at ||
        undefined,
      offers: {
        "@type": "Offer",
        price: Number(listing.price || 0),
        priceCurrency: "CAD",
        availability: isActive
          ? "https://schema.org/InStock"
          : "https://schema.org/SoldOut",
      },
      itemOffered: {
        "@type": "Residence",
        name: address,
        address: {
          "@type": "PostalAddress",
          streetAddress: address,
          addressLocality: cityLabel,
          addressRegion: "BC",
          addressCountry: "CA",
        },
        numberOfBedrooms: Number(listing.beds || 0) || undefined,
        numberOfBathroomsTotal: Number(listing.baths || 0) || undefined,
        floorSize: listing.sqft
          ? {
              "@type": "QuantitativeValue",
              value: Number(listing.sqft),
              unitCode: "FTK",
            }
          : undefined,
      },
    }
  : null;

const accentColor = site?.accent_color || "#2f6f73";
---

<Layout title={pageTitle} city={city} accentColor={accentColor}>
  <Fragment slot="head">
    <meta name="description" content={metaDescription} />

    <meta
      name="robots"
      content={
        shouldNoIndex
          ? "noindex, follow"
          : "index, follow, max-image-preview:large"
      }
    />

    <link rel="canonical" href={canonicalUrl} />

    {images[0] && (
      <meta property="og:image" content={images[0]} />
    )}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />

    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    )}
  </Fragment>

  <main class="listing-page">
    {!listing ? (
      <section class="listing-empty">
        <p class="listing-kicker">Listing unavailable</p>
        <h1>This property could not be found.</h1>
        <p>
          It may have been removed or its listing number may have changed.
        </p>
        <a href={`/${city}`}>Browse current {cityLabel} listings</a>
      </section>
    ) : (
      <>
        <nav class="listing-back" aria-label="Breadcrumb">
          <a href={`/${city}`}>← Back to {cityLabel} listings</a>
        </nav>

        <article>
          {!isActive && (
            <section class="listing-status-banner">
              <div>
                <p class="listing-kicker">Listing update</p>
                <h2>This home is no longer available—but similar homes are.</h2>
              </div>

              <a
                href="#similar-listings"
                data-listing-event="inactive_similar_top"
              >
                See similar homes
              </a>
            </section>
          )}

          <header class:list={[
            "listing-heading",
            !isActive && "listing-heading--inactive"
          ]}>
            <div>
              <p class="listing-kicker">
                {isActive ? "For sale" : "No longer active"}
              </p>

              <h1>{address}</h1>

              <p class="listing-location">
                {cityLabel}, British Columbia
              </p>
            </div>

            <div class="listing-price">
              <span class:list={[
                !isActive && "listing-price--historical"
              ]}>
                {formatPrice(listing.price)}
              </span>

              {!isActive && (
                <small>Previous list price</small>
              )}
            </div>
          </header>

          {images.length > 0 && (
            <section class="listing-gallery" aria-label="Property photos">
              <img
                class="listing-gallery__hero"
                src={images[0]}
                alt={address}
                width="1200"
                height="800"
                fetchpriority="high"
              />

              {images.slice(1, 5).map((image) => (
                <img
                  src={image}
                  alt={`${address} property photo`}
                  width="600"
                  height="400"
                  loading="lazy"
                />
              ))}
            </section>
          )}

          <section class="listing-content">
            <div class="listing-main">
              <div class="listing-facts">
                <span><strong>{listing.beds || "—"}</strong> beds</span>
                <span><strong>{listing.baths || "—"}</strong> baths</span>

                {listing.sqft && (
                  <span>
                    <strong>
                      {Number(listing.sqft).toLocaleString("en-CA")}
                    </strong> sq ft
                  </span>
                )}

                {listing.year_built && (
                  <span>
                    Built <strong>{listing.year_built}</strong>
                  </span>
                )}
              </div>

              {plainDescription && (
                <div class="listing-description">
                  <h2>About this property</h2>
                  <p>{plainDescription}</p>
                </div>
              )}
            </div>

            <aside class:list={[
              "listing-contact",
              !isActive && "listing-contact--inactive"
            ]}>
              {isActive ? (
                <>
                  <p class="listing-kicker">Want to see more?</p>
                  <h2>Explore the complete listing</h2>
                  <p>
                    Open the full photo gallery, map, nearby amenities
                    and detailed property experience.
                  </p>

                  <a
                    class="listing-contact__primary"
                    href={listingBrowserUrl}
                    data-listing-event="active_open_browser"
                  >
                    View all photos, map & details
                  </a>

                  <a
                    class="listing-contact__secondary"
                    href={`${listingBrowserUrl}&action=question`}
                    data-listing-event="active_ask_question"
                  >
                    Ask about this property
                  </a>
                </>
              ) : (
                <>
                  <p class="listing-kicker">Keep your search moving</p>
                  <h2>Find a similar home</h2>
                  <p>
                    See active properties with a similar location,
                    property type and price range.
                  </p>

                  <a
                    class="listing-contact__primary"
                    href="#similar-listings"
                    data-listing-event="inactive_similar_sidebar"
                  >
                    See similar homes for sale
                  </a>

                  <a
                    class="listing-contact__secondary"
                    href={`/${city}`}
                    data-listing-event="inactive_browse_city"
                  >
                    Browse all {cityLabel} listings
                  </a>
                </>
              )}
            </aside>
          </section>

          {similarListings.length > 0 && (
            <section
              class="similar-listings"
              id="similar-listings"
            >
              <div class="similar-listings__heading">
                <div>
                  <p class="listing-kicker">
                    {isActive
                      ? "You may also like"
                      : "Available now"}
                  </p>

                  <h2>
                    {isActive
                      ? `Similar ${cityLabel} properties`
                      : `Homes similar to ${address}`}
                  </h2>
                </div>

                <a
                  href={`/${city}/${listingTypePath}`}
                  data-listing-event="browse_all_similar"
                >
                  View all →
                </a>
              </div>

              <div class:list={[
                "similar-listings__grid",
                !isActive &&
                  "similar-listings__grid--six"
              ]}>
                {similarListings.map((similar) => {
                  const similarImage =
                    getListingImage(similar);

                  return (
                    <a
                      class="similar-card"
                      href={getListingUrl(similar)}
                      data-listing-event={
                        isActive
                          ? "active_similar_listing"
                          : "inactive_similar_listing"
                      }
                      data-listing-id={getListingKey(similar)}
                    >
                      <div class="similar-card__image">
                        {similarImage ? (
                          <img
                            src={similarImage}
                            alt={String(
                              similar.address ||
                              "Similar property"
                            )}
                            width="640"
                            height="440"
                            loading="lazy"
                          />
                        ) : (
                          <div class="similar-card__placeholder">
                            Property photo
                          </div>
                        )}
                      </div>

                      <div class="similar-card__body">
                        <strong>
                          {formatPrice(similar.price)}
                        </strong>

                        <h3>
                          {String(
                            similar.address ||
                            "Property listing"
                          )}
                        </h3>

                        <p>
                          {[
                            similar.beds
                              ? `${similar.beds} bd`
                              : "",
                            similar.baths
                              ? `${similar.baths} ba`
                              : "",
                            similar.sqft
                              ? `${Number(
                                  similar.sqft
                                ).toLocaleString(
                                  "en-CA"
                                )} sq ft`
                              : "",
                          ]
                            .filter(Boolean)
                            .join(" · ")}
                        </p>
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          )}

          <footer class="listing-disclaimer">
            <p>
              MLS® {listing.mls_number || listing.id}
              {!isActive && " · This listing is no longer active."}
            </p>
          </footer>
        </article>
      </>
    )}
  </main>
  <script is:inline>
    document.addEventListener("click", (event) => {
      const target = event.target.closest(
        "[data-listing-event]"
      );

      if (!target) return;

      const eventName =
        target.dataset.listingEvent;

      const eventData = {
        event_category: "listing_page",
        listing_id:
          target.dataset.listingId ||
          window.location.pathname
            .split("/")
            .filter(Boolean)
            .pop() ||
          "",
        destination_url:
          target.getAttribute("href") ||
          "",
      };

      if (typeof window.gtag === "function") {
        window.gtag(
          "event",
          eventName,
          eventData
        );
      }

      if (typeof window.plausible === "function") {
        window.plausible(eventName, {
          props: eventData,
        });
      }
    });
  </script>
</Layout>

<style>
  .listing-page {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 28px 0 110px;
    color: #152536;
  }

  .listing-back {
    margin-bottom: 24px;
  }

  .listing-back a,
  .listing-empty a {
    color: var(--accent);
    font-weight: 750;
    text-decoration: none;
  }

  .listing-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 24px;
  }

  .listing-heading h1 {
    margin: 4px 0;
    font-size: clamp(2rem, 5vw, 4.4rem);
    line-height: .98;
    letter-spacing: -.055em;
  }

  .listing-kicker {
    margin: 0;
    color: var(--accent);
    font-size: .76rem;
    font-weight: 850;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .listing-location {
    margin: 8px 0 0;
    color: #65717c;
  }

  .listing-price {
    flex: 0 0 auto;
    font-size: clamp(1.7rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -.045em;
  }

  .listing-gallery {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: repeat(2, minmax(180px, 300px));
    gap: 8px;
    overflow: hidden;
    border-radius: 18px;
    background: #edf0ee;
  }

  .listing-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .listing-gallery__hero {
    grid-row: 1 / 3;
  }

  .listing-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 48px;
    margin-top: 42px;
  }

  .listing-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    padding-bottom: 28px;
    border-bottom: 1px solid #dfe5e2;
    font-size: 1.05rem;
  }

  .listing-description {
    margin-top: 30px;
  }

  .listing-description h2,
  .listing-contact h2 {
    margin: 0 0 12px;
    letter-spacing: -.035em;
  }

  .listing-description p {
    max-width: 76ch;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .listing-contact {
    align-self: start;
    padding: 26px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, #ddd);
    border-radius: 16px;
    background: color-mix(in srgb, var(--accent) 5%, white);
  }

  .listing-contact a {
    display: block;
    margin-top: 20px;
    padding: 14px 18px;
    border-radius: 10px;
    background: var(--accent);
    color: white;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
  }

  .listing-status-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 26px;
    padding: 22px 24px;
    border-radius: 14px;
    background: color-mix(
      in srgb,
      var(--accent) 9%,
      white
    );
    border: 1px solid color-mix(
      in srgb,
      var(--accent) 20%,
      #ddd
    );
  }

  .listing-status-banner h2 {
    margin: 5px 0 0;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    letter-spacing: -.035em;
  }

  .listing-status-banner a {
    flex: 0 0 auto;
    padding: 12px 18px;
    border-radius: 9px;
    background: var(--accent);
    color: white;
    font-weight: 800;
    text-decoration: none;
  }

  .listing-heading--inactive {
    opacity: .82;
  }

  .listing-price small {
    display: block;
    margin-top: 3px;
    color: #6b767e;
    font-size: .72rem;
    font-weight: 650;
    letter-spacing: .02em;
    text-align: right;
  }

  .listing-price--historical {
    color: #536069;
  }

  .listing-contact__primary,
  .listing-contact__secondary {
    display: block;
    margin-top: 14px;
    padding: 14px 16px;
    border-radius: 10px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
  }

  .listing-contact__primary {
    background: var(--accent);
    color: white;
  }

  .listing-contact__secondary {
    border: 1px solid color-mix(
      in srgb,
      var(--accent) 35%,
      #ddd
    );
    background: white;
    color: var(--accent);
  }

  .listing-contact--inactive {
    background: #f7f8f7;
  }

  .similar-listings {
    margin-top: 68px;
    padding-top: 42px;
    border-top: 1px solid #dfe5e2;
    scroll-margin-top: 30px;
  }

  .similar-listings__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }

  .similar-listings__heading h2 {
    margin: 5px 0 0;
    font-size: clamp(1.6rem, 3vw, 2.35rem);
    letter-spacing: -.045em;
  }

  .similar-listings__heading > a {
    flex: 0 0 auto;
    color: var(--accent);
    font-weight: 800;
    text-decoration: none;
  }

  .similar-listings__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .similar-listings__grid--six {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .similar-card {
    overflow: hidden;
    border: 1px solid #dfe5e2;
    border-radius: 13px;
    background: white;
    color: #152536;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .similar-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(20, 38, 52, .11);
  }

  .similar-card__image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #edf0ee;
  }

  .similar-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .similar-card:hover img {
    transform: scale(1.025);
