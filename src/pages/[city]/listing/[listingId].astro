---
import { createClient } from "@supabase/supabase-js";
import Layout from "../../../layouts/Layout.astro";
import { getSite } from "../../../lib/getSite";

export const prerender = false;

const city = String(Astro.params.city || "nanaimo").toLowerCase();
const listingId = String(Astro.params.listingId || "").trim();

const hostname = Astro.url.hostname
  .toLowerCase()
  .replace(/^www\./, "");

const siteHostname =
  hostname === "localhost" || hostname === "127.0.0.1"
    ? "bc.realestate"
    : hostname;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const site = await getSite(siteHostname, city);

let listing: any = null;

if (listingId) {
  const byMls = await supabase
    .from("listing_rows")
    .select("*")
    .eq("normalized_city", city)
    .eq("mls_number", listingId)
    .maybeSingle();

  listing = byMls.data || null;

  if (!listing) {
    const byId = await supabase
      .from("listing_rows")
      .select("*")
      .eq("normalized_city", city)
      .eq("id", listingId)
      .maybeSingle();

    listing = byId.data || null;
  }
}

if (!listing) {
  Astro.response.status = 404;
}

const titleCase = (value: string) =>
  value
    .replace(/-/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());

const formatPrice = (value: any) => {
  const number = Number(String(value || "").replace(/[^\d.]/g, ""));
  return Number.isFinite(number) && number > 0
    ? `$${number.toLocaleString("en-CA")}`
    : "Price unavailable";
};

const normalizeImage = (image: any) => {
  const value =
    image?.highRes ||
    image?.mediumRes ||
    image?.lowRes ||
    image?.url ||
    image ||
    "";

  if (!value) return "";
  if (/^https?:\/\//i.test(value)) return value;
  if (String(value).startsWith("/")) return `https://cdn.repliers.io${value}`;
  return `https://cdn.repliers.io/${value}`;
};

const rawImages = Array.isArray(listing?.images)
  ? listing.images
  : [];

const images = [
  ...rawImages.map(normalizeImage),
  normalizeImage(listing?.image_url),
].filter((value, index, array) => value && array.indexOf(value) === index);

const address =
  listing?.address ||
  listing?.full_address ||
  "Property listing";

const cityLabel = titleCase(
  listing?.normalized_city ||
  listing?.city ||
  city
);

const status = String(listing?.status || "").toUpperCase();
const isActive = status === "A" || status === "I";

const normalizedType = String(
  listing?.normalized_type ||
  listing?.property_type ||
  "house"
).toLowerCase();

const listingTypePath =
  normalizedType === "condo"
    ? "condos"
    : normalizedType === "townhouse"
    ? "townhomes"
    : normalizedType === "mobile"
    ? "mobile-homes"
    : normalizedType === "land"
    ? "land"
    : "homes";

const listingBrowserUrl =
  `/${city}/${listingTypePath}` +
  `?listing_id=${encodeURIComponent(
    listing?.mls_number ||
    listing?.id ||
    listingId
  )}`;

const canonicalUrl =
  `${Astro.url.origin}/${city}/listing/` +
  encodeURIComponent(
    listing?.mls_number ||
    listing?.id ||
    listingId
  );

const plainDescription = String(listing?.description || "")
  .replace(/<[^>]*>/g, " ")
  .replace(/\s+/g, " ")
  .trim();

const metaDescription = listing
  ? `${formatPrice(listing.price)} — ${address}, ${cityLabel}, BC. ` +
    `${listing.beds || "—"} beds, ${listing.baths || "—"} baths` +
    `${listing.sqft ? `, ${Number(listing.sqft).toLocaleString("en-CA")} sq ft` : ""}.`
  : "Property listing not found.";

const pageTitle = listing
  ? `${address}, ${cityLabel} | ${formatPrice(listing.price)}`
  : "Property listing not found";

const schema = listing
  ? {
      "@context": "https://schema.org",
      "@type": "RealEstateListing",
      name: `${address}, ${cityLabel}`,
      url: canonicalUrl,
      description: plainDescription || metaDescription,
      image: images,
      datePosted:
        listing.listed_at ||
        listing.created_at ||
        undefined,
      offers: {
        "@type": "Offer",
        price: Number(listing.price || 0),
        priceCurrency: "CAD",
        availability: isActive
          ? "https://schema.org/InStock"
          : "https://schema.org/SoldOut",
      },
      itemOffered: {
        "@type": "Residence",
        name: address,
        address: {
          "@type": "PostalAddress",
          streetAddress: address,
          addressLocality: cityLabel,
          addressRegion: "BC",
          addressCountry: "CA",
        },
        numberOfBedrooms: Number(listing.beds || 0) || undefined,
        numberOfBathroomsTotal: Number(listing.baths || 0) || undefined,
        floorSize: listing.sqft
          ? {
              "@type": "QuantitativeValue",
              value: Number(listing.sqft),
              unitCode: "FTK",
            }
          : undefined,
      },
    }
  : null;

const accentColor = site?.accent_color || "#2f6f73";
---

<Layout title={pageTitle} city={city} accentColor={accentColor}>
  <Fragment slot="head">
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    {images[0] && (
      <meta property="og:image" content={images[0]} />
    )}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />

    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    )}
  </Fragment>

  <main class="listing-page">
    {!listing ? (
      <section class="listing-empty">
        <p class="listing-kicker">Listing unavailable</p>
        <h1>This property could not be found.</h1>
        <p>
          It may have been removed or its listing number may have changed.
        </p>
        <a href={`/${city}`}>Browse current {cityLabel} listings</a>
      </section>
    ) : (
      <>
        <nav class="listing-back" aria-label="Breadcrumb">
          <a href={`/${city}`}>← Back to {cityLabel} listings</a>
        </nav>

        <article>
          <header class="listing-heading">
            <div>
              <p class="listing-kicker">
                {isActive ? "For sale" : "No longer active"}
              </p>

              <h1>{address}</h1>

              <p class="listing-location">
                {cityLabel}, British Columbia
              </p>
            </div>

            <div class="listing-price">
              {formatPrice(listing.price)}
            </div>
          </header>

          {images.length > 0 && (
            <section class="listing-gallery" aria-label="Property photos">
              <img
                class="listing-gallery__hero"
                src={images[0]}
                alt={address}
                width="1200"
                height="800"
                fetchpriority="high"
              />

              {images.slice(1, 5).map((image) => (
                <img
                  src={image}
                  alt={`${address} property photo`}
                  width="600"
                  height="400"
                  loading="lazy"
                />
              ))}
            </section>
          )}

          <section class="listing-content">
            <div class="listing-main">
              <div class="listing-facts">
                <span><strong>{listing.beds || "—"}</strong> beds</span>
                <span><strong>{listing.baths || "—"}</strong> baths</span>

                {listing.sqft && (
                  <span>
                    <strong>
                      {Number(listing.sqft).toLocaleString("en-CA")}
                    </strong> sq ft
                  </span>
                )}

                {listing.year_built && (
                  <span>
                    Built <strong>{listing.year_built}</strong>
                  </span>
                )}
              </div>

              {plainDescription && (
                <div class="listing-description">
                  <h2>About this property</h2>
                  <p>{plainDescription}</p>
                </div>
              )}
            </div>

            <aside class="listing-contact">
              <p class="listing-kicker">Interested in this home?</p>
              <h2>Get the full details</h2>
              <p>
                Ask a question, request additional information or arrange
                a private showing.
              </p>
              <a href={listingBrowserUrl}>
                View in listing browser
              </a>
            </aside>
          </section>

          <footer class="listing-disclaimer">
            <p>
              MLS® {listing.mls_number || listing.id}
              {!isActive && " · This listing is no longer active."}
            </p>
          </footer>
        </article>
      </>
    )}
  </main>
</Layout>

<style>
  .listing-page {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 28px 0 110px;
    color: #152536;
  }

  .listing-back {
    margin-bottom: 24px;
  }

  .listing-back a,
  .listing-empty a {
    color: var(--accent);
    font-weight: 750;
    text-decoration: none;
  }

  .listing-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 24px;
  }

  .listing-heading h1 {
    margin: 4px 0;
    font-size: clamp(2rem, 5vw, 4.4rem);
    line-height: .98;
    letter-spacing: -.055em;
  }

  .listing-kicker {
    margin: 0;
    color: var(--accent);
    font-size: .76rem;
    font-weight: 850;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .listing-location {
    margin: 8px 0 0;
    color: #65717c;
  }

  .listing-price {
    flex: 0 0 auto;
    font-size: clamp(1.7rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -.045em;
  }

  .listing-gallery {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: repeat(2, minmax(180px, 300px));
    gap: 8px;
    overflow: hidden;
    border-radius: 18px;
    background: #edf0ee;
  }

  .listing-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .listing-gallery__hero {
    grid-row: 1 / 3;
  }

  .listing-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 48px;
    margin-top: 42px;
  }

  .listing-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    padding-bottom: 28px;
    border-bottom: 1px solid #dfe5e2;
    font-size: 1.05rem;
  }

  .listing-description {
    margin-top: 30px;
  }

  .listing-description h2,
  .listing-contact h2 {
    margin: 0 0 12px;
    letter-spacing: -.035em;
  }

  .listing-description p {
    max-width: 76ch;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .listing-contact {
    align-self: start;
    padding: 26px;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, #ddd);
    border-radius: 16px;
    background: color-mix(in srgb, var(--accent) 5%, white);
  }

  .listing-contact a {
    display: block;
    margin-top: 20px;
    padding: 14px 18px;
    border-radius: 10px;
    background: var(--accent);
    color: white;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
  }

  .listing-disclaimer {
    margin-top: 50px;
    color: #68737b;
    font-size: .8rem;
  }

  .listing-empty {
    max-width: 700px;
    margin: 80px auto;
  }

  @media (max-width: 760px) {
    .listing-page {
      width: min(100% - 24px, 1180px);
      padding-top: 18px;
    }

    .listing-heading {
      display: block;
    }

    .listing-price {
      margin-top: 16px;
    }

    .listing-gallery {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      border-radius: 12px;
    }

    .listing-gallery img,
    .listing-gallery__hero {
      flex: 0 0 92%;
      width: 92%;
      height: auto;
      aspect-ratio: 4 / 3;
      scroll-snap-align: start;
    }

    .listing-content {
      display: block;
      margin-top: 28px;
    }

    .listing-contact {
      margin-top: 32px;
    }
  }
</style>
