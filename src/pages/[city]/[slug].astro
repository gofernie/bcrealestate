/* FIX NEARBY PROFILE CARD LAYOUT */

.nearby-profile__grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.nearby-profile__card {
  min-height: 132px;
  display: grid;
  grid-template-columns: 54px minmax(0, 1fr);
  grid-template-rows: auto 1fr;
  column-gap: 14px;
  row-gap: 5px;
  align-items: start;
  padding: 18px;
}

.nearby-profile__card::before {
  grid-column: 1;
  grid-row: 1 / span 2;
  width: 54px;
  height: 54px;
  margin: 0;
  align-self: start;
}

.nearby-profile__card h3 {
  grid-column: 2;
  grid-row: 1;
  margin: 3px 0 2px;
  min-width: 0;
  white-space: normal;
}

.nearby-profile__card p {
  grid-column: 2;
  grid-row: 2;
  margin: 0;
  min-width: 0;
  max-width: none;
  white-space: normal;
  line-height: 1.5;
}

@media (max-width: 950px) {
  .nearby-profile__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .nearby-profile__grid {
    grid-template-columns: 1fr;
  }
}


/* FINAL NEARBY PROFILE CARD POLISH */

.nearby-profile__grid {
  margin-top: 12px;
}

.nearby-profile__card {
  box-shadow: 0 10px 26px rgba(28, 25, 23, 0.06);
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    border-color 160ms ease;
}

/* Slightly larger icon */
.nearby-profile__card::before {
  width: 59px;
  height: 59px;
  -webkit-mask-size: 58%;
  mask-size: 58%;
}

/* Slightly stronger category tints */
