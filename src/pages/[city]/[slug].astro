  margin-inline: auto;
  padding-top: 24px;
}



.type-hero {
  display: grid;
  grid-template-columns: minmax(0, 0.88fr) minmax(460px, 1.12fr);
  gap: 44px;
  align-items: stretch;
  margin-bottom: 26px;
}

.type-hero__copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 390px;
