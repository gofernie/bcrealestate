}

.type-hero__eyebrow {
  margin: 0 0 16px;
  color: var(--accent);
  font-size: 0.72rem;
  font-weight: 850;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.type-hero h1 {
  max-width: 630px;
  margin: 0;
  color: var(--ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.9rem, 5vw, 5rem);
  font-weight: 500;
  letter-spacing: -0.058em;
  line-height: 0.98;
}

.type-hero h1 {
