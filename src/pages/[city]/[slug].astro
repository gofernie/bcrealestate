  let previousIndex = -1;

  try {
    previousIndex = Number(
      sessionStorage.getItem(storageKey) || "-1"
    );
  } catch {
    previousIndex = -1;
  }

  const nextIndex =
    (previousIndex + 1) % variants.length;

  try {
    sessionStorage.setItem(
      storageKey,
