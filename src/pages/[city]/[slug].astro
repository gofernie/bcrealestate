      // ============================================================
// LEAFLET MAP REPLACEMENT
// Drop this entire block in place of the Google Maps <script is:inline> block
// in [slug].astro. Remove the existing Google Maps script block entirely.
// ============================================================

// --- Load Leaflet after the initial page paint ---
let leafletLoadStarted = false;

function loadLeaflet() {
  if (window.L || leafletLoadStarted) return;

  leafletLoadStarted = true;

  const link = document.createElement("link");
  link.rel = "stylesheet";
  link.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
  document.head.appendChild(link);

  const script = document.createElement("script");
  script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
  script.async = true;

  script.onload = () => {
    window.__leafletReady = true;
  };

  document.body.appendChild(script);
}
function scheduleLeafletLoad() {
  loadLeaflet();
}

// Leaflet is loaded only when an interactive map is requested.

function waitForLeaflet(callback) {
  if (window.L) {
    callback();
    return;
  }

  loadLeaflet();

  let attempts = 0;
  const maxAttempts = 200;

  const check = () => {
    if (window.L) {
      callback();
      return;
    }

    attempts += 1;

    if (attempts < maxAttempts) {
      window.setTimeout(check, 50);
    }
  };

  check();
}

function initTypeHeroMap() {
  const heroMapEl = document.getElementById("type-hero-map");

  if (!heroMapEl || heroMapEl.dataset.mapReady === "true") {
    return;
  }

  waitForLeaflet(() => {
    if (!document.body.contains(heroMapEl)) return;

    const listingCards = Array.from(
      document.querySelectorAll(".grid .card[data-lat][data-lng]")
    );

    const points = listingCards
      .map((card) => {
        const lat = Number(card.dataset.lat || "");
        const lng = Number(card.dataset.lng || "");

        if (
          !Number.isFinite(lat) ||
          !Number.isFinite(lng) ||
          !lat ||
          !lng
        ) {
          return null;
        }

        return {
          lat,
          lng,
          price:
            card.querySelector(".price")?.textContent?.trim() || "",
          address:
            card.querySelector(".address")?.textContent?.trim() || "",
          image:
            card.dataset.image ||
            card.querySelector("img")?.src ||
            "",
          listingId:
            card.dataset.listingId ||
            card.dataset.mls ||
            "",
        };
      })
      .filter(Boolean)
      .slice(0, 60);

    if (!points.length) {
      heroMapEl.innerHTML = `
        <div style="
          height:100%;
          display:grid;
          place-items:center;
          padding:24px;
          color:#6b7280;
          font-size:.85rem;
          text-align:center;
        ">
          Map locations are not available for these listings.
        </div>
      `;
      return;
    }

    heroMapEl.dataset.mapReady = "true";

const heroMap = L.map(heroMapEl, {
  zoomControl: false,
  attributionControl: false,
  scrollWheelZoom: false,
  doubleClickZoom: true,
  dragging: !L.Browser.mobile,
  touchZoom: true,
  tap: true,
});

if (L.Browser.mobile) {
  heroMap.dragging.disable();
}

    L.tileLayer(
      "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
      {
        maxZoom: 19,
      }
    ).addTo(heroMap);

    L.control
      .zoom({
        position: "topright",
      })
      .addTo(heroMap);

    const heroMarkerIcon = L.divIcon({
      className: "",
      iconSize: [24, 24],
      iconAnchor: [12, 12],
      popupAnchor: [0, -10],
      html: `
        <div style="
          width:24px;
          height:24px;
          display:grid;
          place-items:center;
          border:3px solid rgba(255,255,255,.96);
          border-radius:50%;
          background:${accentColor};
          color:#fff;
          box-shadow:0 5px 14px rgba(18,58,90,.28);
          font-size:10px;
          font-weight:900;
        "><span style="width:6px;height:6px;border-radius:50%;background:#fff;display:block;"></span></div>
      `,
    });

    const bounds = L.latLngBounds([]);

    points.forEach((point) => {
      const marker = L.marker(
        [point.lat, point.lng],
        { icon: heroMarkerIcon }
      ).addTo(heroMap);

      marker.bindPopup(
        `
          <div style="
            width:240px;
            overflow:hidden;
            border-radius:9px;
            font-family:DM Sans,system-ui,sans-serif;
            background:#fff;
          ">
            ${
              point.image
                ? `<img
                    src="${point.image}"
                    alt="${point.address || "Listing"}"
                    style="
                      display:block;
                      width:100%;
                      height:132px;
                      object-fit:cover;
                      background:#eef1f3;
                    "
                  />`
                : ""
            }

            <div style="padding:13px 14px 14px;">
              ${
                point.price
                  ? `<strong style="
                      display:block;
                      margin-bottom:4px;
                      color:#172033;
                      font-size:1rem;
                      line-height:1.2;
                    ">${point.price}</strong>`
                  : ""
              }

              ${
                point.address
                  ? `<span style="
                      display:block;
                      margin-bottom:11px;
                      color:#687080;
                      font-size:.78rem;
                      line-height:1.4;
                    ">${point.address}</span>`
                  : ""
              }

              <a
                href="#type-listings"
                onclick="event.preventDefault();document.querySelector('[data-listing-id=&quot;${point.listingId || ""}&quot;]')?.click();"
                style="
                  display:inline-flex;
                  align-items:center;
                  justify-content:center;
                  min-height:36px;
                  padding:0 14px;
                  border-radius:6px;
                  background:${accentColor};
                  color:#fff;
                  font-size:.78rem;
                  font-weight:750;
                  text-decoration:none;
                "
              >
                View listing
              </a>
            </div>
          </div>
        `,
        {
          closeButton: true,
          offset: [0, -8],
          maxWidth: 260,
          minWidth: 240,
        }
      );


      bounds.extend([point.lat, point.lng]);
    });

    if (bounds.isValid()) {
      heroMap.fitBounds(bounds, {
        paddingTopLeft: [205, 34],
        paddingBottomRight: [34, 34],
        maxZoom: 13,
      });
    }

    setTimeout(() => {
      heroMap.invalidateSize();
    }, 150);
  });
}

function prepareTypeHeroMap() {
  const heroMapEl =
    document.getElementById("type-hero-map");

  if (
    !heroMapEl ||
    heroMapEl.dataset.mapReady === "true" ||
    heroMapEl.dataset.mapDeferred === "true"
  ) {
    return;
  }

  heroMapEl.dataset.mapDeferred = "true";

  const useFeaturedHero =
  Boolean(document.querySelector(".area-intelligence")) ||
  Boolean(document.querySelector(".type-hero"));

  if (useFeaturedHero) {
    const featuredCards = Array.from(
      document.querySelectorAll(".original-card")
    ).filter(
      (card) => card instanceof HTMLElement
    );

    const rotationKey =
      `featured-listing-index:${window.location.pathname}`;

    let previousFeaturedIndex = -1;

    try {
      previousFeaturedIndex = Number(
        sessionStorage.getItem(rotationKey) || "-1"
      );
    } catch {
      previousFeaturedIndex = -1;
    }

    const featuredIndex =
      featuredCards.length > 0
        ? (previousFeaturedIndex + 1) % featuredCards.length
        : 0;

    const featuredCard =
      featuredCards[featuredIndex] || null;

    try {
      sessionStorage.setItem(
        rotationKey,
        String(featuredIndex)
      );
    } catch {
      // Ignore storage failures.
    }

    let listingImages = [];

    if (featuredCard instanceof HTMLElement) {
      try {
        const parsedImages = JSON.parse(
          featuredCard.dataset.images || "[]"
        );

        if (Array.isArray(parsedImages)) {
          listingImages = [
            ...new Set(
              parsedImages
                .map((image) =>
                  String(image || "").trim()
                )
                .filter(Boolean)
            ),
          ];
        }
      } catch (error) {
        console.warn(
          "Could not parse featured listing images:",
          error
        );
      }
    }

    const savedNeighbourhoodImage =
      heroMapEl.dataset.areaHeroImage?.trim() || "";

    const fallbackImage =
      listingImages[0] ||
      savedNeighbourhoodImage ||
      "/images/maps/nanaimo-static-map.png";

    // All collage images belong to one featured listing.
    const imageOne =
      listingImages[0] ||
      savedNeighbourhoodImage ||
      fallbackImage;

    const normalizeComparableImage = (value) =>
      String(value || "")
        .trim()
        .replace(/[?#].*$/, "");

    const mainImageKey =
      normalizeComparableImage(imageOne);

    const supportingImages = [
      ...new Set(
        listingImages
          .filter(Boolean)
          .filter(
            (image) =>
              normalizeComparableImage(image) !==
              mainImageKey
          )
      ),
    ];

    const imageTwo =
      supportingImages[0] ||
      imageOne;

    const imageThree =
      supportingImages[1] ||
      supportingImages[0] ||
      imageOne;

    const featuredBadges = [];

    if (featuredCard instanceof HTMLElement) {
      const listedAtValue =
        featuredCard.dataset.listedAt || "";

      const listedAt = listedAtValue
        ? new Date(listedAtValue)
        : null;

      if (listedAt && Number.isFinite(listedAt.getTime())) {
        const ageDays =
          (Date.now() - listedAt.getTime()) / 86400000;

        if (ageDays >= 0 && ageDays < 1) {
          featuredBadges.push({
            label: "New today",
            className: "new",
          });
        } else if (ageDays >= 0 && ageDays < 7) {
          featuredBadges.push({
            label: "New this week",
            className: "new",
