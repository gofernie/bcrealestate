.bc-save-search {
  --bc-home-accent: var(--accent);
  --bc-ink: var(--ink);
  --bc-muted: var(--muted);
  --bc-line: var(--line);

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin: 18px 0 26px;
  padding: 20px 22px;
  border: 1px solid
    color-mix(
      in srgb,
      var(--bc-home-accent) 20%,
      var(--bc-line)
    );
  border-radius: 12px;
  background:
    color-mix(
      in srgb,
      var(--bc-home-accent) 5%,
      white
    );
}

.bc-save-search__copy {
  min-width: 0;
}

.bc-save-search__eyebrow {
  margin: 0 0 4px;
  color: var(--bc-home-accent);
  font-size: 0.66rem;
  font-weight: 850;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.bc-save-search h3 {
  margin: 0;
  font-family:
    var(--serif, Georgia, serif);
  font-size: 1.35rem;
  font-weight: 500;
  line-height: 1.15;
}

.bc-save-search__copy > p:last-child {
  margin: 6px 0 0;
  color: var(--bc-muted);
  font-size: 0.8rem;
  line-height: 1.45;
}

.bc-save-search__button,
.bc-save-search__submit {
  min-height: 44px;
  padding: 0 20px;
  border: 0;
  border-radius: 8px;
  background: var(--bc-home-accent);
  color: #fff;
  font: inherit;
  font-size: 0.78rem;
  font-weight: 850;
  white-space: nowrap;
  cursor: pointer;
}

.bc-save-search__button:hover,
.bc-save-search__submit:hover {
  filter: brightness(0.94);
}

.bc-save-search__panel {
  grid-column: 1 / -1;
  padding-top: 18px;
  border-top: 1px solid var(--bc-line);
}

.bc-save-search__panel[hidden] {
  display: none;
}

.bc-save-search:has(
  .bc-save-search__panel:not([hidden])
) {
  display: grid;
  grid-template-columns: 1fr auto;
}

.bc-save-search__contact {
  display: flex;
  align-items: end;
  gap: 12px;
}

.bc-save-search__contact label {
  flex: 1;
}

.bc-save-search__contact label > span,
.bc-save-search__frequency legend,
.bc-save-search__channel legend {
  display: block;
  margin-bottom: 7px;
  color: var(--bc-ink);
  font-size: 0.74rem;
  font-weight: 800;
}

.bc-save-search__contact input {
  width: 100%;
  height: 46px;
  padding: 0 13px;
  border: 1px solid var(--bc-line);
  border-radius: 8px;
  outline: 0;
  background: #fff;
  color: var(--bc-ink);
  font: inherit;
}

.bc-save-search__contact input:focus {
  border-color: var(--bc-home-accent);
}

.bc-save-search__or {
  padding-bottom: 14px;
  color: var(--bc-muted);
  font-size: 0.74rem;
}

.bc-save-search__frequency,
.bc-save-search__channel {
  display: flex;
  gap: 22px;
  margin: 20px 0 0;
  padding: 0;
  border: 0;
}

.bc-save-search__frequency label,
.bc-save-search__channel label {
  display: flex;
  align-items: start;
  gap: 8px;
  cursor: pointer;
}

.bc-save-search__channel label {
  align-items: center;
  font-size: 0.78rem;
  font-weight: 750;
}

.bc-save-search__frequency small {
  display: block;
  margin-top: 2px;
  color: var(--bc-muted);
  font-size: 0.68rem;
  font-weight: 400;
}

.bc-save-search__channel input {
  accent-color: var(--bc-home-accent);
}

.bc-save-search__submit {
  min-height: 46px;
  margin-top: 20px;
  padding-inline: 22px;
}

@media (max-width: 600px) {
  .bc-save-search,
  .bc-save-search:has(
    .bc-save-search__panel:not([hidden])
  ) {
    align-items: stretch;
    flex-direction: column;
    gap: 15px;
    padding: 18px;
  }

  .bc-save-search__button,
  .bc-save-search__submit {
    width: 100%;
  }

  .bc-save-search__contact,
  .bc-save-search__frequency {
    align-items: stretch;
    flex-direction: column;
  }

  .bc-save-search__or {
    padding: 0;
    text-align: center;
  }

  .bc-save-search__frequency {
    gap: 12px;
  }
}

    
