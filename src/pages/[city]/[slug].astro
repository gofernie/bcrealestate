  );


  const bedsLabel =
    filters.beds === "all"
      ? ""
      : `${filters.beds}+ Bed`;

  const typeLabel =
    filters.type === "all"
      ? "Homes"
      : filters.type === "house"
        ? "Homes"
        : jsTitleCase(`${filters.type}s`);

  const priceLabel =
    filters.price === "all"
      ? ""
      : priceSelect.options[priceSelect.selectedIndex].text;

  heading.textContent = [
    cityLabel,
    bedsLabel,
    typeLabel,
    priceLabel,
  ].filter(Boolean).join(" ");
}

function submitFilters() {
  const filters = getCurrentFilters();
  const cards = Array.from(document.querySelectorAll(".original-card"));
  const filteredCards = getFilteredCards();

  const filteredSet = new Set(filteredCards);

  cards.forEach((card) => {
