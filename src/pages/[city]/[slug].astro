if (areaIntelligenceSection && intentMapEl) {
  const initializeVisibleAreaMap = () => {
    intentMapEl.hidden = false;

    waitForLeaflet(() => {
      initLeafletMap();

      window.setTimeout(() => {
        leafletMap?.invalidateSize();
      }, 100);
    });
  };

  if ("IntersectionObserver" in window) {
    const areaMapObserver = new IntersectionObserver(
      (entries, observer) => {
        const isNearViewport =
          entries.some((entry) => entry.isIntersecting);

        if (!isNearViewport) return;

        observer.disconnect();
        initializeVisibleAreaMap();
      },
      {
        rootMargin: "300px 0px",
        threshold: 0.01,
      }
    );

    areaMapObserver.observe(areaIntelligenceSection);
  } else {
    initializeVisibleAreaMap();
  }
}

