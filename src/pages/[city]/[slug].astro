---
import { createClient } from "@supabase/supabase-js";
import Layout from "../../layouts/Layout.astro";
import SlugSaveSearch from "../../components/SlugSaveSearch.astro";
import IntentModalController from "../../components/IntentModalController.astro";
import SiteNav from "../../components/SiteNav.astro";
import { getSite } from "../../lib/getSite";
import "../../styles/intent-modal.css";
import "../../styles/area-page.css";
import "../../styles/page-hero.css";
import RelatedIntentCards from "../../components/RelatedIntentCards.astro";
import { getNavIntentPages } from "../../lib/getNavIntentPages";
import MobileHomeAreaPage from "../../components/sites/MobileHomeAreaPage.astro";
export const prerender = false;
const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);



const phaseTimingStartedAt = performance.now();
let previousPhaseTiming = phaseTimingStartedAt;

const phaseTimingResults: Array<{
  label: string;
  durationMs: number;
  totalMs: number;
}> = [];

function logPhaseTiming(label: string) {
  const now = performance.now();

  const durationMs = now - previousPhaseTiming;
  const totalMs = now - phaseTimingStartedAt;

  phaseTimingResults.push({
    label,
    durationMs: Number(durationMs.toFixed(1)),
    totalMs: Number(totalMs.toFixed(1)),
  });

  console.log(
    `[PHASE TIMING] ${city}/${slug} | ${label}: ${
      durationMs.toFixed(1)
    }ms | total=${totalMs.toFixed(1)}ms`
  );

  previousPhaseTiming = now;
}

const isInternalRootRewrite =
  Astro.url.searchParams.get("root_rewrite") === "1";

const rootPathSlug = Astro.url.pathname
  .split("/")
  .filter(Boolean)[0] || "";

const city = isInternalRootRewrite
  ? "nanaimo"
  : Astro.params.city || "nanaimo";

const slug = isInternalRootRewrite
  ? rootPathSlug
  : Astro.params.slug || "";

const requestHostname = Astro.url.hostname
  .toLowerCase()
  .replace(/^www\./, "");

const siteHostname =
  requestHostname === "localhost" ||
  requestHostname === "127.0.0.1"
   ? "bc.realestate"
    : requestHostname;

const repeatedMarketSuffix =
  /(?:-real-estate-market){2,}$/i;

if (repeatedMarketSuffix.test(city)) {
  const cleanCity = city
    .replace(/(?:-real-estate-market)+$/i, "")
    .trim();

  return Astro.redirect(
    `/market-insights?city=${encodeURIComponent(cleanCity)}`,
    301
  );
}

const site = await getSite(siteHostname, city);
const sharedListingId =
  String(
    Astro.url.searchParams.get("listing_id") || ""
  ).trim();

let sharedListing = null;

if (sharedListingId) {
  const {
    data,
    error: sharedListingError,
  } = await supabase
    .from("listing_rows")
    .select(`
      id,
      mls_number,
      address,
      price,
      beds,
      baths,
      sqft,
      normalized_city,
      normalized_type,
      image_url,
      images
    `)
    .or(
      `id.eq.${sharedListingId},mls_number.eq.${sharedListingId}`
    )
    .eq("status", "A")
    .maybeSingle();

  if (sharedListingError) {
    console.error(
      "Could not load shared listing metadata:",
      sharedListingError
    );
  }

  sharedListing = data || null;
}
const isMobileHomeSite =
  site?.template === "mobile-homes" ||
  siteHostname === "nanaimomobiles.com";
const usesRootPageUrls =
  siteHostname === "nanaimomobiles.com";

const buildContentHref = (
  pageSlug: string,
  pageType: "intent" | "area" = "intent"
) => {
  if (usesRootPageUrls) {
    return `/${pageSlug}`;
  }

  return pageType === "area"
    ? `/${city}/areas/${pageSlug}`
    : `/${city}/${pageSlug}`;
};
// Root URL handling is now performed by Netlify rewrites.
// No browser redirects are needed here.

const accentColor =
  site?.accent_color ||
  "#2f6f73";

let pageQuery = supabase
  .from("intent_pages")
  .select("*")
  .eq("slug", slug)
  .eq("city", city);

if (site?.id) {
  pageQuery =
    pageQuery.eq("site_id", site.id);
} else {
  pageQuery =
    pageQuery.is("site_id", null);
}

let { data: page } =
  await pageQuery.maybeSingle();

let pageKind = "intent";

if (!page) {
  const typePageMap: Record<string, {
    property_type: string;
    label: string;
    singular: string;
  }> = {
    homes: {
      property_type: "house",
      label: "Homes",
      singular: "home",
    },
    houses: {
      property_type: "house",
      label: "Homes",
      singular: "home",
    },
    condos: {
      property_type: "condo",
      label: "Condos",
      singular: "condo",
    },
    condo: {
      property_type: "condo",
      label: "Condos",
      singular: "condo",
    },
    townhomes: {
      property_type: "townhouse",
      label: "Townhomes",
      singular: "townhome",
    },
    townhouses: {
      property_type: "townhouse",
      label: "Townhomes",
      singular: "townhome",
    },
    "mobile-homes": {
      property_type: "mobile",
      label: "Mobile Homes",
      singular: "mobile home",
    },
    mobiles: {
      property_type: "mobile",
      label: "Mobile Homes",
      singular: "mobile home",
    },
    land: {
      property_type: "land",
      label: "Land",
      singular: "property",
    },
    lots: {
      property_type: "land",
      label: "Land",
      singular: "property",
    },
  };

  const typePage = typePageMap[String(slug).toLowerCase()];

  if (typePage) {
    pageKind = "intent";

    const cityLabel =
      city.charAt(0).toUpperCase() +
      city.slice(1).toLowerCase();

    page = {
      id: `type-${city}-${slug}`,
      slug,
      city,
      area: null,
      property_type: typePage.property_type,

      hero_heading:
        typePage.property_type === "condo"
          ? `${cityLabel} Condos worth a closer look`
          : `${cityLabel} ${typePage.label}`,

      eyebrow: `${cityLabel} Real Estate`,

      intro_copy:
        `Browse every ${typePage.singular} currently for sale in ${cityLabel}. Compare pricing, features, locations and new opportunities as they reach the market.`,

      seo_title:
        `${cityLabel} ${typePage.label} for Sale`,

      meta_description:
        `Browse ${typePage.label.toLowerCase()} for sale in ${cityLabel}. Compare active MLS| listings, prices, features and locations.`,

      seo_heading:
        `${cityLabel} ${typePage.label}`,

      seo_intro:
        `Explore ${cityLabel} ${typePage.label.toLowerCase()} currently available on the MLS|. Compare listings, pricing, features and locations while monitoring new opportunities as they come to market.`,

      seo_body: "",
      seo_long: "",

      hero_image_url: null,
      default_sort: "price-asc",

      price_min: null,
      price_max: null,

      waterfront_type: null,
      requires_waterfront: false,
      requires_ocean_view: false,

      polygon_geojson: null,
      faq_json: [],
    };
  } else {
    const { data: areaPage } = await supabase
  .from("area_boundaries")
  .select("*")
  .eq("city", city)
  .eq("area_slug", slug)
  .maybeSingle();

if (!areaPage) {
  return Astro.redirect("/404");
}

/*
 * Look for copy that belongs specifically to the current site.
 * Shared geography still comes from area_boundaries.
 */
let siteAreaPage: any = null;

if (site?.id && areaPage?.id) {
  const { data: overrideRow } = await supabase
    .from("site_area_pages")
    .select("*")
    .eq("site_id", site.id)
    .eq("area_boundary_id", areaPage.id)
    .eq("is_published", true)
    .maybeSingle();

  siteAreaPage = overrideRow || null;
}

const areaContent = {
  ...areaPage,

  hero_heading:
    siteAreaPage?.hero_heading ??
    areaPage.hero_heading,

  eyebrow:
    siteAreaPage?.eyebrow ??
    null,

  intro_copy:
    siteAreaPage?.intro_copy ??
    areaPage.intro_copy,

  seo_title:
    siteAreaPage?.seo_title ??
    areaPage.seo_title,

  meta_description:
    siteAreaPage?.meta_description ??
    areaPage.meta_description,

  seo_heading:
    siteAreaPage?.seo_heading ??
    areaPage.seo_heading,

  seo_intro:
    siteAreaPage?.seo_intro ??
    areaPage.short_description,

  seo_body:
    siteAreaPage?.seo_body ??
    areaPage.intro_copy,

  seo_long:
    siteAreaPage?.seo_long ??
    areaPage.seo_long,

  neighbourhood_copy:
    siteAreaPage?.neighbourhood_copy ??
    areaPage.neighbourhood_copy,

  market_commentary:
    siteAreaPage?.market_commentary ??
    null,

  market_snapshot_ai:
    siteAreaPage?.market_snapshot_ai ??
    areaPage.market_snapshot_ai,

  buyer_insight_ai:
    siteAreaPage?.buyer_insight_ai ??
    areaPage.buyer_insight_ai,

  long_term_outlook_ai:
    siteAreaPage?.long_term_outlook_ai ??
    areaPage.long_term_outlook_ai,
};

pageKind = "area";

page = {
  id: `area-${areaContent.area_slug}`,
  slug: areaContent.area_slug,

  area:
    areaContent.area_name ||
    String(slug).replace(/-/g, " "),

  property_type: "",

  hero_heading:
    areaContent.hero_heading ||
    `${areaContent.area_name || String(slug).replace(/-/g, " ")} Real Estate`,

  eyebrow:
    areaContent.eyebrow || null,

  intro_copy:
    areaContent.intro_copy ||
    areaContent.short_description ||
    `Browse homes for sale in ${
      areaContent.area_name ||
      String(slug).replace(/-/g, " ")
    }.`,

  hero_image_url:
    areaContent.hero_image_url,

  seo_title:
    areaContent.seo_title ||
    `${areaContent.area_name || String(slug).replace(/-/g, " ")} Real Estate`,

  meta_description:
    areaContent.meta_description ||
    areaContent.short_description ||
    "",

  seo_heading:
    areaContent.seo_heading ||
    `${areaContent.area_name || String(slug).replace(/-/g, " ")} Area Guide`,

  seo_intro:
    areaContent.seo_intro ||
    areaContent.short_description ||
    areaContent.intro_copy ||
    "",

  seo_body:
    areaContent.seo_body ||
    areaContent.intro_copy ||
    "",

  seo_long:
    areaContent.seo_long || "",

  neighbourhood_copy:
    areaContent.neighbourhood_copy || null,

  market_commentary:
    areaContent.market_commentary || null,

  market_snapshot_ai:
    areaContent.market_snapshot_ai || null,

  buyer_insight_ai:
    areaContent.buyer_insight_ai || null,

  long_term_outlook_ai:
    areaContent.long_term_outlook_ai || null,

  polygon_geojson:
    areaContent.polygon_geojson,

  default_sort: "newest",

  price_min: null,
  price_max: null,
  waterfront_type: null,
  requires_waterfront: false,
  requires_ocean_view: false,
  faq_json: [],
};
  }
}

logPhaseTiming("site and page resolution");

const titleCaseCity = city.charAt(0).toUpperCase() + city.slice(1).toLowerCase();
const areaName = page.area
  ? page.area.split(" ").map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ")
  : null;

const neighbourhoodCensusPromise =
  pageKind === "area"
    ? supabase
        .from("neighbourhood_census_data")
        .select("*")
        .eq("city", String(city).toLowerCase())
        .eq("slug", String(slug).toLowerCase())
        .maybeSingle()
    : Promise.resolve({
        data: null,
        error: null,
      });

const cityCensusPromise =
  pageKind !== "area"
    ? supabase
        .from("city_census_data")
        .select("*")
        .eq("city", titleCaseCity)
        .maybeSingle()
    : Promise.resolve({
        data: null,
        error: null,
      });

const [
  neighbourhoodCensusResult,
  cityCensusResult,
] = await Promise.all([
  neighbourhoodCensusPromise,
  cityCensusPromise,
]);

const census =
  neighbourhoodCensusResult.data || null;

const cityCensus =
  cityCensusResult.data || null;

const censusData =
  pageKind === "area"
    ? census
    : cityCensus;
let osmLat = 0;
let osmLng = 0;

if (pageKind === "area" && page.polygon_geojson) {
  try {
    const geojson = page.polygon_geojson;
    const coords =
      geojson?.type === "Feature"
        ? geojson.geometry?.coordinates?.[0]
        : geojson?.type === "FeatureCollection"
          ? geojson.features?.[0]?.geometry?.coordinates?.[0]
          : geojson?.coordinates?.[0];

    if (Array.isArray(coords) && coords.length) {
      const lats = coords.map((c: number[]) => c[1]);
      const lngs = coords.map((c: number[]) => c[0]);
      osmLat = lats.reduce((a: number, b: number) => a + b, 0) / lats.length;
      osmLng = lngs.reduce((a: number, b: number) => a + b, 0) / lngs.length;
    }
  } catch (e) {
    // use 0,0 fallback
  }
}

// Fetch OSM amenities directly from Supabase while other page work continues.
let osmSummary = {
  schools: 0,
  parks: 0,
  transit: 0,
  grocery: 0,
  restaurants: 0,
  medical: 0,
  childcare: 0,
  playgrounds: 0,
  recreation: 0,
  trails: 0,
  beaches: 0,
  golf: 0,
  marinas: 0,
  evCharging: 0,
};

const osmSummaryPromise: Promise<typeof osmSummary> =
  osmLat && osmLng
    ? (async () => {
        const osmStartedAt = performance.now();

        try {
          const radiusKm = 4;
          const latitudeDelta = radiusKm / 111;

          const longitudeDelta =
            radiusKm /
            (
              111 *
              Math.max(
                Math.cos(
                  (Number(osmLat) * Math.PI) / 180
                ),
                0.1
              )
            );

          const normalizedOsmCity = String(city)
            .toLowerCase()
            .trim()
            .replace(/\s+/g, "-");

          const {
            data: amenityRows = [],
            error: amenityError,
          } = await supabase
            .from("osm_amenities")
            .select("category,lat,lng")
            .eq("city", normalizedOsmCity)
            .gte("lat", Number(osmLat) - latitudeDelta)
            .lte("lat", Number(osmLat) + latitudeDelta)
            .gte("lng", Number(osmLng) - longitudeDelta)
            .lte("lng", Number(osmLng) + longitudeDelta);

          if (amenityError) {
            throw amenityError;
          }

          const haversineKm = (
            lat1: number,
            lng1: number,
            lat2: number,
            lng2: number
          ) => {
            const earthRadiusKm = 6371;
            const dLat = ((lat2 - lat1) * Math.PI) / 180;
            const dLng = ((lng2 - lng1) * Math.PI) / 180;

            const value =
              Math.sin(dLat / 2) ** 2 +
              Math.cos((lat1 * Math.PI) / 180) *
                Math.cos((lat2 * Math.PI) / 180) *
                Math.sin(dLng / 2) ** 2;

            return (
              earthRadiusKm *
              2 *
              Math.atan2(
                Math.sqrt(value),
                Math.sqrt(1 - value)
              )
            );
          };

          const counts = {
            schools: 0,
            parks: 0,
            transit: 0,
            grocery: 0,
            restaurants: 0,
            medical: 0,
            childcare: 0,
            playgrounds: 0,
            recreation: 0,
            trails: 0,
            beaches: 0,
            golf: 0,
            marinas: 0,
            evCharging: 0,
          };

          for (const row of amenityRows || []) {
            const rowLat = Number(row.lat);
            const rowLng = Number(row.lng);

            if (
              !Number.isFinite(rowLat) ||
              !Number.isFinite(rowLng)
            ) {
              continue;
            }

            const distanceKm = haversineKm(
              Number(osmLat),
              Number(osmLng),
              rowLat,
              rowLng
            );

            if (distanceKm > 2) continue;

            const category = String(
              row.category || ""
            ).toLowerCase();

            if (category.includes("school")) {
              counts.schools++;
            } else if (
              category.includes("grocery") ||
              category.includes("shop")
            ) {
              counts.grocery++;
            } else if (
              category.includes("restaurant") ||
              category.includes("cafe") ||
              category.includes("coffee")
            ) {
              counts.restaurants++;
            } else if (category.includes("park")) {
              counts.parks++;
            } else if (
              category.includes("medical") ||
              category.includes("doctor") ||
              category.includes("clinic") ||
              category.includes("pharmacy")
            ) {
              counts.medical++;
            } else if (
              category.includes("transit") ||
              category.includes("bus")
            ) {
              counts.transit++;
            } else if (category.includes("childcare")) {
              counts.childcare++;
            } else if (category.includes("playground")) {
              counts.playgrounds++;
            } else if (category.includes("recreation")) {
              counts.recreation++;
            } else if (category.includes("trail")) {
              counts.trails++;
            } else if (category.includes("beach")) {
              counts.beaches++;
            } else if (category.includes("golf")) {
              counts.golf++;
            } else if (category.includes("marina")) {
              counts.marinas++;
            } else if (
              category.includes("ev_charging") ||
              category.includes("charging")
            ) {
              counts.evCharging++;
            }
          }

          console.log(
            `[OSM DIRECT TIMING] ${city}/${slug}: ${
              (performance.now() - osmStartedAt).toFixed(1)
            }ms | candidates=${amenityRows?.length || 0}`
          );

          return counts;
        } catch (error) {
          console.error(
            `[OSM DIRECT TIMING] ${city}/${slug}: failed`,
            error
          );

          return osmSummary;
        }
      })()
    : Promise.resolve(osmSummary);
// Auto-generate neighbourhood copy from live data
function generateAreaCopy(listings: any[], census: any, osm: typeof osmSummary, areaName: string, cityName: string) {
  const prices = listings.map((l) => Number(l.price || 0)).filter((p) => p > 0);
  const minPrice = prices.length ? Math.min(...prices) : 0;
  const maxPrice = prices.length ? Math.max(...prices) : 0;
  const medianPrice = prices.length ? [...prices].sort((a, b) => a - b)[Math.floor(prices.length / 2)] : 0;

  const typeCounts: Record<string, number> = {};
  listings.forEach((l) => {
    const t = String(l.normalized_type || "").toLowerCase();
    if (t) typeCounts[t] = (typeCounts[t] || 0) + 1;
  });

  const dominantTypes = Object.entries(typeCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 2)
    .map(([type]) => type === "house" ? "houses" : `${type}s`);

  const fmt = (n: number) => `$${Math.round(n / 1000)}k`;
  const area = areaName || cityName;

  let about = `${area} has ${listings.length} active listing${listings.length !== 1 ? "s" : ""}`;
  if (minPrice && maxPrice) about += ` ranging from ${fmt(minPrice)} to ${fmt(maxPrice)}`;
  if (dominantTypes.length) about += `, predominantly ${dominantTypes.join(" ")}`;
  about += ".";

  if (census?.pct_owned) about += ` With ${census.pct_owned}% owner-occupied households`;
  if (census?.median_age) about += ` and a median age of ${census.median_age}`;
  if (census?.median_household_income) about += `, the area attracts buyers with a median household income of $${Math.round(census.median_household_income / 1000)}k`;
  if (census?.pct_owned || census?.median_age || census?.median_household_income) about += ".";

  let market = `Median pricing sits at ${fmt(medianPrice)} across current listings.`;
  const osmParts = [];
  if (osm.schools > 0) osmParts.push(`${osm.schools} school${osm.schools !== 1 ? "s" : ""}`);
  if (osm.parks > 0) osmParts.push(`${osm.parks} park${osm.parks !== 1 ? "s" : ""}`);
  if (osm.transit > 0) osmParts.push(`${osm.transit} transit stop${osm.transit !== 1 ? "s" : ""}`);
  if (osmParts.length) market += ` Within 2km you'll find ${osmParts.join(" ")}.`;
  market += " Inventory and pricing can shift quickly | check back regularly for new listings.";

  return { about, market };
}


 

const featureResult =
  pageKind === "intent"
    ? await supabase
        .from("intent_page_features")
        .select("feature_key")
        .eq("intent_page_id", page.id)
    : {
        data: [],
        error: null,
      };

const featureRows =
  featureResult.data || [];

const features = featureRows.map(
  (feature) => feature.feature_key
);
const { data: areaBoundaryRows = [] } = await supabase
  .from("area_boundaries")
  .select("id, area_slug, area_name")
  .eq("city", city);

const currentAreaBoundary =
  pageKind === "area"
    ? areaBoundaryRows.find(
        (row) =>
          String(row.area_slug || "").toLowerCase() ===
          String(slug || "").toLowerCase()
      )
    : null;

let gettingAround: any[] = [];

if (pageKind === "area" && currentAreaBoundary?.id) {
  const { data: driveTimeRows = [], error: driveTimeError } =
    await supabase
      .from("area_drive_times")
      .select(`
        duration_seconds,
        distance_metres,
        duration_text,
        distance_text,
        destination:city_destinations!inner (
          id,
          name,
          category,
          icon,
          sort_order,
          is_active
        )
      `)
      .eq("area_boundary_id", currentAreaBoundary.id)
      .eq("destination.is_active", true);

  if (!driveTimeError) {
    const sortedDriveTimes = [...driveTimeRows].sort(
      (a: any, b: any) =>
        Number(a.destination?.sort_order || 0) -
        Number(b.destination?.sort_order || 0)
    );

    /*
     * Show a useful mix instead of displaying two ferries
     * and two shopping destinations in the first six rows.
     */
    const preferredCategories = [
      "downtown",
      "transport",
      "shopping",
      "education",
      "health",
      "recreation",
    ];

    gettingAround = preferredCategories
      .map((category) =>
        sortedDriveTimes.find(
          (row: any) =>
            String(row.destination?.category || "").toLowerCase() ===
            category
        )
      )
      .filter(Boolean);
  }
}

const areas = areaBoundaryRows
  .map((r) => r.area_name || String(r.area_slug || "").replace(/-/g, " "))
  .filter(Boolean)
  .sort((a, b) => a.localeCompare(b));

const areaLinks = areaBoundaryRows
  .map((r) => {
    const areaSlug =
      r.area_slug ||
      String(r.area_name || "")
        .toLowerCase()
        .replace(/\s+/g, "-");

    return {
      label: String(r.area_name || r.area_slug || "")
        .replace(/^pq\s+/i, "")
        .replace(/\b\w/g, (c: string) => c.toUpperCase()),

href: buildContentHref(areaSlug, "area"),
    };
  })
  .filter((a) => a.label && a.href);

const { data: navRows = [] } = await supabase
  .from("listing_rows")
  .select("normalized_type")
  .eq("normalized_city", city)
  .not("normalized_type", "is", null);

const propertyTypes = [...new Set(
  navRows
    .map((row) => String(row.normalized_type || "").trim())
    .filter((item) => item && item !== "unknown" && item !== "sale")
)].sort((a, b) => a.localeCompare(b));

const navIntentPages = await getNavIntentPages(supabase, site?.id);

let areaIntentQuery = supabase
  .from("intent_pages")
  .select("area, slug, hero_heading")
