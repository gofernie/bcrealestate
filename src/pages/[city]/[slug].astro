  const osmLng = Number(areaEl?.dataset.areaCenterLng || 0);

  if (!osmLat || !osmLng) return;

  try {


    const res = await fetch(
  `/api/osm-amenities?city=${encodeURIComponent(osmCity)}&lat=${osmLat}&lng=${osmLng}&radius=${Math.min(amenityRadius + 2, 15)}&limit=250`
);
    const payload = await res.json();
const areaAmenityFilter = (item) => {
  const lat = Number(item.lat);
  const lng = Number(item.lng);

  if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
    return false;
  }

  // Definitely include anything physically inside the area.
  if (pointInAreaPolygon(lat, lng)) {
    return true;
  }

  // Also allow nearby amenities just outside the boundary.
  return Number(item.distKm || 0) <= 2;
};
    // Update chip counts
