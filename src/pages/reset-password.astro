---
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>Choose new password | Locus</title>

    <style>
      :root {
        --ink: #181614;
        --muted: #726e68;
        --border: #dedbd5;
        --paper: #f6f5f2;
        --green: #2fb52c;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 20% 15%,
            rgba(47, 181, 44, 0.09),
            transparent 34%
          ),
          var(--paper);
        color: var(--ink);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      .shell {
        display: grid;
        min-height: 100dvh;
        place-items: center;
        padding: 28px 18px;
      }

      .card {
        width: min(100%, 430px);
        padding: 34px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: #fff;
        box-shadow:
          0 22px 60px rgba(24, 22, 20, 0.1);
      }

      .brand {
        margin-bottom: 32px;
        font-size: 0.82rem;
        font-weight: 900;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .brand span {
        color: var(--green);
      }

      h1 {
        margin: 0 0 8px;
        font-family:
          Georgia,
          "Times New Roman",
          serif;
        font-size: 2.35rem;
        font-weight: 500;
        letter-spacing: -0.04em;
      }

      .intro {
        margin: 0 0 26px;
        color: var(--muted);
        font-size: 0.94rem;
        line-height: 1.55;
      }

      .field {
        margin-bottom: 18px;
      }

      label {
        display: block;
        margin-bottom: 7px;
        font-size: 0.79rem;
        font-weight: 800;
      }

      input {
        display: block;
        width: 100%;
        min-height: 48px;
        padding: 0 13px;
        border: 1px solid var(--border);
        border-radius: 9px;
        color: var(--ink);
        font: inherit;
        outline: none;
      }

      input:focus {
        border-color: var(--ink);
        box-shadow:
          0 0 0 3px rgba(24, 22, 20, 0.08);
      }

      button {
        appearance: none;
        display: flex;
        width: 100%;
        min-height: 49px;
        align-items: center;
        justify-content: center;
        margin-top: 6px;
        border: 0;
        border-radius: 9px;
        background: var(--ink);
        color: #fff;
        font: inherit;
        font-weight: 850;
        cursor: pointer;
      }

      button:disabled {
        cursor: wait;
        opacity: 0.62;
      }

      .message {
        margin-bottom: 20px;
        padding: 12px 13px;
        border-radius: 9px;
        font-size: 0.86rem;
        line-height: 1.45;
      }

      .message.error {
        border: 1px solid #e1adad;
        background: #fff4f4;
        color: #982828;
      }

      .message.success {
        border: 1px solid #a9d6a8;
        background: #f2fff1;
        color: #246d22;
      }

      [hidden] {
        display: none !important;
      }

      @media (max-width: 520px) {
        .shell {
          align-items: start;
          padding-top: 56px;
        }

        .card {
          padding: 27px 22px;
          border-radius: 14px;
        }
      }
    </style>
  </head>

  <body>
    <main class="shell">
      <section class="card">
        <div class="brand">
          <span>Locus</span> Agent
        </div>

        <h1>Choose a new password.</h1>

        <p class="intro" id="reset-intro">
          Verifying your secure recovery link…
        </p>

        <div
          class="message error"
          id="reset-error"
          role="alert"
          hidden
        ></div>

        <div
          class="message success"
          id="reset-success"
          role="status"
          hidden
        ></div>

        <form id="reset-form" hidden>
          <div class="field">
            <label for="password">
              New password
            </label>

            <input
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
            />
          </div>

          <div class="field">
            <label for="confirm-password">
              Confirm new password
            </label>

            <input
              id="confirm-password"
              name="confirm_password"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
            />
          </div>

          <button type="submit" id="reset-submit">
            Save new password
          </button>
        </form>
      </section>
    </main>

    <script>
      import { createClient } from "@supabase/supabase-js";

      const supabase =
        createClient(
          import.meta.env.PUBLIC_SUPABASE_URL,
          import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
          {
            auth: {
              detectSessionInUrl: true,
              persistSession: true,
            },
          }
        );

      const form =
        document.getElementById("reset-form");

      const intro =
        document.getElementById("reset-intro");

      const errorBox =
        document.getElementById("reset-error");

      const successBox =
        document.getElementById("reset-success");

      const submitButton =
        document.getElementById("reset-submit");

      function showError(message) {
        if (errorBox) {
          errorBox.textContent = message;
          errorBox.hidden = false;
        }
      }

      async function establishRecoverySession() {
        const params =
          new URLSearchParams(window.location.search);

        const code =
          params.get("code");

        if (code) {
          const { error } =
            await supabase.auth.exchangeCodeForSession(
              code
            );

          if (error) {
            showError(error.message);
            return false;
          }

          window.history.replaceState(
            {},
            "",
            window.location.pathname
          );
        }

        const {
          data: { session },
        } = await supabase.auth.getSession();

        if (!session) {
          showError(
            "This recovery link is invalid or has expired. Request a new link from the login page."
          );

          if (intro) {
            intro.textContent =
              "We couldn’t verify this recovery link.";
          }

          return false;
        }

        return true;
      }

      const ready =
        await establishRecoverySession();

      if (ready) {
        if (intro) {
          intro.textContent =
            "Enter a new password with at least 8 characters.";
        }

        if (form) {
          form.hidden = false;
        }
      }

      form?.addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();

          if (errorBox) {
            errorBox.hidden = true;
          }

          const passwordInput =
            document.getElementById("password");

          const confirmInput =
            document.getElementById(
              "confirm-password"
            );

          const password =
            String(passwordInput?.value || "");

          const confirmation =
            String(confirmInput?.value || "");

          if (password.length < 8) {
            showError(
              "Use at least 8 characters."
            );
            return;
          }

          if (password !== confirmation) {
            showError(
              "The passwords do not match."
            );
            return;
          }

          if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent =
              "Saving password…";
          }

          const { error } =
            await supabase.auth.updateUser({
              password,
            });

          if (error) {
            showError(error.message);

            if (submitButton) {
              submitButton.disabled = false;
              submitButton.textContent =
                "Save new password";
            }

            return;
          }

          await supabase.auth.signOut();

          if (form) {
            form.hidden = true;
          }

          if (intro) {
            intro.hidden = true;
          }

          if (successBox) {
            successBox.textContent =
              "Password updated. Returning you to sign in…";

            successBox.hidden = false;
          }

          window.setTimeout(() => {
            window.location.assign(
              "/login?reset=success"
            );
          }, 1000);
        }
      );
    </script>
  </body>
</html>