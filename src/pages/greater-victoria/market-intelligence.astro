---
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { getSite } from "../../lib/getSite";
import { loadGreaterVictoriaData } from "../../lib/greaterVictoria";

export const prerender = false;
const configuredSite = await getSite(Astro.url.hostname, "victoria");
const site = { ...configuredSite, city: "greater-victoria", site_name: "Greater Victoria Homes" };
const region = await loadGreaterVictoriaData();
---
<Layout title="Greater Victoria Market Intelligence" city="greater-victoria" site={site} accentColor={site.accent_color || "#2f6f73"}>
  <SiteNav city="greater-victoria" site={site} />
  <main class="regional-market-reports">
    <h1>Greater Victoria market intelligence</h1>
    <p>Choose a district for its local market report.</p>
    <ul>{region.districts.map((district: any) => (
      <li><a href={`/${district.slug}/market-intelligence`}>{district.name} <span aria-hidden="true">→</span></a></li>
    ))}</ul>
  </main>
</Layout>
<style>
  .regional-market-reports { max-width: 1100px; margin: 0 auto; padding: 40px 24px 64px; }
  h1 { margin: 0 0 14px; font-family: Georgia, serif; font-size: clamp(28px, 4vw, 42px); }
  p { color: var(--muted, #677482); }
  ul { margin: 28px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px 28px; }
  a { display: flex; justify-content: space-between; gap: 12px; padding: 15px 0; color: inherit; text-decoration: none; border-bottom: 1px solid var(--border, #d8dee3); }
  a:hover { text-decoration: underline; }
  @media (max-width: 700px) { ul { grid-template-columns: 1fr; } }
</style>
