---
import CityHomepage from "../[city]/index.astro";
import { loadGreaterVictoriaData, regionSlug } from "../../lib/greaterVictoria";
import { greaterVictoriaHomepageBoundaries } from "../../lib/greaterVictoriaHomepage";

export const prerender = false;

// Preserve links saved from the former district/neighbourhood search.
const district = regionSlug(Astro.url.searchParams.get("district"));
if (district) {
  const region = await loadGreaterVictoriaData();
  if (!region.districts.some((item: any) => item.slug === district)) {
    return Astro.redirect("/greater-victoria/", 302);
  }
  const url = new URL(Astro.url);
  const oldArea = regionSlug(url.searchParams.get("area"));
  const target = oldArea
    ? greaterVictoriaHomepageBoundaries(region).find((boundary: any) =>
        boundary.__gvDistrict === district &&
        boundary.__gvOriginalSlug === oldArea
      )?.area_slug || district
    : district;
  url.searchParams.delete("district");
  url.searchParams.set("area", target.replace(/-/g, " "));
  return Astro.redirect(`${url.pathname}?${url.searchParams.toString()}`, 302);
}
if ([...Astro.url.searchParams.keys()].length === 0) {
  Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");
  Astro.response.headers.set("Netlify-CDN-Cache-Control", "public, durable, s-maxage=300, stale-while-revalidate=604800");
}
---
<CityHomepage marketCity="greater-victoria" />
