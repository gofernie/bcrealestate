---
const pageTitle = "Property Match | bc.realestate";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A quick real estate memory game from bc.realestate." />
    <title>{pageTitle}</title>
      <style is:inline>
      /* memory-card-inline-styles-v2 */
      .memory-card {
        position: relative; aspect-ratio: 1; padding: 0; border: 0;
        border-radius: 14px; background: transparent; cursor: pointer; perspective: 700px;
      }
      .memory-card .card-face {
        position: absolute; inset: 0; display: grid; place-items: center;
        border-radius: 14px; backface-visibility: hidden;
        transition: transform .38s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease;
      }
      .memory-card .card-back {
        overflow: hidden; border: 1px solid #2d7775;
        background: linear-gradient(145deg,#246c6a,#164e56);
        box-shadow: inset 0 0 0 4px rgba(255,255,255,.07);
      }
      .memory-card .roof {
        position: absolute; top: 27%; width: 45%; height: 45%;
        border: 3px solid #d4eee6; border-bottom: 0; transform: rotate(45deg);
      }
      .memory-card .door {
        position: absolute; bottom: 21%; width: 18%; height: 28%;
        border-radius: 3px 3px 0 0; background: #d4eee6;
      }
      .memory-card .card-front {
        border: 1px solid #e0e5df; background: #f0f1ed;
        box-shadow: 0 5px 12px rgba(24,53,50,.1); transform: rotateY(180deg);
      }
      .memory-card .emoji {
        font-size: clamp(2rem,5.5vw,3.6rem);
        filter: drop-shadow(0 4px 2px rgba(0,0,0,.08));
      }
      .memory-card:hover .card-back { transform: translateY(-2px); }
      .memory-card.is-flipped .card-back,
      .memory-card.is-matched .card-back { transform: rotateY(180deg); }
      .memory-card.is-flipped .card-front,
      .memory-card.is-matched .card-front { transform: rotateY(0); }
      .memory-card.is-matched .card-front {
        border-color: #74b59e; background: #e1f0e6;
        box-shadow: 0 0 0 3px rgba(82,162,128,.17);
      }
      .memory-card .sr-only {
        position: absolute; width: 1px; height: 1px; overflow: hidden;
        clip: rect(0,0,0,0); white-space: nowrap;
      }
    </style>
  </head>
  <body>
    <main class="game-page">
      <header class="site-bar">
        <a class="wordmark" href="/nanaimo">bc.realestate</a>
        <a class="back-link" href="/nanaimo/homes">Browse homes <span>→</span></a>
      </header>

      <section class="game-shell" aria-labelledby="game-title">
        <div class="intro">
          <p class="eyebrow">A quick break from house hunting</p>
          <h1 id="game-title">Property Match</h1>
          <p class="subhead">Match eight pairs before the market moves.</p>
        </div>

        <div class="scoreboard" aria-label="Game score">
          <div class="score-card progress-card">
            <div class="progress-track"><span id="progress-fill"></span></div>
            <span class="score-label">Pairs matched</span>
            <strong><span id="matched-count">0</span> / 8</strong>
          </div>
          <div class="score-card">
            <span class="score-label">Total moves</span>
            <strong id="move-count">0</strong>
          </div>
          <div class="score-card time-card">
            <span class="score-label">Time</span>
            <strong id="timer">0:00</strong>
          </div>
        </div>

        <div id="game-board" class="game-board" aria-label="Property Match game board"></div>

        <div class="actions">
          <button id="restart-button" class="restart-button" type="button">Reset game</button>
          <a class="return-link" href="/nanaimo/homes">Return to homes</a>
        </div>
      </section>
    </main>

    <dialog id="win-dialog" class="win-dialog">
      <div class="win-content">
        <p class="eyebrow">Nicely played</p>
        <h2>All pairs matched.</h2>
        <p id="win-copy"></p>
        <button id="play-again-button" class="restart-button" type="button">Play again</button>
      </div>
    </dialog>

    <script is:inline>
      const pairs = [
        { icon: "🏠", label: "House" },
        { icon: "🔑", label: "Keys" },
        { icon: "🏡", label: "Home" },
        { icon: "📍", label: "Location pin" },
        { icon: "🪧", label: "For sale sign" },
        { icon: "📋", label: "Contract" },
        { icon: "📈", label: "Market chart" },
        { icon: "🛁", label: "Bathroom" }
      ];

      const board = document.querySelector("#game-board");
      const movesEl = document.querySelector("#move-count");
      const matchedEl = document.querySelector("#matched-count");
      const timerEl = document.querySelector("#timer");
      const progressFill = document.querySelector("#progress-fill");
      const restartButton = document.querySelector("#restart-button");
      const dialog = document.querySelector("#win-dialog");
      const winCopy = document.querySelector("#win-copy");
      const playAgainButton = document.querySelector("#play-again-button");

      let firstCard = null;
      let locked = false;
      let moves = 0;
      let matched = 0;
      let seconds = 0;
      let timerId = null;

      const shuffle = (items) => {
        const shuffled = [...items];
        for (let index = shuffled.length - 1; index > 0; index--) {
          const other = Math.floor(Math.random() * (index + 1));
          [shuffled[index], shuffled[other]] = [shuffled[other], shuffled[index]];
        }
        return shuffled;
      };

      const formatTime = (totalSeconds) => {
        const minutes = Math.floor(totalSeconds / 60);
        const remaining = String(totalSeconds % 60).padStart(2, "0");
        return `${minutes}:${remaining}`;
      };

      const updateScore = () => {
        movesEl.textContent = moves;
        matchedEl.textContent = matched;
        timerEl.textContent = formatTime(seconds);
        progressFill.style.width = `${(matched / pairs.length) * 100}%`;
      };

      const startTimer = () => {
        if (timerId) return;
        timerId = window.setInterval(() => {
          seconds += 1;
          updateScore();
        }, 1000);
      };

      const finishGame = () => {
        window.clearInterval(timerId);
        timerId = null;
        winCopy.textContent = `You matched all 8 pairs in ${moves} moves and ${formatTime(seconds)}.`;
        dialog.showModal();
      };

      const handleCard = (card) => {
        if (locked || card === firstCard || card.classList.contains("is-matched")) return;

        startTimer();
        card.classList.add("is-flipped");

        if (!firstCard) {
          firstCard = card;
          return;
        }

        moves += 1;
        const samePair = firstCard.dataset.pair === card.dataset.pair;

        if (samePair) {
          card.classList.add("is-matched");
          firstCard.classList.add("is-matched");
          matched += 1;
          firstCard = null;
          updateScore();

          if (matched === pairs.length) {
            window.setTimeout(finishGame, 420);
          }
          return;
        }

        locked = true;
        const priorCard = firstCard;

        window.setTimeout(() => {
          card.classList.remove("is-flipped");
          priorCard.classList.remove("is-flipped");
          firstCard = null;
          locked = false;
        }, 700);

        updateScore();
      };

      const buildGame = () => {
        window.clearInterval(timerId);
        timerId = null;
        firstCard = null;
        locked = false;
        moves = 0;
        matched = 0;
        seconds = 0;
        dialog.close();
        board.innerHTML = "";

        const deck = shuffle([...pairs, ...pairs]);

        deck.forEach((item, index) => {
          const card = document.createElement("button");
          card.type = "button";
          card.className = "memory-card";
          card.dataset.pair = item.label;
          card.setAttribute("aria-label", `Reveal card ${index + 1}`);
          card.innerHTML = `
            <span class="card-face card-back" aria-hidden="true">
              <span class="roof"></span>
              <span class="door"></span>
            </span>
            <span class="card-face card-front">
              <span class="emoji" aria-hidden="true">${item.icon}</span>
              <span class="sr-only">${item.label}</span>
            </span>
          `;
          card.addEventListener("click", () => handleCard(card));
          board.appendChild(card);
        });

        updateScore();
      };

      restartButton.addEventListener("click", buildGame);
      playAgainButton.addEventListener("click", buildGame);
      buildGame();
    </script>
    <script src="/look-search.js" defer is:inline></script>
</body>
</html>

<style>
  :global(*) { box-sizing: border-box; }

  :global(body) {
    margin: 0;
    min-width: 320px;
    color: #18262d;
    background: #edf1ed;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .game-page {
    min-height: 100vh;
    padding: 24px;
    background:
      radial-gradient(circle at 8% 2%, rgba(130, 184, 166, 0.2), transparent 28rem),
      radial-gradient(circle at 96% 92%, rgba(244, 193, 111, 0.2), transparent 30rem),
      #f4f5f0;
  }

  .site-bar {
    display: flex;
    width: min(820px, 100%);
    align-items: center;
    justify-content: space-between;
    margin: 0 auto 46px;
  }

  .wordmark {
    color: #143a40;
    font-family: Georgia, serif;
    font-size: 1.45rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link,
  .return-link {
    color: #235e65;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link span { padding-left: 4px; }

  .game-shell {
    width: min(820px, 100%);
    margin: 0 auto;
    padding: clamp(24px, 5vw, 48px);
    border: 1px solid rgba(22, 57, 61, 0.12);
    border-radius: 22px;
    background: rgba(255, 255, 252, 0.88);
    box-shadow: 0 22px 70px rgba(36, 58, 49, 0.14);
  }

  .intro { margin-bottom: 26px; }

  .eyebrow {
    margin: 0 0 8px;
    color: #37766d;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1, h2 {
    margin: 0;
    color: #1c3337;
    font-family: Georgia, serif;
    letter-spacing: -0.04em;
  }

  h1 { font-size: clamp(2.2rem, 5vw, 3.7rem); }
  h2 { font-size: 2rem; }

  .subhead {
    margin: 11px 0 0;
    color: #657374;
    font-size: 1rem;
  }

  .scoreboard {
    display: grid;
    grid-template-columns: 1.45fr 1fr 1fr;
    gap: 12px;
    margin-bottom: 24px;
  }

  .score-card {
    min-height: 84px;
    padding: 16px;
    border-radius: 12px;
    background: #eff2ef;
  }

  .score-label {
    display: block;
    margin-top: 9px;
    color: #657374;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .score-card strong {
    display: block;
    margin-top: 3px;
    color: #173d43;
    font-size: 1.25rem;
  }

  .progress-track {
    height: 6px;
    overflow: hidden;
    border-radius: 99px;
    background: #d6dedb;
  }

  .progress-track span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: #2c8a81;
    transition: width 0.3s ease;
  }

  .game-board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(9px, 1.8vw, 16px);
  }

  .memory-card {
    position: relative;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: transparent;
    cursor: pointer;
    perspective: 700px;
  }

  .card-face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 14px;
    backface-visibility: hidden;
    transition: transform 0.38s cubic-bezier(.2, .8, .2, 1), box-shadow 0.25s ease;
  }

  .card-back {
    overflow: hidden;
    border: 1px solid #2d7775;
    background: linear-gradient(145deg, #246c6a, #164e56);
    box-shadow: inset 0 0 0 4px rgba(255, 255, 255, 0.07);
  }

  .roof {
    position: absolute;
    top: 27%;
    width: 45%;
    height: 45%;
    border: 3px solid #d4eee6;
    border-bottom: 0;
    transform: rotate(45deg);
  }

  .door {
    position: absolute;
    bottom: 21%;
    width: 18%;
    height: 28%;
    border-radius: 3px 3px 0 0;
    background: #d4eee6;
  }

  .card-front {
    border: 1px solid #e0e5df;
    background: #f0f1ed;
    box-shadow: 0 5px 12px rgba(24, 53, 50, 0.1);
    transform: rotateY(180deg);
  }

  .emoji {
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    filter: drop-shadow(0 4px 2px rgba(0,0,0,0.08));
  }

  .memory-card:hover .card-back { transform: translateY(-2px); }
  .memory-card.is-flipped .card-back,
  .memory-card.is-matched .card-back { transform: rotateY(180deg); }
  .memory-card.is-flipped .card-front,
  .memory-card.is-matched .card-front { transform: rotateY(0); }

  .memory-card.is-matched .card-front {
    border-color: #74b59e;
    background: #e1f0e6;
    box-shadow: 0 0 0 3px rgba(82, 162, 128, 0.17);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 28px;
  }

  .restart-button {
    border: 0;
    border-radius: 9px;
    padding: 12px 16px;
    color: #093a3c;
    background: #a5f2e7;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 800;
    cursor: pointer;
  }

  .restart-button:hover { background: #7ee3d5; }

  .win-dialog {
    width: min(440px, calc(100% - 32px));
    padding: 0;
    border: 0;
    border-radius: 20px;
    box-shadow: 0 25px 80px rgba(0,0,0,0.3);
  }

  .win-dialog::backdrop { background: rgba(13, 35, 35, 0.48); }

  .win-content {
    padding: 36px;
    background: #fffef9;
  }

  .win-content p:not(.eyebrow) {
    margin: 12px 0 24px;
    color: #637173;
    line-height: 1.5;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .game-page { padding: 14px; }
    .site-bar { margin-bottom: 26px; }
    .game-shell { padding: 23px 16px; border-radius: 16px; }
    .scoreboard { grid-template-columns: 1fr 1fr; }
    .progress-card { grid-column: 1 / -1; }
    .score-card { min-height: 72px; padding: 12px; }
    .actions { justify-content: space-between; }
  }
</style>
