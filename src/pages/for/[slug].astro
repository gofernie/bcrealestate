---
import Layout from "../../layouts/Layout.astro";
import { createClient } from "@supabase/supabase-js";

const { slug } = Astro.params;

const host =
  Astro.request.headers.get("x-forwarded-host") ||
  Astro.request.headers.get("host") ||
  "";

let domain = host
  .split(",")[0]
  .trim()
  .replace(/^www\./, "")
  .split(":")[0];

const requestedDomain =
  Astro.url.searchParams.get("domain")
    ?.trim()
    .replace(/^https?:\/\//, "")
    .replace(/^www\./, "")
    .split("/")[0]
    .split(":")[0];

if (requestedDomain) {
  domain = requestedDomain;
} else if (
  import.meta.env.DEV &&
  (domain === "localhost" || domain === "127.0.0.1")
) {
  domain = "tammygalvin.bc.realestate";
}

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const { data: prospect, error } = await supabase
  .from("prospect_pages")
  .select("*")
  .eq("domain", domain)
  .eq("slug", slug)
  .eq("is_published", true)
  .maybeSingle();

if (error) {
  console.error("Prospect page lookup failed:", error);
}

if (!prospect) {
  return new Response("Prospect page not found", {
    status: 404,
    headers: {
      "Content-Type": "text/plain; charset=utf-8",
    },
  });
}

const links = prospect.links || {};

function getListingDemoUrl(value) {
  const raw = String(value || "").trim();

  if (!raw) return "";

  const match = raw.match(
    /(?:\/listing\/)?(\d{6,})\/?(?:[?#].*)?$/
  );

  if (!match) return raw;

  const listingId = match[1];

  const market = String(
    prospect.primary_market || "nanaimo"
  )
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

  return `/${market}?listing_id=${encodeURIComponent(listingId)}`;
}

const listingDemoUrl =
  getListingDemoUrl(links.listing);

const sections = prospect.sections || {};

const agentName = prospect.agent_name || "there";
const primaryMarket = prospect.primary_market || "";
const otherMarkets = Array.isArray(prospect.other_markets)
  ? prospect.other_markets
  : [];

const enabled = (key) =>
  sections[key] !== false;
