---
import { createClient } from "@supabase/supabase-js";
import Layout from "../layouts/Layout.astro";
import { getSite } from "../lib/getSite";

export const prerender = false;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

const forwardedHost =
  Astro.request.headers.get("x-forwarded-host") ||
  Astro.request.headers.get("host") ||
  Astro.url.hostname;

const requestDomain = forwardedHost
  .split(",")[0]
  .trim()
  .replace(/^www\./, "")
  .split(":")[0]
  .toLowerCase();

const isLocalRequest =
  requestDomain === "localhost" ||
  requestDomain === "127.0.0.1";

const previewDomain = String(
  Astro.url.searchParams.get("siteDomain") || ""
)
  .trim()
  .toLowerCase()
  .replace(/^www\./, "");

const effectiveDomain =
  isLocalRequest && previewDomain
    ? previewDomain
    : requestDomain;

const site = await getSite(effectiveDomain);

const isDirectoryDomain =
  effectiveDomain === "bc.realestate" ||
  effectiveDomain.endsWith(".netlify.app");

const shouldShowClientHomepage =
  Boolean(site?.city) &&
  !isDirectoryDomain &&
  (!isLocalRequest || Boolean(previewDomain));

if (shouldShowClientHomepage) {
  const homepageUrl = new URL(`/${site.city}`, Astro.url);

  if (isLocalRequest && previewDomain) {
    homepageUrl.searchParams.set("siteDomain", previewDomain);
  }

  return Astro.rewrite(homepageUrl);
}

const { data: sites = [] } = await supabase
  .from("sites")
  .select("city, site_name, domain, accent_color")
  .not("city", "is", null)
  .order("city");

const { data: listings = [] } = await supabase
  .from("listing_rows")
  .select("normalized_city, status, normalized_type, property_type")
  .eq("status", "A");

const cityCounts = listings.reduce((acc: Record<string, number>, row: any) => {
  const city = String(row.normalized_city || "").toLowerCase().trim();
  if (!city) return acc;

  acc[city] = (acc[city] || 0) + 1;
  return acc;
}, {});


const normalizeInventoryType = (value: unknown) => {
  const normalized = String(value || "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "-");

  const aliases: Record<string, string> = {
    homes: "house",
    home: "house",
    houses: "house",
    condos: "condo",
    apartment: "condo",
    apartments: "condo",
    townhome: "townhouse",
    townhomes: "townhouse",
    mobiles: "mobile",
    "mobile-home": "mobile",
    "mobile-homes": "mobile",
    lots: "land",
  };

  return aliases[normalized] || normalized;
};

const cityTypeCounts = listings.reduce(
  (
    acc: Record<string, Record<string, number>>,
    listing: any
  ) => {
    const city = String(
      listing.normalized_city || ""
    )
      .toLowerCase()
      .trim();

    const inventoryType = normalizeInventoryType(
      listing.normalized_type ??
      listing.property_type ??
      ""
    );

    if (!city || !inventoryType) {
      return acc;
    }

    if (!acc[city]) {
      acc[city] = {};
    }

    acc[city][inventoryType] =
      (acc[city][inventoryType] || 0) + 1;

    return acc;
  },
  {}
);
const titleCase = (value = "") =>
  String(value)
    .replace(/-/g, " ")
    .replace(/\b\w/g, (char) => char.toUpperCase());


const MARKET_CITY_GROUPS: Record<string, string[]> = {
  parksville: [
    "parksville",
    "errington",
    "coombs",
    "hilliers",
    "nanoose bay",
    "qualicum beach",
    "qualicum north",
    "french creek",
    "fairwinds",
    "little qualicum river village",
    "bowser/deep bay",
  ],
};

const getMarketCities = (city: string) =>
  MARKET_CITY_GROUPS[city] || [city];

const getMarketListingCount = (city: string) =>
  getMarketCities(city).reduce(
    (total, marketCity) =>
      total + (cityCounts[marketCity] || 0),
    0
  );

const getMarketTypeCounts = (city: string) =>
  getMarketCities(city).reduce(
    (totals: Record<string, number>, marketCity) => {
      const cityTypes =
        cityTypeCounts[marketCity] || {};

      Object.entries(cityTypes).forEach(
        ([type, count]) => {
          totals[type] =
            (totals[type] || 0) +
            Number(count || 0);
        }
      );

      return totals;
    },
    {}
  );
const cityCards = Object.values(
  sites.reduce((acc: Record<string, any>, row: any) => {
    const city = String(row.city || "").toLowerCase().trim();
    if (!city) return acc;

    const label = titleCase(city);

    if (!acc[city]) {
      acc[city] = {
        city,
        label,
        href: `/${city}`,
        count: getMarketListingCount(city),
        typeCounts: getMarketTypeCounts(city),
        accent: row.accent_color || "#176b68",
      };
    }

    return acc;
  }, {})
).sort((a: any, b: any) => b.count - a.count);

const totalListings = cityCards.reduce(
  (total: number, city: any) => total + city.count,
  0
);

const marketCount = cityCards.length;

const normalizeCityKey = (value = "") =>
  String(value)
    .toLowerCase()
    .trim()
    .replace(/[\s_]+/g, "-");

const getCity = (city: string) =>
  cityCards.find(
    (item: any) =>
      normalizeCityKey(item.city) === normalizeCityKey(city)
  );

const regionDefinitions = [
  {
    kicker: "Vancouver Island",
    title: "Island communities",
    copy: "Coastal cities, smaller communities, and relaxed Island living.",
    cities: [
      "nanaimo",
      "parksville",
      "comox",
      "campbell-river",
      "duncan",
      "ladysmith",
      "port-alberni"
    ],
    fallback: "/nanaimo",
    tone: "coast",
  },
  {
    kicker: "Mountain Markets",
    title: "Mountain country",
    copy: "Four-season communities shaped by mountains, trails, and snow.",
    cities: ["whistler", "fernie", "sparwood"],
    fallback: "/whistler",
    tone: "alpine",
  },
  {
    kicker: "Greater Victoria",
    title: "City meets coast",
    copy: "Established neighbourhoods and West Coast living near the capital.",
    cities: ["saanich", "colwood"],
    fallback: "/saanich",
    tone: "harbour",
  },
  {
    kicker: "More BC Markets",
    title: "Places worth exploring",
    copy: "Distinct local markets beyond the province's largest centres.",
    cities: [
      "tofino",
      "lantzville",
      "qualicum-beach",
      "nanoose-bay",
      "elkford"
    ],
    fallback: "/tofino",
    tone: "valley",
  },
];

const regions = regionDefinitions.map((region) => {
  const availableCities = region.cities
    .map(getCity)
    .filter(Boolean);

  return {
    ...region,
    availableCities,
    count: availableCities.reduce(
      (total: number, city: any) => total + city.count,
      0
    ),
  };
});

const featuredPaths = [
  {
    eyebrow: "Everyday BC",
    title: "Homes",
    copy: "Detached homes across established neighbourhoods, rural communities, and growing cities.",
    query: "type=house",
  },
  {
    eyebrow: "Lock and leave",
    title: "Condos",
    copy: "Apartments and condominiums close to centres, amenities, recreation, and the waterfront.",
    query: "type=condo",
  },
  {
    eyebrow: "More for less",
    title: "Mobile homes",
    copy: "Manufactured homes and park communities throughout British Columbia.",
    query: "type=mobile",
  },
  {
    eyebrow: "Build or hold",
    title: "Land",
    copy: "Residential lots, acreage, development opportunities, and rural parcels.",
    query: "type=land",
  },
];

const pageTitle = "BC Real Estate | Homes for Sale Across British Columbia";
const pageDescription =
  "Explore British Columbia homes for sale by city, region, neighbourhood, and property type. Browse live real estate listings across BC.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  accentColor="#176b68"
  city="bc"
>
  <header class="directory-nav">
    <a class="directory-brand" href="/" aria-label="BC Real Estate home">
      <span class="directory-brand__mark">BC</span>
      <span>Real Estate</span>
    </a>

    <nav class="directory-links" aria-label="Primary navigation">
      <a href="#regions">Regions</a>
      <a href="#property-types">Property types</a>
      <a href="#markets">Markets</a>
      <a class="directory-links__agent" href="/login">Agent login</a>
    </nav>
  </header>

  <main>
    <section class="bc-hero">
      <div class="bc-hero__shade"></div>

      <div class="bc-hero__inner">
        <div class="bc-hero__content">
          <p class="eyebrow eyebrow--light">British Columbia real estate</p>

          <h1>Find your place<br />in British Columbia.</h1>

          <p class="bc-hero__copy">
            Search real homes in distinctive BC communities—from the coast
            and islands to mountain towns and growing cities.
          </p>

          <form class="market-jump" id="market-jump">
            <label for="market-select">Where do you want to look?</label>

            <div class="market-jump__controls">
              <select id="market-select" name="market">
                <option value="">Choose a BC market</option>
                {cityCards.map((city: any) => (
                  <option value={city.href}>
                    {city.label} · {city.count.toLocaleString()} listings
                  </option>
                ))}
              </select>

              <button type="submit">Explore market</button>
            </div>
          </form>
        </div>

        <aside class="bc-hero__facts" aria-label="Current listing coverage">
          <div>
            <strong>{marketCount.toLocaleString()}</strong>
            <span>BC markets</span>
          </div>

          <div>
            <strong>{totalListings.toLocaleString()}</strong>
            <span>active listings</span>
          </div>

          <p>Live market inventory, updated regularly.</p>
        </aside>
      </div>
    </section>

    <section class="intro-strip">
      <p>
        One province. Many ways to live.
        <span>Start with the kind of place that feels right.</span>
      </p>

      <a href="#markets">See all markets <span aria-hidden="true">↓</span></a>
    </section>

    <section class="page-section" id="regions">
      <div class="section-heading">
        <p class="eyebrow">Explore by region</p>
        <h2>BC is not one market.</h2>
        <p>
          Each part of the province has its own pace, landscape, housing,
          and local character.
        </p>
      </div>

      <div class="region-grid">
        {regions.map((region, index) => (
          <article class={`region-card region-card--${region.tone}`}>
            <span class="region-card__number">
              {String(index + 1).padStart(2, "0")}
            </span>

            <div class="region-card__content">
              <p>{region.kicker}</p>
              <h3>{region.title}</h3>
              <span class="region-card__copy">{region.copy}</span>

              {region.availableCities.length > 0 && (
                <nav
                  class="region-card__links"
                  aria-label={`${region.title} markets`}
                >
                  {region.availableCities.map((city: any) => (
                    <a href={city.href}>
                      {city.label}
                      <span aria-hidden="true">→</span>
                    </a>
                  ))}
                </nav>
              )}
            </div>

            <div class="region-card__footer">
              <span>
                {region.count > 0
                  ? `${region.count.toLocaleString()} active listings`
                  : "More markets coming soon"}
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section" id="property-types">
      <div class="section-heading">
        <p class="eyebrow">Find your way in</p>
        <h2>Start with the property.</h2>
        <p>
          Choose a market first, or begin with the kind of home
          you are looking for.
        </p>
      </div>

      <div class="path-grid">
        {featuredPaths.map((path, index) => (
          <article
            class="path-card"
            data-property-card
            tabindex="0"
            role="button"
          >
            <span class="path-card__number">
              {String(index + 1).padStart(2, "0")}
            </span>

            <p class="eyebrow">{path.eyebrow}</p>
            <h3>{path.title}</h3>
            <p>{path.copy}</p>

            <button
              class="path-card__action"
              type="button"
              data-property-query={path.query}
            >
              Choose a market first <span aria-hidden="true">→</span>
            </button>
          </article>
        ))}
      </div>
    </section>

    <section class="market-section" id="markets">
      <div class="market-section__inner">
        <div class="section-heading section-heading--market">
          <p class="eyebrow">Browse by city</p>
          <h2 id="market-heading">Choose a BC market.</h2>
          <p>
            Browse current listings, neighbourhoods, property types,
            and local market information.
          </p>
        </div>

        <label class="market-search">
          <span class="sr-only">Search BC markets</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input
            id="market-search"
            type="search"
            placeholder="Search a city or community..."
            autocomplete="off"
          />
        </label>

        <div class="market-grid" id="market-grid">
          {cityCards.map((city: any, index: number) => (
            <a
              class="market-card"
              href={city.href}
              data-market-card
              data-market-name={city.label.toLowerCase()}
              data-count-house={city.typeCounts.house || 0}
              data-count-condo={city.typeCounts.condo || 0}
              data-count-townhouse={city.typeCounts.townhouse || 0}
              data-count-mobile={city.typeCounts.mobile || 0}
              data-count-land={city.typeCounts.land || 0}
              style={`--market-accent:${city.accent};`}
            >
              <span class="market-card__index">
                {String(index + 1).padStart(2, "0")}
              </span>

              <div>
                <h3>{city.label}</h3>
                <p
                  data-market-count
                  data-default-count={`${city.count.toLocaleString()} active listings`}
                >
                  <strong class="market-count-number">{city.count.toLocaleString()}</strong>
                  <span class="market-count-label">
                    {city.count === 1
                      ? "active listing"
                      : "active listings"}
                  </span>
                </p>
              </div>

              <span class="market-card__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <p class="market-empty" id="market-empty" hidden>
          That market is not in the directory yet.
        </p>
      </div>
    </section>

    <section class="closing-panel">
      <div>
        <p class="eyebrow eyebrow--light">Explore locally</p>
        <h2>Real estate begins with place.</h2>
      </div>

      <p>
        BC Real Estate connects broad property search with focused local
        market pages—so you can understand the community before choosing
        the home.
      </p>

      <a href="#markets">Find your market <span aria-hidden="true">↑</span></a>
    </section>
  </main>

  <footer class="directory-footer">
    <a class="directory-brand directory-brand--footer" href="/">
      <span class="directory-brand__mark">BC</span>
      <span>Real Estate</span>
    </a>

    <p>
      Homes, neighbourhoods, and local market information across
      British Columbia.
    </p>

    <span>© {new Date().getFullYear()} BC Real Estate</span>
  </footer>
</Layout>

<script is:inline>
  (() => {
    const marketForm = document.getElementById("market-jump");
    const marketSelect = document.getElementById("market-select");
    const marketSearch = document.getElementById("market-search");
    const marketCards = Array.from(
      document.querySelectorAll("[data-market-card]")
    );
    const marketEmpty = document.getElementById("market-empty");
    const marketHeading = document.getElementById("market-heading");
    const propertyButtons = Array.from(
      document.querySelectorAll("[data-property-query]")
    );

    let selectedPropertyQuery = "";

    marketForm?.addEventListener("submit", (event) => {
      event.preventDefault();

      const destination = marketSelect?.value || "";

      if (destination) {
        const url = new URL(destination, window.location.origin);

        if (selectedPropertyQuery) {
          url.search = selectedPropertyQuery;
        }

        window.location.href = `${url.pathname}${url.search}#homepage-listings`;
        return;
      }

      marketSelect?.focus();
    });

    marketSearch?.addEventListener("input", () => {
      const query = String(marketSearch.value || "")
        .trim()
        .toLowerCase();

      let visibleCount = 0;

      marketCards.forEach((card) => {
        const marketName = card.dataset.marketName || "";
        const isVisible = !query || marketName.includes(query);

        card.hidden = !isVisible;

        if (isVisible) visibleCount += 1;
      });

      if (marketEmpty) {
        marketEmpty.hidden = visibleCount !== 0;
      }
    });

    propertyButtons.forEach((button) => {
      button.addEventListener("click", () => {
        selectedPropertyQuery =
          button.dataset.propertyQuery || "";

        const selectedType =
          new URLSearchParams(
            selectedPropertyQuery
          ).get("type") || "";

        const typeLabels = {
          house: {
            heading: "homes",
            singular: "home for sale",
            plural: "homes for sale"
          },
          condo: {
            heading: "condos",
            singular: "condo for sale",
            plural: "condos for sale"
          },
          townhouse: {
            heading: "townhomes",
            singular: "townhome for sale",
            plural: "townhomes for sale"
          },
          mobile: {
            heading: "mobile homes",
            singular: "mobile home for sale",
            plural: "mobile homes for sale"
          },
          land: {
            heading: "land",
            singular: "land listing",
            plural: "land listings"
          }
        };

        const selectedLabel =
          typeLabels[selectedType];

        if (marketHeading && selectedLabel) {
          marketHeading.textContent =
            `Choose a BC market for ${selectedLabel.heading}.`;
        }

        marketCards.forEach((card) => {
          const countElement =
            card.querySelector("[data-market-count]");

          if (!countElement || !selectedLabel) {
            return;
          }

          const attributeName =
            `count${selectedType
              .charAt(0)
              .toUpperCase()}${selectedType.slice(1)}`;

          const count = Number(
            card.dataset[attributeName] || 0
          );

          const countLabel =
            count === 1
              ? selectedLabel.singular
              : selectedLabel.plural;

          countElement.innerHTML =
            `<strong class="market-count-number">${count.toLocaleString()}</strong>` +
            `<span class="market-count-label">${countLabel}</span>`;
        });

        propertyButtons.forEach((candidate) => {
          const isSelected = candidate === button;

          candidate
            .closest(".path-card")
            ?.classList.toggle("is-selected", isSelected);

          candidate.setAttribute(
            "aria-pressed",
            String(isSelected)
          );
        });

        marketCards.forEach((card) => {
          const originalHref =
            card.dataset.originalHref ||
            card.getAttribute("href") ||
            "";

          card.dataset.originalHref = originalHref;

          const url = new URL(
            originalHref,
            window.location.origin
          );

          url.search = selectedPropertyQuery;

          card.setAttribute(
            "href",
            `${url.pathname}${url.search}#homepage-listings`
          );
        });

        document
          .getElementById("markets")
          ?.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });

        window.setTimeout(() => {
          marketSearch?.focus();
        }, 500);
      });
    });

    const propertyCards = Array.from(
      document.querySelectorAll("[data-property-card]")
    );

    propertyCards.forEach((card) => {
      const activateCard = () => {
        const action = card.querySelector(
          "[data-property-query]"
        );

        action?.click();
      };

      card.addEventListener("click", (event) => {
        if (event.target.closest("[data-property-query]")) {
          return;
        }

        activateCard();
      });

      card.addEventListener("keydown", (event) => {
        if (
          event.key !== "Enter" &&
          event.key !== " "
        ) {
          return;
        }

        event.preventDefault();
        activateCard();
      });
    });
  })();
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f5f3ee;
    color: #161b18;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .directory-nav {
    position: relative;
    z-index: 20;
    min-height: 78px;
    padding: 0 clamp(24px, 4vw, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    background: #faf9f6;
    border-bottom: 1px solid rgba(19, 30, 25, 0.12);
  }

  .directory-brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #121612;
    text-decoration: none;
    font-family: var(--f-display, Georgia, serif);
    font-size: 1.48rem;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .directory-brand__mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #176b68;
    color: white;
    font-family: var(--f-sans, Arial, sans-serif);
    font-size: 0.69rem;
    font-weight: 900;
    letter-spacing: 0.04em;
  }

  .directory-links {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 36px);
  }

  .directory-links a {
    color: #3d4640;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 750;
  }

  .directory-links a:hover {
    color: #176b68;
  }

  .directory-links__agent {
    padding: 11px 16px;
    border: 1px solid rgba(19, 30, 25, 0.18);
    border-radius: 999px;
  }

  .bc-hero {
    position: relative;
    min-height: min(710px, calc(100vh - 78px));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background:
      url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2000&q=88")
      center 48% / cover no-repeat;
  }

  .bc-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(8, 22, 18, 0.82) 0%,
        rgba(8, 22, 18, 0.58) 43%,
        rgba(8, 22, 18, 0.15) 75%,
        rgba(8, 22, 18, 0.07) 100%
      ),
      linear-gradient(
        0deg,
        rgba(7, 18, 15, 0.6) 0%,
        transparent 48%
      );
  }

  .bc-hero__inner {
    position: relative;
    z-index: 2;
    width: min(1420px, calc(100% - 80px));
    margin: 0 auto;
    padding: clamp(90px, 12vh, 150px) 0 58px;
    display: grid;
    grid-template-columns: minmax(0, 800px) 280px;
    align-items: end;
    justify-content: space-between;
    gap: 60px;
  }

  .eyebrow {
    margin: 0 0 13px;
    color: #176b68;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .eyebrow--light {
    color: #a5e0bd;
  }

  .bc-hero h1 {
    max-width: 850px;
    margin: 0;
    color: white;
    font-family: var(--f-display, Georgia, serif);
    font-size: clamp(4rem, 7.4vw, 7rem);
    line-height: 0.87;
    letter-spacing: -0.065em;
    font-weight: 500;
    text-wrap: balance;
  }

  .bc-hero__copy {
    max-width: 650px;
    margin: 27px 0 30px;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1rem, 1.5vw, 1.16rem);
    line-height: 1.65;
  }

  .market-jump {
    max-width: 680px;
  }

  .market-jump label {
    display: block;
    margin-bottom: 9px;
    color: white;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .market-jump__controls {
    display: grid;
    grid-template-columns: 1fr auto;
    padding: 6px;
    border-radius: 8px;
    background: white;
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.22);
  }

  .market-jump select {
    min-width: 0;
    height: 54px;
    padding: 0 18px;
    border: 0;
    outline: 0;
    background: white;
    color: #17201b;
    font: inherit;
    font-size: 0.94rem;
  }

  .market-jump button {
    min-height: 54px;
    padding: 0 22px;
    border: 0;
    border-radius: 5px;
    background: #176b68;
    color: white;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 850;
    cursor: pointer;
  }

  .market-jump button:hover {
    background: #105b58;
  }

  .bc-hero__facts {
    padding: 24px;
    color: white;
    border-top: 1px solid rgba(255, 255, 255, 0.48);
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
  }

  .bc-hero__facts div {
    display: grid;
    grid-template-columns: 88px 1fr;
    align-items: baseline;
    gap: 12px;
    padding: 9px 0;
  }

  .bc-hero__facts strong {
    font-family: var(--f-display, Georgia, serif);
    font-size: 2.15rem;
    line-height: 1;
    font-weight: 500;
  }

  .bc-hero__facts span {
    color: rgba(255, 255, 255, 0.74);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bc-hero__facts p {
    margin: 16px 0 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .intro-strip {
    min-height: 126px;
    padding: 28px max(40px, calc((100% - 1420px) / 2));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    background: #122c27;
    color: white;
  }

  .intro-strip p {
    margin: 0;
    font-family: var(--f-display, Georgia, serif);
    font-size: clamp(1.3rem, 2vw, 1.85rem);
  }

  .intro-strip p span {
    margin-left: 8px;
    color: rgba(255, 255, 255, 0.6);
  }

  .intro-strip a {
    flex: 0 0 auto;
    color: white;
    text-decoration: none;
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .page-section {
    width: min(1420px, calc(100% - 80px));
    margin: 0 auto;
    padding: 96px 0 108px;
  }

  .section-heading {
    max-width: 790px;
    margin-bottom: 40px;
  }

  .section-heading h2 {
    margin: 0 0 16px;
    font-family: var(--f-display, Georgia, serif);
    font-size: clamp(2.7rem, 5vw, 5rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
    font-weight: 500;
  }

  .section-heading > p:last-child {
    max-width: 610px;
    margin: 0;
    color: #606a64;
    font-size: 1rem;
    line-height: 1.65;
  }

  .region-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .region-card {
    position: relative;
    min-height: 390px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 4px;
    color: white;
    isolation: isolate;
    transition: transform 0.2s ease;
  }

  .region-card:hover {
    transform: translateY(-3px);
  }

  .region-card::before,
  .region-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .region-card::after {
    z-index: -1;
    background:
      linear-gradient(130deg, rgba(6, 18, 15, 0.88), rgba(6, 18, 15, 0.2)),
      linear-gradient(0deg, rgba(6, 18, 15, 0.6), transparent 70%);
  }

  .region-card--coast::before {
    background:
      linear-gradient(135deg, #174b51, #73a69c 65%, #bbcab9);
  }

  .region-card--alpine::before {
    background:
      linear-gradient(145deg, #233c42, #718487 62%, #d0d6ce);
  }

  .region-card--harbour::before {
    background:
      linear-gradient(145deg, #183d3a, #687f70 62%, #b3aa8c);
  }

  .region-card--valley::before {
    background:
      linear-gradient(145deg, #314337, #788165 62%, #c4b692);
  }

  .region-card__number {
    align-self: flex-end;
    font-family: var(--f-display, Georgia, serif);
    font-size: 1.15rem;
    opacity: 0.65;
  }

  .region-card__content {
    max-width: 480px;
    margin-top: auto;
  }

  .region-card__content > p {
    margin: 0 0 8px;
    color: #b6e2ca;
    font-size: 0.67rem;
    font-weight: 900;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .region-card h3 {
    margin: 0 0 14px;
    font-family: var(--f-display, Georgia, serif);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
    font-weight: 500;
  }

  .region-card__copy {
    display: block;
    max-width: 390px;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .region-card__links {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .region-card__links a {
    padding: 8px 11px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    color: white;
    text-decoration: none;
    font-size: 0.71rem;
    font-weight: 800;
    backdrop-filter: blur(4px);
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .region-card__links a:hover {
    background: white;
    border-color: white;
    color: #14221c;
    transform: translateY(-1px);
  }

  .region-card__footer {
    margin-top: 30px;
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .market-section {
    padding: 100px 0 110px;
    background: #faf9f6;
    border-top: 1px solid rgba(20, 31, 25, 0.1);
    border-bottom: 1px solid rgba(20, 31, 25, 0.1);
  }

  .market-section__inner {
    width: min(1420px, calc(100% - 80px));
    margin: 0 auto;
  }

  .section-heading--market {
    margin-bottom: 26px;
  }

  .market-search {
    width: min(620px, 100%);
    height: 58px;
    margin: 0 0 28px;
    padding: 0 17px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: white;
    border: 1px solid rgba(20, 31, 25, 0.15);
    border-radius: 5px;
  }

  .market-search:focus-within {
    border-color: #176b68;
    box-shadow: 0 0 0 3px rgba(23, 107, 104, 0.1);
  }

  .market-search svg {
    width: 20px;
    fill: none;
    stroke: #66726b;
    stroke-width: 1.7;
  }

  .market-search input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: #17201b;
    font: inherit;
    font-size: 0.92rem;
  }

  .market-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(20, 31, 25, 0.13);
    border-left: 1px solid rgba(20, 31, 25, 0.13);
  }

  .market-card {
    min-height: 135px;
    padding: 20px;
    display: grid;
    grid-template-columns: 36px 1fr auto;
    align-items: start;
    gap: 14px;
    background: #faf9f6;
    color: inherit;
    text-decoration: none;
    border-right: 1px solid rgba(20, 31, 25, 0.13);
    border-bottom: 1px solid rgba(20, 31, 25, 0.13);
    transition: background 0.18s ease;
  }

  .market-card:hover {
    background:
      color-mix(
        in srgb,
        var(--market-accent, #176b68) 7%,
        white
      );
  }

  .market-card[hidden] {
    display: none;
  }

  .market-card__index {
    color: #8c958f;
    font-family: var(--f-display, Georgia, serif);
    font-size: 0.78rem;
  }

  .market-card h3 {
    margin: 0 0 8px;
    font-family: var(--f-display, Georgia, serif);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .market-card p {
    margin: 0;
    color: #69736d;
    font-size: 0.77rem;
  }

  .market-card__arrow {
    color: var(--market-accent, #176b68);
    font-size: 1.15rem;
  }

  .market-empty {
    padding: 28px 0;
    color: #68726c;
  }

  .path-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .path-card {
    min-height: 330px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    background: #eceae4;
    border-top: 3px solid #176b68;
  }

  .path-card:nth-child(2) {
    background: #e2ebe7;
  }

  .path-card:nth-child(3) {
    background: #ebe5d9;
  }

  .path-card:nth-child(4) {
    background: #e3e5df;
  }

  .path-card__number {
    margin-left: auto;
    color: #7f8882;
    font-family: var(--f-display, Georgia, serif);
    font-size: 0.85rem;
  }

  .path-card .eyebrow {
    margin-top: auto;
  }

  .path-card h3 {
    margin: 0 0 13px;
    font-family: var(--f-display, Georgia, serif);
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 600;
  }

  .path-card > p:not(.eyebrow) {
    margin: 0 0 24px;
    color: #58625c;
    font-size: 0.83rem;
    line-height: 1.55;
  }

  .path-card__action {
    padding: 0;
    display: flex;
    justify-content: space-between;
    border: 0;
    background: transparent;
    color: #17201b;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 850;
    cursor: pointer;
  }

  .closing-panel {
    width: min(1420px, calc(100% - 80px));
    min-height: 340px;
    margin: 0 auto 90px;
    padding: clamp(36px, 6vw, 74px);
    display: grid;
    grid-template-columns: 1.2fr 0.9fr auto;
    align-items: end;
    gap: 50px;
    background: #122c27;
    color: white;
  }

  .closing-panel h2 {
    max-width: 570px;
    margin: 0;
    font-family: var(--f-display, Georgia, serif);
    font-size: clamp(2.8rem, 5vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.06em;
    font-weight: 500;
  }

  .closing-panel > p {
    margin: 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .closing-panel > a {
    color: white;
    text-decoration: none;
    white-space: nowrap;
    font-size: 0.76rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .directory-footer {
    min-height: 180px;
    padding: 38px max(40px, calc((100% - 1420px) / 2));
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: start;
    gap: 40px;
    background: #e9e7e1;
    border-top: 1px solid rgba(20, 31, 25, 0.1);
  }

  .directory-brand--footer {
    font-size: 1.2rem;
  }

  .directory-footer p,
  .directory-footer > span {
    margin: 4px 0 0;
    color: #68716b;
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1000px) {
    .bc-hero__inner {
      grid-template-columns: 1fr;
    }

    .bc-hero__facts {
      max-width: 500px;
    }

    .market-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .path-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .closing-panel {
      grid-template-columns: 1fr 1fr;
    }

    .closing-panel > a {
      grid-column: 2;
    }
  }

  @media (max-width: 760px) {
    .directory-nav {
      min-height: 68px;
      padding: 0 18px;
    }

    .directory-brand {
      font-size: 1.25rem;
    }

    .directory-brand__mark {
      width: 30px;
      height: 30px;
    }

    .directory-links a:not(.directory-links__agent) {
      display: none;
    }

    .directory-links__agent {
      padding: 9px 12px;
    }

    .bc-hero {
      min-height: 690px;
      background-position: 62% center;
    }

    .bc-hero__shade {
      background:
        linear-gradient(
          0deg,
          rgba(7, 20, 16, 0.94) 0%,
          rgba(7, 20, 16, 0.62) 58%,
          rgba(7, 20, 16, 0.2) 100%
        );
    }

    .bc-hero__inner {
      width: 100%;
      padding: 100px 18px 28px;
      gap: 30px;
    }

    .bc-hero h1 {
      font-size: clamp(3.5rem, 17vw, 5.3rem);
    }

    .market-jump__controls {
      grid-template-columns: 1fr;
      gap: 5px;
    }

    .market-jump button {
      width: 100%;
    }

    .bc-hero__facts {
      padding: 16px 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px 18px;
    }

    .bc-hero__facts div {
      grid-template-columns: 1fr;
      gap: 5px;
    }

    .bc-hero__facts p {
      grid-column: 1 / -1;
    }

    .intro-strip {
      padding: 25px 18px;
      align-items: flex-start;
      flex-direction: column;
    }

    .intro-strip p span {
      display: block;
      margin: 6px 0 0;
    }

    .page-section,
    .market-section__inner,
    .closing-panel {
      width: 100%;
    }

    .page-section {
      padding: 70px 18px 78px;
    }

    .market-section {
      padding: 70px 18px 78px;
    }

    .section-heading h2 {
      font-size: clamp(2.7rem, 13vw, 4rem);
    }

    .region-grid {
      grid-template-columns: 1fr;
    }

    .region-card {
      min-height: 330px;
    }

    .market-grid {
      grid-template-columns: 1fr;
    }

    .market-card {
      min-height: 112px;
    }

    .path-grid {
      grid-template-columns: 1fr;
    }

    .path-card {
      min-height: 270px;
    }

    .closing-panel {
      margin-bottom: 0;
      padding: 58px 18px;
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .closing-panel > a {
      grid-column: auto;
    }

    .directory-footer {
      padding: 38px 18px;
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  /* Softer regional collection cards */
  .region-grid {
    gap: 16px;
  }

  .region-card {
    min-height: 350px;
    padding: 30px;
    color: #17231e;
    border: 1px solid rgba(26, 48, 39, 0.1);
    border-radius: 10px;
    box-shadow: 0 8px 28px rgba(28, 42, 35, 0.045);
  }

  .region-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(28, 42, 35, 0.08);
  }

  .region-card::after {
    display: none;
  }

  .region-card--coast::before {
    background: linear-gradient(145deg, #e3efea, #d4e4de);
  }

  .region-card--alpine::before {
    background: linear-gradient(145deg, #e7eceb, #d9e2e1);
  }

  .region-card--harbour::before {
    background: linear-gradient(145deg, #edf0e8, #dfe6dc);
  }

  .region-card--valley::before {
    background: linear-gradient(145deg, #f0ebe0, #e4dfd2);
  }

  .region-card__number {
    color: rgba(25, 47, 38, 0.48);
    opacity: 1;
  }

  .region-card__content {
    width: 100%;
    max-width: none;
  }

  .region-card__content > p {
    color: #176b68;
  }

  .region-card h3 {
    margin-bottom: 12px;
    color: #17231e;
  }

  .region-card__copy {
    color: #5d6963;
  }

  .region-card__links {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .region-card__links a {
    min-height: 43px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #1b332a;
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(25, 55, 43, 0.12);
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 800;
    backdrop-filter: none;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }

  .region-card__links a:hover {
    color: #114f4d;
    background: white;
    border-color: rgba(23, 107, 104, 0.34);
    transform: translateY(-1px);
  }

  .region-card__links a span {
    color: #176b68;
  }

  .region-card__footer {
    color: #647069;
    border-top-color: rgba(25, 47, 38, 0.14);
  }

  @media (max-width: 560px) {
    .region-card {
      min-height: 0;
      padding: 24px;
