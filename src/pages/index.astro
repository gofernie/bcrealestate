<style is:global>
  /* subtle-bc-hero-drift-v2 */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .bc-hero {
      isolation: isolate;
      background-image: none !important;
    }

    .bc-hero::before {
      content: "";
      position: absolute;
      z-index: 0;
      inset: -12%;
      background:
        url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2000&q=88")
        center 48% / cover no-repeat;
      transform:
        translate3d(
          0,
          var(--bc-hero-drift-y, -48px),
          0
        );
      will-change: transform;
      pointer-events: none;
    }

    .bc-hero__shade {
      z-index: 1;
    }
  }
</style>

<script is:inline>
  (() => {
    const hero = document.querySelector(".bc-hero");

    const motionAllowed = window.matchMedia(
      "(min-width: 900px) and (prefers-reduced-motion: no-preference)"
    ).matches;

    if (!hero || !motionAllowed) {
      return;
    }

    let frameRequested = false;

    const updateBcHeroDrift = () => {
      frameRequested = false;

      const heroHeight =
        hero.getBoundingClientRect().height || 1;

      const progress = Math.min(
        1,
        Math.max(0, window.scrollY / heroHeight)
      );

      const drift = -48 + progress * 96;

      hero.style.setProperty(
        "--bc-hero-drift-y",
        `${drift.toFixed(2)}px`
      );
    };

    const requestBcHeroDriftUpdate = () => {
      if (frameRequested) return;

      frameRequested = true;
      requestAnimationFrame(updateBcHeroDrift);
    };

    window.addEventListener(
      "scroll",
      requestBcHeroDriftUpdate,
      { passive: true }
    );

    window.addEventListener(
      "resize",
      requestBcHeroDriftUpdate
    );

    updateBcHeroDrift();
  })();
</script>
<style is:global>
  /* lighter-bc-hero-overlay-v1 */
  .bc-hero__shade {
    opacity: 0.72 !important;
  }
</style>
