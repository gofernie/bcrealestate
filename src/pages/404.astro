---
export const prerender = false;

Astro.response.status = 404;

const parts = Astro.url.pathname
  .split("/")
  .filter(Boolean);

const likelyCity =
  parts.length > 1
    ? parts[0]
    : "";

const marketBase =
  likelyCity
    ? `/${likelyCity}`
    : "";

const cityLabel = likelyCity
  .replace(/-/g, " ")
  .replace(/\b\w/g, (letter) =>
    letter.toUpperCase()
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="robots" content="noindex, follow" />
    <title>Page not found | Locus</title>

    <style>
      :root {
        --ink: #181614;
        --muted: #706b64;
        --paper: #f6f4ef;
        --surface: #fff;
        --line: #dfd9cf;
        --accent: #147d73;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 15% 10%,
            rgba(20, 125, 115, 0.11),
            transparent 34%
          ),
          var(--paper);
        color: var(--ink);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          sans-serif;
      }

      main {
        display: grid;
        min-height: 100vh;
        place-items: center;
        padding: 32px 18px;
      }

      .card {
        width: min(100%, 760px);
        padding: clamp(30px, 6vw, 64px);
        border: 1px solid var(--line);
        border-radius: 22px;
        background: var(--surface);
        box-shadow:
          0 24px 70px rgba(24, 22, 20, 0.09);
      }

      .kicker {
        margin: 0 0 20px;
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 900;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 620px;
        margin: 0;
        font-family:
          Georgia,
          "Times New Roman",
          serif;
        font-size: clamp(2.5rem, 7vw, 5rem);
        font-weight: 500;
        letter-spacing: -0.055em;
        line-height: 0.98;
      }

      .intro {
        max-width: 570px;
        margin: 24px 0 0;
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.7;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 32px;
      }

      .button {
        display: inline-flex;
        min-height: 46px;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        border: 1px solid var(--ink);
        border-radius: 10px;
        color: var(--ink);
        font-size: 0.86rem;
        font-weight: 800;
        text-decoration: none;
      }

      .button--primary {
        background: var(--ink);
        color: #fff;
      }

      .links {
        display: grid;
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 42px;
        padding-top: 28px;
        border-top: 1px solid var(--line);
      }

      .links a {
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: 12px;
        color: var(--ink);
        font-weight: 750;
        text-decoration: none;
      }

      .links span {
        display: block;
        margin-top: 4px;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 500;
      }

      @media (max-width: 560px) {
        .links {
          grid-template-columns: 1fr;
        }

        .button {
          width: 100%;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <section class="card">
        <p class="kicker">404 · Let’s get you home</p>

        <h1>
          This page has moved on.
        </h1>

        <p class="intro">
          The page may have been removed or its address
          may have changed. The homes are still here—let’s
          get you back to something useful.
        </p>

        <div class="actions">
          <a class="button button--primary" href="/">
            Go to the homepage
          </a>

          <button
            class="button"
            type="button"
            onclick="history.back()"
          >
            Go back
          </button>
        </div>

        {
          likelyCity && (
            <div class="links">
              <a href={`${marketBase}/homes`}>
                Browse {cityLabel} homes
                <span>See detached homes for sale</span>
              </a>

              <a href={`${marketBase}/condos`}>
                Browse {cityLabel} condos
                <span>Explore apartments and condos</span>
              </a>

              <a href={`${marketBase}/areas`}>
                Explore neighbourhoods
                <span>Find the part of town that fits</span>
              </a>

              <a href={marketBase}>
                Search all listings
                <span>Return to the full market</span>
              </a>
            </div>
          )
        }
      </section>
    </main>
  </body>
</html>